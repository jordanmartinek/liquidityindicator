//@version=6
// =============================================================================
// Liquidity Radar  (Pine Script v6) — STREAMLINED CORE
// Focus: key liquidity levels + their validity.
//   • Liquidity levels: PDH/PDL, PWH/PWL, PMH/PML, sessions H/L, swings (+HTF),
//     equal highs/lows — all removed once swept.
//   • Stacked liquidity: nearby levels merge into strength-rated zones.
//   • Confluence score (0-100) per zone.
//   • Draw-on-Liquidity (DOL) bias gauge + conviction.
//   • Order Blocks and Fair Value Gaps.
//   • Sweep + reversal (SFP) markers, per-level countdown, age-scaled extension.
// =============================================================================
indicator("Liquidity Radar", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// Anchor plot so the compiler always sees a top-level drawing output.
plot(na, "anchor", display = display.none)

// -----------------------------------------------------------------------------
// GROUP NAMES
// -----------------------------------------------------------------------------
var string G_PREV   = "① Previous-Period Levels"
var string G_SESS   = "② Sessions"
var string G_STRUCT = "③ Structure (swings · EQ · FVG · OB · SFP)"
var string G_CD     = "④ Countdown"
var string G_CLUST  = "⑤ Clustering & Confluence"
var string G_DOL    = "⑥ Draw-on-Liquidity Gauge"
var string G_STYLE  = "⑦ Style"
var string G_EMO    = "⑧ Emoji Tags"
var string G_TESTED = "⑨ Tested Levels"
var string G_EXEC   = "⑩ FVG Execution (setups)"
var string G_BIAS   = "⑪ Daily Bias"
var string G_EMA    = "⑫ Moving Averages (EMA)"

// -----------------------------------------------------------------------------
// INPUTS — PREVIOUS-PERIOD LEVELS
// -----------------------------------------------------------------------------
showPDHL = input.bool(true,  "Prev Day High/Low (PDH/PDL)",    group = G_PREV)
showPWHL = input.bool(true,  "Prev Week High/Low (PWH/PWL)",   group = G_PREV)
showPMHL = input.bool(false, "Prev Month High/Low (PMH/PML)",  group = G_PREV)
showDO   = input.bool(false, "Daily Open",                     group = G_PREV)
showWO   = input.bool(false, "Weekly Open",                    tooltip = "Current week's opening price — a key institutional reference; price often reverts to it. Feeds the clusters + DOL pull.", group = G_PREV)
showMO   = input.bool(false, "Monthly Open",                   tooltip = "Current month's opening price — a major reference level. Feeds the clusters + DOL pull.", group = G_PREV)
showMidO = input.bool(false, "NY Midnight Open (00:00 ET)",    tooltip = "Price at 00:00 New York time — the ICT 'true day' open. A high-signal intraday anchor for premium/discount. Feeds the clusters + DOL pull.", group = G_PREV)

// -----------------------------------------------------------------------------
// INPUTS — SESSIONS
// -----------------------------------------------------------------------------
sessTZ    = input.string("UTC", "Session Timezone", options = ["UTC","America/New_York","Europe/London","Asia/Tokyo"], group = G_SESS)
showAsia  = input.bool(true,  "Asian Session H/L",   group = G_SESS)
asiaSess  = input.session("0000-0800", "  Asian time",   group = G_SESS)
showLond  = input.bool(true,  "London Session H/L",  group = G_SESS)
londSess  = input.session("0800-1600", "  London time",  group = G_SESS)
showNY    = input.bool(true,  "New York Session H/L", group = G_SESS)
nySess    = input.session("1300-2100", "  New York time", group = G_SESS)
sessResetDaily = input.bool(true, "Reset session H/L each new day", tooltip = "At the start of a new trading day, clear the previous day's session highs/lows so stale levels don't linger.", group = G_SESS)
sessRemoveSwept = input.bool(true, "Remove session level once swept", tooltip = "If price trades through a session high/low, drop it (the liquidity has been taken).", group = G_SESS)
sessReclassify = input.bool(true, "Reclassify unswept session H/L as swings", tooltip = "A session high/low that survives into the next day (never swept) gets relabeled e.g. 'Asia H (swing)'.", group = G_SESS)

// -----------------------------------------------------------------------------
// INPUTS — STRUCTURE
// -----------------------------------------------------------------------------
showSwing  = input.bool(true,  "Swing Highs/Lows (liquidity)", group = G_STRUCT)
swingLen   = input.int(10, "  Swing pivot length", minval = 2, group = G_STRUCT)
swingHist  = input.int(40, "  Historical swings kept (per side)", minval = 1, maxval = 200, tooltip = "How many UNSWEPT swing highs/lows to keep. Higher = more levels going back. Old untapped swings persist until swept.", group = G_STRUCT)
htfSwingOn = input.bool(true, "  Add higher-timeframe swings", tooltip = "Also pull swing highs/lows from a higher timeframe so major structural levels far back are captured on a low-TF chart.", group = G_STRUCT)
htfTF      = input.timeframe("240", "  HTF timeframe", tooltip = "Timeframe for the extra structural swings (e.g. 240 = 4h, D = daily).", group = G_STRUCT)
htfLen     = input.int(5, "  HTF swing pivot length", minval = 2, group = G_STRUCT)
removeSwept = input.bool(true, "Remove swept levels (swings, EQ, prev-period)", tooltip = "Once price trades through a level, remove it - the liquidity has been taken.", group = G_STRUCT)
showEQ     = input.bool(true,  "Equal Highs/Lows (EQH/EQL)",   group = G_STRUCT)
eqTol      = input.float(0.35, "  EQ tolerance (× ATR)", minval = 0.0, step = 0.05, tooltip = "Two swing pivots count as an Equal High/Low if within this many ATRs of each other.", group = G_STRUCT)
eqLookback = input.int(6, "  EQ lookback (pivots)", minval = 1, maxval = 30, tooltip = "How many recent same-type pivots to compare against when hunting equal highs/lows.", group = G_STRUCT)
showRelEQ  = input.bool(true, "  Relative (near) Equal H/L", tooltip = "Also flag NEAR-equal highs/lows — pivots close but not within the strict EQ tolerance. Real stop-runs rarely line up to the tick; relative EQs (rEQH/rEQL) catch the softer clusters. Tagged distinctly and fed into the clusters/pull at a slightly lower weight than exact EQs.", group = G_STRUCT)
relEqTol   = input.float(0.75, "    Relative EQ tolerance (× ATR)", minval = 0.0, step = 0.05, tooltip = "Wider band (in ATRs) for near-equal highs/lows. Should be larger than the strict EQ tolerance.", group = G_STRUCT)
showBreaker = input.bool(true, "Breaker blocks (failed OB flips polarity)", tooltip = "When an order block is violated (price closes through it), it doesn't just vanish — it becomes a BREAKER: former demand flips to supply (and vice versa). Breakers are strong reaction zones; they feed the confluence score + resistance like order blocks.", group = G_STRUCT)
// --- FVG ---
showFVG    = input.bool(true,  "Fair Value Gaps (FVG)",        group = G_STRUCT)
hideMitFVG = input.bool(true,  "  Remove invalidated FVGs",    group = G_STRUCT)
fvgFillMode = input.string("Body close through", "  FVG invalidation", options = ["Body close through","Wick touch (50%)","Full fill (wick)"], tooltip = "Body close through: gap disappears once a candle CLOSES beyond it. Wick touch: removed at midpoint. Full fill: removed only when a wick fully engulfs it.", group = G_STRUCT)
// --- FVG strength filter (declutter: only keep gaps price is likely to respect) ---
fvgFilterOn   = input.bool(true,  "  Filter FVGs by strength", tooltip = "RANK every fair value gap 0-100 (a relative QUALITY ranking, not a probability) and only draw the ones that clear the threshold below. The rank = a CORE BASE (the quality every gap has: size vs ATR · creation volume · displacement · premium/discount — a clean ordinary gap lands ~40-55) PLUS BONUS points added on top only when the occasional factors fire (inside an order/breaker block, inversion/IFVG, higher-timeframe-gap alignment, round-number/VWAP/OTE confluence, liquidity-pool confluence, sweep precedence), minus a discount if the gap is already tested or poorly located. Absent bonuses never penalise — so a valid gap keeps a usable score and confluent gaps rise above ordinary ones. Typical: trivial gap <30, ordinary 40-55, confluent 65-90+.", group = G_STRUCT)
fvgMinStr     = input.int(35, "    Min FVG strength % to draw", minval = 0, maxval = 100, tooltip = "Fair value gaps ranking below this are hidden (or dimmed, if 'Dim weak FVGs' is on). On the core-base+bonus scale a TYPICAL valid gap ranks ~45-60 and confluent gaps 65-90+, so ~35 keeps genuine gaps while dimming only the trivial ones. TUNE THIS to the % values you actually see on your chart: if too many gaps dim, lower it; if too many show, raise it.", group = G_STRUCT)
fvgDimWeak    = input.bool(true, "    Dim weak FVGs instead of hiding", tooltip = "Rather than removing sub-threshold gaps entirely, draw them very faintly so context is kept while the strong gaps stand out. Off = weak gaps are not drawn at all.", group = G_STRUCT)
fvgShowStr    = input.bool(true, "    Label FVG strength %", tooltip = "Print each drawn gap's strength % (plus tags: 'htf' = aligns with a higher-timeframe gap, 'liq' = sits on/just beyond a liquidity pool (EQ / prev-period / open / session / swing / VP), 'swp' = formed right after a same-direction sweep (SFP), 'inv' = followed an inversion, 'blk' = inside an order/breaker block) so you can see WHY it scored the way it did.", group = G_STRUCT)
fvgLblStyle   = input.string("Inside box (centered)", "    FVG label style", options = ["Inside box (centered)","Pointer (distinct)","Plain text (no box)","Callout (like levels)"], tooltip = "How the FVG strength % label is drawn, so it doesn't blend into the level/cluster callouts when zoomed out. 'Inside box (centered)': the % sits CENTERED inside the gap box itself — tied directly to its box, clearly separate from the level labels at the right edge (recommended). 'Pointer (distinct)': a tinted pointer tag at the LEFT edge of the gap. 'Plain text (no box)': borderless text in the gap color — the most minimal. 'Callout (like levels)': the original left-callout box at the right edge.", group = G_STRUCT)
fvgKeep       = input.int(50, "    Max FVGs kept", minval = 5, maxval = 100, tooltip = "How many unfilled fair value gaps to retain before the OLDEST is dropped. Raise this to keep more / older gaps far back in history (e.g. gaps sitting above the current swing high); lower it to keep the chart light. Note: gaps older than the chart's loaded history still can't be drawn, and each gap uses a drawing-object slot shared with order blocks and cluster zones (budget is 500).", group = G_STRUCT)
fvgRejGauge  = input.bool(true, "    Rejection gauge (live, when price is in the gap)", tooltip = "A LIVE read shown next to the % ONLY while price is at/returning into the gap: how likely price is to REJECT (bounce off) vs ACCEPT (fill through) the gap right now. Shown as ⟲NN (reject-leaning, 50-100) or ⇥NN (accept-leaning, 0-50). It blends: the STRENGTH of the move that created the gap, the STRENGTH of the pullback returning into it (fast momentum return → more likely to blow through; slow drift → more likely to reject), ABSORPTION (a wick pushing back out of the gap on the touch bar), and the CHARACTER of the candles approaching the gap (pure trend bodies → accept-leaning; wicky/indecisive → reject-leaning). This is a heuristic read, NOT a measured probability, and it is separate from the formation strength %.", group = G_STRUCT)
fvgSizeW      = input.float(1.0, "    Weight: gap size vs ATR", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "How much the gap's own size (displacement) counts toward its strength. Bigger gaps = stronger imbalance.", group = G_STRUCT)
fvgVolW       = input.float(1.0, "    Weight: creation volume", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "How much the relative volume of the candle that CREATED the gap counts. High-volume displacement gaps are respected more often. Uses the Rel-volume lookback from the SFP section.", group = G_STRUCT)
fvgBlockW     = input.float(1.0, "    Weight: inside OB / breaker", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap overlaps an order block or breaker block — a gap defended by a resting institutional zone is far more likely to hold.", group = G_STRUCT)
fvgInvW       = input.float(1.0, "    Weight: inversion (IFVG)", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap forms right after an opposite gap in the same zone was invalidated (an inverted FVG / IFVG). Inversions mark a decisive flip and tend to be respected hard on the retest.", group = G_STRUCT)
fvgInvBars    = input.int(30, "    Inversion memory (bars)", minval = 1, maxval = 200, tooltip = "How many bars back a recently-invalidated opposite gap still counts as the parent of an inversion.", group = G_STRUCT)
fvgHtfW       = input.float(1.0, "    Weight: HTF-gap alignment", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap overlaps a higher-timeframe fair value gap. HTF alignment is the single biggest accuracy signal — a chart-TF gap sitting inside an HTF imbalance is defended by far heavier flow. The bonus scales with the HTF gap's own strength.", group = G_STRUCT)
fvgPdW        = input.float(1.0, "    Weight: premium/discount location", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap sits on the 'correct' side of the live dealing range: a BULLISH gap in DISCOUNT (lower half) or a BEARISH gap in PREMIUM (upper half) aligns with where institutions fill, so it is respected more often. A bullish gap in premium (or bearish in discount) earns little here.", group = G_STRUCT)
fvgDispW      = input.float(1.0, "    Weight: displacement quality", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus for a decisive creating candle: a large real body (vs its range) and/or a move that broke recent structure (took out a swing). A gap left by conviction holds better than one from an indecisive wick.", group = G_STRUCT)
fvgConflW     = input.float(1.0, "    Weight: confluence (round / VWAP / OTE)", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap's midpoint sits near a round number, the session VWAP, or an OTE retracement level of the dealing range — defended fair-value references that reinforce the gap.", group = G_STRUCT)
fvgLiqW       = input.float(1.0, "    Weight: liquidity-pool confluence", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap sits on or just beyond a tracked liquidity pool — equal highs/lows (engineered stops), previous-period levels (PDH/PDL · PWH/PWL · PMH/PML), daily/weekly/monthly/midnight opens, session highs/lows, swing BSL/SSL, or volume-profile POC/VAH/VAL. Graded by the MOST IMPORTANT nearby pool (a weekly high counts far more than a session low), so a gap positioned exactly where resting liquidity lives — the fuel price is drawn to — scores much higher.", group = G_STRUCT)
fvgLiqATR     = input.float(0.5, "      Liquidity proximity (× ATR)", minval = 0.1, maxval = 2.0, step = 0.1, tooltip = "How close (in ATRs) a liquidity pool must be to the gap to count toward the liquidity-pool confluence factor. Covers both overlap and 'the gap guards a pool just beyond its edge'.", group = G_STRUCT)
fvgSweepW     = input.float(1.0, "    Weight: sweep precedence (SFP→FVG)", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "Bonus when the gap forms right after a liquidity sweep + reversal (SFP) in the SAME direction — the textbook ICT sweep → displacement → fair value gap sequence. A gap born out of a stop-run is a far higher-probability reaction zone.", group = G_STRUCT)
fvgSweepBars  = input.int(3, "      Sweep look-back (bars)", minval = 1, maxval = 20, tooltip = "How many bars before the gap formed to look for a same-direction SFP/sweep that qualifies the gap for the sweep-precedence bonus.", group = G_STRUCT)
fvgFreshDisc  = input.float(0.35, "    Tested-gap discount", minval = 0.0, maxval = 0.9, step = 0.05, tooltip = "How much to cut a gap's score once price has already probed into it (partially mitigated / 'used' liquidity). 0.35 = a tested gap scores 35% lower. A virgin, untouched gap keeps its full score. 0 = disable (freshness ignored).", group = G_STRUCT)
fvgTrapDisc  = input.float(0.40, "    Poor-location (trapped) discount", minval = 0.0, maxval = 0.9, step = 0.05, tooltip = "Cut a gap's rank when it is TRAPPED against opposing structure in its intended direction — a BULLISH gap with major resistance (weekly/daily high, equal highs, order-block top, swing high) sitting just ABOVE it, or a BEARISH gap with support just below. Such a gap has little room to run and is a poor long/short despite otherwise scoring well. 0.40 = up to -40% when fully walled. 0 = disable (no location penalty).", group = G_STRUCT)
fvgTrapATR   = input.float(0.75, "      Trap look-ahead (× ATR)", minval = 0.1, maxval = 3.0, step = 0.1, tooltip = "How far beyond the gap (in ATRs) to look for opposing structure that would 'trap' it. Larger = a wall farther away still counts as limiting the runway.", group = G_STRUCT)
// --- momentum exhaustion: a DYNAMIC, live score adjustment driven by RSI divergence ---
exhOn        = input.bool(true,  "  Momentum-exhaustion dynamic weighting", tooltip = "A LIVE layer that nudges each gap's effective score as momentum exhausts. Primary signal is RSI DIVERGENCE: if price pushes to a new low but RSI makes a HIGHER low (the down-push is running out of steam), gaps BELOW price — the likely reversal/support zones — get a rising bonus, while bearish continuation gaps below get discounted. Mirror for an exhausting up-push. Overbought/oversold adds a secondary nudge. Unlike the static factors (fixed at gap creation), this one RE-EVALUATES every bar, so scores visibly rise/fall as exhaustion builds. Affects the on-chart strength %% and the execution-engine arming score; it does not alter the DOL gauge.", group = G_STRUCT)
exhRsiLen    = input.int(14, "    RSI length", minval = 2, maxval = 50, group = G_STRUCT)
exhDivLook   = input.int(5, "    Divergence pivot look-back (bars)", minval = 2, maxval = 30, tooltip = "Pivot distance used to detect RSI vs price divergence. Larger = only bigger, slower divergences register.", group = G_STRUCT)
exhW         = input.float(1.0, "    Weight: exhaustion adjustment", minval = 0.0, maxval = 3.0, step = 0.1, tooltip = "How strongly live exhaustion moves a gap's effective score. The raw adjustment is up to ±18 points at full exhaustion; this scales it. 0 = disable the dynamic layer (scores stay static).", group = G_STRUCT)
exhShow      = input.bool(true,  "    Show RSI gauge", tooltip = "Show a dedicated RSI gauge banner (its own corner) with the live RSI value, its overbought/oversold/neutral state, and whether an RSI vs price divergence is currently active. This is a pure RSI readout — it does not display or imply directional bias (that lives in the Daily Bias banner).", group = G_STRUCT)
exhGaugePos  = input.string("Middle Right", "    RSI gauge position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], tooltip = "Where to anchor the RSI gauge banner. Defaults away from the DOL banner (top-right) and the Daily Bias banner (top-left).", group = G_STRUCT)
exhOB        = input.int(70, "    Overbought level", minval = 50, maxval = 95, group = G_STRUCT)
exhOS        = input.int(30, "    Oversold level", minval = 5, maxval = 50, group = G_STRUCT)
// --- min-gap floor: kill micro-gaps at the source before they are ever scored/drawn ---
fvgMinGapATR  = input.float(0.0, "  Min gap size (× ATR)", minval = 0.0, maxval = 3.0, step = 0.05, tooltip = "A gap smaller than this many ATRs is ignored entirely — never scored, drawn, or tracked. A hard noise floor that kills micro-imbalances at the source on low timeframes (e.g. the 5-minute chart), complementing the strength filter. 0 = disable (keep every gap, however small).", group = G_STRUCT)
// --- consequent encroachment (CE) line: the 50% midpoint price reacts to most ---
fvgShowCE     = input.bool(false, "  Show CE (50%) line on FVGs", tooltip = "Draw a dashed line at each gap's midpoint — the 'consequent encroachment' (CE). Price very often reacts to the gap's 50% rather than the full fill, so the CE is the real mitigation/entry reference ICT traders watch. Applies to drawn chart-timeframe gaps.", group = G_STRUCT)
fvgCECol      = input.color(color.new(#ab47bc, 20), "    CE line color", group = G_STRUCT)
// --- higher-timeframe (HTF) FVGs: detected and folded into scoring (no separate chart drawing) ---
htfFvgOn      = input.bool(true, "  Use higher-timeframe FVGs in scoring", tooltip = "Detect fair value gaps on the HTF timeframe set above (the same '  HTF timeframe' input used for HTF swings — edit it to pick which timeframe to watch, e.g. 60 / 240 / D). HTF gaps are NOT drawn on the chart; instead they BOOST the score of any chart-TF gap that aligns with them (see 'Weight: HTF-gap alignment') and they also feed the DOL model (confluence, path-clearance / resistance, and the ⭐ stacked-agreement flag) as strong magnet zones.", group = G_STRUCT)
htfFvgKeep    = input.int(6, "    Max HTF FVGs tracked", minval = 1, maxval = 20, tooltip = "How many recent unfilled HTF gaps to keep in memory for the alignment boost and the DOL scoring.", group = G_STRUCT)
htfFvgMaxTF   = input.int(5, "    HTF scoring only at/below (minutes)", minval = 1, maxval = 240, tooltip = "The HTF-alignment factor and its rebalanced weighting apply ONLY when the chart timeframe is at or below this many minutes (default 5 — i.e. the 1-to-5-minute charts the HTF overlay is designed for). On HIGHER chart timeframes the gap score reverts to the original full-weight model (gap size / volume / order-block / inversion) PLUS the premium-discount, displacement, confluence and freshness factors — so HTF charts keep scoring gaps the way they did before HTF alignment was added, and nothing disappears.", group = G_STRUCT)
// --- SFP (sweep + reversal) ---
showSFP    = input.bool(true, "Sweep + reversal markers (SFP)", tooltip = "The core validity trigger: a wick pierces a tracked level then the candle CLOSES back on the origin side (a stop-run). Marks 🎯 SFP long/short.", group = G_STRUCT)
sfpUseVol  = input.bool(true, "  Require volume confirmation", tooltip = "Only flag a sweep as a real grab on elevated relative volume.", group = G_STRUCT)
sfpConfirm = input.bool(true, "  Confirm on bar close (no repaint)", tooltip = "An SFP is 'a wick pierces a level then the candle CLOSES back on the origin side' — a CLOSE-based event. With this on, the SFP marker/alert only fires once the bar has CLOSED, so it can't flash on the forming bar and then disappear (no repaint). Turn OFF to see a provisional intrabar preview (which may vanish before the bar closes).", group = G_STRUCT)
sfpCooldown = input.int(10, "  Same-level SFP cooldown (bars)", minval = 0, maxval = 100, tooltip = "After an SFP fires on a level, suppress further SFPs on that SAME level for this many bars — so a wick repeatedly poking one high/low doesn't re-fire the signal every bar. 0 = no cooldown (every qualifying bar fires, legacy behavior).", group = G_STRUCT)
rvolLen    = input.int(20, "  Rel-volume lookback", minval = 5, maxval = 200, group = G_STRUCT)
rvolMult   = input.float(1.5, "  Min rel-volume for grab", minval = 1.0, maxval = 5.0, step = 0.1, group = G_STRUCT)
sfpColLong  = input.color(color.new(#26a69a, 0), "  Bullish SFP color", group = G_STRUCT)
sfpColShort = input.color(color.new(#ef5350, 0), "  Bearish SFP color", group = G_STRUCT)
// --- Order Blocks ---
showOB     = input.bool(true, "Order blocks after displacement", tooltip = "After a sweep+displacement, mark the last opposing candle as a demand/supply zone until mitigated.", group = G_STRUCT)
obDisp     = input.float(1.2, "  Displacement size (× ATR)", minval = 0.3, step = 0.1, tooltip = "How large the breakout candle body must be (in ATRs) to leave a valid order block.", group = G_STRUCT)
obColBull  = input.color(color.new(#26a69a, 80), "  Bullish OB color", group = G_STRUCT)
obColBear  = input.color(color.new(#ef5350, 80), "  Bearish OB color", group = G_STRUCT)
obKeep     = input.int(8, "  Max order blocks kept", minval = 1, maxval = 40, group = G_STRUCT)

// -----------------------------------------------------------------------------
// INPUTS — COUNTDOWN
// -----------------------------------------------------------------------------
showCD    = input.bool(true,  "Show countdown to level",  group = G_CD)
velLen    = input.int(14, "Velocity lookback (bars)", minval = 2, group = G_CD)
cdMode    = input.string("Clock time", "Countdown units", options = ["Clock time","Bars"], group = G_CD)
dirAware  = input.bool(true,  "Only show for levels price is approaching", group = G_CD)

// -----------------------------------------------------------------------------
// INPUTS — CLUSTERING & CONFLUENCE
// -----------------------------------------------------------------------------
// --- MODE: one dropdown that bundles sensible defaults for a trading style ---
tradeMode  = input.string("Custom", "Mode (one-click preset)", options = ["Scalp","Intraday","Swing","Clean","Custom"], tooltip = "One-click trading-style preset. It bundles the safe, high-impact display settings — chart density and the confidence window — into a sensible starting point, so you don't have to tune dozens of toggles. SCALP: tight & minimal (nearest few levels). INTRADAY: balanced. SWING: balanced but a wider window for bigger structure. CLEAN: maximum focus, only the strongest levels bold. CUSTOM (default): leaves every setting exactly as you set it. Mode does NOT touch which level CATEGORIES are on or detection lengths — only the focus/density layer — so nothing changes meaning, it just changes what's emphasised.", group = G_CLUST)
masterOn   = input.bool(true, "MASTER: draw everything", tooltip = "Global on/off for all drawings.", group = G_CLUST)
// --- declutter: one-click density + top-N-per-side + confidence gate (faint, not removed) ---
densityPreset = input.string("Balanced", "Chart density", options = ["Minimal","Balanced","Everything","Custom"], tooltip = "One-click declutter. MINIMAL: only the few strongest levels each side drawn boldly, everything else faint. BALANCED: a healthy handful. EVERYTHING: draw all at full strength (legacy). CUSTOM: use the Top-N / gate / fade values below. Levels below the cut are DIMMED (drawn faintly), never removed — so nothing is lost, it just recedes.", group = G_CLUST)
densTopN   = input.int(4, "  Custom: bold levels per side (Top-N by confidence)", minval = 1, maxval = 30, tooltip = "Only the N highest-confidence levels ABOVE and N BELOW price are drawn bold; the rest go faint. (Custom preset.)", group = G_CLUST)
densGate   = input.float(6.0, "  Custom: faint below confidence %", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Levels/zones whose confidence % is below this are drawn faintly. (Custom preset.)", group = G_CLUST)
densFadeOp = input.int(78, "  Faint opacity (0 solid → 100 invisible)", minval = 40, maxval = 96, tooltip = "How dim a de-emphasized level is drawn. Higher = fainter.", group = G_CLUST)
clusterOn  = input.bool(true, "Merge nearby levels into zones", group = G_CLUST)
clustDist  = input.float(0.5, "Cluster distance (× ATR)", minval = 0.05, step = 0.05, tooltip = "Levels within this many ATRs of each other merge into one strength-rated zone.", group = G_CLUST)
minStrength = input.int(1, "Min strength to display", minval = 1, maxval = 8, tooltip = "Only draw levels/zones whose strength (stacked count) is at least this. 2+ hides lone levels.", group = G_CLUST)
maxStrength   = input.int(4, "Max strength markers shown", minval = 1, maxval = 6, group = G_CLUST)
zoneOpacityMin = input.int(85, "Zone fill opacity — weakest", minval = 0, maxval = 100, group = G_CLUST)
zoneOpacityMax = input.int(55, "Zone fill opacity — strongest", minval = 0, maxval = 100, group = G_CLUST)
sideColorOn = input.bool(true, "Color-code by side (BSL/SSL)", tooltip = "Levels ABOVE price = BSL (resistance) use the BSL color; BELOW price = SSL (support) use the SSL color.", group = G_CLUST)
colBSL   = input.color(color.new(#ef5350, 0), "  BSL color (above price)", group = G_CLUST)
colSSL   = input.color(color.new(#26a69a, 0), "  SSL color (below price)", group = G_CLUST)
emojiBSL = input.string("🔴", "  BSL strength marker", options = ["🔴","🟥","🔺","🛑","⛔","🔻","💢"], group = G_CLUST)
emojiSSL = input.string("🟢", "  SSL strength marker", options = ["🟢","🟩","🔼","✅","💚","🔽","🌿"], group = G_CLUST)
strengthEmoji = input.string("🔥", "  Neutral strength marker (side off)", options = ["🔥","⭐","🟥","🟦","🟨","🔶","💠"], group = G_CLUST)
clustLblTxt = input.color(color.new(#ffffff, 0),  "Cluster label text color", group = G_CLUST)
showStrengthEmoji = input.bool(true, "Show strength emojis on clusters", group = G_CLUST)
showSideTag  = input.bool(true, "Show BSL/SSL text tag on clusters", group = G_CLUST)
outlineTags  = input.bool(true, "Outline level/cluster tags in side color", group = G_CLUST)
tieredEmoji  = input.bool(true, "Fun tiered strength emojis (💧⚡🔥💎🐋)", group = G_CLUST)
bigStrongLbl = input.bool(true, "Enlarge label for strong zones", group = G_CLUST)
// --- Confluence score ---
showConf    = input.bool(true, "Confluence score on zones (0-100)", tooltip = "Rolls up stacked levels + order-block overlap + OTE-fib proximity + premium/discount extreme + round-number proximity into a 0-100 'how loaded is this zone' score. The OTE/premium-discount factors are computed from the live dealing range internally (not drawn on the chart).", group = G_CLUST)
confMin     = input.int(0, "  Hide zones below score", minval = 0, maxval = 100, tooltip = "Only show cluster zones scoring at least this. 0 = show all.", group = G_CLUST)
confRound   = input.float(0.0, "  Round-number step (price)", minval = 0.0, tooltip = "Adds confluence when a zone sits near a round-number multiple of this step (e.g. 50/100 indices, 1000 BTC). 0 = disable.", group = G_CLUST)
confVWAP    = input.bool(true, "  VWAP proximity in confluence", tooltip = "Adds confluence when a level sits near the session VWAP — a heavily-defended fair-value reference. VWAP is used as a SCORING factor only (not drawn as its own magnet).", group = G_CLUST)
showVP      = input.bool(false, "Volume Profile levels (POC / VAH / VAL)", tooltip = "Builds a rough volume profile over a lookback and adds the Point of Control (highest-volume price) and Value Area High/Low as levels. Acceptance-based levels (where volume traded), a different KIND of level from swing liquidity — they feed the clusters + DOL pull.", group = G_CLUST)
vpLen       = input.int(240, "  VP lookback (bars)", minval = 20, maxval = 1000, tooltip = "How many recent bars to build the volume profile from.", group = G_CLUST)
vpBins      = input.int(24, "  VP resolution (bins)", minval = 8, maxval = 60, tooltip = "Number of price buckets in the profile. More = finer POC/VA, slightly heavier.", group = G_CLUST)

// -----------------------------------------------------------------------------
// INPUTS — DRAW-ON-LIQUIDITY GAUGE
// -----------------------------------------------------------------------------
showDOL   = input.bool(true, "Show DOL gauge", tooltip = "A corner banner pointing to the side (BSL above vs SSL below) with the greater LIQUIDITY GRAVITY - a multi-factor score of where price is most likely being drawn.", group = G_DOL)
showVerdict = input.bool(true, "One-line verdict (headline)", tooltip = "A single plain-language line at the top of the banner distilling the whole read into the sentence you act on: bias direction · dominant target + distance · confidence % · path clear/blocked · premium/equilibrium/discount. Everything else in the banner is the supporting detail.", group = G_DOL)
dolBanPos = input.string("Top Right", "Banner position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], group = G_DOL)
dolBull   = input.string("🔼", "Bullish draw emoji", options = ["🔼","🟢","🚀","📈","👆","🐂"], group = G_DOL)
dolBear   = input.string("🔽", "Bearish draw emoji", options = ["🔽","🔴","🐻","📉","👇","🩸"], group = G_DOL)
dolSize   = input.string("Large", "Banner text size", options = ["Normal","Large","Huge"], group = G_DOL)
dolSens   = input.string("Medium", "Gravity sensitivity", options = ["Low","Medium","High"], tooltip = "How sharply nearby / important / aged / clustered liquidity dominates the pull.", group = G_DOL)
dolUseType = input.bool(true, "Weight by level importance (type)", tooltip = "Major levels (PDH/PDL, weekly/monthly, HTF) pull harder than minor session/local levels.", group = G_DOL)
dolUseAge  = input.bool(true, "Weight by level age (resting time)", group = G_DOL)
dolMomWt   = input.float(30, "Momentum tilt %", minval = 0, maxval = 100, step = 5, tooltip = "How much live directional momentum biases the arrow on top of the static liquidity score.", group = G_DOL)
dolTgtLine = input.bool(true, "Show primary-magnet target in banner", tooltip = "Adds a banner row with the strongest magnet price and its distance (ATR / %).", group = G_DOL)
dolMeter   = input.bool(true, "Show conviction meter", group = G_DOL)
dolTugBar  = input.bool(true, "Show tug-of-war bar (BSL vs SSL)", group = G_DOL)
// --- accuracy pass ---
dolConfW   = input.bool(true, "Weight pull by each level's confluence score", tooltip = "A level sitting in an order block + OTE + round number pulls far harder than a lone level. Multiplies each level's DOL pull by its own confluence score - the single biggest accuracy boost.", group = G_DOL)
dolNearBias = input.float(1.5, "Nearest-pool emphasis", minval = 0.0, maxval = 4.0, step = 0.25, tooltip = "Extra sharpening of the distance decay. Higher = the nearest untapped pool dominates the pull (price hunts the closest liquidity first). 0 = flat.", group = G_DOL)
dolFreshW  = input.bool(true, "Freshness premium (untested pulls harder)", tooltip = "Levels price has NOT yet reacted off pull harder; levels already wicked into are discounted.", group = G_DOL)
showLvlConf = input.bool(true, "Show per-level confidence % (target likelihood)", tooltip = "Each level/zone gets a 0-100 score for how likely price heads THERE next. The single most-likely target is flagged 🎯.", group = G_DOL)
lvlRejGauge = input.bool(true, "  Level reaction gauge (reject vs sweep, live)", tooltip = "A LIVE read shown next to a level's confidence % ONLY while price is AT/near the level: how likely price is to REJECT / reverse off it (⟲NN, 50-100) vs SWEEP through it (⇥NN, 0-50). Different from the confidence % (which is 'how likely price heads TO the level') — this is 'what happens WHEN it gets there'. It blends the level's IMPORTANCE/type, the APPROACH strength (fast momentum into it → more likely to sweep through; slow → reject), an ABSORPTION wick on the touch bar, whether the level is already TESTED (weaker → sweep), and its CONFLUENCE. Equal highs/lows (engineered stop liquidity) correctly lean SWEEP-THROUGH rather than reject. Heuristic, not a probability.", group = G_DOL)
lvlConfMode = input.string("Magnet quality", "  Confidence % basis", options = ["Magnet quality","Raw pull"], tooltip = "Magnet quality (recommended): distance is removed so the % reflects how STRONG a magnet each level is for its distance — a far but heavy pool (equal highs + order block + old + fresh) can out-score a near lone swing. Raw pull (legacy): the % is each level's share of the proximity-weighted gravity, so the nearest level almost always dominates (obvious, less useful). The 🎯 still marks the nearest strongest pull in both modes.", group = G_DOL)
lvlConfWin  = input.int(5, "  Confidence window (levels each side)", minval = 1, maxval = 50, tooltip = "Only the N nearest levels ABOVE and N nearest BELOW price get a confidence %, and the % is normalized over just those levels. Keeps intraday reads focused on the levels price can realistically reach instead of diluting the % across far higher-timeframe levels. Lower = tighter/more decisive; higher = wider context. 🎯 still uses all levels.", group = G_DOL)
// --- projection pass (all reuse existing pull / velocity / OB-FVG / range machinery) ---
projClear   = input.bool(true,  "Path-clearance on 🎯 target", tooltip = "Discounts the primary magnet by what stands between price and it: opposing order blocks / FVGs / strong levels in the path lower a 0-100 clearance score. A clear runway reads high; a blocked path reads low. Shown as 🛣️ on the target row.", group = G_DOL)
projClearW  = input.float(1.0, "  Clearance sensitivity", minval = 0.0, maxval = 3.0, step = 0.25, tooltip = "How hard each obstacle in the path cuts the clearance score. 0 = ignore obstacles; higher = a single blocker matters more.", group = G_DOL)
projETA     = input.bool(true,  "ETA to 🎯 target (time projection)", tooltip = "Uses recent price velocity to project HOW LONG until the primary magnet is reached (bars or clock time, per the Countdown setting). Adds a ⏱ estimate to the target row.", group = G_DOL)
projEqui    = input.bool(true,  "Equilibrium / range-state (Prem·EQ·Disc)", tooltip = "Shows where price sits in the current dealing range: Premium (upper), Equilibrium (~50%), or Discount (lower). Crossing equilibrium toward a pool is a continuation tell. Adds a range-state row to the banner.", group = G_DOL)
projConfMom = input.bool(true,  "Confidence momentum ▲▼", tooltip = "Marks whether each level's confidence % is RISING or FALLING versus the previous bar. A strengthening magnet (▲) is a firming draw; a fading one (▼) warns of rejection. Appended to the per-level %.", group = G_DOL)
projStacked = input.bool(true,  "Stacked-agreement flag ⭐", tooltip = "Flags a level where multiple independent signals align — DOL bias side + primary magnet + an overlapping order block / FVG. 3+ agreeing signals is the highest-conviction projection. Adds ⭐ to that level.", group = G_DOL)
// --- de-skew: stop a level price is CURRENTLY forming/sitting on from inflating confidence ---
projLiveSess = input.bool(true, "Exclude forming session H/L from magnet", tooltip = "A still-forming session high/low tracks price in real time, so it sits ~0 distance away and unfairly dominates the confidence % (price 'chasing' a level it is itself creating). When on, the CURRENT session's extreme still draws as a line but takes no magnet / confidence role until the session closes or price pulls away — it becomes real resting liquidity, then re-enters the pull.", group = G_DOL)
projDistFloor = input.bool(true, "Distance floor (ignore levels hugging price)", tooltip = "General safety net: any level within the floor distance of price contributes ~no pull and no confidence %, since you can't be 'drawn' to where price already is. Catches the session case and any other level price is sitting on.", group = G_DOL)
projDistFloorATR = input.float(0.12, "  Distance floor (× ATR)", minval = 0.0, maxval = 1.0, step = 0.02, tooltip = "How close (in ATRs) a level must be to price before it's treated as 'already here' and excluded from the magnet pool. 0 = disable.", group = G_DOL)
// --- resistance-adjusted bias: a pool only pulls as hard as the PATH to it is open ---
projResist = input.bool(true, "Resistance-adjusted DOL bias", tooltip = "Weights each side's draw by how CLEAR the path to it is. Structure standing in the way (order blocks, FVGs) between price and a pool discounts that side's effective pull, so a heavily-walled pool pulls less than an open one. Price hunts the REACHABLE liquidity, not the blocked pool. Conservative: resistance only DISCOUNTS a side's pull, it never adds to the opposite side. Obstacle severity uses the Path-clearance sensitivity. A 🧱 clearance readout is added to the banner.", group = G_DOL)
// --- landscape bias: don't let ONE level price is hugging dominate the whole side ---
biasCap = input.float(0.5, "Bias dominance cap (max share per level)", minval = 0.2, maxval = 1.0, step = 0.05, tooltip = "Caps how much a SINGLE level can contribute to its side's pull when computing the DOL bias. Without this, one level price is sitting right next to can out-pull a whole cluster of levels on the other side (distance decay makes the nearest level huge), flipping the bias toward wherever price momentarily is. Capping each level's share (e.g. 0.5 = no level exceeds 50% of its side) makes the bias reflect the LIQUIDITY LANDSCAPE — where the mass/cluster of levels sits — instead of one proximity outlier. The 🎯 magnet still tracks the single nearest-strongest level, so you keep both readings. 1.0 = disable (legacy).", group = G_DOL)
// --- flip stability: deadband + hysteresis so the arrow doesn't whipsaw near a key level ---
dolStable   = input.bool(true, "Stabilize DOL flips (deadband + hysteresis)", tooltip = "Stops the DOL arrow flipping randomly when price is approaching a key level. Instead of flipping the instant one side edges out the other (bias crosses exactly 0), the arrow only CHANGES direction once the opposing side is decisively ahead — the bias must clear the deadband on the new side. Inside the band the arrow HOLDS its prior direction. Highly recommended for lower timeframes (e.g. the 5-minute chart) where the raw bias is noisy.", group = G_DOL)
dolDeadband = input.float(0.10, "  Flip deadband (bias units, 0-1)", minval = 0.0, maxval = 0.9, step = 0.01, tooltip = "How decisively the opposing side must win before the arrow flips. The DOL bias runs from -1 (all SSL / down) to +1 (all BSL / up). With a 0.10 deadband, an UP arrow only flips to DOWN once bias falls below -0.10, and a DOWN arrow only flips UP once bias rises above +0.10. Between -0.10 and +0.10 the arrow holds its last direction. Higher = stickier (fewer flips, slower to turn); 0 = legacy instant flip at 0.", group = G_DOL)
dolFlipConfirm = input.bool(true, "  Only flip on bar close (confirm)", tooltip = "Require the deadband to be cleared on a CLOSED bar before committing a flip, so a single intrabar spike through a level can't turn the arrow. The banner still shows a faint 'turning…' hint intrabar, but the committed direction only changes when the bar closes beyond the deadband. Turn off to allow intrabar flips (still gated by the deadband).", group = G_DOL)

// -----------------------------------------------------------------------------
// INPUTS — STYLE
// -----------------------------------------------------------------------------
uiTheme    = input.string("Refined Dark", "Panel theme", options = ["Refined Dark","Refined Light","Midnight","Slate","Classic (legacy)"], group = G_STYLE)
uiPanelOpacity = input.int(16, "Panel background opacity boost", minval = 0, maxval = 60, group = G_STYLE)
uiAccentTint = input.int(70, "Accent softness", minval = 0, maxval = 90, group = G_STYLE)
uiSlimBorders = input.bool(true, "Slim panel borders", group = G_STYLE)
lineWidth  = input.int(1, "Line width", minval = 1, maxval = 3, group = G_STYLE)
lineStyleI = input.string("Solid", "Line style", options = ["Solid","Dashed","Dotted"], group = G_STYLE)
labelSize  = input.string("Small", "Label size", options = ["Tiny","Small","Normal"], group = G_STYLE)
extendR    = input.int(10, "Line extend-right (bars)", minval = 0, group = G_STYLE)
ageExtend  = input.bool(true, "Age-scaled extension (older = longer)", tooltip = "Each level's line grows with how long it has persisted, so mature levels are visibly longer.", group = G_STYLE)
ageMaxBars = input.int(20, "  Max extra bars from age", minval = 0, maxval = 200, group = G_STYLE)
ageScale   = input.float(0.35, "  Age scale (bars added per bar of age)", minval = 0.05, maxval = 1.0, step = 0.05, group = G_STYLE)
compact    = input.bool(false, "Compact Mode (hide levels far from price)", group = G_STYLE)
nearN      = input.int(3, "  Nearest N above & below", minval = 1, maxval = 10, group = G_STYLE)
compactBand = input.float(4.0, "  Compact band (× ATR × N)", minval = 1.0, step = 0.5, group = G_STYLE)
colBull  = input.color(color.new(#26a69a, 0),  "Bullish / High color", group = G_STYLE)
colBear  = input.color(color.new(#ef5350, 0),  "Bearish / Low color",  group = G_STYLE)
colSess  = input.color(color.new(#42a5f5, 0),  "Session color",        group = G_STYLE)
colZone  = input.color(color.new(#ffb300, 0),  "Cluster zone color",   group = G_STYLE)
colFVGBase = input.color(color.new(#ab47bc, 0), "FVG fill color",       group = G_STYLE)
opacityFVG = input.int(80, "FVG zone opacity", minval = 0, maxval = 100, group = G_STYLE)
colFVG  = color.new(colFVGBase, opacityFVG)

// -----------------------------------------------------------------------------
// INPUTS — EMOJI TAGS
// -----------------------------------------------------------------------------
emoPrev = input.string("⭐", "Previous-period tag", options = ["None","🔥","⭐","🟡","🔹","💧","🎯","🧲"], group = G_EMO)
emoSess = input.string("🟡", "Session tag",         options = ["None","🔥","⭐","🟡","🔹","💧","🎯","🧲"], group = G_EMO)
emoLiq  = input.string("💧", "Liquidity tag",       options = ["None","🔥","⭐","🟡","🔹","💧","🎯","🧲"], group = G_EMO)

// -----------------------------------------------------------------------------
// INPUTS — TESTED LEVELS
// -----------------------------------------------------------------------------
// --- tested / virgin state: has price already PROBED a level (wicked in, not swept through)? ---
showTested   = input.bool(true, "Flag tested levels (probed, not swept)", tooltip = "Marks levels a wick has already PROBED into (reacted off) but not fully swept — 'used' liquidity vs a virgin untouched level. Tested levels get a ✓ and a dotted/dimmed outline; untouched ones stay solid. (Fully swept levels are removed already.)", group = G_TESTED)
testDepthATR = input.float(0.10, "  Tested probe depth (× ATR)", minval = 0.02, maxval = 1.0, step = 0.02, tooltip = "How far a wick must poke INTO a level (in ATRs) to count as tested. Small = only genuine probes register; larger = grazes count too.", group = G_TESTED)
testDiscount = input.bool(true, "  Discount tested levels in scoring", tooltip = "A tested level is a slightly weaker magnet (some of its liquidity was already taken / defended), so reduce its DOL pull. Visual-only if this is off.", group = G_TESTED)
testDiscAmt  = input.float(0.25, "    Tested pull discount", minval = 0.0, maxval = 0.9, step = 0.05, tooltip = "How much to cut a tested level's pull (0.25 = -25%). 0 = no discount.", group = G_TESTED)
testKeep     = input.int(120, "  Max tested levels tracked", minval = 10, maxval = 500, group = G_TESTED)

// -----------------------------------------------------------------------------
// INPUTS — FVG EXECUTION (setups)
// -----------------------------------------------------------------------------
// Turns high-quality gaps into actionable setups: wait for price to RETURN to the gap's CE
// (50%), then arm an entry with a stop and R-multiple targets, with alerts at each stage.
execOn       = input.bool(false, "Enable FVG execution setups", tooltip = "Wait for the OPTIMAL setup on strong fair value gaps: the indicator stays quiet until price RETRACES back into a qualifying gap's CE (50% — the mitigation entry), then it ARMS the setup and draws an entry / stop / target with the risk:reward. Alerts fire at each stage so you don't have to watch. Nothing here places orders — it is a planning / signalling overlay.", group = G_EXEC)
execMinStr   = input.int(70, "  Min gap strength % to arm", minval = 0, maxval = 100, tooltip = "Only gaps scoring at least this (the 0-100 FVG strength) can become setups. Higher = only A+ gaps arm. This is the primary quality gate.", group = G_EXEC)
execNeedPD   = input.bool(true, "  Require correct premium/discount", tooltip = "Only arm a BULLISH gap when it sits in DISCOUNT (lower half of the dealing range) and a BEARISH gap when it sits in PREMIUM (upper half) — i.e. buy low / sell high relative to the range. Uncheck to arm regardless of range location.", group = G_EXEC)
execNeedDOL  = input.bool(true, "  Require DOL bias agreement", tooltip = "Only arm a setup whose direction agrees with the current Draw-on-Liquidity bias (long setups when DOL points UP, shorts when DOL points DOWN). Keeps you trading with the dominant draw. Uncheck to arm against the bias too.", group = G_EXEC)
execNeedDay  = input.bool(true, "  Require Daily Bias agreement", tooltip = "Only arm a setup whose direction agrees with the Daily Bias (see group ⑪): long setups when the daily bias is LONG, shorts when SHORT. When the daily bias is NEUTRAL, both directions are allowed. This is the main 'trade with the daily bias' filter.", group = G_EXEC)
execEntry    = input.string("CE (50%)", "  Entry at", options = ["CE (50%)","Proximal edge"], tooltip = "Where the entry level sits. 'CE (50%)': the gap midpoint — price often reacts there rather than at the full fill (recommended). 'Proximal edge': the near edge of the gap (the first touch).", group = G_EXEC)
execStopATR  = input.float(0.25, "  Stop buffer beyond far edge (× ATR)", minval = 0.0, maxval = 2.0, step = 0.05, tooltip = "The stop sits beyond the FAR edge of the gap by this many ATRs (room for a stop-hunt wick). Entry-to-stop is your 1R.", group = G_EXEC)
execTP1R     = input.float(1.0, "  TP1 (R multiple)", minval = 0.5, maxval = 10.0, step = 0.5, tooltip = "First target as a multiple of risk (entry-to-stop distance). 1.0 = 1R.", group = G_EXEC)
execTP2R     = input.float(2.0, "  TP2 (R multiple)", minval = 0.5, maxval = 20.0, step = 0.5, tooltip = "Second target as a multiple of risk. 2.0 = 2R.", group = G_EXEC)
execConfirm  = input.bool(false, "  Require confirmation close before 'confirmed'", tooltip = "After price taps the entry (ARMED), wait for a candle to CLOSE rejecting back out of the gap on the setup's side before flagging the setup CONFIRMED (and firing the confirmation alert). Off = the setup is treated as confirmed on the CE tap itself.", group = G_EXEC)
execNoRepaint = input.bool(true, "  Commit setup states on bar close (no repaint)", tooltip = "Only advance a setup (arm / confirm) and fire its alert once the bar has CLOSED, so an intrabar tap that pulls back before close can't arm a setup and then un-arm it. Strongly recommended — without it, arm/confirm react to the still-forming candle and can flash then vanish. (Historical bars are unaffected; this only holds the live forming bar until close.)", group = G_EXEC)
execExpiry   = input.int(40, "  Setup expiry (bars after arming)", minval = 0, maxval = 500, tooltip = "An armed/confirmed setup that neither hits its stop nor is resolved within this many bars is marked DEAD and stops drawing — stale setups don't linger forever. 0 = never expire (only a stop-out kills it).", group = G_EXEC)
execStopKill = input.bool(true, "  Invalidate setup on stop breach", tooltip = "Mark a setup DEAD the moment price trades through its stop level (far edge of the gap + the ATR buffer). The setup stops drawing and fires the 'FVG setup invalidated' alert. This is the explicit 'the trade idea is wrong now' trigger.", group = G_EXEC)
execMinRR    = input.float(1.5, "  Min reward:risk to a liquidity target", minval = 0.0, maxval = 10.0, step = 0.25, tooltip = "Feasibility check: before arming, the engine finds the nearest OPPOSING liquidity pool in the trade's direction (the realistic target price is drawn to) and measures reward:risk from the entry to that pool vs the entry-to-stop distance (1R). A setup whose reachable target offers less than this R:R is either skipped or flagged (see below) — so you don't take a long into a wall 0.5R away. 0 = disable the feasibility check.", group = G_EXEC)
execRRReject = input.bool(true, "    Skip setups below min R:R (else just flag)", tooltip = "ON: a setup that fails the min-R:R feasibility check does NOT arm at all. OFF: it still arms/draws but is visibly flagged 'low R:R' so you can judge it yourself.", group = G_EXEC)
execMaxShow  = input.int(2, "  Max active setups drawn", minval = 1, maxval = 6, tooltip = "How many armed setups (nearest to price first) draw their entry/stop/target lines at once, to keep the chart readable. All qualifying gaps still arm and still fire alerts.", group = G_EXEC)
execColEntry = input.color(color.new(#42a5f5, 0), "  Entry line color", group = G_EXEC)
execColStop  = input.color(color.new(#ef5350, 0), "  Stop line color", group = G_EXEC)
execColTP    = input.color(color.new(#26a69a, 0), "  Target line color", group = G_EXEC)

// -----------------------------------------------------------------------------
// INPUTS — DAILY BIAS
// -----------------------------------------------------------------------------
// A sticky, structural daily bias from daily candle structure + the last PDH/PDL sweep.
// Built from resolved HTF structure (not intraday proximity or momentum), so it LEADS rather
// than reacts. Used as a directional anchor: it drives the bias banner, fades counter-bias
// FVGs, and can gate which execution setups arm.
biasOn       = input.bool(true,  "Show Daily Bias", tooltip = "A sticky daily directional read built from the last 1-2 DAILY candles (market structure + close position) and the most recent PDH/PDL sweep + reclaim/reject. Because it is derived from resolved higher-timeframe structure — not intraday proximity or momentum — it LEADS price instead of reacting to it, and it HOLDS between real events (a new daily candle or a confirmed sweep) rather than flickering on 5-minute noise.", group = G_BIAS)
biasFast     = input.bool(true,  "  Fast flip (vs conservative)", tooltip = "FAST (default): a confirmed counter-direction PDH/PDL sweep + reclaim flips the bias immediately — catches reversals early. CONSERVATIVE (off): a counter sweep only raises a 'caution' flag; the bias doesn't actually flip until the DAILY STRUCTURE itself breaks — slower but higher-conviction.", group = G_BIAS)
biasBanner   = input.bool(true,  "  Show bias banner", group = G_BIAS)
biasBanPos   = input.string("Top Left", "  Bias banner position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], tooltip = "Where to anchor the Daily Bias banner. Defaults top-left so it doesn't collide with the DOL banner (top-right).", group = G_BIAS)
biasBanSize  = input.string("Large", "  Bias banner text size", options = ["Normal","Large","Huge"], group = G_BIAS)
// --- bias-aligned declutter ---
biasFadeFVG  = input.bool(true,  "Fade counter-bias FVGs", tooltip = "When a daily bias is set, fair value gaps that oppose it (bearish gaps while bias is LONG, and vice-versa) are drawn FAINT so the chart visually agrees with your one directional thesis. With-bias gaps stay prominent. Bias NEUTRAL = everything shows normally.", group = G_BIAS)
biasHideFVG  = input.bool(false, "  Hide counter-bias FVGs entirely", tooltip = "Instead of just fading them, remove counter-bias gaps from the chart completely. (They still exist in scoring — this is visual only.)", group = G_BIAS)
biasFadeLvls = input.bool(false, "Fade counter-bias-side levels", tooltip = "Also fade the levels on the counter-bias side of price (e.g. levels above price while bias is SHORT), so the magnets you're drawn toward stand out. Off = levels are left to the normal density declutter.", group = G_BIAS)

// -----------------------------------------------------------------------------
// INPUTS — MOVING AVERAGES (EMA)
// -----------------------------------------------------------------------------
// Up to four exponential moving averages. EMA #1 is on by default at length 20; #2-#4 are off
// by default (common 50 / 100 / 200) — toggle them on as needed.
emaSrc   = input.source(close, "EMA source", group = G_EMA)
emaMTF   = input.timeframe("", "EMA timeframe (blank = chart)", tooltip = "Optionally compute the EMAs on a HIGHER timeframe and overlay them on this chart (e.g. 60 / 240 / D). Blank = use the chart timeframe. Uses non-repainting historical values.", group = G_EMA)
ema1On   = input.bool(true,  "EMA 1", inline = "e1", group = G_EMA)
ema1Len  = input.int(20, "", minval = 1, inline = "e1", group = G_EMA)
ema1Col  = input.color(color.new(#2962ff, 0), "", inline = "e1", group = G_EMA)
ema2On   = input.bool(false, "EMA 2", inline = "e2", group = G_EMA)
ema2Len  = input.int(50, "", minval = 1, inline = "e2", group = G_EMA)
ema2Col  = input.color(color.new(#ff6d00, 0), "", inline = "e2", group = G_EMA)
ema3On   = input.bool(false, "EMA 3", inline = "e3", group = G_EMA)
ema3Len  = input.int(100, "", minval = 1, inline = "e3", group = G_EMA)
ema3Col  = input.color(color.new(#26a69a, 0), "", inline = "e3", group = G_EMA)
ema4On   = input.bool(false, "EMA 4", inline = "e4", group = G_EMA)
ema4Len  = input.int(200, "", minval = 1, inline = "e4", group = G_EMA)
ema4Col  = input.color(color.new(#d500f9, 0), "", inline = "e4", group = G_EMA)
emaWidth = input.int(1, "EMA line width", minval = 1, maxval = 4, group = G_EMA)

f_lineStyle() =>
    lineStyleI == "Dashed" ? line.style_dashed : lineStyleI == "Dotted" ? line.style_dotted : line.style_solid

// --- MODE -> effective density preset + confidence window (Custom = leave raw inputs) ---
// Mode is a convenience layer over the existing density/window controls; it only maps to a
// density preset name + a confidence-window size, so behavior stays identical to setting
// those by hand. It never changes level categories or detection lengths.
string eDensity = tradeMode == "Scalp" ? "Minimal" : tradeMode == "Intraday" ? "Balanced" : tradeMode == "Swing" ? "Balanced" : tradeMode == "Clean" ? "Minimal" : densityPreset
int   eConfWin  = tradeMode == "Scalp" ? 3 : tradeMode == "Intraday" ? 5 : tradeMode == "Swing" ? 8 : tradeMode == "Clean" ? 4 : lvlConfWin

// --- density preset -> effective declutter params (Custom uses the raw inputs) ---
// eTopN: how many levels per side (by confidence) stay BOLD; eGate: faint below this
// confidence %. Everything = draw all at full strength. De-emphasised levels are drawn
// FAINT (never removed), so nothing is lost — it just recedes.
int   eTopN = eDensity == "Minimal" ? 2 : eDensity == "Balanced" ? 4 : eDensity == "Everything" ? 9999 : densTopN
float eGate = eDensity == "Minimal" ? 12.0 : eDensity == "Balanced" ? 6.0 : eDensity == "Everything" ? 0.0 : densGate
bool  densOn = eDensity != "Everything"

// tested-state memory: prices that a wick has PROBED into (persists across the per-bar
// level rebuild). Populated in the capture block below; read at scoring + render time.
var testedP = array.new<float>()
f_isTested(float price, float atrU) =>
    bool hit = false
    if showTested and array.size(testedP) > 0
        float tol = math.max(atrU * 0.10, syminfo.mintick)
        for ti = 0 to array.size(testedP) - 1
            if math.abs(array.get(testedP, ti) - price) <= tol
                hit := true
    hit

f_labelSize() =>
    labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : size.small

// --- theme palette ---
themeBgBase  = uiTheme == "Refined Light" ? color.new(#f5f6fa, 0) : uiTheme == "Midnight" ? color.new(#0d1117, 0) : uiTheme == "Slate" ? color.new(#262b36, 0) : uiTheme == "Classic (legacy)" ? color.new(#1e222d, 0) : color.new(#171a21, 0)
themeTxt     = uiTheme == "Refined Light" ? color.new(#2b2f3a, 0) : color.new(#e6e9ef, 0)
themeMuted   = uiTheme == "Refined Light" ? color.new(#6b7280, 0) : color.new(#9aa4b2, 0)
themeHdrRaw  = uiTheme == "Refined Light" ? #b45309 : #d4b483
themeHdr     = color.new(themeHdrRaw, uiAccentTint > 40 ? uiAccentTint - 40 : 0)
themeUpSolid = color.new(#4db6ac, 0)
themeDnSolid = color.new(#e08d8d, 0)
themePanelBg = color.new(themeBgBase, math.min(100, uiPanelOpacity))
themeRowBg   = color.new(themeBgBase, math.min(100, uiPanelOpacity + 8))
themeBorder  = color.new(uiTheme == "Refined Light" ? #d0d4dc : #3a4150, uiSlimBorders ? 20 : 0)
themeBW      = uiSlimBorders ? 1 : 2

// core series
velocity  = ta.sma(math.abs(ta.change(close)), velLen)
secPerBar = timeframe.in_seconds(timeframe.period)
atr       = ta.atr(14)

// HTF-FVG scoring is only relevant on low timeframes (1-5 min by default). On higher chart
// timeframes the gap score reverts to the original full-weight model (see f_fvgStrength).
fvgHtfActive = (secPerBar / 60.0) <= htfFvgMaxTF

// -----------------------------------------------------------------------------
// MOVING AVERAGES (EMA) — up to four, optional higher-timeframe, drawn via plot()
// -----------------------------------------------------------------------------
string emaTF = emaMTF == "" ? timeframe.period : emaMTF
// compute each EMA on the chosen timeframe (lookahead_off = non-repainting). Lengths are simple
// ints so ta.ema is valid; the security call returns a single series (no tuple-in-ternary).
emaV1 = request.security(syminfo.tickerid, emaTF, ta.ema(emaSrc, ema1Len), lookahead = barmerge.lookahead_off)
emaV2 = request.security(syminfo.tickerid, emaTF, ta.ema(emaSrc, ema2Len), lookahead = barmerge.lookahead_off)
emaV3 = request.security(syminfo.tickerid, emaTF, ta.ema(emaSrc, ema3Len), lookahead = barmerge.lookahead_off)
emaV4 = request.security(syminfo.tickerid, emaTF, ta.ema(emaSrc, ema4Len), lookahead = barmerge.lookahead_off)
plot(masterOn and ema1On ? emaV1 : na, "EMA 1", color = ema1Col, linewidth = emaWidth)
plot(masterOn and ema2On ? emaV2 : na, "EMA 2", color = ema2Col, linewidth = emaWidth)
plot(masterOn and ema3On ? emaV3 : na, "EMA 3", color = ema3Col, linewidth = emaWidth)
plot(masterOn and ema4On ? emaV4 : na, "EMA 4", color = ema4Col, linewidth = emaWidth)

// DOL momentum (per-bar, real history)
dolEmaF   = ta.ema(close, 21)
dolEmaS   = ta.ema(close, 55)
dolTrendV = (dolEmaF - dolEmaS) / math.max(nz(atr), syminfo.mintick)
dolRoc    = ta.roc(close, 9) / 100.0
dolMomRaw = 0.6 * dolTrendV + 0.4 * (dolRoc * 20.0)
dolMom    = math.max(-1.0, math.min(1.0, dolMomRaw))

// relative volume
avgVol = ta.sma(volume, rvolLen)
rvol   = nz(avgVol) > 0 ? volume / avgVol : 0.0
volOK  = (not sfpUseVol) or (rvol >= rvolMult)

// -----------------------------------------------------------------------------
// MOMENTUM EXHAUSTION GAUGE — RSI level + divergence -> signed score (-1..+1)
// -----------------------------------------------------------------------------
// +1 = the DOWN push is exhausting (bullish lean: favor gaps below as reversal support)
// -1 = the UP push is exhausting (bearish lean). ~0 = trend still has momentum.
exhRsi = ta.rsi(close, exhRsiLen)
// RSI pivots (confirmed, lagged by exhDivLook bars) + the matching price extreme at the pivot
exhPH = ta.pivothigh(exhRsi, exhDivLook, exhDivLook)
exhPL = ta.pivotlow(exhRsi, exhDivLook, exhDivLook)
var float exhPrevPLrsi = na, var float exhPrevPLprice = na
var float exhCurrPLrsi = na, var float exhCurrPLprice = na
var float exhPrevPHrsi = na, var float exhPrevPHprice = na
var float exhCurrPHrsi = na, var float exhCurrPHprice = na
if not na(exhPL)
    exhPrevPLrsi := exhCurrPLrsi
    exhPrevPLprice := exhCurrPLprice
    exhCurrPLrsi := exhPL
    exhCurrPLprice := low[exhDivLook]
if not na(exhPH)
    exhPrevPHrsi := exhCurrPHrsi
    exhPrevPHprice := exhCurrPHprice
    exhCurrPHrsi := exhPH
    exhCurrPHprice := high[exhDivLook]
// bullish divergence: price lower low, RSI higher low -> down-push exhausting
bool exhBullDiv = not na(exhPrevPLprice) and not na(exhCurrPLprice) and exhCurrPLprice < exhPrevPLprice and exhCurrPLrsi > exhPrevPLrsi
// bearish divergence: price higher high, RSI lower high -> up-push exhausting
bool exhBearDiv = not na(exhPrevPHprice) and not na(exhCurrPHprice) and exhCurrPHprice > exhPrevPHprice and exhCurrPHrsi < exhPrevPHrsi
// signed exhaustion: divergence is primary (±0.7), overbought/oversold is a secondary nudge (±0.3)
float exhScore = 0.0
if exhBullDiv
    exhScore := exhScore + 0.7
if exhBearDiv
    exhScore := exhScore - 0.7
if not na(exhRsi)
    if exhRsi <= exhOS
        exhScore := exhScore + 0.3 * math.min((exhOS - exhRsi) / 20.0, 1.0)   // oversold -> down push tiring
    else if exhRsi >= exhOB
        exhScore := exhScore - 0.3 * math.min((exhRsi - exhOB) / 20.0, 1.0)   // overbought -> up push tiring
exhScore := math.max(-1.0, math.min(1.0, exhScore))

// Live exhaustion adjustment for a gap (points, roughly -18..+18 before the weight). A gap on
// the side price is being drawn toward as the opposing push exhausts gets a bonus; a gap that
// needs the exhausting push to CONTINUE gets discounted. Scaled by |exhScore| and the weight.
f_exhAdj(float gTop, float gBot, bool isBull) =>
    float adj = 0.0
    if exhOn and exhW > 0 and exhScore != 0.0
        float gMid = (gTop + gBot) / 2.0
        bool below = gMid < close
        // exhScore > 0 (down push tiring, bullish): reward bullish gaps below (reversal support)
        // exhScore < 0 (up push tiring, bearish):   reward bearish gaps above (reversal supply)
        float dirMatch = 0.0
        if exhScore > 0 and isBull and below
            dirMatch := 1.0
        else if exhScore < 0 and (not isBull) and (not below)
            dirMatch := 1.0
        else if exhScore > 0 and (not isBull) and below
            dirMatch := -0.6   // bearish continuation gap below, into exhausting selling -> discount
        else if exhScore < 0 and isBull and (not below)
            dirMatch := -0.6
        adj := dirMatch * math.abs(exhScore) * 18.0 * exhW
    adj

// LIVE rejection gauge — only meaningful when price is AT / returning INTO the gap. Returns
// [active, rejLean] where rejLean is 0..100: 100 = strong REJECT (bounce off), 0 = strong
// ACCEPT (fill through), 50 = neutral. Blends four factors (each nudges the lean ±):
//   • creation strength (creatQ): a gap left by a decisive move is defended harder -> reject
//   • pullback strength: a FAST, large-bodied return blows through -> accept; a slow drift -> reject
//   • absorption wick: on the touching bar, a wick pushing back OUT of the gap -> reject
//   • approach character: pure trend-body approach -> momentum -> accept; wicky approach -> reject
// Heuristic, not a probability. Reads current + recent bars (atr/velocity already defined above).
f_rejGauge(float gTop, float gBot, bool isBull, float creatQ) =>
    float atrR = math.max(nz(atr), syminfo.mintick)
    // active only while THIS bar's range overlaps the gap zone
    bool active = high >= gBot and low <= gTop
    float lean = 50.0
    if active
        // 1) creation strength — strong creation defends the gap (reject). ±15
        lean := lean + (math.min(math.max(nz(creatQ), 0.0), 1.0) - 0.5) * 2.0 * 15.0
        // 2) pullback strength — recent return momentum vs ATR. Fast return -> accept (-), slow -> reject (+). ±18
        float retSpeed = math.min(nz(velocity) / (atrR * 0.5), 2.0) / 2.0   // 0..1 (1 = fast)
        lean := lean - (retSpeed - 0.5) * 2.0 * 18.0
        // 3) absorption wick on the touch bar — a wick pushing back OUT of the gap. ±22
        float rng = math.max(high - low, syminfo.mintick)
        float lowerWick = (math.min(open, close) - low) / rng    // 0..1
        float upperWick = (high - math.max(open, close)) / rng   // 0..1
        float absorb = isBull ? lowerWick : upperWick            // the rejecting wick for this side
        lean := lean + (absorb - 0.2) * 22.0 / 0.8               // ~0 at a 20% wick, +22 at a full wick
        // 4) approach character over the last 3 bars — trend bodies vs wicks (approaching, pre-touch)
        float bodySum = 0.0
        float rngSum  = 0.0
        for ab = 1 to 3
            bodySum := bodySum + math.abs(close[ab] - open[ab])
            rngSum  := rngSum + math.max(high[ab] - low[ab], syminfo.mintick)
        float bodyFrac = rngSum > 0 ? bodySum / rngSum : 0.5     // 1 = pure trend, 0 = pure wick
        lean := lean - (bodyFrac - 0.5) * 2.0 * 14.0             // trend -> accept(-), wicky -> reject(+)
    [active, int(math.max(0.0, math.min(100.0, math.round(lean))))]

// LIVE level-reaction gauge — only meaningful when price is AT / near the level. Returns
// [active, rejLean] where 100 = strong REJECT/reverse off the level, 0 = strong SWEEP through,
// 50 = neutral. A level is RESTING LIQUIDITY, so it blends:
//   • importance/type: major levels (weekly/PDH) defend harder -> reject; minor swings less so
//   • EQUAL highs/lows are ENGINEERED to be taken -> lean SWEEP (the key level-specific nuance)
//   • approach strength: fast momentum into it -> sweep; slow/tentative -> reject
//   • absorption wick on the touch bar (toward the level) -> reject
//   • tested: an already-probed level is weaker on the next touch -> sweep
//   • confluence (0..1): stacked / OB-FVG-backed levels react harder -> reject
// name is the level label (e.g. "PWH","EQH","BSL"); conf01 is a 0..1 confluence strength.
f_lvlGauge(float price, string name, bool tested, float conf01, float atrU) =>
    float atrL = math.max(nz(atrU), syminfo.mintick)
    bool active = math.abs(close - price) <= atrL * 0.15 or (high >= price and low <= price)
    float lean = 50.0
    if active
        // 1) importance by type (mirrors the DOL hierarchy) -> reject strength 0..1
        float imp = 0.4
        if str.contains(name, "PWH") or str.contains(name, "PWL") or str.contains(name, "PMH") or str.contains(name, "PML")
            imp := 1.0
        else if str.contains(name, "PDH") or str.contains(name, "PDL")
            imp := 0.8
        else if str.contains(name, "Open") or str.contains(name, "Midnight")
            imp := 0.75
        else if str.contains(name, "POC") or str.contains(name, "VAH") or str.contains(name, "VAL")
            imp := 0.7
        else if str.contains(name, "Breaker")
            imp := 0.7
        else if str.contains(name, "NY") or str.contains(name, "London") or str.contains(name, "Asia")
            imp := 0.5
        lean := lean + (imp - 0.5) * 2.0 * 16.0
        // 2) EQUAL highs/lows are engineered stop liquidity -> lean SWEEP (overrides importance)
        if str.contains(name, "EQ")
            lean := lean - 18.0
        // 3) approach strength — fast into the level sweeps (-), slow rejects (+). ±16
        float apSpeed = math.min(nz(velocity) / (atrL * 0.5), 2.0) / 2.0
        lean := lean - (apSpeed - 0.5) * 2.0 * 16.0
        // 4) absorption wick toward the level on the touch bar. ±20
        float rng = math.max(high - low, syminfo.mintick)
        float lowerWick = (math.min(open, close) - low) / rng
        float upperWick = (high - math.max(open, close)) / rng
        bool  above = price >= close                     // resistance above -> upper wick rejects
        float absorb = above ? upperWick : lowerWick
        lean := lean + (absorb - 0.2) * 20.0 / 0.8
        // 5) tested state — a probed level is weaker next touch -> sweep. -12
        if tested
            lean := lean - 12.0
        // 6) confluence — stacked / backed levels react harder -> reject. ±12
        lean := lean + (math.min(math.max(nz(conf01), 0.0), 1.0) - 0.5) * 2.0 * 12.0
    [active, int(math.max(0.0, math.min(100.0, math.round(lean))))]

f_tablePos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : p == "Middle Left" ? position.middle_left : position.middle_right

// clamp a drawing's start bar to inside the loaded history buffer (never < 0)
f_clampBar(int b) =>
    int back = math.min(bar_index, 300)
    int floorBar = bar_index - back
    int r = na(b) ? floorBar : math.max(b, floorBar)
    math.max(math.min(r, bar_index), 0)

// countdown-to-level string
f_countdown(float target) =>
    string outTxt = ""
    if showCD and nz(velocity) > 0 and not na(target)
        float dist = math.abs(target - close)
        bool approaching = (target > close and close > nz(close[1], close)) or (target < close and close < nz(close[1], close))
        if (not dirAware) or approaching
            float bars = dist / velocity
            if cdMode == "Bars"
                outTxt := " → ≈ " + str.tostring(math.round(bars)) + "b"
            else
                float secs = bars * secPerBar
                if secs < 3600
                    outTxt := " → ≈ " + str.tostring(math.round(secs / 60)) + "m"
                else if secs < 86400
                    int h = int(math.floor(secs / 3600))
                    int m = int(math.round((secs - h * 3600) / 60))
                    outTxt := " → ≈ " + str.tostring(h) + "h " + str.tostring(m) + "m"
                else
                    outTxt := " → ≈ " + str.tostring(math.round(secs / 86400)) + "d"
    outTxt

f_repeat(string e, int n) =>
    string s = ""
    int cnt = math.min(n, maxStrength)
    for i = 1 to cnt
        s := s + e
    s

f_tierEmoji(int members) =>
    members <= 1 ? "💧" : members == 2 ? "⚡" : members == 3 ? "🔥" : members == 4 ? "💎" : "🐋"

f_strongSize(int members) =>
    not bigStrongLbl ? f_labelSize() : (members >= 4 ? size.large : members >= 2 ? size.normal : f_labelSize())

// BSL/SSL by POSITION vs price
f_sideColI(int side, float lvl, color fallback) =>
    not sideColorOn ? fallback : (lvl >= close ? colBSL : colSSL)
f_sideEmojiI(int side, float lvl) =>
    not sideColorOn ? strengthEmoji : (lvl >= close ? emojiBSL : emojiSSL)
f_sideTagI(int side, float lvl) =>
    lvl >= close ? "BSL" : "SSL"

f_sessName(string base, bool carried) =>
    (sessReclassify and carried) ? (base + " (swing)") : base

f_inCompactRange(float lvl) =>
    not compact or (na(lvl) ? false : math.abs(lvl - close) <= nz(atr) * (nearN * compactBand))

f_extLen(int birthBar) =>
    if not ageExtend or na(birthBar)
        extendR
    else
        int age = math.max(bar_index - birthBar, 0)
        int extra = int(math.min(age * ageScale, ageMaxBars))
        extendR + extra

// -----------------------------------------------------------------------------
// LEVEL SOURCES
// -----------------------------------------------------------------------------
pdh   = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl   = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh   = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl   = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)
pmh   = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_on)
pml   = request.security(syminfo.tickerid, "M", low[1],  lookahead = barmerge.lookahead_on)
dOpen = request.security(syminfo.tickerid, "D", open,    lookahead = barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", open,    lookahead = barmerge.lookahead_on)
mOpen = request.security(syminfo.tickerid, "M", open,    lookahead = barmerge.lookahead_on)
// NY midnight open: capture price at the first bar of the New York (ET) day.
var float midO = na
bool newNYDay = ta.change(time("D", "0000-0000", "America/New_York")) != 0
if newNYDay
    midO := open
// session VWAP (scoring factor only)
vwapVal = ta.vwap(hlc3)

// -----------------------------------------------------------------------------
// VOLUME PROFILE — rough POC / Value Area over a lookback (computed on last bar)
// -----------------------------------------------------------------------------
var float vpPOC = na
var float vpVAH = na
var float vpVAL = na
// ta.highest/ta.lowest must be evaluated every bar (not inside a conditional) for a consistent
// series; compute at global scope and read the results inside the VP block below.
float vpHiP = ta.highest(high, vpLen)
float vpLoP = ta.lowest(low, vpLen)
if showVP and barstate.islast
    float hiP = vpHiP
    float loP = vpLoP
    if not na(hiP) and not na(loP) and hiP > loP
        float binW = (hiP - loP) / vpBins
        var bins = array.new<float>()
        array.clear(bins)
        for bni = 0 to vpBins - 1
            array.push(bins, 0.0)
        // distribute each bar's volume into the bin covering its hlc3
        for bk = 0 to vpLen - 1
            float pxk = (high[bk] + low[bk] + close[bk]) / 3.0
            float vk  = nz(volume[bk], 1.0)
            int bidx = int(math.floor((pxk - loP) / binW))
            bidx := math.max(0, math.min(vpBins - 1, bidx))
            array.set(bins, bidx, array.get(bins, bidx) + vk)
        // POC = highest-volume bin center; total for value-area
        float totV = array.sum(bins)
        int pocI = 0
        float pocV = 0.0
        for bni = 0 to vpBins - 1
            if array.get(bins, bni) > pocV
                pocV := array.get(bins, bni)
                pocI := bni
        vpPOC := loP + (pocI + 0.5) * binW
        // expand around POC until ~70% of volume is captured -> value area
        float acc = pocV
        int lo_i = pocI
        int hi_i = pocI
        while acc < totV * 0.70 and (lo_i > 0 or hi_i < vpBins - 1)
            float belowV = lo_i > 0 ? array.get(bins, lo_i - 1) : -1.0
            float aboveV = hi_i < vpBins - 1 ? array.get(bins, hi_i + 1) : -1.0
            if aboveV >= belowV and hi_i < vpBins - 1
                hi_i := hi_i + 1
                acc := acc + array.get(bins, hi_i)
            else if lo_i > 0
                lo_i := lo_i - 1
                acc := acc + array.get(bins, lo_i)
            else if hi_i < vpBins - 1
                hi_i := hi_i + 1
                acc := acc + array.get(bins, hi_i)
        vpVAL := loP + lo_i * binW
        vpVAH := loP + (hi_i + 1) * binW

// -----------------------------------------------------------------------------
// SESSIONS
// -----------------------------------------------------------------------------
f_inSession(string s) => not na(time(timeframe.period, s, sessTZ))
newDay = ta.change(time("D", "0000-0000", sessTZ)) != 0

f_sessHL(bool active, string sess) =>
    var float hi        = na
    var float lo        = na
    var bool  prevIn    = false
    var bool  hiCarried = false
    var bool  loCarried = false
    bool inS = f_inSession(sess)
    if active
        if sessResetDaily and newDay
            hiCarried := not na(hi)
            loCarried := not na(lo)
        if inS and not prevIn
            hi := high
            lo := low
            hiCarried := false
            loCarried := false
        else if inS
            hi := math.max(nz(hi, high), high)
            lo := math.min(nz(lo, low), low)
        if sessRemoveSwept
            if not na(hi) and high > hi
                hi := na
                hiCarried := false
            if not na(lo) and low < lo
                lo := na
                loCarried := false
    prevIn := inS
    // "forming" = we're inside this session AND the current bar is at/making the extreme.
    // A forming extreme is not resting liquidity yet (price is defining it in real time),
    // so it should NOT act as a DOL magnet / carry a confidence % (it would just chase price).
    bool hiForming = active and inS and not na(hi) and high >= hi
    bool loForming = active and inS and not na(lo) and low  <= lo
    [hi, lo, hiCarried, loCarried, hiForming, loForming]

[asiaH, asiaL, asiaHc, asiaLc, asiaHf, asiaLf] = f_sessHL(showAsia, asiaSess)
[londH, londL, londHc, londLc, londHf, londLf] = f_sessHL(showLond, londSess)
[nyH,   nyL,   nyHc,   nyLc,   nyHf,   nyLf]   = f_sessHL(showNY,   nySess)

// -----------------------------------------------------------------------------
// SWINGS + HTF SWINGS
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

f_htfPH() => ta.pivothigh(high, htfLen, htfLen)
f_htfPL() => ta.pivotlow(low, htfLen, htfLen)
htfPH = htfSwingOn ? request.security(syminfo.tickerid, htfTF, f_htfPH(), lookahead = barmerge.lookahead_off) : na
htfPL = htfSwingOn ? request.security(syminfo.tickerid, htfTF, f_htfPL(), lookahead = barmerge.lookahead_off) : na
htfPHchg = not na(htfPH) and (na(htfPH[1]) or htfPH != htfPH[1])
htfPLchg = not na(htfPL) and (na(htfPL[1]) or htfPL != htfPL[1])

// --- HTF Fair Value Gaps: detect the 3-candle gap natively on the HTF, pull back the
// zone bounds + polarity + displacement volume in one security call. Box-less: they boost
// aligned chart-TF gap scores and feed the DOL model, but are never drawn as boxes. ---
f_htfFvg() =>
    bool bull = low > nz(high[2], low)
    bool bear = high < nz(low[2], high)
    bool exists = bull or bear
    float gT = bull ? low   : (bear ? low[2] : na)
    float gB = bull ? high[2] : (bear ? high  : na)
    float dV = nz(volume[1], volume)
    int   bn = bar_index
    [exists ? 1 : 0, gT, gB, bull ? 1 : 0, dV, bn]
// NOTE: request.security is called unconditionally (a ternary cannot return a tuple in Pine).
// The htfFvgOn guards on htfFvgNew / registration below suppress all tracking when it's off.
[hfvgEx, hfvgT, hfvgB, hfvgBull, hfvgVol, hfvgBar] = request.security(syminfo.tickerid, htfTF, f_htfFvg(), lookahead = barmerge.lookahead_off)
// a gap is "new" when the reported HTF bar index advances (one registration per HTF bar)
htfFvgNew = htfFvgOn and nz(hfvgEx) == 1 and not na(hfvgT) and not na(hfvgB) and (na(hfvgBar[1]) or hfvgBar != hfvgBar[1])

var float lastPH = na
var float lastPL = na
var int rangeDir = 0
if showSwing or showEQ or showConf
    if not na(ph)
        lastPH := ph
        rangeDir := -1
    if not na(pl)
        lastPL := pl
        rangeDir := 1

// LIVE dealing range (for the confluence OTE / premium-discount factor).
// Computed internally whenever the confluence score is on; NOT drawn on the chart.
// One end anchors to the freshest opposing swing; the other tracks the running
// extreme, so the OTE levels re-measure as price continues in the leg's direction.
var float rngHi = na
var float rngLo = na
if showConf
    if not na(pl)
        rngLo := pl
        rngHi := math.max(nz(rngHi, high), high)
    if not na(ph)
        rngHi := ph
        rngLo := math.min(nz(rngLo, low), low)
    if rangeDir >= 0
        rngHi := math.max(nz(rngHi, high), high)
    else
        rngLo := math.min(nz(rngLo, low), low)

// OTE retracement ratios used by the confluence score (internal; never drawn)
var float pdFib1 = 0.705
var float pdFib2 = 0.788
var float pdFib3 = 0.886

// historical swing storage
var swHi   = array.new<float>()
var swHiB  = array.new<int>()
var swLo   = array.new<float>()
var swLoB  = array.new<int>()

if showSwing and not na(ph)
    array.push(swHi, ph)
    array.push(swHiB, bar_index - swingLen)
if showSwing and not na(pl)
    array.push(swLo, pl)
    array.push(swLoB, bar_index - swingLen)
if showSwing and htfSwingOn and htfPHchg
    array.push(swHi, htfPH)
    array.push(swHiB, na)
if showSwing and htfSwingOn and htfPLchg
    array.push(swLo, htfPL)
    array.push(swLoB, na)

// sweep-removal from swing arrays
if removeSwept and array.size(swHi) > 0
    int ih = 0
    while ih < array.size(swHi)
        if high > array.get(swHi, ih)
            array.remove(swHi, ih)
            array.remove(swHiB, ih)
        else
            ih += 1
if removeSwept and array.size(swLo) > 0
    int il = 0
    while il < array.size(swLo)
        if low < array.get(swLo, il)
            array.remove(swLo, il)
            array.remove(swLoB, il)
        else
            il += 1
while array.size(swHi) > swingHist
    array.shift(swHi)
    array.shift(swHiB)
while array.size(swLo) > swingHist
    array.shift(swLo)
    array.shift(swLoB)

// -----------------------------------------------------------------------------
// EQUAL HIGHS / LOWS — rolling-buffer detection
// -----------------------------------------------------------------------------
float eqTolPrice = nz(atr) * eqTol
float relEqTolPrice = nz(atr) * relEqTol
var pvHi  = array.new<float>()
var pvLo  = array.new<float>()
var eqHiA = array.new<float>()
var eqHiB = array.new<int>()
var eqLoA = array.new<float>()
var eqLoB = array.new<int>()
var reqHiA = array.new<float>()   // relative (near) equal highs
var reqHiB = array.new<int>()
var reqLoA = array.new<float>()   // relative (near) equal lows
var reqLoB = array.new<int>()

if showEQ and not na(ph)
    bool found = false
    bool relFound = false
    float matched = na
    float relMatched = na
    int hs = array.size(pvHi)
    if hs > 0
        int start = math.max(hs - eqLookback, 0)
        for qi = start to hs - 1
            float prevH = array.get(pvHi, qi)
            float d = math.abs(ph - prevH)
            if d <= eqTolPrice
                found := true
                matched := math.max(ph, prevH)
            else if showRelEQ and d <= relEqTolPrice
                relFound := true
                relMatched := math.max(ph, prevH)
    if found
        array.push(eqHiA, matched)
        array.push(eqHiB, bar_index - swingLen)
    else if relFound
        array.push(reqHiA, relMatched)
        array.push(reqHiB, bar_index - swingLen)
    array.push(pvHi, ph)
    while array.size(pvHi) > 40
        array.shift(pvHi)

if showEQ and not na(pl)
    bool found = false
    bool relFound = false
    float matched = na
    float relMatched = na
    int ls = array.size(pvLo)
    if ls > 0
        int start = math.max(ls - eqLookback, 0)
        for qi = start to ls - 1
            float prevL = array.get(pvLo, qi)
            float d = math.abs(pl - prevL)
            if d <= eqTolPrice
                found := true
                matched := math.min(pl, prevL)
            else if showRelEQ and d <= relEqTolPrice
                relFound := true
                relMatched := math.min(pl, prevL)
    if found
        array.push(eqLoA, matched)
        array.push(eqLoB, bar_index - swingLen)
    else if relFound
        array.push(reqLoA, relMatched)
        array.push(reqLoB, bar_index - swingLen)
    array.push(pvLo, pl)
    while array.size(pvLo) > 40
        array.shift(pvLo)

if array.size(eqHiA) > 0
    int i = 0
    while i < array.size(eqHiA)
        if removeSwept and high > array.get(eqHiA, i)
            array.remove(eqHiA, i)
            array.remove(eqHiB, i)
        else
            i += 1
if array.size(eqLoA) > 0
    int i = 0
    while i < array.size(eqLoA)
        if removeSwept and low < array.get(eqLoA, i)
            array.remove(eqLoA, i)
            array.remove(eqLoB, i)
        else
            i += 1
while array.size(eqHiA) > swingHist
    array.shift(eqHiA)
    array.shift(eqHiB)
while array.size(eqLoA) > swingHist
    array.shift(eqLoA)
    array.shift(eqLoB)
// relative-EQ maintenance (sweep removal + size cap), mirroring exact EQ
if array.size(reqHiA) > 0
    int i = 0
    while i < array.size(reqHiA)
        if removeSwept and high > array.get(reqHiA, i)
            array.remove(reqHiA, i)
            array.remove(reqHiB, i)
        else
            i += 1
if array.size(reqLoA) > 0
    int i = 0
    while i < array.size(reqLoA)
        if removeSwept and low < array.get(reqLoA, i)
            array.remove(reqLoA, i)
            array.remove(reqLoB, i)
        else
            i += 1
while array.size(reqHiA) > swingHist
    array.shift(reqHiA)
    array.shift(reqHiB)
while array.size(reqLoA) > swingHist
    array.shift(reqLoA)
    array.shift(reqLoB)

// -----------------------------------------------------------------------------
// BIRTH-BAR TRACKING (for age-scaled extension)
// -----------------------------------------------------------------------------
var int b_pdh = na, var int b_pdl = na
var int b_pwh = na, var int b_pwl = na
var int b_pmh = na, var int b_pml = na
var int b_do  = na
var int b_wo  = na, var int b_mo = na, var int b_mid = na
var int b_ah  = na, var int b_al = na
var int b_lh  = na, var int b_ll = na
var int b_nh  = na, var int b_nl = na
b_pdh := (na(b_pdh) or pdh != pdh[1]) ? bar_index : b_pdh
b_pdl := (na(b_pdl) or pdl != pdl[1]) ? bar_index : b_pdl
b_pwh := (na(b_pwh) or pwh != pwh[1]) ? bar_index : b_pwh
b_pwl := (na(b_pwl) or pwl != pwl[1]) ? bar_index : b_pwl
b_pmh := (na(b_pmh) or pmh != pmh[1]) ? bar_index : b_pmh
b_pml := (na(b_pml) or pml != pml[1]) ? bar_index : b_pml
b_do  := (na(b_do)  or dOpen != dOpen[1]) ? bar_index : b_do
b_wo  := (na(b_wo)  or wOpen != wOpen[1]) ? bar_index : b_wo
b_mo  := (na(b_mo)  or mOpen != mOpen[1]) ? bar_index : b_mo
b_mid := (na(b_mid) or midO  != midO[1])  ? bar_index : b_mid
b_ah  := (na(b_ah)  or asiaH != asiaH[1]) ? bar_index : b_ah
b_al  := (na(b_al)  or asiaL != asiaL[1]) ? bar_index : b_al
b_lh  := (na(b_lh)  or londH != londH[1]) ? bar_index : b_lh
b_ll  := (na(b_ll)  or londL != londL[1]) ? bar_index : b_ll
b_nh  := (na(b_nh)  or nyH != nyH[1]) ? bar_index : b_nh
b_nl  := (na(b_nl)  or nyL != nyL[1]) ? bar_index : b_nl

// -----------------------------------------------------------------------------
// SWEEP MASKING for previous-period levels
// -----------------------------------------------------------------------------
var bool sw_pdh = false, var bool sw_pdl = false
var bool sw_pwh = false, var bool sw_pwl = false
var bool sw_pmh = false, var bool sw_pml = false
sw_pdh := (pdh != pdh[1]) ? false : (sw_pdh or (not na(pdh) and high > pdh))
sw_pdl := (pdl != pdl[1]) ? false : (sw_pdl or (not na(pdl) and low  < pdl))
sw_pwh := (pwh != pwh[1]) ? false : (sw_pwh or (not na(pwh) and high > pwh))
sw_pwl := (pwl != pwl[1]) ? false : (sw_pwl or (not na(pwl) and low  < pwl))
sw_pmh := (pmh != pmh[1]) ? false : (sw_pmh or (not na(pmh) and high > pmh))
sw_pml := (pml != pml[1]) ? false : (sw_pml or (not na(pml) and low  < pml))
pdhM = (removeSwept and sw_pdh) ? na : pdh
pdlM = (removeSwept and sw_pdl) ? na : pdl
pwhM = (removeSwept and sw_pwh) ? na : pwh
pwlM = (removeSwept and sw_pwl) ? na : pwl
pmhM = (removeSwept and sw_pmh) ? na : pmh
pmlM = (removeSwept and sw_pml) ? na : pml

// -----------------------------------------------------------------------------
// DAILY BIAS ENGINE — structural (daily candle structure + last PDH/PDL sweep)
// -----------------------------------------------------------------------------
// Pull the last two COMPLETED daily candles (offset [1]/[2] so they're closed, not forming).
// lookahead_off + the historical offset is the non-repainting pattern: we read only CLOSED
// daily bars, and the committed daily values never change retroactively on the chart TF.
dH1 = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_off)
dL1 = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_off)
dC1 = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_off)
dH2 = request.security(syminfo.tickerid, "D", high[2],  lookahead = barmerge.lookahead_off)
dL2 = request.security(syminfo.tickerid, "D", low[2],   lookahead = barmerge.lookahead_off)
// Layer 1 — daily candle structure (last 1-2 completed dailies): HH+HL vs LH+LL, plus a
// close-position tilt (where the last daily closed within its own range).
int structBias = 0
if not na(dH1) and not na(dH2) and not na(dL1) and not na(dL2)
    bool hh = dH1 > dH2
    bool hl = dL1 > dL2
    bool lh = dH1 < dH2
    bool ll = dL1 < dL2
    if hh and hl
        structBias := 1
    else if lh and ll
        structBias := -1
    else
        // mixed (inside/outside bar): break the tie with the last daily close position
        float dRng = math.max(dH1 - dL1, syminfo.mintick)
        float cPos = (dC1 - dL1) / dRng
        structBias := cPos >= 0.66 ? 1 : (cPos <= 0.34 ? -1 : 0)
// Layer 2 — last PDH/PDL sweep + close-confirmed reclaim/reject (the trigger).
//   PDL swept then reclaimed  -> bullish (grab below, close back above)
//   PDH swept then rejected   -> bearish (grab above, close back below)
// sweepBias holds the most recent such event until the next one supersedes it or a new day.
var int sweepBias = 0
bool pdlReclaim = not na(pdl) and sw_pdl and close > pdl        // was pierced below, now closed back above
bool pdhReject  = not na(pdh) and sw_pdh and close < pdh        // was pierced above, now closed back below
if pdlReclaim
    sweepBias := 1
else if pdhReject
    sweepBias := -1
if newDay
    sweepBias := 0                                              // reset each new daily candle
// Combine the two layers into a committed daily bias that HOLDS between events.
//   dayBias:  1 = LONG, -1 = SHORT, 0 = NEUTRAL
//   dayCaution: true = structure vs a fresh counter sweep disagree (conservative mode holds)
var int  dayBias    = 0
var bool dayCaution = false
if biasOn
    dayCaution := false
    bool agree = structBias != 0 and sweepBias != 0 and structBias == sweepBias
    bool conflict = structBias != 0 and sweepBias != 0 and structBias != sweepBias
    if agree
        dayBias := structBias                                  // high conviction
    else if sweepBias != 0 and structBias == 0
        dayBias := sweepBias                                   // sweep leads a neutral structure
    else if conflict
        if biasFast
            dayBias := sweepBias                               // fast: a fresh counter sweep flips it
        else
            dayBias := structBias                              // conservative: hold structure...
            dayCaution := true                                 // ...but flag the brewing flip
    else if structBias != 0
        dayBias := structBias                                  // structure only (no fresh sweep)
    // (both zero -> hold the previous dayBias; genuine range = stays as last committed)
else
    dayBias := 0
    dayCaution := false
// human-readable 'why' for the banner
string biasWhyStruct = structBias > 0 ? "bullish daily" : structBias < 0 ? "bearish daily" : "mixed daily"
string biasWhySweep  = sweepBias > 0 ? " · PDL reclaimed" : sweepBias < 0 ? " · PDH rejected" : ""
// bias-flip event (committed value changed direction) — for the alert
bool biasFlipNow = biasOn and dayBias != nz(dayBias[1], 0) and dayBias != 0

// -----------------------------------------------------------------------------
// SFP (sweep + reversal) DETECTION
// -----------------------------------------------------------------------------
lvHiNow = array.new<float>()
lvLoNow = array.new<float>()
if showSFP
    if not na(pdhM)
        array.push(lvHiNow, pdhM)
    if not na(pwhM)
        array.push(lvHiNow, pwhM)
    if not na(pmhM)
        array.push(lvHiNow, pmhM)
    if not na(pdlM)
        array.push(lvLoNow, pdlM)
    if not na(pwlM)
        array.push(lvLoNow, pwlM)
    if not na(pmlM)
        array.push(lvLoNow, pmlM)
    if not na(asiaH)
        array.push(lvHiNow, asiaH)
    if not na(londH)
        array.push(lvHiNow, londH)
    if not na(nyH)
        array.push(lvHiNow, nyH)
    if not na(asiaL)
        array.push(lvLoNow, asiaL)
    if not na(londL)
        array.push(lvLoNow, londL)
    if not na(nyL)
        array.push(lvLoNow, nyL)
    if array.size(swHi) > 0
        for si = 0 to array.size(swHi) - 1
            array.push(lvHiNow, array.get(swHi, si))
    if array.size(swLo) > 0
        for si = 0 to array.size(swLo) - 1
            array.push(lvLoNow, array.get(swLo, si))
    if array.size(eqHiA) > 0
        for si = 0 to array.size(eqHiA) - 1
            array.push(lvHiNow, array.get(eqHiA, si))
    if array.size(eqLoA) > 0
        for si = 0 to array.size(eqLoA) - 1
            array.push(lvLoNow, array.get(eqLoA, si))

// per-level SFP fired-memory: suppress re-firing on the SAME level within sfpCooldown bars.
var sfpFiredPx  = array.new<float>()   // price of a level that recently fired an SFP
var sfpFiredBar = array.new<int>()     // bar it fired on
// has an SFP fired on (a level within tol of) px inside the cooldown window?
f_sfpOnCooldown(float px, float tol) =>
    bool hit = false
    if sfpCooldown > 0 and array.size(sfpFiredPx) > 0
        for ci = 0 to array.size(sfpFiredPx) - 1
            if math.abs(array.get(sfpFiredPx, ci) - px) <= tol and (bar_index - array.get(sfpFiredBar, ci)) < sfpCooldown
                hit := true
    hit
float sfpTol = math.max(nz(atr) * 0.1, syminfo.mintick)
float sweptHiLvl = na
float sweptLoLvl = na
if showSFP and array.size(lvHiNow) > 0
    for si = 0 to array.size(lvHiNow) - 1
        float lv = array.get(lvHiNow, si)
        if high > lv and close < lv and not f_sfpOnCooldown(lv, sfpTol)
            if na(sweptHiLvl) or lv > sweptHiLvl
                sweptHiLvl := lv
if showSFP and array.size(lvLoNow) > 0
    for si = 0 to array.size(lvLoNow) - 1
        float lv = array.get(lvLoNow, si)
        if low < lv and close > lv and not f_sfpOnCooldown(lv, sfpTol)
            if na(sweptLoLvl) or lv < sweptLoLvl
                sweptLoLvl := lv

// confirm on bar close (no repaint) unless the user opts into the intrabar preview.
// On historical bars barstate.isconfirmed is always true, so history is unaffected — only the
// live forming bar is held until close.
bool sfpConfOK = (not sfpConfirm) or barstate.isconfirmed
bool sfpShort = showSFP and not na(sweptHiLvl) and volOK and sfpConfOK
bool sfpLong  = showSFP and not na(sweptLoLvl) and volOK and sfpConfOK
// record the fired level into the cooldown memory (so it won't re-fire for sfpCooldown bars)
if sfpCooldown > 0 and sfpShort and not na(sweptHiLvl)
    array.push(sfpFiredPx, sweptHiLvl)
    array.push(sfpFiredBar, bar_index)
if sfpCooldown > 0 and sfpLong and not na(sweptLoLvl)
    array.push(sfpFiredPx, sweptLoLvl)
    array.push(sfpFiredBar, bar_index)
// prune cooldown memory beyond the window (also hard-capped so it can't grow unbounded)
if array.size(sfpFiredPx) > 0
    int sfi = 0
    while sfi < array.size(sfpFiredPx)
        if (bar_index - array.get(sfpFiredBar, sfi)) >= sfpCooldown
            array.remove(sfpFiredPx, sfi)
            array.remove(sfpFiredBar, sfi)
        else
            sfi += 1
    while array.size(sfpFiredPx) > 50
        array.shift(sfpFiredPx)
        array.shift(sfpFiredBar)

// -----------------------------------------------------------------------------
// TESTED-STATE CAPTURE — a wick PROBES a level (enters within depth×ATR) but does NOT
// sweep through it. Recorded persistently by price (deduped/capped), independent of the
// per-bar level rebuild. Fully-swept levels are removed elsewhere, so this is the
// "touched but still standing" middle state.
// -----------------------------------------------------------------------------
if showTested
    float tDepth = math.max(nz(atr) * testDepthATR, syminfo.mintick)
    float tDedup = math.max(nz(atr) * 0.05, syminfo.mintick)
    tHiNow = array.new<float>()
    tLoNow = array.new<float>()
    if not na(pdhM)
        array.push(tHiNow, pdhM)
    if not na(pwhM)
        array.push(tHiNow, pwhM)
    if not na(pmhM)
        array.push(tHiNow, pmhM)
    if not na(pdlM)
        array.push(tLoNow, pdlM)
    if not na(pwlM)
        array.push(tLoNow, pwlM)
    if not na(pmlM)
        array.push(tLoNow, pmlM)
    if not na(asiaH)
        array.push(tHiNow, asiaH)
    if not na(londH)
        array.push(tHiNow, londH)
    if not na(nyH)
        array.push(tHiNow, nyH)
    if not na(asiaL)
        array.push(tLoNow, asiaL)
    if not na(londL)
        array.push(tLoNow, londL)
    if not na(nyL)
        array.push(tLoNow, nyL)
    if array.size(swHi) > 0
        for si = 0 to array.size(swHi) - 1
            array.push(tHiNow, array.get(swHi, si))
    if array.size(swLo) > 0
        for si = 0 to array.size(swLo) - 1
            array.push(tLoNow, array.get(swLo, si))
    if array.size(eqHiA) > 0
        for si = 0 to array.size(eqHiA) - 1
            array.push(tHiNow, array.get(eqHiA, si))
    if array.size(eqLoA) > 0
        for si = 0 to array.size(eqLoA) - 1
            array.push(tLoNow, array.get(eqLoA, si))
    // highs: wick pokes up to within tDepth BELOW the level but doesn't reach it (no sweep)
    if array.size(tHiNow) > 0
        for si = 0 to array.size(tHiNow) - 1
            float lv = array.get(tHiNow, si)
            if high >= lv - tDepth and high < lv
                bool dup = false
                if array.size(testedP) > 0
                    for dj = 0 to array.size(testedP) - 1
                        if math.abs(array.get(testedP, dj) - lv) <= tDedup
                            dup := true
                if not dup
                    array.push(testedP, lv)
    // lows: wick pokes down to within tDepth ABOVE the level but doesn't reach it
    if array.size(tLoNow) > 0
        for si = 0 to array.size(tLoNow) - 1
            float lv = array.get(tLoNow, si)
            if low <= lv + tDepth and low > lv
                bool dup = false
                if array.size(testedP) > 0
                    for dj = 0 to array.size(testedP) - 1
                        if math.abs(array.get(testedP, dj) - lv) <= tDedup
                            dup := true
                if not dup
                    array.push(testedP, lv)
    // cap (oldest dropped first)
    while array.size(testedP) > testKeep
        array.shift(testedP)

// signal markers — capped rolling pool so they never exhaust the label budget
var mk_labels = array.new<label>()
f_mark(int x, float y, string txt, string yl, string stl, color col, color tcol, string sz) =>
    label lb = label.new(x, y, txt, yloc = yl, style = stl, color = col, textcolor = tcol, size = sz)
    array.push(mk_labels, lb)
    while array.size(mk_labels) > 120
        label.delete(array.shift(mk_labels))

if masterOn and sfpLong
    f_mark(bar_index, low, "🎯 SFP▲" + (sfpUseVol ? " " + str.tostring(rvol, "#.0") + "x" : ""), yloc.belowbar, label.style_label_up, sfpColLong, color.white, size.small)
if masterOn and sfpShort
    f_mark(bar_index, high, "🎯 SFP▼" + (sfpUseVol ? " " + str.tostring(rvol, "#.0") + "x" : ""), yloc.abovebar, label.style_label_down, sfpColShort, color.white, size.small)

// -----------------------------------------------------------------------------
// ORDER BLOCKS
// -----------------------------------------------------------------------------
float bodySize = math.abs(close - open)
bool  disp     = bodySize >= obDisp * nz(atr)
var obTop  = array.new<float>()
var obBot  = array.new<float>()
var obBull = array.new<bool>()
var obBirth = array.new<int>()
// breaker blocks: a violated OB with flipped polarity (former demand -> supply, etc.)
var brkTop  = array.new<float>()
var brkBot  = array.new<float>()
var brkBull = array.new<bool>()   // polarity AFTER the flip
var brkBirth = array.new<int>()
if showOB and disp and close > open and (sfpLong or (close > high[1]))
    array.push(obTop, high[1])
    array.push(obBot, low[1])
    array.push(obBull, true)
    array.push(obBirth, bar_index - 1)
if showOB and disp and close < open and (sfpShort or (close < low[1]))
    array.push(obTop, high[1])
    array.push(obBot, low[1])
    array.push(obBull, false)
    array.push(obBirth, bar_index - 1)
if array.size(obTop) > 0
    int oi = 0
    while oi < array.size(obTop)
        bool bull = array.get(obBull, oi)
        bool dead = bull ? (close < array.get(obBot, oi)) : (close > array.get(obTop, oi))
        if dead
            // on violation, convert to a breaker with flipped polarity (if enabled)
            if showBreaker
                array.push(brkTop, array.get(obTop, oi))
                array.push(brkBot, array.get(obBot, oi))
                array.push(brkBull, not bull)
                array.push(brkBirth, bar_index)
            array.remove(obTop, oi)
            array.remove(obBot, oi)
            array.remove(obBull, oi)
            array.remove(obBirth, oi)
        else
            oi += 1
while array.size(obTop) > obKeep
    array.shift(obTop)
    array.shift(obBot)
    array.shift(obBull)
    array.shift(obBirth)
// breaker maintenance: a breaker dies when price closes back through it (opposite of OB)
if array.size(brkTop) > 0
    int bi = 0
    while bi < array.size(brkTop)
        bool bbull = array.get(brkBull, bi)
        bool bdead = bbull ? (close < array.get(brkBot, bi)) : (close > array.get(brkTop, bi))
        if bdead
            array.remove(brkTop, bi)
            array.remove(brkBot, bi)
            array.remove(brkBull, bi)
            array.remove(brkBirth, bi)
        else
            bi += 1
while array.size(brkTop) > obKeep
    array.shift(brkTop)
    array.shift(brkBot)
    array.shift(brkBull)
    array.shift(brkBirth)

// -----------------------------------------------------------------------------
// COLLECT → CLUSTER → RENDER  (last bar only)
// -----------------------------------------------------------------------------
var pool_lines = array.new<line>()
var pool_labels = array.new<label>()
var pool_boxes = array.new<box>()
var xtra_boxes  = array.new<box>()
var xtra_labels = array.new<label>()

f_clearXtra() =>
    while array.size(xtra_boxes) > 0
        box.delete(array.pop(xtra_boxes))
    while array.size(xtra_labels) > 0
        label.delete(array.pop(xtra_labels))
f_clearPools() =>
    while array.size(pool_lines) > 0
        line.delete(array.pop(pool_lines))
    while array.size(pool_labels) > 0
        label.delete(array.pop(pool_labels))
    while array.size(pool_boxes) > 0
        box.delete(array.pop(pool_boxes))

// candidate level arrays (rebuilt each last-bar pass)
var lv_price = array.new<float>()
var lv_name = array.new<string>()
var lv_col = array.new<color>()
var lv_emo = array.new<string>()
var lv_birth = array.new<int>()
var lv_side = array.new<int>()
var lv_pull = array.new<float>()   // per-level DOL pull (proximity-weighted gravity)
var lv_qual = array.new<float>()   // per-level distance-neutral magnet quality
var lv_inwin = array.new<bool>()   // is this level within the N-nearest-each-side confidence window
var lv_nomag = array.new<bool>()   // true = level draws but takes NO DOL magnet / confidence role
var lv_primary = array.new<bool>() // declutter: true = among the Top-N by confidence on its side (drawn bold)

// variant that can flag a level as "no magnet" (still drawn, but excluded from the DOL pull)
f_addLevelM(bool active, float price, string name, color col, string emo, int birthBar, int side, bool noMagnet) =>
    if masterOn and active and not na(price) and f_inCompactRange(price)
        array.push(lv_price, price)
        array.push(lv_name, name)
        array.push(lv_col, col)
        array.push(lv_emo, emo)
        array.push(lv_birth, birthBar)
        array.push(lv_side, side)
        array.push(lv_nomag, noMagnet)

// convenience wrapper: a normal level always takes a magnet role
f_addLevel(bool active, float price, string name, color col, string emo, int birthBar, int side) =>
    f_addLevelM(active, price, name, col, emo, birthBar, side, false)

// FVG state (declared here so f_confScore + projection helpers below can read it; populated later)
var fvgBoxes  = array.new<box>()
var fvgIsBull = array.new<bool>()
var fvgStr    = array.new<float>()   // 0-100 strength score per gap
var fvgLabels = array.new<label>()   // optional strength label per gap (na if none)
var fvgCE     = array.new<line>()    // optional consequent-encroachment (50%) line per gap (na if none)
var fvgArmed  = array.new<int>()     // execution state per gap: 0 watching · 1 armed · 2 confirmed · 3 dead (stop hit / expired)
var fvgArmBar = array.new<int>()     // bar_index the gap ARMED on (for setup expiry); na while watching
var fvgApproached = array.new<bool>() // approach alert already fired for this gap (cooldown)
var fvgCreatQ = array.new<float>()   // creation displacement quality 0..1 (for the rejection gauge)
// FVG execution setup drawings (entry/stop/target lines + label), redrawn each bar from the
// armed gaps so only the nearest active setups show. Alert flags are raised in the gap loop.
var exec_lines  = array.new<line>()
var exec_labels = array.new<label>()
var bool execArmNow     = false   // a gap armed on THIS bar (for alertcondition)
var bool execConfirmNow = false   // a gap confirmed on THIS bar
var bool execReturnNow  = false   // price is returning into a qualifying gap (approach alert)
var bool execInvalidNow = false   // a setup was invalidated (stop breach / expiry) THIS bar
// HTF (higher-timeframe) FVG state — tracked box-less (plain floats, zero draw-object cost).
// They boost the score of aligned chart-TF gaps and feed the DOL model; never drawn.
var htfFvgTop   = array.new<float>()
var htfFvgBot   = array.new<float>()
var htfFvgBull  = array.new<bool>()
var htfFvgStr   = array.new<float>()  // 0-100 strength score per HTF gap
// inversion memory: zones of recently-invalidated gaps, so a new opposite gap in the
// same zone can be flagged as an inverted FVG (IFVG).
var invTop    = array.new<float>()
var invBot    = array.new<float>()
var invWasBull = array.new<bool>()   // polarity of the gap that got invalidated
var invBar    = array.new<int>()     // bar it was invalidated on

// How important is the strongest liquidity pool sitting on/just-beyond a gap? Returns 0..1,
// graded by a type hierarchy (weekly/monthly > equal highs/lows > prev-day > opens > VP >
// session > swing), mirroring the DOL type weights. "Near" = overlap OR within fvgLiqATR of a
// gap edge, so it also rewards a gap that GUARDS a pool just beyond it (the fuel price hunts).
// is a price within [lo..hi]? (helper for f_gapLiqPool; top-level since Pine has no nesting)
f_inBand(float p, float lo, float hi) => not na(p) and p >= lo and p <= hi
f_gapLiqPool(float gTop, float gBot, bool isBull) =>
    float band = math.max(nz(atr) * fvgLiqATR, syminfo.mintick)
    float lo = gBot - band
    float hi = gTop + band
    float best = 0.0
    // equal highs/lows — engineered stop liquidity (very high value)
    if array.size(eqHiA) > 0
        for i = 0 to array.size(eqHiA) - 1
            if f_inBand(array.get(eqHiA, i), lo, hi)
                best := math.max(best, 0.90)
    if array.size(eqLoA) > 0
        for i = 0 to array.size(eqLoA) - 1
            if f_inBand(array.get(eqLoA, i), lo, hi)
                best := math.max(best, 0.90)
    if showRelEQ and array.size(reqHiA) > 0
        for i = 0 to array.size(reqHiA) - 1
            if f_inBand(array.get(reqHiA, i), lo, hi)
                best := math.max(best, 0.70)
    if showRelEQ and array.size(reqLoA) > 0
        for i = 0 to array.size(reqLoA) - 1
            if f_inBand(array.get(reqLoA, i), lo, hi)
                best := math.max(best, 0.70)
    // previous-period levels (weekly/monthly weigh most)
    if f_inBand(pwhM, lo, hi) or f_inBand(pwlM, lo, hi)
        best := math.max(best, 0.95)
    if f_inBand(pmhM, lo, hi) or f_inBand(pmlM, lo, hi)
        best := math.max(best, 1.00)
    if f_inBand(pdhM, lo, hi) or f_inBand(pdlM, lo, hi)
        best := math.max(best, 0.80)
    // key opens
    if f_inBand(wOpen, lo, hi) or f_inBand(mOpen, lo, hi)
        best := math.max(best, 0.85)
    if f_inBand(dOpen, lo, hi) or f_inBand(midO, lo, hi)
        best := math.max(best, 0.65)
    // volume-profile acceptance levels
    if showVP
        if f_inBand(vpPOC, lo, hi)
            best := math.max(best, 0.80)
        if f_inBand(vpVAH, lo, hi) or f_inBand(vpVAL, lo, hi)
            best := math.max(best, 0.65)
    // session highs/lows
    if f_inBand(asiaH, lo, hi) or f_inBand(asiaL, lo, hi) or f_inBand(londH, lo, hi) or f_inBand(londL, lo, hi) or f_inBand(nyH, lo, hi) or f_inBand(nyL, lo, hi)
        best := math.max(best, 0.55)
    // swing BSL/SSL liquidity
    if array.size(swHi) > 0
        for i = 0 to array.size(swHi) - 1
            if f_inBand(array.get(swHi, i), lo, hi)
                best := math.max(best, 0.60)
    if array.size(swLo) > 0
        for i = 0 to array.size(swLo) - 1
            if f_inBand(array.get(swLo, i), lo, hi)
                best := math.max(best, 0.60)
    best

// How TRAPPED is a gap against opposing structure in its intended direction? Returns 0..1
// (0 = clear runway, 1 = heavily walled). For a BULLISH gap it scans just ABOVE the gap top
// for resistance (highs / order-block tops); for a BEARISH gap, just BELOW the gap bottom for
// support. Only OPPOSING-side structure counts — this is the poor-location penalty.
f_gapTrapped(float gTop, float gBot, bool isBull) =>
    float band = math.max(nz(atr) * fvgTrapATR, syminfo.mintick)
    // search window strictly on the opposing side, just beyond the gap edge
    float wLo = isBull ? gTop : (gBot - band)
    float wHi = isBull ? (gTop + band) : gBot
    float wall = 0.0
    if isBull
        // resistance above: prev-period / session / swing HIGHS, equal highs, OB tops
        if f_inBand(pwhM, wLo, wHi) or f_inBand(pmhM, wLo, wHi)
            wall := math.max(wall, 1.0)
        if f_inBand(pdhM, wLo, wHi)
            wall := math.max(wall, 0.85)
        if array.size(eqHiA) > 0
            for i = 0 to array.size(eqHiA) - 1
                if f_inBand(array.get(eqHiA, i), wLo, wHi)
                    wall := math.max(wall, 0.9)
        if f_inBand(nyH, wLo, wHi) or f_inBand(londH, wLo, wHi) or f_inBand(asiaH, wLo, wHi)
            wall := math.max(wall, 0.6)
        if array.size(swHi) > 0
            for i = 0 to array.size(swHi) - 1
                if f_inBand(array.get(swHi, i), wLo, wHi)
                    wall := math.max(wall, 0.6)
        if array.size(obTop) > 0
            for i = 0 to array.size(obTop) - 1
                if not array.get(obBull, i) and f_inBand(array.get(obTop, i), wLo, wHi)  // bearish OB above
                    wall := math.max(wall, 0.8)
    else
        // support below: prev-period / session / swing LOWS, equal lows, OB bottoms
        if f_inBand(pwlM, wLo, wHi) or f_inBand(pmlM, wLo, wHi)
            wall := math.max(wall, 1.0)
        if f_inBand(pdlM, wLo, wHi)
            wall := math.max(wall, 0.85)
        if array.size(eqLoA) > 0
            for i = 0 to array.size(eqLoA) - 1
                if f_inBand(array.get(eqLoA, i), wLo, wHi)
                    wall := math.max(wall, 0.9)
        if f_inBand(nyL, wLo, wHi) or f_inBand(londL, wLo, wHi) or f_inBand(asiaL, wLo, wHi)
            wall := math.max(wall, 0.6)
        if array.size(swLo) > 0
            for i = 0 to array.size(swLo) - 1
                if f_inBand(array.get(swLo, i), wLo, wHi)
                    wall := math.max(wall, 0.6)
        if array.size(obTop) > 0
            for i = 0 to array.size(obTop) - 1
                if array.get(obBull, i) and f_inBand(array.get(obBot, i), wLo, wHi)  // bullish OB below
                    wall := math.max(wall, 0.8)
    wall

// pick the closer opposing-pool candidate (top-level; Pine has no nested functions).
// Returns the candidate p if it is a valid target beyond fromP and nearer than the running best.
f_closerOpp(float best, float p, float fromP, bool isBull) =>
    float r = best
    if not na(p)
        if isBull and p > fromP and (na(best) or p < best)
            r := p
        else if (not isBull) and p < fromP and (na(best) or p > best)
            r := p
    r
// Nearest OPPOSING liquidity pool in the trade's direction, used as a realistic TARGET for the
// feasibility / R:R check. For a long (isBull) that's the nearest pool ABOVE fromP (prev-period
// highs, equal highs, session highs, swing highs); for a short, the nearest pool BELOW. Returns
// the target price, or na if none is tracked above/below.
f_nextOppLiq(float fromP, bool isBull) =>
    float best = na
    if isBull
        best := f_closerOpp(best, pdhM, fromP, isBull)
        best := f_closerOpp(best, pwhM, fromP, isBull)
        best := f_closerOpp(best, pmhM, fromP, isBull)
        best := f_closerOpp(best, nyH, fromP, isBull)
        best := f_closerOpp(best, londH, fromP, isBull)
        best := f_closerOpp(best, asiaH, fromP, isBull)
        if array.size(eqHiA) > 0
            for i = 0 to array.size(eqHiA) - 1
                best := f_closerOpp(best, array.get(eqHiA, i), fromP, isBull)
        if array.size(swHi) > 0
            for i = 0 to array.size(swHi) - 1
                best := f_closerOpp(best, array.get(swHi, i), fromP, isBull)
    else
        best := f_closerOpp(best, pdlM, fromP, isBull)
        best := f_closerOpp(best, pwlM, fromP, isBull)
        best := f_closerOpp(best, pmlM, fromP, isBull)
        best := f_closerOpp(best, nyL, fromP, isBull)
        best := f_closerOpp(best, londL, fromP, isBull)
        best := f_closerOpp(best, asiaL, fromP, isBull)
        if array.size(eqLoA) > 0
            for i = 0 to array.size(eqLoA) - 1
                best := f_closerOpp(best, array.get(eqLoA, i), fromP, isBull)
        if array.size(swLo) > 0
            for i = 0 to array.size(swLo) - 1
                best := f_closerOpp(best, array.get(swLo, i), fromP, isBull)
    best

// RANK a fair value gap 0-100 (a relative quality ranking, NOT a probability). CORE BASE (the
// quality every gap has: size · volume · displacement · premium-discount → ~40-55 for a clean
// gap) PLUS BONUS points added on top only when occasional factors fire — so absent bonuses
// never drag an ordinary gap to the floor, yet confluent gaps clearly rise above:
//   • gap size vs ATR            • creation volume (rel-vol of the displacement candle)
//   • inside an order/breaker     • inversion of a prior opposite gap (IFVG)
//   • alignment with an HTF gap   • premium/discount location in the dealing range
//   • displacement quality        • confluence (round number / VWAP / OTE)
//   • liquidity-pool confluence   • sweep precedence (SFP -> displacement -> FVG)
//   • freshness (tested gaps are discounted, applied as a multiplier after the average)
// dispVol = volume of the creating candle; dispQual = caller-computed 0..1 candle-conviction
// (body dominance + structure break). Pass isHtf=true to skip the HTF-alignment factor for
// HTF gaps themselves (avoids self-matching). Returns [score, isInv, inBlock, htfAligned].
f_fvgStrength(float gTop, float gBot, bool isBull, float dispVol, float dispQual, bool isHtf) =>
    float atrF = math.max(nz(atr), syminfo.mintick)
    // HTF-alignment is a low-timeframe tool: it is an APPLICABLE scoring factor only when the
    // chart TF <= htfFvgMaxTF (htfMode). On higher timeframes it is excluded from the average
    // entirely (not just zeroed), and gap-size importance rises, so HTF charts rank gaps on the
    // classic factors as before.
    bool  htfMode = fvgHtfActive and htfFvgOn and not isHtf
    // ---- CORE-BASE + BONUS model ----
    // Problem with a pure weighted average over ALL factors: most factors (OB, inversion, HTF,
    // confluence, sweep) are binary and usually ABSENT, so their zeros sit in the denominator and
    // drag every ordinary-but-valid gap's score to the floor — the filter then dims everything.
    // Fix: a gap's BASELINE quality is the weighted average of the CORE factors it *always* has
    // (size · volume · displacement · premium-discount) → a clean gap lands in a usable mid-range.
    // The occasional BONUS factors (OB/breaker · inversion · HTF · confluence · liquidity pool ·
    // sweep) then ADD points ON TOP only when they fire — so an absent bonus never penalises, and
    // confluent gaps rise above ordinary ones. Score = base (0..~65) + bonuses, capped at 100.
    //
    // --- CORE base (weighted average, 0..~70) ---
    // Sub-scores are calibrated so a TYPICAL gap reads mid-range (not near 0). On low timeframes
    // an FVG's size is usually a small fraction of ATR and volume/displacement are unremarkable,
    // so the old "1.0 = normal" curves floored every gap. These map a normal gap to ~0.5-0.7.
    float cNum = 0.0
    float cDen = 0.0
    // 1) gap size vs ATR — a gap ~0.4×ATR already reads as good size (not 0.4)
    float gapATRv = math.abs(gTop - gBot) / atrF
    float subSize = math.min(gapATRv / 0.4, 1.0)
    cNum := cNum + subSize * 22.0 * fvgSizeW
    cDen := cDen + 22.0 * fvgSizeW
    // 2) creation volume — average volume (relV≈1) already reads ~0.67; a spike saturates
    float relV   = nz(avgVol) > 0 ? dispVol / avgVol : 1.0
    float subVol = math.min(math.max(relV, 0.0) / 1.5, 1.0)
    cNum := cNum + subVol * 14.0 * fvgVolW
    cDen := cDen + 14.0 * fvgVolW
    // 7) displacement quality (caller 0..1) — floored so a normal displacement reads ~0.55+
    float subDisp = math.min(0.35 + math.max(nz(dispQual), 0.0) * 0.65, 1.0)
    cNum := cNum + subDisp * 16.0 * fvgDispW
    cDen := cDen + 16.0 * fvgDispW
    // 6) premium/discount location — full correct half scores linearly 0..1; neutral 0.5 when no
    //    range exists (so the factor never collapses the average to 0).
    float subPd = 0.5
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float gMid = (gTop + gBot) / 2.0
        float pos  = math.min(1.0, math.max(0.0, (gMid - rngLo) / (rngHi - rngLo)))
        subPd := isBull ? (1.0 - pos) : pos      // bull wants discount (low pos), bear wants premium
    cNum := cNum + subPd * 10.0 * fvgPdW
    cDen := cDen + 10.0 * fvgPdW
    // base scaled so a strong-core gap reaches ~70 (leaving headroom for bonuses up to 100)
    float base = cDen > 0 ? (cNum / cDen) * 70.0 : 0.0
    //
    // --- BONUS points added on top (absent bonuses add nothing — they never penalise) ---
    float bonus = 0.0
    // 3) inside an order block or breaker block
    bool  inBlock = false
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if not na(ot) and not na(ob) and gTop >= ob and gBot <= ot
                inBlock := true
    if showBreaker and array.size(brkTop) > 0
        for bri = 0 to array.size(brkTop) - 1
            float bt = array.get(brkTop, bri)
            float bb = array.get(brkBot, bri)
            if not na(bt) and not na(bb) and gTop >= bb and gBot <= bt
                inBlock := true
    if inBlock
        bonus := bonus + 12.0 * fvgBlockW
    // 4) inversion of a prior opposite gap in the same zone (IFVG)
    bool  isInv = false
    if array.size(invTop) > 0
        for ii = 0 to array.size(invTop) - 1
            if bar_index - array.get(invBar, ii) <= fvgInvBars and array.get(invWasBull, ii) != isBull
                float it = array.get(invTop, ii)
                float ib = array.get(invBot, ii)
                if gTop >= ib and gBot <= it
                    isInv := true
    if isInv
        bonus := bonus + 10.0 * fvgInvW
    // 5) HTF-gap alignment (low timeframes only)
    bool  htfAligned = false
    if htfMode and array.size(htfFvgTop) > 0
        float bestHtf = 0.0
        for hi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, hi)
            float hb = array.get(htfFvgBot, hi)
            if gTop >= hb and gBot <= ht
                htfAligned := true
                float hs = hi < array.size(htfFvgStr) ? array.get(htfFvgStr, hi) : 60.0
                bestHtf := math.max(bestHtf, 0.5 + 0.5 * (nz(hs, 60.0) / 100.0))   // 0.5..1.0
        if htfAligned
            bonus := bonus + bestHtf * 16.0 * fvgHtfW
    // 8) confluence: midpoint near a round number / VWAP / OTE fib
    float gMid2 = (gTop + gBot) / 2.0
    float tolC = math.max(atrF * 0.25, syminfo.mintick)
    bool  conflHit = false
    if confRound > 0
        float nearest = math.round(gMid2 / confRound) * confRound
        if math.abs(gMid2 - nearest) <= tolC
            conflHit := true
    if confVWAP and not na(vwapVal) and math.abs(gMid2 - vwapVal) <= tolC
        conflHit := true
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float rng = rngHi - rngLo
        bool bullLeg = rangeDir >= 0
        float oteA = bullLeg ? (rngHi - pdFib1 * rng) : (rngLo + pdFib1 * rng)
        float oteB = bullLeg ? (rngHi - pdFib2 * rng) : (rngLo + pdFib2 * rng)
        float oteC = bullLeg ? (rngHi - pdFib3 * rng) : (rngLo + pdFib3 * rng)
        if math.abs(gMid2 - oteA) <= tolC or math.abs(gMid2 - oteB) <= tolC or math.abs(gMid2 - oteC) <= tolC
            conflHit := true
    if conflHit
        bonus := bonus + 7.0 * fvgConflW
    // 10) liquidity-pool confluence (graded 0..1 by the most important nearby pool)
    float liqPool = f_gapLiqPool(gTop, gBot, isBull)
    bool  liqAligned = liqPool > 0.0
    bonus := bonus + liqPool * 14.0 * fvgLiqW
    // 11) sweep precedence (SFP -> displacement -> FVG) — chart-TF gaps only
    bool  sweptBefore = false
    if not isHtf
        for sb = 0 to fvgSweepBars
            if (isBull and sfpLong[sb]) or ((not isBull) and sfpShort[sb])
                sweptBefore := true
        if sweptBefore
            bonus := bonus + 10.0 * fvgSweepW
    // formation score = core base + bonuses (capped at 100 before freshness/trap)
    float raw = math.min(base + bonus, 100.0)
    // 9) freshness multiplier — a gap price has already probed is 'used' liquidity, discount it
    float freshMul = 1.0
    if fvgFreshDisc > 0 and f_isTested((gTop + gBot) / 2.0, atrF)
        freshMul := 1.0 - fvgFreshDisc
    // 12) poor-location (trapped) multiplier — opposing structure right in the gap's path cuts
    //     the rank proportional to how walled it is (bullish gap under resistance, etc.).
    float trapMul = 1.0
    if fvgTrapDisc > 0
        float trapped = f_gapTrapped(gTop, gBot, isBull)
        trapMul := 1.0 - fvgTrapDisc * trapped
    int scInt = int(math.min(math.round(raw * freshMul * trapMul), 100))
    [scInt, isInv, inBlock, htfAligned, liqAligned, sweptBefore]

// confluence score for a price band [loB..hiB]
f_confScore(float mid, float loB, float hiB, int members) =>
    float score = 0.0
    string parts = ""
    float tol = math.max(nz(atr) * 0.25, syminfo.mintick)
    score := score + math.min(members, 5) * 12.0
    if members >= 2
        parts := parts + "stack "
    float atrC = math.max(nz(atr), syminfo.mintick)
    // ORDER BLOCK — graded by zone size (displacement leaves bigger blocks) + freshness,
    // instead of a flat flag. Take the STRONGEST overlapping OB (not a sum).
    float obBest = 0.0
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if hiB >= ob and loB <= ot
                float sizeW = math.min((ot - ob) / atrC, 1.5) / 1.5      // 0..1 by zone size vs ATR
                float freshW = 1.0 - math.min(math.max(0.0, bar_index - array.get(obBirth, oi)) / 60.0, 1.0)  // 1 fresh -> 0 old
                float obStr = 12.0 + sizeW * 10.0 + freshW * 4.0          // 12 .. 26
                obBest := math.max(obBest, obStr)
    if obBest > 0
        score := score + obBest
        parts := parts + (obBest >= 20.0 ? "OB+ " : "OB ")
    // FAIR VALUE GAP — folded into confluence, now graded by each gap's STRENGTH score
    // (size + creation volume + inside OB/breaker + inversion), not just raw gap size, so a
    // strong gap in a block / an IFVG adds far more weight than a trivial imbalance. Take the
    // strongest overlapping gap. Falls back to gap-size grading if strength wasn't stored.
    float fvgBest = 0.0
    if array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if hiB >= fb and loB <= ft
                float sStr = fi < array.size(fvgStr) ? array.get(fvgStr, fi) : na
                float strW = na(sStr) ? math.min(math.abs(ft - fb) / atrC, 1.0) : sStr / 100.0   // 0..1
                float fvgPts = 8.0 + strW * 14.0                           // 8 .. 22
                fvgBest := math.max(fvgBest, fvgPts)
    // HTF fair value gaps — same overlap grading, but a higher weight ceiling because an
    // HTF gap is a far stronger magnet than any chart-TF gap. Box-less, read from floats.
    if htfFvgOn and array.size(htfFvgTop) > 0
        for hi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, hi)
            float hb = array.get(htfFvgBot, hi)
            if hiB >= hb and loB <= ht
                float sStr = hi < array.size(htfFvgStr) ? array.get(htfFvgStr, hi) : na
                float strW = na(sStr) ? math.min(math.abs(ht - hb) / atrC, 1.0) : sStr / 100.0
                float htfPts = 12.0 + strW * 18.0                          // 12 .. 30 (above chart-TF ceiling)
                fvgBest := math.max(fvgBest, htfPts)
    if fvgBest > 0
        score := score + fvgBest
        parts := parts + (fvgBest >= 16.0 ? "FVG+ " : "FVG ")
    // OTE fib proximity + premium/discount extreme (from the live dealing range).
    // Computed internally for scoring only - the P/D fibs are NOT drawn on chart.
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float rng = rngHi - rngLo
        bool bullLeg = rangeDir >= 0
        f1 = bullLeg ? (rngHi - pdFib1 * rng) : (rngLo + pdFib1 * rng)
        f2 = bullLeg ? (rngHi - pdFib2 * rng) : (rngLo + pdFib2 * rng)
        f3 = bullLeg ? (rngHi - pdFib3 * rng) : (rngLo + pdFib3 * rng)
        bool fibHit = (math.abs(mid - f1) <= tol) or (math.abs(mid - f2) <= tol) or (math.abs(mid - f3) <= tol)
        if fibHit
            score := score + 18.0
            parts := parts + "OTE "
        float pos = (mid - rngLo) / rng
        if pos >= 0.75 or pos <= 0.25
            score := score + 8.0
            parts := parts + (pos >= 0.75 ? "prem " : "disc ")
    if confRound > 0
        float nearest = math.round(mid / confRound) * confRound
        if math.abs(mid - nearest) <= tol
            score := score + 10.0
            parts := parts + "round "
    // VWAP proximity — a defended fair-value reference (scoring factor only)
    if confVWAP and not na(vwapVal) and math.abs(mid - vwapVal) <= tol
        score := score + 10.0
        parts := parts + "VWAP "
    // breaker block overlap — flipped OB, strong reaction zone
    if showBreaker and array.size(brkTop) > 0
        bool brkHit = false
        for bri = 0 to array.size(brkTop) - 1
            if hiB >= array.get(brkBot, bri) and loB <= array.get(brkTop, bri)
                brkHit := true
        if brkHit
            score := score + 14.0
            parts := parts + "brk "
    int s = int(math.min(math.round(score), 100))
    [s, parts]

// ---- per-level DOL pull + magnet-quality (accuracy pass) ----
// Two scores are produced from the same weights:
//   • pull  = distance-decay(#2) × type × age × freshness(#3) × confluence(#1)
//             — proximity dominates. Drives the DOL arrow/bias and the 🎯 magnet.
//   • qual  = type × age × freshness × confluence  (distance REMOVED)
//             — "how strong a magnet is this for its distance". Drives the
//             per-level confidence % in Magnet-quality mode, so a far but heavy
//             pool can out-score a near lone level.
// f_pull returns [pull, qual]; callers pick which to display.
f_pull(float pk, string nk, int bk, float sensK, float atrU) =>
    float dist = math.abs(pk - close)
    // sharper decay so the NEAREST pool dominates (dolNearBias raises the exponent)
    float distW = math.pow(1.0 / (1.0 + sensK * (dist / atrU)), 1.0 + dolNearBias)
    // type weight — EQ (engineered liquidity) now ranks at the TOP with monthly/HTF
    float typeW = 1.0
    if dolUseType
        if str.contains(nk, "rEQ")
            typeW := 1.7                 // relative (near) equal H/L — softer than exact EQ
        else if str.contains(nk, "EQ")
            typeW := 2.4                 // exact equal H/L — engineered liquidity, top
        else if str.contains(nk, "PMH") or str.contains(nk, "PML")
            typeW := 2.2
        else if str.contains(nk, "POC")
            typeW := 2.1                 // volume point of control — heavy acceptance
        else if str.contains(nk, "PWH") or str.contains(nk, "PWL")
            typeW := 1.9
        else if str.contains(nk, "M.Open") or str.contains(nk, "W.Open")
            typeW := 1.8                 // monthly / weekly opens — institutional refs
        else if str.contains(nk, "VAH") or str.contains(nk, "VAL")
            typeW := 1.7                 // value-area edges
        else if str.contains(nk, "Breaker")
            typeW := 1.7                 // flipped OB — strong reaction zone
        else if str.contains(nk, "PDH") or str.contains(nk, "PDL")
            typeW := 1.6
        else if str.contains(nk, "Midnight")
            typeW := 1.4                 // NY midnight open
        else if str.contains(nk, "London") or str.contains(nk, "NY") or str.contains(nk, "Asia")
            typeW := 1.2
        typeW := 1.0 + (typeW - 1.0) * sensK
    // age
    float ageW = 1.0
    if dolUseAge and not na(bk)
        float ageBars = math.max(0.0, bar_index - bk)
        ageW := 1.0 + math.min(1.0, math.log(1.0 + ageBars) / 6.0) * sensK
    // freshness — discount a level price is currently sitting right on (being tested)
    float freshW = 1.0
    if dolFreshW
        freshW := dist < atrU * 0.15 ? 0.6 : 1.0
    // confluence weight — a level's own confluence score amplifies its pull
    float confW = 1.0
    if dolConfW
        [cs, cp] = f_confScore(pk, pk - atrU * 0.05, pk + atrU * 0.05, 1)
        confW := 1.0 + cs / 100.0    // 1.0 .. 2.0
    // tested discount — a level already probed is a slightly weaker magnet
    float testW = 1.0
    if testDiscount and f_isTested(pk, atrU)
        testW := 1.0 - testDiscAmt
    float qual = typeW * ageW * freshW * confW * testW   // distance-neutral magnet quality
    float pull = distW * qual                             // proximity-weighted gravity
    [pull, qual]


// ---- projection helpers (reuse OB/FVG/level state; no new data feeds) ----
// Path-clearance: 0..100 for how UNOBSTRUCTED the route from price -> target is.
// Every opposing order block / FVG / strong level strictly between the two prices
// is an obstacle that cuts the score. A clear runway ≈ 100; a blocked path ≈ low.
f_pathClear(float fromP, float toP, float atrU) =>
    float lo = math.min(fromP, toP)
    float hi = math.max(fromP, toP)
    float pad = atrU * 0.05
    int obstacles = 0            // count shown in the banner
    float severity = 0.0         // strength-weighted obstacle load that actually cuts clearance
    // order blocks whose zone falls between price and target (full-weight structural walls)
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if ot >= lo - pad and ob <= hi + pad and not (ot >= hi and ob >= hi) and not (ot <= lo and ob <= lo)
                obstacles := obstacles + 1
                severity  := severity + 1.0
    // fair value gaps between price and target — a STRONG gap walls the path harder than a
    // trivial one, so each gap's severity scales with its strength score (0.2..1.0).
    if array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if ft >= lo - pad and fb <= hi + pad
                float sStr = fi < array.size(fvgStr) ? array.get(fvgStr, fi) : na
                float w = na(sStr) ? 1.0 : (0.2 + 0.8 * (sStr / 100.0))
                obstacles := obstacles + 1
                severity  := severity + w
    // HTF gaps between price and target wall the path harder (0.4..1.4 severity).
    if htfFvgOn and array.size(htfFvgTop) > 0
        for gi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, gi)
            float hb = array.get(htfFvgBot, gi)
            if ht >= lo - pad and hb <= hi + pad
                float sStr = gi < array.size(htfFvgStr) ? array.get(htfFvgStr, gi) : na
                float w = na(sStr) ? 1.4 : (0.4 + 1.0 * (sStr / 100.0))
                obstacles := obstacles + 1
                severity  := severity + w
    float clr = 100.0 * math.pow(0.72, projClearW * severity)
    [math.round(clr), obstacles]

// ETA to a target price from recent velocity (independent of the countdown toggle so the
// projETA switch works on its own). Formats per the Countdown units setting.
f_eta(float target) =>
    string outTxt = ""
    if nz(velocity) > 0 and not na(target)
        float bars = math.abs(target - close) / velocity
        if cdMode == "Bars"
            outTxt := " ⏱≈" + str.tostring(math.round(bars)) + "b"
        else
            float secs = bars * secPerBar
            outTxt := secs < 3600 ? (" ⏱≈" + str.tostring(math.round(secs / 60)) + "m") : (secs < 86400 ? (" ⏱≈" + str.tostring(math.round(secs / 3600)) + "h") : (" ⏱≈" + str.tostring(math.round(secs / 86400)) + "d"))
    outTxt

// Confidence momentum: remember each level's confidence % keyed by rounded price so we
// can show ▲/▼ vs the previous bar. Two maps: *_prev is last bar's snapshot (read from),
// *_now is this bar's fresh values (written to); they swap at the end of the last-bar block.
var cm_keysPrev = array.new<float>()
var cm_valsPrev = array.new<float>()
var cm_keysNow  = array.new<float>()
var cm_valsNow  = array.new<float>()
f_cmKey(float p, float atrU) =>
    math.round(p / math.max(atrU * 0.1, syminfo.mintick))
f_cmPrev(float p, float atrU) =>
    float k = f_cmKey(p, atrU)
    float found = na
    if array.size(cm_keysPrev) > 0
        for ci = 0 to array.size(cm_keysPrev) - 1
            if array.get(cm_keysPrev, ci) == k
                found := array.get(cm_valsPrev, ci)
    found
f_cmStore(float p, float atrU, float confPct) =>
    array.push(cm_keysNow, f_cmKey(p, atrU))
    array.push(cm_valsNow, confPct)
    0

// Stacked agreement: does a price band overlap an order block OR an FVG?
f_hasOBFVG(float loB, float hiB) =>
    bool hit = false
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            if hiB >= array.get(obBot, oi) and loB <= array.get(obTop, oi)
                hit := true
    // only a reasonably strong gap counts toward stacked agreement — a trivial imbalance
    // shouldn't fire the high-conviction ⭐ flag.
    if not hit and array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            float sStr = fi < array.size(fvgStr) ? array.get(fvgStr, fi) : na
            bool strongEnough = na(sStr) or not fvgFilterOn or sStr >= fvgMinStr
            if hiB >= fb and loB <= ft and strongEnough
                hit := true
    // an HTF gap overlapping the band also counts toward stacked agreement
    if not hit and htfFvgOn and array.size(htfFvgTop) > 0
        for hi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, hi)
            float hb = array.get(htfFvgBot, hi)
            if hiB >= hb and loB <= ht
                hit := true
    hit

// ---- DOL flip stability state (persists across bars) ----
// Committed arrow direction from the last decision: +1 = UP (BSL draw), -1 = DOWN (SSL draw).
// The deadband + hysteresis logic below only mutates this when the opposing side wins
// decisively (bias clears the deadband), so the arrow holds through near-50/50 noise.
var float dm_dirState = 1.0

// ---- DOL gravity tally + shared direction (last bar) ----
if barstate.islast
    f_clearPools()
    array.clear(lv_price)
    array.clear(lv_name)
    array.clear(lv_col)
    array.clear(lv_emo)
    array.clear(lv_birth)
    array.clear(lv_side)
    array.clear(lv_pull)
    array.clear(lv_qual)
    array.clear(lv_inwin)
    array.clear(lv_nomag)
    array.clear(lv_primary)
    array.clear(cm_keysNow)          // fresh confidence-momentum snapshot this bar
    array.clear(cm_valsNow)

    f_addLevel(showPDHL, pdhM,   "PDH",     colBull, emoPrev, b_pdh,  1)
    f_addLevel(showPDHL, pdlM,   "PDL",     colBear, emoPrev, b_pdl, -1)
    f_addLevel(showPWHL, pwhM,   "PWH",     colBull, emoPrev, b_pwh,  1)
    f_addLevel(showPWHL, pwlM,   "PWL",     colBear, emoPrev, b_pwl, -1)
    f_addLevel(showPMHL, pmhM,   "PMH",     colBull, emoPrev, b_pmh,  1)
    f_addLevel(showPMHL, pmlM,   "PML",     colBear, emoPrev, b_pml, -1)
    f_addLevel(showDO,   dOpen,  "D.Open",  colSess, emoPrev, b_do,   0)
    f_addLevel(showWO,   wOpen,  "W.Open",  colSess, emoPrev, b_wo,   0)
    f_addLevel(showMO,   mOpen,  "M.Open",  colSess, emoPrev, b_mo,   0)
    f_addLevel(showMidO, midO,   "Midnight",colSess, emoPrev, b_mid,  0)
    f_addLevelM(showAsia, asiaH,  f_sessName("Asia H", asiaHc),   colSess, emoSess, b_ah,   1, projLiveSess and asiaHf)
    f_addLevelM(showAsia, asiaL,  f_sessName("Asia L", asiaLc),   colSess, emoSess, b_al,  -1, projLiveSess and asiaLf)
    f_addLevelM(showLond, londH,  f_sessName("London H", londHc), colSess, emoSess, b_lh,   1, projLiveSess and londHf)
    f_addLevelM(showLond, londL,  f_sessName("London L", londLc), colSess, emoSess, b_ll,  -1, projLiveSess and londLf)
    f_addLevelM(showNY,   nyH,    f_sessName("NY H", nyHc),       colSess, emoSess, b_nh,   1, projLiveSess and nyHf)
    f_addLevelM(showNY,   nyL,    f_sessName("NY L", nyLc),       colSess, emoSess, b_nl,  -1, projLiveSess and nyLf)
    if showSwing
        if array.size(swHi) > 0
            for si = 0 to array.size(swHi) - 1
                f_addLevel(true, array.get(swHi, si), "BSL", colBull, emoLiq, array.get(swHiB, si), 1)
        if array.size(swLo) > 0
            for si = 0 to array.size(swLo) - 1
                f_addLevel(true, array.get(swLo, si), "SSL", colBear, emoLiq, array.get(swLoB, si), -1)
    if showEQ
        if array.size(eqHiA) > 0
            for ei = 0 to array.size(eqHiA) - 1
                f_addLevel(true, array.get(eqHiA, ei), "EQH", colBull, emoLiq, array.get(eqHiB, ei), 1)
        if array.size(eqLoA) > 0
            for ei = 0 to array.size(eqLoA) - 1
                f_addLevel(true, array.get(eqLoA, ei), "EQL", colBear, emoLiq, array.get(eqLoB, ei), -1)
    if showEQ and showRelEQ
        if array.size(reqHiA) > 0
            for ei = 0 to array.size(reqHiA) - 1
                f_addLevel(true, array.get(reqHiA, ei), "rEQH", colBull, emoLiq, array.get(reqHiB, ei), 1)
        if array.size(reqLoA) > 0
            for ei = 0 to array.size(reqLoA) - 1
                f_addLevel(true, array.get(reqLoA, ei), "rEQL", colBear, emoLiq, array.get(reqLoB, ei), -1)
    if showBreaker and array.size(brkTop) > 0
        for bri = 0 to array.size(brkTop) - 1
            float bmid = (array.get(brkTop, bri) + array.get(brkBot, bri)) / 2.0
            bool  bbl  = array.get(brkBull, bri)
            f_addLevel(true, bmid, bbl ? "Breaker▲" : "Breaker▼", bbl ? colBull : colBear, emoLiq, array.get(brkBirth, bri), bbl ? 1 : -1)
    if showVP
        f_addLevel(not na(vpPOC), vpPOC, "POC", colZone, emoPrev, na, 0)
        f_addLevel(not na(vpVAH), vpVAH, "VAH", colZone, emoPrev, na, 1)
        f_addLevel(not na(vpVAL), vpVAL, "VAL", colZone, emoPrev, na, -1)

    // ---- DOL gravity: pull = distance x type x age, per side ----
    float bslStrength = 0.0
    float sslStrength = 0.0
    float bslTopPull  = 0.0
    float sslTopPull  = 0.0
    float bslTopPrice = na
    float sslTopPrice = na
    int nl = array.size(lv_price)
    float totalPull = 0.0
    float totalQual = 0.0
    if nl > 0
        float sensK = dolSens == "High" ? 2.0 : dolSens == "Low" ? 0.5 : 1.0
        float atrU  = math.max(nz(atr), syminfo.mintick)
        // pass 1: pull/qual per level + DOL bias & 🎯 magnet.
        // Excluded levels (forming session extreme, or hugging price under the distance
        // floor) still DRAW but contribute zero pull/qual — they take no magnet, no bias
        // tilt, and no confidence %, so a level price is sitting on can't inflate the score.
        for k = 0 to nl - 1
            float pk = array.get(lv_price, k)
            string nk = array.get(lv_name, k)
            int   bk = array.get(lv_birth, k)
            bool  floorHit = projDistFloor and projDistFloorATR > 0 and (math.abs(pk - close) < projDistFloorATR * atrU)
            bool  excl = array.get(lv_nomag, k) or floorHit
            array.set(lv_nomag, k, excl)   // fold the dynamic floor in so pass 2 + render can read it
            [rawPull, rawQual] = f_pull(pk, nk, bk, sensK, atrU)
            float pull = excl ? 0.0 : rawPull
            float qual = excl ? 0.0 : rawQual
            array.push(lv_pull, pull)
            array.push(lv_qual, qual)
            array.push(lv_inwin, false)
            array.push(lv_primary, false)
            if not excl
                if pk >= close
                    bslStrength := bslStrength + pull
                    if pull > bslTopPull
                        bslTopPull  := pull
                        bslTopPrice := pk
                else
                    sslStrength := sslStrength + pull
                    if pull > sslTopPull
                        sslTopPull  := pull
                        sslTopPrice := pk
        // pass 2: confidence window — mark the N nearest levels ABOVE and N BELOW price.
        // A level is in-window if fewer than N same-side levels sit strictly nearer to price.
        for k = 0 to nl - 1
            // excluded levels take no window slot and don't crowd out real levels
            if not array.get(lv_nomag, k)
                float pk = array.get(lv_price, k)
                bool  above = pk >= close
                float dk = math.abs(pk - close)
                int nearer = 0
                for j = 0 to nl - 1
                    if j != k and not array.get(lv_nomag, j)
                        float pj = array.get(lv_price, j)
                        bool  aboveJ = pj >= close
                        if aboveJ == above and math.abs(pj - close) < dk
                            nearer := nearer + 1
                if nearer < eConfWin
                    array.set(lv_inwin, k, true)
                    totalPull := totalPull + array.get(lv_pull, k)
                    totalQual := totalQual + array.get(lv_qual, k)
        // pass 2b: declutter rank — mark the Top-N by confidence on each side as PRIMARY
        // (bold). A level is primary if fewer than eTopN same-side levels have higher
        // confidence. Below-Top-N or below the gate levels are drawn faintly at render.
        bool useQualR = lvlConfMode == "Magnet quality"
        for k = 0 to nl - 1
            if not array.get(lv_nomag, k)
                float pk = array.get(lv_price, k)
                bool  above = pk >= close
                float ck = useQualR ? array.get(lv_qual, k) : array.get(lv_pull, k)
                int stronger = 0
                for j = 0 to nl - 1
                    if j != k and not array.get(lv_nomag, j)
                        float pj = array.get(lv_price, j)
                        bool  aboveJ = pj >= close
                        float cj = useQualR ? array.get(lv_qual, j) : array.get(lv_pull, j)
                        if aboveJ == above and cj > ck
                            stronger := stronger + 1
                if stronger < eTopN
                    array.set(lv_primary, k, true)

    // ---- landscape cap: stop ONE hugging level from dominating its side ----
    // Distance decay makes the nearest level's pull huge, so a single level price is sitting
    // next to can out-weigh a whole cluster on the other side and flip the bias. Clamp each
    // level's contribution to biasCap × its side's raw total, so the bias reflects the mass /
    // cluster of levels (the liquidity landscape) rather than one proximity outlier.
    // The 🎯 magnet (bslTopPull/sslTopPull) is untouched — proximity read stays available.
    if biasCap < 1.0 and nl > 0
        float bslCapAbs = bslStrength * biasCap
        float sslCapAbs = sslStrength * biasCap
        float bslCapped = 0.0
        float sslCapped = 0.0
        for k = 0 to nl - 1
            if not array.get(lv_nomag, k)
                float pk2 = array.get(lv_price, k)
                float p2  = array.get(lv_pull, k)
                if pk2 >= close
                    bslCapped := bslCapped + math.min(p2, bslCapAbs)
                else
                    sslCapped := sslCapped + math.min(p2, sslCapAbs)
        bslStrength := bslCapped
        sslStrength := sslCapped

    // ---- resistance-adjusted (clearance-weighted) draw ----
    // Each side's EFFECTIVE pull = raw draw × how clear the path to that side's magnet is.
    // Structure in the way (OBs / FVGs) discounts a side; it never adds to the other side.
    float atrR   = math.max(nz(atr), syminfo.mintick)
    float upClr  = 100.0
    float dnClr  = 100.0
    if projResist
        if not na(bslTopPrice)
            [uc, uo] = f_pathClear(close, bslTopPrice, atrR)
            upClr := uc
        if not na(sslTopPrice)
            [dc, doo] = f_pathClear(close, sslTopPrice, atrR)
            dnClr := dc
    float bslEff = bslStrength * (projResist ? upClr / 100.0 : 1.0)
    float sslEff = sslStrength * (projResist ? dnClr / 100.0 : 1.0)

    float dm_totalG = bslEff + sslEff
    float dm_liqBias = dm_totalG > 0 ? (bslEff - sslEff) / dm_totalG : 0.0
    float dm_bias = (1.0 - dolMomWt / 100.0) * dm_liqBias + (dolMomWt / 100.0) * dolMom
    // ---- deadband + hysteresis: only flip when the opposing side wins DECISIVELY ----
    // Legacy behaviour flipped the arrow the instant dm_bias crossed exactly 0, so distance
    // decay, the hard distance-floor cut, discrete path-clearance steps and live momentum all
    // whipsawed the direction as price approached a key level. Here the committed direction
    // (dm_dirState, +1 up / -1 down) is held UNLESS the bias clears the deadband on the OTHER
    // side: an UP arrow only turns DOWN once dm_bias < -dolDeadband, and vice-versa. Inside
    // [-dolDeadband, +dolDeadband] the prior direction persists. When "confirm on bar close"
    // is on, the flip is only committed on a closed bar; intrabar we surface a "turning" hint
    // but keep the committed direction so a single spike through a level can't flip the read.
    bool  dm_turning = false
    if dolStable
        float band = dolDeadband
        bool  wantUp   = dm_bias >  band      // BSL decisively ahead
        bool  wantDown = dm_bias < -band      // SSL decisively ahead
        bool  crossUp   = wantUp   and dm_dirState < 0    // currently DOWN, bias says flip UP
        bool  crossDown = wantDown and dm_dirState > 0    // currently UP,   bias says flip DOWN
        bool  canCommit = (not dolFlipConfirm) or barstate.isconfirmed
        if (crossUp or crossDown) and canCommit
            dm_dirState := crossUp ? 1.0 : -1.0
        else if crossUp or crossDown
            // deadband cleared but waiting on bar close to confirm — flag the pending turn
            dm_turning := true
    else
        // legacy: instant flip at zero, no memory
        dm_dirState := dm_bias >= 0 ? 1.0 : -1.0
    bool  dolDrawUp = dm_dirState >= 0
    float dolTgt = dolDrawUp ? bslTopPrice : sslTopPrice
    // single MOST-LIKELY target = the level with the greatest pull overall
    float topPullPrice = bslTopPull >= sslTopPull ? bslTopPrice : sslTopPrice

    // ---- sort + cluster + render ----
    int n = array.size(lv_price)
    if n > 0
        idx = array.new<int>()
        for i = 0 to n - 1
            array.push(idx, i)
        int idxN = array.size(idx)
        if idxN > 1
            for i = 1 to idxN - 1
                int keyIdx = array.get(idx, i)
                float keyVal = array.get(lv_price, keyIdx)
                int j = i - 1
                while j >= 0 and array.get(lv_price, array.get(idx, j)) > keyVal
                    array.set(idx, j + 1, array.get(idx, j))
                    j := j - 1
                array.set(idx, j + 1, keyIdx)

        float mergeDist = nz(atr) * clustDist
        int gi = 0
        while gi < idxN
            int startI = gi
            float sumP = array.get(lv_price, array.get(idx, gi))
            float minP = sumP
            float maxP = sumP
            int members = 1
            string names = array.get(lv_name, array.get(idx, gi))
            int oldestBirth = array.get(lv_birth, array.get(idx, gi))
            int sideSum = array.get(lv_side, array.get(idx, gi))
            // accumulate only IN-WINDOW members' pull/qual so the zone % matches the windowed normalization
            bool  zInWin  = array.get(lv_inwin, array.get(idx, gi))
            bool  zPrimary = array.get(lv_primary, array.get(idx, gi))   // declutter: any Top-N member?
            float sumPull = zInWin ? array.get(lv_pull, array.get(idx, gi)) : 0.0
            float sumQual = zInWin ? array.get(lv_qual, array.get(idx, gi)) : 0.0
            while clusterOn and gi + 1 < idxN and (array.get(lv_price, array.get(idx, gi + 1)) - array.get(lv_price, array.get(idx, gi))) <= mergeDist
                gi := gi + 1
                float p = array.get(lv_price, array.get(idx, gi))
                sumP := sumP + p
                minP := math.min(minP, p)
                maxP := math.max(maxP, p)
                members := members + 1
                names := names + "·" + array.get(lv_name, array.get(idx, gi))
                int mb = array.get(lv_birth, array.get(idx, gi))
                oldestBirth := na(oldestBirth) ? mb : (na(mb) ? oldestBirth : math.min(oldestBirth, mb))
                sideSum := sideSum + array.get(lv_side, array.get(idx, gi))
                if array.get(lv_primary, array.get(idx, gi))
                    zPrimary := true
                if array.get(lv_inwin, array.get(idx, gi))
                    zInWin  := true
                    sumPull := sumPull + array.get(lv_pull, array.get(idx, gi))
                    sumQual := sumQual + array.get(lv_qual, array.get(idx, gi))

            int ext = f_extLen(oldestBirth)
            bool drawGroup = members >= minStrength
            if drawGroup and members == 1
                float p = array.get(lv_price, array.get(idx, startI))
                int  sd = array.get(lv_side, array.get(idx, startI))
                color c = f_sideColI(sd, p, array.get(lv_col, array.get(idx, startI)))
                string emo = sideColorOn ? f_sideEmojiI(sd, p) : array.get(lv_emo, array.get(idx, startI))
                string tier = tieredEmoji ? (f_tierEmoji(1) + " ") : ""
                // per-level confidence % — Magnet quality (distance removed) or Raw pull share.
                // Only levels inside the N-nearest-each-side window get a %.
                bool useQual = lvlConfMode == "Magnet quality"
                bool lInWin = array.get(lv_inwin, array.get(idx, startI))
                float lpNum = useQual ? array.get(lv_qual, array.get(idx, startI)) : array.get(lv_pull, array.get(idx, startI))
                float lpDen = useQual ? totalQual : totalPull
                float lp = lpDen > 0 ? lpNum / lpDen * 100.0 : 0.0
                bool isTop = not na(topPullPrice) and math.abs(p - topPullPrice) <= syminfo.mintick
                float atrUt = math.max(nz(atr), syminfo.mintick)
                // confidence momentum ▲/▼ vs previous bar (feature 4)
                string momTag = ""
                if projConfMom and showLvlConf and lInWin
                    float prevC = f_cmPrev(p, atrUt)
                    momTag := na(prevC) ? "" : (lp > prevC + 0.5 ? " ▲" : (lp < prevC - 0.5 ? " ▼" : " ="))
                    f_cmStore(p, atrUt, lp)
                // stacked-agreement ⭐: DOL-side agrees + it's the magnet + overlaps OB/FVG (feature 8)
                bool sideAgree = (dolDrawUp and p >= close) or (not dolDrawUp and p < close)
                string stackTag = (projStacked and lInWin and isTop and sideAgree and f_hasOBFVG(p - atrUt * 0.05, p + atrUt * 0.05)) ? " ⭐" : ""
                // tested/virgin: probed levels get a ✓ + dotted, dimmed line (still standing, just 'used')
                bool lTested = f_isTested(p, atrUt)
                // live level-reaction gauge (reject vs sweep) — only while price is at/near the level
                string lvlGaugeTag = ""
                if lvlRejGauge and lInWin
                    [lgActive, lgLean] = f_lvlGauge(p, array.get(lv_name, array.get(idx, startI)), lTested, 0.4, atrUt)
                    if lgActive
                        lvlGaugeTag := lgLean >= 50 ? (" ⟲" + str.tostring(lgLean)) : (" ⇥" + str.tostring(lgLean))
                string confLvlTag = (showLvlConf and lInWin) ? ((isTop ? " 🎯" : " ") + str.tostring(math.round(lp)) + "%" + momTag + stackTag + lvlGaugeTag) : ""
                string testTag = (showTested and lTested) ? " ✓" : ""
                // declutter: faint if de-prioritised (beyond Top-N) or below the confidence gate
                bool lPrimary = array.get(lv_primary, array.get(idx, startI))
                // bias-aligned: fade levels on the side price is NOT being drawn toward
                bool lCounterBias = biasFadeLvls and biasOn and dayBias != 0 and (dayBias > 0 ? p < close : p > close)
                bool lFaint = (densOn and (not lPrimary or (lInWin and lp < eGate))) or lCounterBias
                color cLine = lFaint ? color.new(c, densFadeOp) : ((showTested and lTested) ? color.new(c, 55) : c)
                string lStyle = (lFaint or (showTested and lTested)) ? line.style_dotted : f_lineStyle()
                // faint levels shed their tags to a bare price so they recede into the background
                string full = lFaint ? (array.get(lv_name, array.get(idx, startI)) + " " + str.tostring(p, format.mintick)) : (tier + (emo == "None" ? "" : emo + " ") + array.get(lv_name, array.get(idx, startI)) + " " + str.tostring(p, format.mintick) + confLvlTag + testTag + f_countdown(p))
                line ln = line.new(bar_index, p, bar_index + ext, p, color = cLine, width = lineWidth, style = lStyle)
                color soloBg  = lFaint ? color.new(c, densFadeOp) : (outlineTags ? c : color.new(c, 85))
                color soloTxt = lFaint ? color.new(c, math.max(densFadeOp - 30, 0)) : (outlineTags ? clustLblTxt : c)
                label lb = label.new(bar_index + ext, p, full, style = label.style_label_left, color = soloBg, textcolor = soloTxt, size = f_labelSize())
                array.push(pool_lines, ln)
                array.push(pool_labels, lb)
            else if drawGroup
                float mid = sumP / members
                float t = math.min((members - 1) / 4.0, 1.0)
                int op = int(zoneOpacityMin + (zoneOpacityMax - zoneOpacityMin) * t)
                float pad = math.max(maxP - minP, nz(atr) * 0.08) / 2.0
                int domSide = sideSum > 0 ? 1 : sideSum < 0 ? -1 : 0
                color zbase = f_sideColI(domSide, mid, colZone)
                string sideTag = (showSideTag and sideColorOn) ? f_sideTagI(domSide, mid) : ""
                [confS, confParts] = f_confScore(mid, minP, maxP, members)
                if not showConf or confS >= confMin
                    float heatT = showConf ? math.min(confS / 100.0, 1.0) : 0.0
                    color zoneFillBase = color.from_gradient(heatT, 0.0, 1.0, zbase, color.new(#ffb300, 0))
                    int   heatOp = int(op - op * 0.45 * heatT)
                    color zoneFill = color.new(zoneFillBase, math.max(heatOp, 0))
                    color zoneBorder = color.from_gradient(heatT, 0.0, 1.0, color.new(zbase, 25), color.new(#ffb300, 10))
                    box bx = box.new(bar_index, mid + pad, bar_index + ext, mid - pad, border_color = zoneBorder, border_width = lineWidth, bgcolor = zoneFill)
                    string strength = showStrengthEmoji ? (f_repeat(f_sideEmojiI(domSide, mid), members) + " x" + str.tostring(members)) : ("x" + str.tostring(members))
                    string tier = tieredEmoji ? (f_tierEmoji(members) + " ") : ""
                    string confTag = showConf ? ("  ⭐" + str.tostring(confS) + (confParts == "" ? "" : " [" + confParts + "]")) : ""
                    // per-zone target-likelihood — Magnet quality (distance removed) or Raw pull share.
                    // Only zones with a member inside the N-nearest-each-side window get a %.
                    bool zUseQual = lvlConfMode == "Magnet quality"
                    float zNum = zUseQual ? sumQual : sumPull
                    float zDen = zUseQual ? totalQual : totalPull
                    float zPull = zDen > 0 ? zNum / zDen * 100.0 : 0.0
                    bool zTop = not na(topPullPrice) and topPullPrice >= minP - pad and topPullPrice <= maxP + pad
                    float atrUz = math.max(nz(atr), syminfo.mintick)
                    // confidence momentum ▲/▼ vs previous bar (feature 4)
                    string zMomTag = ""
                    if projConfMom and showLvlConf and zInWin
                        float zPrevC = f_cmPrev(mid, atrUz)
                        zMomTag := na(zPrevC) ? "" : (zPull > zPrevC + 0.5 ? " ▲" : (zPull < zPrevC - 0.5 ? " ▼" : " ="))
                        f_cmStore(mid, atrUz, zPull)
                    // stacked-agreement ⭐: DOL-side agrees + it's the magnet + zone overlaps OB/FVG (feature 8)
                    bool zSideAgree = (dolDrawUp and mid >= close) or (not dolDrawUp and mid < close)
                    string zStackTag = (projStacked and zInWin and zTop and zSideAgree and f_hasOBFVG(minP - pad, maxP + pad)) ? " ⭐" : ""
                    // tested/virgin zone: dashed hollow border + ✓ when price has probed the zone
                    bool zTested = showTested and (f_isTested(mid, atrUz) or f_isTested(minP, atrUz) or f_isTested(maxP, atrUz))
                    // live level-reaction gauge (reject vs sweep) for the zone, using its confluence score
                    string zGaugeTag = ""
                    if lvlRejGauge and zInWin
                        [zgActive, zgLean] = f_lvlGauge(mid, names, zTested, math.min(confS / 100.0, 1.0), atrUz)
                        if zgActive
                            zGaugeTag := zgLean >= 50 ? (" ⟲" + str.tostring(zgLean)) : (" ⇥" + str.tostring(zgLean))
                    string lvlConfTag = (showLvlConf and zInWin) ? ((zTop ? "  🎯" : "  →") + str.tostring(math.round(zPull)) + "%" + zMomTag + zStackTag + zGaugeTag) : ""
                    if zTested
                        box.set_border_style(bx, line.style_dashed)
                        box.set_bgcolor(bx, color.new(zbase, 92))
                    string testTagZ = zTested ? "  ✓" : ""
                    // declutter: faint zone if no Top-N member OR below the confidence gate
                    bool zCounterBias = biasFadeLvls and biasOn and dayBias != 0 and (dayBias > 0 ? mid < close : mid > close)
                    bool zFaint = (densOn and (not zPrimary or (zInWin and zPull < eGate))) or zCounterBias
                    if zFaint
                        box.set_border_style(bx, line.style_dotted)
                        box.set_border_color(bx, color.new(zbase, densFadeOp))
                        box.set_bgcolor(bx, color.new(zbase, math.max(densFadeOp, 90)))
                    string full = zFaint ? (names + "  " + str.tostring(mid, format.mintick)) : (tier + strength + (sideTag == "" ? "" : " " + sideTag) + "  " + names + "  " + str.tostring(mid, format.mintick) + confTag + lvlConfTag + testTagZ + f_countdown(mid))
                    color lblBg  = zFaint ? color.new(zbase, densFadeOp) : (outlineTags ? zbase : color.new(#1e222d, 10))
                    color lblTxt = zFaint ? color.new(zbase, math.max(densFadeOp - 30, 0)) : clustLblTxt
                    label lb = label.new(bar_index + ext, mid, full, style = label.style_label_left, color = lblBg, textcolor = lblTxt, size = zFaint ? size.tiny : f_strongSize(members))
                    array.push(pool_boxes, bx)
                    array.push(pool_labels, lb)
            gi := gi + 1

    // ---- Order block boxes (last bar) ----
    f_clearXtra()
    if masterOn and showOB and array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            bool bull = array.get(obBull, oi)
            color oc  = bull ? obColBull : obColBear
            int   ob0 = array.get(obBirth, oi)
            float obT = array.get(obTop, oi)
            float obB = array.get(obBot, oi)
            if not na(obT) and not na(obB)
                box obx = box.new(f_clampBar(ob0), obT, bar_index + extendR, obB, border_color = color.new(bull ? obColBull : obColBear, 20), border_width = 1, bgcolor = oc)
                array.push(xtra_boxes, obx)
                label olb = label.new(bar_index + extendR, (obT + obB) / 2.0, bull ? "OB▲ demand" : "OB▼ supply", style = label.style_label_left, color = color.new(bull ? obColBull : obColBear, 30), textcolor = color.white, size = size.tiny)
                array.push(xtra_labels, olb)

    // confidence-momentum: snapshot this bar's values into *_prev for next bar's ▲/▼
    array.clear(cm_keysPrev)
    array.clear(cm_valsPrev)
    if array.size(cm_keysNow) > 0
        for ci = 0 to array.size(cm_keysNow) - 1
            array.push(cm_keysPrev, array.get(cm_keysNow, ci))
            array.push(cm_valsPrev, array.get(cm_valsNow, ci))

    // ---- DOL banner ----
    if masterOn and showDOL and (bslStrength > 0 or sslStrength > 0)
        float atrU2 = math.max(nz(atr), syminfo.mintick)
        float totalG = dm_totalG
        bool drawUp = dolDrawUp
        string arrow = drawUp ? dolBull : dolBear
        // balance-aware conviction (#9): magnitude of the bias, further scaled by how
        // DECISIVE the BSL-vs-SSL split is. A near-50/50 tug-of-war reads as low
        // confidence even when the winning side's absolute pull is large.
        float dominance = totalG > 0 ? math.abs(bslEff - sslEff) / totalG : 0.0
        float conv = math.round(math.min(1.0, math.abs(dm_bias)) * (0.4 + 0.6 * dominance) * 100)
        float tgtPrice = dolTgt
        string distTxt = ""
        if not na(tgtPrice)
            float dATR = math.abs(tgtPrice - close) / atrU2
            float dPct = math.abs(tgtPrice - close) / math.max(close, syminfo.mintick) * 100.0
            distTxt := " · " + str.tostring(tgtPrice, format.mintick) + " (" + str.tostring(dATR, "#.0") + " ATR / " + str.tostring(dPct, "#.0#") + "%)"
        string meter = ""
        if dolMeter
            int filled = math.max(0, math.min(5, int(math.round(conv / 20.0))))
            string mtr = ""
            for seg = 1 to 5
                mtr := mtr + (seg <= filled ? "▰" : "▱")
            meter := " " + mtr
        // hysteresis hint: deadband cleared toward the OTHER side but not yet committed (waiting on bar close)
        string turnTxt = (dolStable and dm_turning) ? " ⟳" : ""
        string dolTxt = arrow + " DOL " + (drawUp ? "UP" : "DOWN") + turnTxt + " " + str.tostring(math.round(conv)) + "%" + meter
        // path-clearance (feature 1) + ETA (feature 2) appended to the 🎯 target row
        string clrTxt = ""
        if projClear and not na(tgtPrice)
            [clrScore, obsN] = f_pathClear(close, tgtPrice, atrU2)
            clrTxt := " · 🛣️" + str.tostring(clrScore) + (obsN > 0 ? (" (" + str.tostring(obsN) + " block" + (obsN == 1 ? "" : "s") + ")") : " clear")
        string etaTxt = (projETA and not na(tgtPrice)) ? f_eta(tgtPrice) : ""
        string tgtTxt = na(tgtPrice) ? "" : ("🎯 target" + distTxt + clrTxt + etaTxt)
        string tugTxt = ""
        if dolTugBar and totalG > 0
            int bslPct = int(math.round(bslEff / totalG * 100.0))
            int sslPct = 100 - bslPct
            int sslSeg = int(math.round(sslPct / 10.0))
            string bar = ""
            for sg = 1 to 10
                bar := bar + (sg <= sslSeg ? "▮" : "▯")
            tugTxt := "SSL " + str.tostring(sslPct) + " " + bar + " " + str.tostring(bslPct) + " BSL"
        // equilibrium / range-state (feature 3): where price sits in the live dealing range
        string equiTxt = ""
        if projEqui and not na(rngHi) and not na(rngLo) and rngHi > rngLo
            float posR = (close - rngLo) / (rngHi - rngLo)
            string state = posR >= 0.62 ? "PREMIUM" : (posR <= 0.38 ? "DISCOUNT" : "EQUILIBRIUM")
            string emoR = posR >= 0.62 ? "🔺" : (posR <= 0.38 ? "🔻" : "⚖️")
            equiTxt := emoR + " " + state + " " + str.tostring(math.round(posR * 100)) + "%"
        // resistance readout: how clear the path is up vs down (0 = fully walled, 100 = open)
        string resistTxt = ""
        if projResist
            resistTxt := "🧱 clear ↑" + str.tostring(math.round(upClr)) + " ↓" + str.tostring(math.round(dnClr))
        // ---- one-line verdict: the sentence a trader acts on ----
        string verdictTxt = ""
        if showVerdict
            string vDir = drawUp ? "LONG" : "SHORT"
            string vTgt = na(tgtPrice) ? "" : (" · →" + str.tostring(tgtPrice, format.mintick) + " (" + str.tostring(math.abs(tgtPrice - close) / atrU2, "#.0") + "R~ATR)")
            string vConf = " · " + str.tostring(math.round(conv)) + "%"
            string vPath = ""
            if not na(tgtPrice)
                [vc, vo] = f_pathClear(close, tgtPrice, atrU2)
                vPath := vo > 0 ? (" · ⚠ " + str.tostring(vo) + " block" + (vo == 1 ? "" : "s")) : " · clear"
            string vState = ""
            if not na(rngHi) and not na(rngLo) and rngHi > rngLo
                float vp = (close - rngLo) / (rngHi - rngLo)
                vState := vp >= 0.62 ? " · premium" : (vp <= 0.38 ? " · discount" : " · equilibrium")
            verdictTxt := (drawUp ? "🔼 " : "🔽 ") + vDir + vTgt + vConf + vPath + vState
        color dirAccent = drawUp ? themeUpSolid : themeDnSolid
        bool showTgtRow = dolTgtLine and not na(tgtPrice)
        bool showTugRow = dolTugBar and totalG > 0
        bool showEquiRow = projEqui and equiTxt != ""
        bool showResistRow = projResist and resistTxt != ""
        bool showVerdictRow = showVerdict and verdictTxt != ""
        dolSzB = dolSize == "Huge" ? size.large : dolSize == "Large" ? size.normal : size.small
        var table dolTbl = table.new(position.top_right, 1, 6, border_width = 1)
        table.set_position(dolTbl, f_tablePos(dolBanPos))
        table.clear(dolTbl, 0, 0, 0, 5)
        int rowN = 0
        if showVerdictRow
            table.cell(dolTbl, 0, rowN, verdictTxt, text_color = dirAccent, bgcolor = themePanelBg, text_size = dolSzB)
            rowN := rowN + 1
        table.cell(dolTbl, 0, rowN, dolTxt, text_color = dirAccent, bgcolor = showVerdictRow ? themeRowBg : themePanelBg, text_size = showVerdictRow ? size.small : dolSzB)
        rowN := rowN + 1
        if showTugRow
            table.cell(dolTbl, 0, rowN, tugTxt, text_color = themeTxt, bgcolor = themeRowBg, text_size = size.small)
            rowN := rowN + 1
        if showResistRow
            table.cell(dolTbl, 0, rowN, resistTxt, text_color = themeTxt, bgcolor = themeRowBg, text_size = size.small)
            rowN := rowN + 1
        if showEquiRow
            table.cell(dolTbl, 0, rowN, equiTxt, text_color = themeTxt, bgcolor = themeRowBg, text_size = size.small)
            rowN := rowN + 1
        if showTgtRow
            table.cell(dolTbl, 0, rowN, tgtTxt, text_color = themeMuted, bgcolor = themeRowBg, text_size = size.small)
        table.set_frame_color(dolTbl, color.new(dirAccent, 35))
        table.set_frame_width(dolTbl, themeBW)

// ---- Daily Bias banner (its own corner, independent of the DOL gauge) ----
if masterOn and biasOn and biasBanner and barstate.islast
    color  biasAccent = dayBias > 0 ? themeUpSolid : dayBias < 0 ? themeDnSolid : themeMuted
    string biasWord = dayBias > 0 ? "LONG" : dayBias < 0 ? "SHORT" : "NEUTRAL"
    string biasArrow = dayBias > 0 ? "🔼" : dayBias < 0 ? "🔽" : "⏸"
    string cautionTxt = dayCaution ? " ⚠ caution" : ""
    string whyTxt = dayBias == 0 ? "no clean structure" : (biasWhyStruct + biasWhySweep)
    biasSzB = biasBanSize == "Huge" ? size.large : biasBanSize == "Large" ? size.normal : size.small
    var table biasTbl = table.new(position.top_left, 1, 2, border_width = 1)
    table.set_position(biasTbl, f_tablePos(biasBanPos))
    table.clear(biasTbl, 0, 0, 0, 1)
    table.cell(biasTbl, 0, 0, biasArrow + " TODAY: " + biasWord + cautionTxt, text_color = biasAccent, bgcolor = themePanelBg, text_size = biasSzB)
    table.cell(biasTbl, 0, 1, whyTxt, text_color = themeMuted, bgcolor = themeRowBg, text_size = size.small)
    table.set_frame_color(biasTbl, color.new(biasAccent, 35))
    table.set_frame_width(biasTbl, themeBW)

// ---- dedicated RSI gauge banner (pure RSI info — NO bias framing) ----
if masterOn and exhOn and exhShow and barstate.islast and not na(exhRsi)
    string rsiState = exhRsi >= exhOB ? "OVERBOUGHT" : exhRsi <= exhOS ? "OVERSOLD" : "neutral"
    color  rsiCol = exhRsi >= exhOB ? themeDnSolid : exhRsi <= exhOS ? themeUpSolid : themeTxt
    // divergence is a factual RSI-vs-price observation, stated neutrally (no bullish/bearish)
    string divState = exhBullDiv ? "bullish RSI divergence" : exhBearDiv ? "bearish RSI divergence" : "no divergence"
    var table rsiTbl = table.new(position.middle_right, 1, 3, border_width = 1)
    table.set_position(rsiTbl, f_tablePos(exhGaugePos))
    table.clear(rsiTbl, 0, 0, 0, 2)
    table.cell(rsiTbl, 0, 0, "📊 RSI " + str.tostring(math.round(exhRsi)), text_color = rsiCol, bgcolor = themePanelBg, text_size = size.normal)
    table.cell(rsiTbl, 0, 1, rsiState, text_color = rsiCol, bgcolor = themeRowBg, text_size = size.small)
    table.cell(rsiTbl, 0, 2, divState, text_color = themeMuted, bgcolor = themeRowBg, text_size = size.small)
    table.set_frame_color(rsiTbl, color.new(rsiCol, 35))
    table.set_frame_width(rsiTbl, themeBW)

// wipe extra pool when master/OB off
if (not masterOn or not showOB) and array.size(xtra_boxes) + array.size(xtra_labels) > 0
    f_clearXtra()

// -----------------------------------------------------------------------------
// FAIR VALUE GAPS  — rolling boxes  (arrays declared earlier, near projection helpers)
// -----------------------------------------------------------------------------
f_delFvgAt(int ix) =>
    box.delete(array.get(fvgBoxes, ix))
    label lb = array.get(fvgLabels, ix)
    if not na(lb)
        label.delete(lb)
    line ce = array.get(fvgCE, ix)
    if not na(ce)
        line.delete(ce)
    array.remove(fvgBoxes, ix)
    array.remove(fvgIsBull, ix)
    array.remove(fvgStr, ix)
    array.remove(fvgLabels, ix)
    array.remove(fvgCE, ix)
    array.remove(fvgArmed, ix)
    array.remove(fvgArmBar, ix)
    array.remove(fvgApproached, ix)
    array.remove(fvgCreatQ, ix)

if (not masterOn or not showFVG) and array.size(fvgBoxes) > 0
    while array.size(fvgBoxes) > 0
        f_delFvgAt(0)

bullFVG = low > nz(high[2], low)
bearFVG = high < nz(low[2], high)
// A newly confirmed gap is scored for strength; weak gaps are hidden (or dimmed) so the
// chart isn't flooded with trivial imbalances on low timeframes.
if masterOn and showFVG and (bullFVG or bearFVG)
    bool  isBull = bullFVG
    float gTop   = isBull ? low   : low[2]
    float gBot   = isBull ? high[2] : high
    // min-gap floor: a micro-gap below the ATR floor is ignored entirely (never scored/drawn)
    float gapATR = math.abs(gTop - gBot) / math.max(nz(atr), syminfo.mintick)
    bool  bigEnough = fvgMinGapATR <= 0.0 or gapATR >= fvgMinGapATR
    if bigEnough
        // the displacement candle that opened the gap is the middle bar [1]
        float dispVol = nz(volume[1], volume)
        // displacement quality (0..1): body dominance of the creating candle + a structure-break
        // bonus if that candle's close took out the most recent opposing swing.
        float dRange = math.max(high[1] - low[1], syminfo.mintick)
        float bodyDom = math.abs(close[1] - open[1]) / dRange                 // 0..1
        bool  brokeStruct = isBull ? (not na(lastPH) and close[1] > lastPH) : (not na(lastPL) and close[1] < lastPL)
        float dispQual = math.min(1.0, bodyDom * 0.7 + (brokeStruct ? 0.3 : 0.0))
        [sc, isInv, inBlock, htfAl, liqAl, swpAl] = f_fvgStrength(gTop, gBot, isBull, dispVol, dispQual, false)
        // bias-aligned declutter: a gap opposing the committed daily bias is counter-bias.
        bool counterBias = biasOn and dayBias != 0 and (isBull ? dayBias < 0 : dayBias > 0)
        bool biasHide = counterBias and biasHideFVG
        bool pass = (not fvgFilterOn) or (sc >= fvgMinStr)
        if (pass or fvgDimWeak) and not biasHide
            // counter-bias gaps are drawn faint (like weak) when fading is on
            bool weak = (fvgFilterOn and sc < fvgMinStr) or (counterBias and biasFadeFVG)
            color baseCol = isBull ? colBull : colBear
            int   fillOp  = weak ? math.min(opacityFVG + 15, 97) : opacityFVG
            int   bordOp  = weak ? 85 : 40
            box b = box.new(bar_index[2], gTop, bar_index + extendR, gBot, border_color = color.new(baseCol, bordOp), bgcolor = color.new(colFVGBase, fillOp))
            array.push(fvgBoxes, b)
            array.push(fvgIsBull, isBull)
            array.push(fvgStr, sc)
            label lb = na
            if fvgShowStr and not weak
                string suffix = (htfAl ? " htf" : "") + (liqAl ? " liq" : "") + (swpAl ? " swp" : "") + (isInv ? " inv" : "") + (inBlock ? " blk" : "")
                float ceY = (gTop + gBot) / 2.0
                if fvgLblStyle == "Inside box (centered)"
                    // % sits CENTERED inside the gap box itself — tied to its box, no callout,
                    // so it can't blend with the level labels bunched at the right edge.
                    int cx = int(math.round((bar_index[2] + bar_index + extendR) / 2.0))
                    lb := label.new(cx, ceY, str.tostring(sc) + "%" + suffix, style = label.style_text_outline, textcolor = color.white, color = color.new(baseCol, 100), size = size.small)
                else if fvgLblStyle == "Plain text (no box)"
                    // borderless text in the gap color — most minimal, cannot blend with the solid callouts
                    lb := label.new(bar_index + extendR, ceY, "◆ " + str.tostring(sc) + "%" + suffix, style = label.style_none, textcolor = baseCol, size = size.small)
                else if fvgLblStyle == "Callout (like levels)"
                    lb := label.new(bar_index + extendR, ceY, "◆ " + str.tostring(sc) + "%" + suffix, style = label.style_label_left, color = color.new(baseCol, 25), textcolor = color.white, size = size.small)
                else
                    // Pointer (distinct): anchored at the LEFT edge of the gap (away from the
                    // right-edge level labels) with the pointer facing right into the gap.
                    lb := label.new(bar_index[2], ceY, "◆ " + str.tostring(sc) + "%" + suffix, style = label.style_label_right, color = color.new(baseCol, 10), textcolor = color.white, size = size.small)
            array.push(fvgLabels, lb)
            // consequent-encroachment (CE) line at the gap midpoint — the 50% price reacts to
            line ce = na
            if fvgShowCE and not weak
                float ceMid = (gTop + gBot) / 2.0
                ce := line.new(bar_index[2], ceMid, bar_index + extendR, ceMid, color = fvgCECol, style = line.style_dashed, width = 1)
            array.push(fvgCE, ce)
            array.push(fvgArmed, 0)   // execution state starts at 'watching'
            array.push(fvgArmBar, na) // bar it armed on (set when it arms)
            array.push(fvgApproached, false)
            array.push(fvgCreatQ, dispQual)   // creation strength for the rejection gauge

// reset this bar's execution alert flags + clear the setup drawing pool (redrawn below)
execArmNow     := false
execConfirmNow := false
execReturnNow  := false
execInvalidNow := false
if array.size(exec_lines) > 0
    while array.size(exec_lines) > 0
        line.delete(array.shift(exec_lines))
if array.size(exec_labels) > 0
    while array.size(exec_labels) > 0
        label.delete(array.shift(exec_labels))

if array.size(fvgBoxes) > 0
    while array.size(fvgBoxes) > fvgKeep
        f_delFvgAt(0)
    int i = 0
    while i < array.size(fvgBoxes)
        box bx     = array.get(fvgBoxes, i)
        bool isBull = array.get(fvgIsBull, i)
        float top  = box.get_top(bx)
        float bot  = box.get_bottom(bx)
        float mid  = (top + bot) / 2.0
        bool invalid = false
        if hideMitFVG
            if fvgFillMode == "Body close through"
                invalid := isBull ? (close < bot) : (close > top)
            else if fvgFillMode == "Wick touch (50%)"
                invalid := isBull ? (low <= mid) : (high >= mid)
            else
                invalid := high >= top and low <= bot
        if invalid
            // remember this zone briefly so a later opposite gap here counts as an inversion
            array.push(invTop, top)
            array.push(invBot, bot)
            array.push(invWasBull, isBull)
            array.push(invBar, bar_index)
            f_delFvgAt(i)
        else
            box.set_right(bx, bar_index + extendR)
            label lb = array.get(fvgLabels, i)
            // rebuild the label each bar from the STATIC base % + live context tags (exhaustion
            // delta + rejection gauge). The base score never visually mutates; live reads append.
            if not na(lb) and ((exhOn and exhW > 0) or fvgRejGauge)
                float baseSc = array.get(fvgStr, i)
                string tags = ""
                // live exhaustion context as a SEPARATE signed delta
                if exhOn and exhW > 0
                    int delta = int(math.round(f_exhAdj(top, bot, isBull)))
                    tags := tags + (delta >= 1 ? (" ⛽+" + str.tostring(delta)) : (delta <= -1 ? (" ⛽" + str.tostring(delta)) : ""))
                // live rejection gauge — only shows while price is at/in the gap
                if fvgRejGauge
                    [rjActive, rjLean] = f_rejGauge(top, bot, isBull, array.get(fvgCreatQ, i))
                    if rjActive
                        tags := tags + (rjLean >= 50 ? (" ⟲" + str.tostring(rjLean)) : (" ⇥" + str.tostring(rjLean)))
                string pfx = fvgLblStyle == "Inside box (centered)" ? "" : "◆ "
                label.set_text(lb, pfx + str.tostring(int(baseSc)) + "%" + tags)
            // keep each label correctly placed as the box extends right:
            //  • Inside box (centered): re-center over the (growing) box
            //  • Right-edge styles (Plain / Callout): follow the right edge
            //  • Pointer: stays anchored at the gap's left edge — don't move it
            if not na(lb)
                if fvgLblStyle == "Inside box (centered)"
                    label.set_x(lb, int(math.round((box.get_left(bx) + bar_index + extendR) / 2.0)))
                else if fvgLblStyle != "Pointer (distinct)"
                    label.set_x(lb, bar_index + extendR)
            line ce = array.get(fvgCE, i)
            if not na(ce)
                line.set_x2(ce, bar_index + extendR)
            // ---- execution state machine: watch -> armed -> confirmed ----
            if execOn
                int    st  = array.get(fvgArmed, i)
                // no-repaint gate: only advance state / fire alerts on a CLOSED bar (unless the
                // user opts into intrabar). Historical bars are always confirmed, so unaffected.
                bool   commitOK = (not execNoRepaint) or barstate.isconfirmed
                // effective score = stored static base + live momentum-exhaustion adjustment
                float  gsc = math.max(0.0, math.min(100.0, array.get(fvgStr, i) + f_exhAdj(top, bot, isBull)))
                float  ceP = mid
                // qualification gates: strength, premium/discount side, DOL agreement
                bool qStr = gsc >= execMinStr
                bool qPD  = true
                if execNeedPD and not na(rngHi) and not na(rngLo) and rngHi > rngLo
                    float pos = (ceP - rngLo) / (rngHi - rngLo)
                    qPD := isBull ? (pos <= 0.5) : (pos >= 0.5)
                bool qDOL = (not execNeedDOL) or (isBull ? dm_dirState > 0 : dm_dirState < 0)
                // daily-bias agreement: NEUTRAL bias (dayBias == 0) allows both directions
                bool qBias = (not execNeedDay) or dayBias == 0 or (isBull ? dayBias > 0 : dayBias < 0)
                // the stop level for this gap (far edge + ATR buffer) — used for invalidation + R:R
                float atrX = math.max(nz(atr), syminfo.mintick)
                float stopLvl = isBull ? (bot - execStopATR * atrX) : (top + execStopATR * atrX)
                // feasibility: reward:risk to the nearest OPPOSING liquidity pool (the realistic
                // target). If below execMinRR the setup has no room — skip it (or just flag it).
                float entryQ = execEntry == "CE (50%)" ? ceP : (isBull ? top : bot)
                float riskQ  = math.max(math.abs(entryQ - stopLvl), syminfo.mintick)
                float tgtLiq = f_nextOppLiq(entryQ, isBull)
                float feasRR = na(tgtLiq) ? na : (math.abs(tgtLiq - entryQ) / riskQ)
                bool  lowRR  = execMinRR > 0 and not na(feasRR) and feasRR < execMinRR
                bool  qRR    = (execMinRR <= 0) or (not execRRReject) or (not lowRR)
                bool qualifies = qStr and qPD and qDOL and qBias and qRR
                // price returning toward a still-watching qualifying gap (approach alert, once per gap)
                if st == 0 and qualifies and commitOK and not array.get(fvgApproached, i)
                    bool nearing = isBull ? (low <= top and low > ceP) : (high >= bot and high < ceP)
                    if nearing
                        execReturnNow := true
                        array.set(fvgApproached, i, true)   // cooldown: don't re-announce this gap
                // ARM when price taps the entry (CE by default, else proximal edge)
                if st == 0 and qualifies and commitOK
                    float entryP = execEntry == "CE (50%)" ? ceP : (isBull ? top : bot)
                    bool tapped = low <= entryP and high >= entryP
                    if tapped
                        array.set(fvgArmed, i, execConfirm ? 1 : 2)
                        array.set(fvgArmBar, i, bar_index)   // stamp arm bar for expiry
                        execArmNow := true
                        if not execConfirm
                            execConfirmNow := true
                // CONFIRM an armed gap once a candle closes rejecting back out on the setup side
                else if st == 1 and commitOK
                    bool rejectClose = isBull ? (close > ceP) : (close < ceP)
                    if rejectClose
                        array.set(fvgArmed, i, 2)
                        execConfirmNow := true
                // ---- lifecycle: invalidate an armed/confirmed setup on stop breach or expiry ----
                if (st == 1 or st == 2) and commitOK
                    bool stopHit = execStopKill and (isBull ? (low <= stopLvl) : (high >= stopLvl))
                    int  armedBar = array.get(fvgArmBar, i)
                    bool expired  = execExpiry > 0 and not na(armedBar) and (bar_index - armedBar) >= execExpiry
                    if stopHit or expired
                        array.set(fvgArmed, i, 3)            // dead — stops drawing + no more alerts
                        execInvalidNow := true
            i += 1

// ---- draw the nearest active setups (entry / stop / TP1 / TP2 + R:R) ----
// Only the execMaxShow armed gaps closest to price draw lines, to keep the chart readable.
if execOn and masterOn and barstate.islast and array.size(fvgBoxes) > 0
    float atrE = math.max(nz(atr), syminfo.mintick)
    int drawn = 0
    // repeatedly pick the nearest armed-but-undrawn gap
    var drawnIx = array.new<bool>()
    array.clear(drawnIx)
    for di = 0 to array.size(fvgBoxes) - 1
        array.push(drawnIx, false)
    while drawn < execMaxShow
        float bestD = na
        int   bestI = -1
        for gi = 0 to array.size(fvgBoxes) - 1
            // draw only LIVE setups (armed=1 / confirmed=2); skip dead=3 and watching=0
            int gSt0 = array.get(fvgArmed, gi)
            if (gSt0 == 1 or gSt0 == 2) and not array.get(drawnIx, gi)
                float gmid = (box.get_top(array.get(fvgBoxes, gi)) + box.get_bottom(array.get(fvgBoxes, gi))) / 2.0
                float d = math.abs(gmid - close)
                if na(bestD) or d < bestD
                    bestD := d
                    bestI := gi
        if bestI < 0
            break
        array.set(drawnIx, bestI, true)
        drawn := drawn + 1
        box  gbx = array.get(fvgBoxes, bestI)
        bool gBull = array.get(fvgIsBull, bestI)
        int  gSt = array.get(fvgArmed, bestI)
        float gT = box.get_top(gbx)
        float gB = box.get_bottom(gbx)
        float gMid = (gT + gB) / 2.0
        float entryP = execEntry == "CE (50%)" ? gMid : (gBull ? gT : gB)
        float stopP  = gBull ? (gB - execStopATR * atrE) : (gT + execStopATR * atrE)
        float risk   = math.abs(entryP - stopP)
        float tp1P   = gBull ? (entryP + execTP1R * risk) : (entryP - execTP1R * risk)
        float tp2P   = gBull ? (entryP + execTP2R * risk) : (entryP - execTP2R * risk)
        // realistic target = nearest opposing liquidity pool, and the feasible R:R to it
        float liqT   = f_nextOppLiq(entryP, gBull)
        float liqRR  = na(liqT) ? na : (math.abs(liqT - entryP) / math.max(risk, syminfo.mintick))
        bool  gLowRR = execMinRR > 0 and not na(liqRR) and liqRR < execMinRR
        int   xL = bar_index + 2
        int   xR = bar_index + extendR + 15
        array.push(exec_lines, line.new(xL, entryP, xR, entryP, color = execColEntry, style = line.style_solid,  width = 2))
        array.push(exec_lines, line.new(xL, stopP,  xR, stopP,  color = execColStop,  style = line.style_dashed, width = 1))
        array.push(exec_lines, line.new(xL, tp1P,   xR, tp1P,   color = execColTP,    style = line.style_dotted, width = 1))
        array.push(exec_lines, line.new(xL, tp2P,   xR, tp2P,   color = execColTP,    style = line.style_dotted, width = 1))
        string stTxt = gSt == 2 ? "CONFIRMED" : "ARMED"
        string dirTxt = gBull ? "LONG" : "SHORT"
        string rrTxt  = na(liqRR) ? "  (no liq target)" : ("  →liq " + str.tostring(math.round(liqRR * 10) / 10.0) + ":1" + (gLowRR ? " ⚠ low R:R" : ""))
        string head = (gBull ? "▲ " : "▼ ") + dirTxt + " " + stTxt + rrTxt
        array.push(exec_labels, label.new(xR, entryP, head + "  entry " + str.tostring(entryP, format.mintick), style = label.style_label_left, color = color.new(gLowRR ? execColStop : execColEntry, 10), textcolor = color.white, size = size.small))
        array.push(exec_labels, label.new(xR, stopP, "SL " + str.tostring(stopP, format.mintick), style = label.style_label_left, color = color.new(execColStop, 30), textcolor = color.white, size = size.tiny))
        array.push(exec_labels, label.new(xR, tp1P, "TP1 " + str.tostring(tp1P, format.mintick) + " (" + str.tostring(execTP1R, "#.#") + "R)", style = label.style_label_left, color = color.new(execColTP, 30), textcolor = color.white, size = size.tiny))
        array.push(exec_labels, label.new(xR, tp2P, "TP2 " + str.tostring(tp2P, format.mintick) + " (" + str.tostring(execTP2R, "#.#") + "R)", style = label.style_label_left, color = color.new(execColTP, 30), textcolor = color.white, size = size.tiny))
        // the realistic liquidity target line (where price is actually drawn)
        if not na(liqT)
            array.push(exec_lines, line.new(xL, liqT, xR, liqT, color = color.new(execColTP, 0), style = line.style_solid, width = 1))
            array.push(exec_labels, label.new(xR, liqT, "🎯 liq " + str.tostring(liqT, format.mintick), style = label.style_label_left, color = color.new(execColTP, 10), textcolor = color.white, size = size.tiny))

// wipe execution drawings when the engine is off
if (not execOn or not masterOn) and (array.size(exec_lines) > 0 or array.size(exec_labels) > 0)
    while array.size(exec_lines) > 0
        line.delete(array.shift(exec_lines))
    while array.size(exec_labels) > 0
        label.delete(array.shift(exec_labels))

// prune inversion memory beyond its window
if array.size(invTop) > 0
    int k = 0
    while k < array.size(invTop)
        if bar_index - array.get(invBar, k) > fvgInvBars
            array.remove(invTop, k)
            array.remove(invBot, k)
            array.remove(invWasBull, k)
            array.remove(invBar, k)
        else
            k += 1

// -----------------------------------------------------------------------------
// HIGHER-TIMEFRAME FAIR VALUE GAPS — box-less tracking (boost aligned gaps + feed DOL)
// -----------------------------------------------------------------------------
// wipe when master/HTF-FVG off
if (not masterOn or not htfFvgOn) and array.size(htfFvgTop) > 0
    array.clear(htfFvgTop)
    array.clear(htfFvgBot)
    array.clear(htfFvgBull)
    array.clear(htfFvgStr)

// register a newly confirmed HTF gap (once per HTF bar), gated by the same min-gap floor
if masterOn and htfFvgNew
    bool  hbull = nz(hfvgBull) == 1
    float hT = math.max(hfvgT, hfvgB)
    float hB = math.min(hfvgT, hfvgB)
    float hGapATR = math.abs(hT - hB) / math.max(nz(atr), syminfo.mintick)
    bool  hBig = fvgMinGapATR <= 0.0 or hGapATR >= fvgMinGapATR
    // avoid duplicate of a near-identical zone already tracked
    bool  dup = false
    if array.size(htfFvgTop) > 0
        float tolZ = nz(atr) * 0.1
        for di = 0 to array.size(htfFvgTop) - 1
            if math.abs(array.get(htfFvgTop, di) - hT) <= tolZ and math.abs(array.get(htfFvgBot, di) - hB) <= tolZ
                dup := true
    if hBig and not dup
        // HTF gaps: skip the HTF-alignment factor (isHtf=true) to avoid self-matching; use a
        // neutral displacement quality since the HTF candle body isn't pulled back.
        [hsc, hInv, hBlk, hAl, hLq, hSw] = f_fvgStrength(hT, hB, hbull, nz(hfvgVol), 0.5, true)
        array.push(htfFvgTop, hT)
        array.push(htfFvgBot, hB)
        array.push(htfFvgBull, hbull)
        array.push(htfFvgStr, hsc)
        while array.size(htfFvgTop) > htfFvgKeep
            array.shift(htfFvgTop)
            array.shift(htfFvgBot)
            array.shift(htfFvgBull)
            array.shift(htfFvgStr)

// invalidate tracked HTF gaps once the current (chart) price fills them, same rule set
if array.size(htfFvgTop) > 0
    int hi2 = 0
    while hi2 < array.size(htfFvgTop)
        float hT = array.get(htfFvgTop, hi2)
        float hB = array.get(htfFvgBot, hi2)
        bool  hbull = array.get(htfFvgBull, hi2)
        float hMid = (hT + hB) / 2.0
        bool hInvalid = false
        if hideMitFVG
            if fvgFillMode == "Body close through"
                hInvalid := hbull ? (close < hB) : (close > hT)
            else if fvgFillMode == "Wick touch (50%)"
                hInvalid := hbull ? (low <= hMid) : (high >= hMid)
            else
                hInvalid := high >= hT and low <= hB
        if hInvalid
            array.remove(htfFvgTop, hi2)
            array.remove(htfFvgBot, hi2)
            array.remove(htfFvgBull, hi2)
            array.remove(htfFvgStr, hi2)
        else
            hi2 += 1

// (HTF FVGs are now folded into the gap SCORE — see f_fvgStrength's HTF-alignment factor —
//  and still feed the DOL model; there is no separate HTF panel.)

// -----------------------------------------------------------------------------
// ALERTS
// -----------------------------------------------------------------------------
f_touch(float lvl) => not na(lvl) and high >= lvl and low <= lvl
alertcondition(f_touch(pdh) or f_touch(pdl), "PD level touched", "Price touched a Previous-Day level")
alertcondition(f_touch(lastPH) or f_touch(lastPL), "Liquidity swept", "Price swept a swing liquidity level")
alertcondition(f_touch(nyH) or f_touch(nyL) or f_touch(londH) or f_touch(londL) or f_touch(asiaH) or f_touch(asiaL), "Session level touched", "Price touched a session high/low")
alertcondition(sfpLong or sfpShort, "SFP fired", "Sweep + reversal (liquidity grab) detected")
alertcondition(sfpLong, "SFP long", "Bullish sweep + reversal")
alertcondition(sfpShort, "SFP short", "Bearish sweep + reversal")
// --- FVG execution engine ---
alertcondition(execReturnNow,  "FVG setup approaching", "Price is returning into a qualifying fair value gap — setup may arm soon")
alertcondition(execArmNow,     "FVG setup armed",       "Price tapped a qualifying FVG entry — setup ARMED (entry/stop/target active)")
alertcondition(execConfirmNow, "FVG setup confirmed",   "FVG setup CONFIRMED — entry trigger met")
alertcondition(execInvalidNow, "FVG setup invalidated", "FVG setup INVALIDATED — stop breached or expired")
alertcondition(biasFlipNow,    "Daily bias flipped",    "The Daily Bias direction changed")
