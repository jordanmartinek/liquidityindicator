//@version=6
// =============================================================================
// Liquidity Radar  (Pine Script v6) — STREAMLINED CORE
// Focus: key liquidity levels + their validity.
//   • Liquidity levels: PDH/PDL, PWH/PWL, PMH/PML, sessions H/L, swings (+HTF),
//     equal highs/lows — all removed once swept.
//   • Stacked liquidity: nearby levels merge into strength-rated zones.
//   • Confluence score (0-100) per zone.
//   • Per-level confidence % + 🎯 most-likely target (draw-on-liquidity model).
//   • Order Blocks / Breakers and Fair Value Gaps (strength-ranked).
//   • Sweep + reversal (SFP) markers, per-level countdown, Daily Bias, ORB.
//   • ⑫ Brooks microtrendline module for execution + entries (toggle).
// =============================================================================
indicator("Liquidity Radar", overlay = true, scale = scale.right, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

// Anchor plot so the compiler always sees a top-level drawing output.
plot(na, "anchor", display = display.none)

// -----------------------------------------------------------------------------
// GROUP NAMES
// -----------------------------------------------------------------------------
var string G_PREV   = "① Previous-Period Levels"
var string G_SESS   = "② Sessions"
var string G_STRUCT = "③ Structure (swings · EQ · FVG · OB · SFP)"
var string G_CD     = "④ Countdown"
var string G_CLUST  = "⑤ Clustering & Confluence"
var string G_DOL    = "⑥ Level Confidence"
var string G_STYLE  = "⑦ Style"
var string G_TESTED = "⑧ Tested Levels"
var string G_BIAS   = "⑨ Daily Bias"
var string G_REGIME = "⑩ Market Condition (shared)"
var string G_ORB    = "⑪ Opening Range Breakout (ORB)"

// -----------------------------------------------------------------------------
// INPUTS — PREVIOUS-PERIOD LEVELS
// -----------------------------------------------------------------------------
showPDHL = input.bool(true,  "Prev Day High/Low (PDH/PDL)",    group = G_PREV)
showPWHL = input.bool(true,  "Prev Week High/Low (PWH/PWL)",   group = G_PREV)
showPMHL = input.bool(false, "Prev Month High/Low (PMH/PML)",  group = G_PREV)
showDO   = input.bool(false, "Daily Open",                     group = G_PREV)
showWO   = input.bool(false, "Weekly Open",                    tooltip = "Current week's opening price — a key institutional reference; price often reverts to it. Feeds the clusters + DOL pull.", group = G_PREV)
showMO   = input.bool(false, "Monthly Open",                   tooltip = "Current month's opening price — a major reference level. Feeds the clusters + DOL pull.", group = G_PREV)
showMidO = input.bool(false, "NY Midnight Open (00:00 ET)",    tooltip = "Price at 00:00 New York time — the ICT 'true day' open. A high-signal intraday anchor for premium/discount. Feeds the clusters + DOL pull.", group = G_PREV)

// -----------------------------------------------------------------------------
// INPUTS — SESSIONS
// -----------------------------------------------------------------------------
sessTZ    = input.string("UTC", "Session Timezone", options = ["UTC","America/New_York","Europe/London","Asia/Tokyo"], group = G_SESS)
showAsia  = input.bool(true,  "Asian Session H/L",   group = G_SESS)
asiaSess  = input.session("0000-0800", "  Asian time",   group = G_SESS)
showLond  = input.bool(true,  "London Session H/L",  group = G_SESS)
londSess  = input.session("0800-1600", "  London time",  group = G_SESS)
showNY    = input.bool(true,  "New York Session H/L", group = G_SESS)
nySess    = input.session("1300-2100", "  New York time", group = G_SESS)
sessResetDaily = input.bool(true, "Reset session H/L each new day", tooltip = "At the start of a new trading day, clear the previous day's session highs/lows so stale levels don't linger.", group = G_SESS)
sessRemoveSwept = input.bool(true, "Remove session level once swept", tooltip = "If price trades through a session high/low, drop it (the liquidity has been taken).", group = G_SESS)
sessReclassify = input.bool(true, "Reclassify unswept session H/L as swings", tooltip = "A session high/low that survives into the next day (never swept) gets relabeled e.g. 'Asia H (swing)'.", group = G_SESS)

// -----------------------------------------------------------------------------
// INPUTS — STRUCTURE
// -----------------------------------------------------------------------------
showSwing  = input.bool(true,  "Swing Highs/Lows (liquidity)", group = G_STRUCT)
swingLen   = input.int(10, "  Swing pivot length", minval = 2, group = G_STRUCT)
swingHist  = input.int(40, "  Historical swings kept (per side)", minval = 1, maxval = 200, tooltip = "How many UNSWEPT swing highs/lows to keep. Higher = more levels going back. Old untapped swings persist until swept.", group = G_STRUCT)
htfSwingOn = input.bool(true, "  Add higher-timeframe swings", tooltip = "Also pull swing highs/lows from a higher timeframe so major structural levels far back are captured on a low-TF chart.", group = G_STRUCT)
htfTF      = input.timeframe("240", "  HTF timeframe", tooltip = "Timeframe for the extra structural swings (e.g. 240 = 4h, D = daily).", group = G_STRUCT)
htfLen     = input.int(5, "  HTF swing pivot length", minval = 2, group = G_STRUCT)
removeSwept = input.bool(true, "Remove swept levels (swings, EQ, prev-period)", tooltip = "Once price trades through a level, remove it - the liquidity has been taken.", group = G_STRUCT)
showEQ     = input.bool(true,  "Equal Highs/Lows (EQH/EQL)",   group = G_STRUCT)
eqTol      = input.float(0.35, "  EQ tolerance (× ATR)", minval = 0.0, step = 0.05, tooltip = "Two swing pivots count as an Equal High/Low if within this many ATRs of each other.", group = G_STRUCT)
eqLookback = input.int(6, "  EQ lookback (pivots)", minval = 1, maxval = 30, tooltip = "How many recent same-type pivots to compare against when hunting equal highs/lows.", group = G_STRUCT)
showRelEQ  = input.bool(true, "  Relative (near) Equal H/L", tooltip = "Also flag NEAR-equal highs/lows — pivots close but not within the strict EQ tolerance. Real stop-runs rarely line up to the tick; relative EQs (rEQH/rEQL) catch the softer clusters. Tagged distinctly and fed into the clusters/pull at a slightly lower weight than exact EQs.", group = G_STRUCT)
relEqTol   = input.float(0.75, "    Relative EQ tolerance (× ATR)", minval = 0.0, step = 0.05, tooltip = "Wider band (in ATRs) for near-equal highs/lows. Should be larger than the strict EQ tolerance.", group = G_STRUCT)
showBreaker = input.bool(true, "Breaker blocks (failed OB flips polarity)", tooltip = "When an order block is violated (price closes through it), it doesn't just vanish — it becomes a BREAKER: former demand flips to supply (and vice versa). Breakers are strong reaction zones; they feed the confluence score + resistance like order blocks.", group = G_STRUCT)
// --- FVG ---
showFVG    = input.bool(true,  "Fair Value Gaps (FVG)",        group = G_STRUCT)
hideMitFVG = input.bool(true,  "  Remove invalidated FVGs",    group = G_STRUCT)
fvgFillMode = input.string("Body close through", "  FVG invalidation", options = ["Body close through","Wick touch (50%)","Full fill (wick)"], tooltip = "Body close through: gap disappears once a candle CLOSES beyond it. Wick touch: removed at midpoint. Full fill: removed only when a wick fully engulfs it.", group = G_STRUCT)
// --- FVG strength filter (declutter: only keep gaps price is likely to respect) ---
fvgFilterOn   = input.bool(true,  "  Filter FVGs by strength", tooltip = "RANK every fair value gap 0-100 (a relative QUALITY ranking, not a probability) and only draw the ones that clear the threshold below. The rank = a CORE BASE (the quality every gap has: size vs ATR · creation volume · displacement · premium/discount — a clean ordinary gap lands ~40-55) PLUS BONUS points added on top only when the occasional factors fire (inside an order/breaker block, inversion/IFVG, higher-timeframe-gap alignment, round-number/VWAP/OTE confluence, liquidity-pool confluence, sweep precedence), minus a discount if the gap is already tested or poorly located. Absent bonuses never penalise — so a valid gap keeps a usable score and confluent gaps rise above ordinary ones. Typical: trivial gap <30, ordinary 40-55, confluent 65-90+.", group = G_STRUCT)
fvgMinStr     = input.int(35, "    Min FVG strength % to draw", minval = 0, maxval = 100, tooltip = "Fair value gaps ranking below this are hidden (or dimmed, if 'Dim weak FVGs' is on). On the core-base+bonus scale a TYPICAL valid gap ranks ~45-60 and confluent gaps 65-90+, so ~35 keeps genuine gaps while dimming only the trivial ones. TUNE THIS to the % values you actually see on your chart: if too many gaps dim, lower it; if too many show, raise it.", group = G_STRUCT)
fvgDimWeak    = input.bool(true, "    Dim weak FVGs instead of hiding", tooltip = "Rather than removing sub-threshold gaps entirely, draw them very faintly so context is kept while the strong gaps stand out. Off = weak gaps are not drawn at all.", group = G_STRUCT)
fvgShowStr    = input.bool(true, "    Label FVG strength %", tooltip = "Print each drawn gap's strength % (plus tags: 'htf' = aligns with a higher-timeframe gap, 'liq' = sits on/just beyond a liquidity pool (EQ / prev-period / open / session / swing), 'swp' = formed right after a same-direction sweep (SFP), 'inv' = followed an inversion, 'blk' = inside an order/breaker block) so you can see WHY it scored the way it did.", group = G_STRUCT)
fvgKeep       = input.int(50, "    Max FVGs kept", minval = 5, maxval = 100, tooltip = "How many unfilled fair value gaps to retain before the OLDEST is dropped. Raise this to keep more / older gaps far back in history (e.g. gaps sitting above the current swing high); lower it to keep the chart light. Note: gaps older than the chart's loaded history still can't be drawn, and each gap uses a drawing-object slot shared with order blocks and cluster zones (budget is 500).", group = G_STRUCT)
// FVG strength model — fixed internal weights (1.0 = default influence) and look-backs
fvgSizeW     = 1.0
fvgVolW      = 1.0
fvgBlockW    = 1.0
fvgInvW      = 1.0
fvgInvBars   = 30
fvgHtfW      = 1.0
fvgPdW       = 1.0
fvgDispW     = 1.0
fvgConflW    = 1.0
fvgLiqW      = 1.0
fvgLiqATR    = 0.5
fvgSweepW    = 1.0
fvgSweepBars = 3
fvgFreshDisc = 0.35
fvgTrapDisc  = 0.40
fvgTrapATR   = 0.75
htfFvgKeep   = 6
htfFvgMaxTF  = 5
// --- min-gap floor: kill micro-gaps at the source before they are ever scored/drawn ---
fvgMinGapATR  = input.float(0.0, "  Min gap size (× ATR)", minval = 0.0, maxval = 3.0, step = 0.05, tooltip = "A gap smaller than this many ATRs is ignored entirely — never scored, drawn, or tracked. A hard noise floor that kills micro-imbalances at the source on low timeframes (e.g. the 5-minute chart), complementing the strength filter. 0 = disable (keep every gap, however small).", group = G_STRUCT)
// --- consequent encroachment (CE) line: the 50% midpoint price reacts to most ---
fvgShowCE     = input.bool(false, "  Show CE (50%) line on FVGs", tooltip = "Draw a dashed line at each gap's midpoint — the 'consequent encroachment' (CE). Price very often reacts to the gap's 50% rather than the full fill, so the CE is the real mitigation/entry reference ICT traders watch. Applies to drawn chart-timeframe gaps.", group = G_STRUCT)
fvgCECol      = input.color(color.new(#ab47bc, 20), "    CE line color", group = G_STRUCT)
// --- higher-timeframe (HTF) FVGs: detected and folded into scoring (no separate chart drawing) ---
htfFvgOn      = input.bool(true, "  Use higher-timeframe FVGs in scoring", tooltip = "Detect fair value gaps on the HTF timeframe set above (the same '  HTF timeframe' input used for HTF swings — edit it to pick which timeframe to watch, e.g. 60 / 240 / D). HTF gaps are NOT drawn on the chart; instead they BOOST the score of any chart-TF gap that aligns with them (see 'Weight: HTF-gap alignment') and they also feed the DOL model (confluence, path-clearance / resistance, and the ⭐ stacked-agreement flag) as strong magnet zones.", group = G_STRUCT)
// --- SFP (sweep + reversal) ---
showSFP    = input.bool(true, "Sweep + reversal markers (SFP)", tooltip = "The core validity trigger: a wick pierces a tracked level then the candle CLOSES back on the origin side (a stop-run). Marks 🎯 SFP long/short.", group = G_STRUCT)
sfpUseVol  = input.bool(true, "  Require volume confirmation", tooltip = "Only flag a sweep as a real grab on elevated relative volume.", group = G_STRUCT)
sfpConfirm = input.bool(true, "  Confirm on bar close (no repaint)", tooltip = "An SFP is 'a wick pierces a level then the candle CLOSES back on the origin side' — a CLOSE-based event. With this on, the SFP marker/alert only fires once the bar has CLOSED, so it can't flash on the forming bar and then disappear (no repaint). Turn OFF to see a provisional intrabar preview (which may vanish before the bar closes).", group = G_STRUCT)
sfpCooldown = 10
rvolLen    = input.int(20, "  Rel-volume lookback", minval = 5, maxval = 200, group = G_STRUCT)
rvolMult   = input.float(1.5, "  Min rel-volume for grab", minval = 1.0, maxval = 5.0, step = 0.1, group = G_STRUCT)
sfpColLong  = input.color(color.new(#26a69a, 0), "  Bullish SFP color", group = G_STRUCT)
sfpColShort = input.color(color.new(#ef5350, 0), "  Bearish SFP color", group = G_STRUCT)
// --- Order Blocks ---
showOB     = input.bool(true, "Order blocks after displacement", tooltip = "After a sweep+displacement, mark the last opposing candle as a demand/supply zone until mitigated.", group = G_STRUCT)
obDisp = 1.2
obColBull  = input.color(color.new(#26a69a, 80), "  Bullish OB color", group = G_STRUCT)
obColBear  = input.color(color.new(#ef5350, 80), "  Bearish OB color", group = G_STRUCT)
obKeep = 8
obFilterOn = input.bool(true, "  Filter order blocks by strength", tooltip = "Score every order block 0-100 at formation (decisive displacement body + the block's zone size + whether it formed from a SWEEP + relative volume) and only draw the ones that clear the threshold below — so only high-quality blocks show. The score is printed INSIDE the block.", group = G_STRUCT)
obMinStr   = input.int(45, "    Min OB strength % to draw", minval = 0, maxval = 100, tooltip = "Order blocks scoring below this are not drawn. A decisive, swept, high-volume block scores high; a marginal displacement scores low. Raise to show only the strongest blocks.", group = G_STRUCT)
obShowStr  = input.bool(true, "    Show OB strength % inside the block", tooltip = "Print the 0-100 strength centered inside the order block box (like the FVG inside-box label) so there's no right-edge label clutter.", group = G_STRUCT)

// -----------------------------------------------------------------------------
// INPUTS — COUNTDOWN
// -----------------------------------------------------------------------------
showCD    = input.bool(true,  "Show countdown to level",  group = G_CD)
velLen    = input.int(14, "Velocity lookback (bars)", minval = 2, group = G_CD)
cdMode    = input.string("Clock time", "Countdown units", options = ["Clock time","Bars"], group = G_CD)
dirAware  = input.bool(true,  "Only show for levels price is approaching", group = G_CD)

// -----------------------------------------------------------------------------
// INPUTS — CLUSTERING & CONFLUENCE
// -----------------------------------------------------------------------------
// --- MODE: one dropdown that bundles sensible defaults for a trading style ---
masterOn   = input.bool(true, "MASTER: draw everything", tooltip = "Global on/off for all drawings.", group = G_CLUST)
// --- declutter: one-click density + top-N-per-side + confidence gate (faint, not removed) ---
densityPreset = input.string("Balanced", "Chart density", options = ["Minimal","Balanced","Everything","Custom"], tooltip = "One-click declutter. MINIMAL: only the few strongest levels each side drawn boldly, everything else faint. BALANCED: a healthy handful. EVERYTHING: draw all at full strength (legacy). CUSTOM: use the Top-N / gate / fade values below. Levels below the cut are DIMMED (drawn faintly), never removed — so nothing is lost, it just recedes.", group = G_CLUST)
densTopN   = input.int(4, "  Custom: bold levels per side (Top-N by confidence)", minval = 1, maxval = 30, tooltip = "Only the N highest-confidence levels ABOVE and N BELOW price are drawn bold; the rest go faint. (Custom preset.)", group = G_CLUST)
densGate   = input.float(6.0, "  Custom: faint below confidence %", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Levels/zones whose confidence % is below this are drawn faintly. (Custom preset.)", group = G_CLUST)
densFadeOp = input.int(78, "  Faint opacity (0 solid → 100 invisible)", minval = 40, maxval = 96, tooltip = "How dim a de-emphasized level is drawn. Higher = fainter.", group = G_CLUST)
clusterOn  = input.bool(true, "Merge nearby levels into zones", group = G_CLUST)
clustDist  = input.float(0.5, "Cluster distance (× ATR)", minval = 0.05, step = 0.05, tooltip = "Levels within this many ATRs of each other merge into one strength-rated zone.", group = G_CLUST)
minStrength = input.int(1, "Min strength to display", minval = 1, maxval = 8, tooltip = "Only draw levels/zones whose strength (stacked count) is at least this. 2+ hides lone levels.", group = G_CLUST)
maxStrength   = input.int(4, "Max strength markers shown", minval = 1, maxval = 6, group = G_CLUST)
zoneOpacityMin = input.int(85, "Zone fill opacity — weakest", minval = 0, maxval = 100, group = G_CLUST)
zoneOpacityMax = input.int(55, "Zone fill opacity — strongest", minval = 0, maxval = 100, group = G_CLUST)
sideColorOn = input.bool(true, "Color-code by side (BSL/SSL)", tooltip = "Levels ABOVE price = BSL (resistance) use the BSL color; BELOW price = SSL (support) use the SSL color.", group = G_CLUST)
colBSL   = input.color(color.new(#ef5350, 0), "  BSL color (above price)", group = G_CLUST)
colSSL   = input.color(color.new(#26a69a, 0), "  SSL color (below price)", group = G_CLUST)
emojiBSL = input.string("🔴", "  BSL strength marker", options = ["🔴","🟥","🔺","🛑","⛔","🔻","💢"], group = G_CLUST)
emojiSSL = input.string("🟢", "  SSL strength marker", options = ["🟢","🟩","🔼","✅","💚","🔽","🌿"], group = G_CLUST)
strengthEmoji = input.string("🔥", "  Neutral strength marker (side off)", options = ["🔥","⭐","🟥","🟦","🟨","🔶","💠"], group = G_CLUST)
clustLblTxt = input.color(color.new(#ffffff, 0),  "Cluster label text color", group = G_CLUST)
showStrengthEmoji = input.bool(true, "Show strength emojis on clusters", group = G_CLUST)
showSideTag  = input.bool(true, "Show BSL/SSL text tag on clusters", group = G_CLUST)
outlineTags  = input.bool(true, "Outline level/cluster tags in side color", group = G_CLUST)
tieredEmoji  = input.bool(true, "Fun tiered strength emojis (💧⚡🔥💎🐋)", group = G_CLUST)
bigStrongLbl = input.bool(true, "Enlarge label for strong zones", group = G_CLUST)
// --- Confluence score ---
showConf    = input.bool(true, "Confluence score on zones (0-100)", tooltip = "Rolls up stacked levels + order-block overlap + OTE-fib proximity + premium/discount extreme + round-number proximity into a 0-100 'how loaded is this zone' score. The OTE/premium-discount factors are computed from the live dealing range internally (not drawn on the chart).", group = G_CLUST)
confMin     = input.int(0, "  Hide zones below score", minval = 0, maxval = 100, tooltip = "Only show cluster zones scoring at least this. 0 = show all.", group = G_CLUST)
confRound   = input.float(0.0, "  Round-number step (price)", minval = 0.0, tooltip = "Adds confluence when a zone sits near a round-number multiple of this step (e.g. 50/100 indices, 1000 BTC). 0 = disable.", group = G_CLUST)
confVWAP    = input.bool(true, "  VWAP proximity in confluence", tooltip = "Adds confluence when a level sits near the session VWAP — a heavily-defended fair-value reference. VWAP is used as a SCORING factor only (not drawn as its own magnet).", group = G_CLUST)

// -----------------------------------------------------------------------------
// INPUTS — LEVEL CONFIDENCE (draw-on-liquidity model)
// -----------------------------------------------------------------------------
showLvlConf = input.bool(true, "Show per-level confidence % (target likelihood)", tooltip = "Each level/zone gets a 0-100 score for how likely price heads THERE next. The single most-likely target is flagged 🎯.", group = G_DOL)
projStacked = input.bool(true,  "Stacked-agreement flag ⭐", tooltip = "Flags a level where multiple independent signals align — DOL bias side + primary magnet + an overlapping order block / FVG. 3+ agreeing signals is the highest-conviction projection. Adds ⭐ to that level.", group = G_DOL)
// DOL gravity model — fixed internal settings (powers level confidence %, 🎯 target, ⭐ flag,
// and path-clearance).
dolSens          = "Medium"   // distance-decay sharpness
dolUseType       = true       // major levels pull harder
dolUseAge        = true       // older resting liquidity pulls harder
dolMomWt         = 30.0       // % momentum tilt in the bias
dolConfW         = true       // weight pull by each level's confluence score
dolNearBias      = 1.5        // nearest-pool emphasis
dolFreshW        = true       // untested levels pull harder
lvlConfMode      = "Magnet quality"
projClearW       = 1.0        // path-clearance sensitivity
projLiveSess     = true       // a still-forming session H/L is not a magnet
projDistFloor    = true       // ignore levels hugging price
projDistFloorATR = 0.12
projResist       = true       // resistance-adjusted side strength
biasCap          = 0.5        // max share of a side's pull from one level
dolDeadband      = 0.10       // direction flips only when the bias clears this band
dolFlipConfirm   = true       // ...and only on a closed bar

// -----------------------------------------------------------------------------
// INPUTS — STYLE
// -----------------------------------------------------------------------------
uiTheme    = input.string("Refined Dark", "Panel theme", options = ["Refined Dark","Refined Light"], group = G_STYLE)
uiPanelOpacity = input.int(16, "Panel background opacity boost", minval = 0, maxval = 60, group = G_STYLE)
uiSlimBorders = input.bool(true, "Slim panel borders", group = G_STYLE)
lineWidth  = input.int(1, "Line width", minval = 1, maxval = 3, group = G_STYLE)
lineStyleI = input.string("Solid", "Line style", options = ["Solid","Dashed","Dotted"], group = G_STYLE)
labelSize  = input.string("Small", "Label size", options = ["Tiny","Small","Normal"], group = G_STYLE)
extendR    = input.int(10, "Line extend-right (bars)", minval = 0, group = G_STYLE)
colBull  = input.color(color.new(#26a69a, 0),  "Bullish / High color", group = G_STYLE)
colBear  = input.color(color.new(#ef5350, 0),  "Bearish / Low color",  group = G_STYLE)
colSess  = input.color(color.new(#42a5f5, 0),  "Session color",        group = G_STYLE)
colZone  = input.color(color.new(#ffb300, 0),  "Cluster zone color",   group = G_STYLE)
colFVGBase = input.color(color.new(#ab47bc, 0), "FVG fill color",       group = G_STYLE)
opacityFVG = input.int(80, "FVG zone opacity", minval = 0, maxval = 100, group = G_STYLE)

// level emoji tags (fixed)
emoPrev = "⭐"
emoSess = "🟡"
emoLiq  = "💧"

// -----------------------------------------------------------------------------
// INPUTS — TESTED LEVELS
// -----------------------------------------------------------------------------
// --- tested / virgin state: has price already PROBED a level (wicked in, not swept through)? ---
showTested   = input.bool(true, "Flag tested levels (probed, not swept)", tooltip = "Marks levels a wick has already PROBED into (reacted off) but not fully swept — 'used' liquidity vs a virgin untouched level. Tested levels get a ✓ and a dotted/dimmed outline; untouched ones stay solid. (Fully swept levels are removed already.)", group = G_TESTED)
testDepthATR = 0.10
testDiscount = true
testDiscAmt = 0.25
testKeep = 120

// -----------------------------------------------------------------------------
// INPUTS — FVG EXECUTION (setups)
// -----------------------------------------------------------------------------
// Turns high-quality gaps into actionable setups: wait for price to RETURN to the gap's CE
// (50%), then arm an entry with a stop and R-multiple targets, with alerts at each stage.

// -----------------------------------------------------------------------------
// INPUTS — DAILY BIAS
// -----------------------------------------------------------------------------
// A sticky, structural daily bias from daily candle structure + the last PDH/PDL sweep.
// Built from resolved HTF structure (not intraday proximity or momentum), so it LEADS rather
// than reacts. Used as a directional anchor: it drives the bias banner, fades counter-bias
// FVGs and counter-bias levels.
biasOn       = input.bool(true,  "Show Daily Bias", tooltip = "A sticky daily directional read built from the last 1-2 DAILY candles (market structure + close position) and the most recent PDH/PDL sweep + reclaim/reject. Because it is derived from resolved higher-timeframe structure — not intraday proximity or momentum — it LEADS price instead of reacting to it, and it HOLDS between real events (a new daily candle or a confirmed sweep) rather than flickering on 5-minute noise.", group = G_BIAS)
biasFast     = input.bool(true,  "  Fast flip (vs conservative)", tooltip = "FAST (default): a confirmed counter-direction PDH/PDL sweep + reclaim flips the bias immediately — catches reversals early. CONSERVATIVE (off): a counter sweep only raises a 'caution' flag; the bias doesn't actually flip until the DAILY STRUCTURE itself breaks — slower but higher-conviction.", group = G_BIAS)
biasBanner   = input.bool(true,  "  Show bias banner", group = G_BIAS)
biasBanPos   = input.string("Top Left", "  Bias banner position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], tooltip = "Where to anchor the Daily Bias banner. Defaults top-left so it doesn't collide with the DOL banner (top-right).", group = G_BIAS)
biasBanSize  = input.string("Large", "  Bias banner text size", options = ["Normal","Large","Huge"], group = G_BIAS)
// --- bias-aligned declutter ---
biasFadeFVG  = input.bool(true,  "Fade counter-bias FVGs", tooltip = "When a daily bias is set, fair value gaps that oppose it (bearish gaps while bias is LONG, and vice-versa) are drawn FAINT so the chart visually agrees with your one directional thesis. With-bias gaps stay prominent. Bias NEUTRAL = everything shows normally.", group = G_BIAS)
biasHideFVG  = input.bool(false, "  Hide counter-bias FVGs entirely", tooltip = "Instead of just fading them, remove counter-bias gaps from the chart completely. (They still exist in scoring — this is visual only.)", group = G_BIAS)
biasFadeLvls = input.bool(false, "Fade counter-bias-side levels", tooltip = "Also fade the levels on the counter-bias side of price (e.g. levels above price while bias is SHORT), so the magnets you're drawn toward stand out. Off = levels are left to the normal density declutter.", group = G_BIAS)

// -----------------------------------------------------------------------------
// INPUTS — MARKET CONDITIONS (REGIME)
// -----------------------------------------------------------------------------
// One shared TREND / RANGE / TRANSITION classifier (computed in MARKET CONDITION below). Feeds
// the Brooks setups' market-suitability factor and the context panel.
regimeOn   = input.bool(true,  "Show market condition (TREND / RANGE / TRANSITION)", tooltip = "One shared classifier used by the whole indicator (Brooks setups + context panel). Blends efficiency ratio, bar overlap, VWAP-cross frequency and EMA slope; TRANSITION = a trend losing efficiency, especially right after a genuine microtrendline break. Display only: shown in the context panel (or in the Brooks dashboard when that is on);", group = G_REGIME)
mtTrendHi   = input.float(0.55, "  Trend score threshold", minval = 0.2, maxval = 0.9, step = 0.05, group = G_REGIME)
mtTransBars = input.int(15, "  Transition window after a microtrendline break (bars)", minval = 3, maxval = 60, group = G_REGIME)

// -----------------------------------------------------------------------------
// INPUTS — OPENING RANGE BREAKOUT (ORB)
// -----------------------------------------------------------------------------
// The high/low of the opening window (default the first 5 minutes of the NY session) drawn as a
// box, with a confirmed break (buffer + consecutive closes) and failed-break marker.
orbOn      = input.bool(true, "Show Opening Range (ORB)", tooltip = "Draws the HIGH and LOW of the opening window (default the first 5 minutes of the NY session) as a box, frozen once the window closes. A break is marked (ORB ▲ / ORB ▼) when price closes beyond an edge by the buffer for the required consecutive closes; a later close back inside marks ORB fail.", group = G_ORB)
orbSession = input.session("0930-0935", "  Opening window (session time)", tooltip = "The opening range window. Default 0930-0935 = the first 5 minutes of the NY equities open. Works on any chart timeframe (on a 5-minute chart this is the first 5m bar; on a 1m chart, the first five 1m bars).", group = G_ORB)
orbTZ      = input.string("America/New_York", "  Opening window timezone", options = ["America/New_York","UTC","Europe/London","Asia/Tokyo"], group = G_ORB)
orbCol     = input.color(color.new(#42a5f5, 0), "  ORB color", group = G_ORB)
orbExtend  = input.bool(true, "  Extend ORB across the session", group = G_ORB)
orbHist    = input.int(10, "  Max historical ORBs kept", minval = 1, maxval = 60, tooltip = "How many past days' opening-range boxes stay drawn on the chart for look-back analysis. Oldest is dropped when the limit is reached.", group = G_ORB)
orbBrkBuf  = input.float(0.10, "  Break buffer (× ATR beyond edge)", minval = 0.0, maxval = 2.0, step = 0.05, tooltip = "A close must clear the opening-range edge by this many ATRs before it counts as a break — so a one-tick poke beyond the high/low no longer registers as a breakout. Raising this filters noise and lifts the realized 'breaks held' rate (at the cost of registering real breaks a touch later). 0 = legacy behaviour (any close beyond the edge). On the 5-minute chart ~0.10-0.25 cuts most fakeouts.", group = G_ORB)
orbBrkBars = input.int(1, "  Break confirmation (consecutive closes)", minval = 1, maxval = 5, tooltip = "How many CONSECUTIVE confirmed closes beyond the buffered edge are required before a break is registered. 1 = a single qualifying close (legacy). 2+ filters flash-breaks that immediately reverse, raising the hold rate.", group = G_ORB)

// -----------------------------------------------------------------------------
// INPUTS — ⑫ BROOKS MICROTRENDLINES (execution + entries)
// -----------------------------------------------------------------------------
var string G_MT  = "⑫ Brooks Microtrendlines · Core & Display"
var string G_MTD = "⑫ Brooks Microtrendlines · Detection"
var string G_MTS = "⑫ Brooks Microtrendlines · Setups & Signal Bar"
var string G_MTC = "⑫ Brooks Microtrendlines · Confidence Weights"
