// ---- core & display ----
mtOn        = input.bool(true, "Enable Brooks microtrendline module", tooltip = "Master on/off for the whole microtrendline price-action module (trendlines, setups, dashboard, alerts, stats). Off = nothing from this module is calculated or drawn.", group = G_MT)
mtTF5       = input.timeframe("5", "  Secondary context timeframe", group = G_MT)
mtTF15      = input.timeframe("15", "  Higher-timeframe directional context", group = G_MT)
