mtTblSz     = input.string("Tiny", "  Dashboard / stats text size", options = ["Tiny","Small"], group = G_MT)
mtDashPos   = input.string("Top Right", "  Dashboard position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], group = G_MT)
mtShowTL    = input.bool(true, "Show active trendlines", group = G_MT)
mtShowHist  = input.bool(true, "Show historical trendlines", group = G_MT)
mtHistKeep  = input.int(12, "  Historical trendlines kept", minval = 1, maxval = 60, group = G_MT)
mtShowBrk   = input.bool(true, "Show break / failed-breakout markers", group = G_MT)
mtShowSig   = input.bool(true, "Show LONG / SHORT signal markers", group = G_MT)
mtShowHL    = input.bool(true, "Show H1/H2/L1/L2 markers", group = G_MT)
mtShowLvls  = input.bool(true, "Show entry / stop / target levels", group = G_MT)
mtKeepLvls  = input.bool(true, "  Keep finished setups' levels (last few)", group = G_MT)
mtShowVwap  = input.bool(false, "Show VWAP", group = G_MT)
mtShowBg    = input.bool(false, "Market-condition background shading", group = G_MT)
mtColBull   = input.color(#00c853, "  Bullish trendline", group = G_MT)
mtColBear   = input.color(#ff1744, "  Bearish trendline", group = G_MT)
mtColBrk    = input.color(#ff9800, "  Break marker / broken line", group = G_MT)

// ---- detection ----
mtPivL      = input.int(2, "Pivot sensitivity · bars left", minval = 1, maxval = 6, group = G_MTD)
mtPivR      = input.int(1, "Pivot sensitivity · bars right", minval = 1, maxval = 4, tooltip = "Pivots are confirmed this many bars late (no repaint). Smaller = faster, noisier.", group = G_MTD)
mtMinTouch  = input.int(2, "Minimum trendline touches", minval = 2, maxval = 5, group = G_MTD)
mtMaxAge    = input.int(30, "Maximum trendline age (bars since last touch)", minval = 5, maxval = 200, group = G_MTD)
mtMinBetween = input.int(2, "Min bars between pivots", minval = 1, maxval = 10, group = G_MTD)
mtMaxBetween = input.int(10, "Max bars between pivots", minval = 3, maxval = 30, tooltip = "Keeps lines MICRO (about 2-10 bars) rather than structural trendlines.", group = G_MTD)
mtMinSlope  = input.float(0.02, "Minimum slope (ATR per bar)", minval = 0.0, step = 0.01, group = G_MTD)
mtMaxPen    = input.float(0.15, "Max penetration before 'broken' (× ATR)", minval = 0.0, step = 0.05, group = G_MTD)
mtTouchTol  = input.float(0.12, "Touch tolerance (× ATR)", minval = 0.0, step = 0.02, group = G_MTD)
mtMcOn      = input.bool(true, "Microchannel detection (few-bar channels)", tooltip = "Strong microchannels can develop over very few bars. Consecutive bars with rising lows/highs (falling for bears) get a supporting line without needing separated pivots.", group = G_MTD)
mtMcMin     = input.int(4, "  Microchannel min bars", minval = 3, maxval = 10, group = G_MTD)
mtMcTol     = input.float(0.05, "  Microchannel tolerance (× ATR)", minval = 0.0, step = 0.01, group = G_MTD)
mtMcMinMove = input.float(1.0, "  Microchannel min net move (× ATR)", minval = 0.0, step = 0.1, group = G_MTD)
mtFailBars  = input.int(4, "Failed-breakout window (bars to reclaim)", minval = 1, maxval = 12, tooltip = "After a penetration, price must close back on the trend side of the line within this many bars to count as a FAILED breakout; otherwise it is a genuine break.", group = G_MTD)
mtSigWait   = input.int(2, "Signal-bar wait after reclaim (bars)", minval = 0, maxval = 6, group = G_MTD)

// ---- setups & signal bar ----
mtSetA      = input.bool(true, "Setup A · Failed microtrendline breakout", group = G_MTS)
mtSetB      = input.bool(true, "Setup B · Break + pullback continuation", group = G_MTS)
mtSetC      = input.bool(true, "Setup C · Failed-breakout reversal", group = G_MTS)
mtSetD      = input.bool(true, "Setup D · High 2 / Low 2", group = G_MTS)
mtPostBreak = input.int(20, "Post-break window for B / C (bars)", minval = 5, maxval = 100, group = G_MTS)
mtMaxRetr   = input.float(0.75, "B · max pullback retracement of the leg", minval = 0.2, maxval = 1.0, step = 0.05, group = G_MTS)
mtSupTol    = input.float(0.8, "B · support/resistance proximity (× ATR)", minval = 0.1, step = 0.1, group = G_MTS)
mtExtATR    = input.float(3.0, "C · min extension of prior move (× ATR)", minval = 0.5, step = 0.5, group = G_MTS)
mtRetestTol = input.float(0.25, "C · retest zone around old extreme (× ATR)", minval = 0.0, step = 0.05, group = G_MTS)
mtRetestOver = input.float(0.25, "C · max overshoot of old extreme (× ATR)", minval = 0.0, step = 0.05, group = G_MTS)
mtRevConf   = input.int(3, "C · confirmations required (of 5)", minval = 1, maxval = 5, group = G_MTS)
mtRevSbMin  = input.float(0.65, "C · min signal-bar quality (0-1)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_MTS)
mtPbMax     = input.int(15, "H/L · max pullback length (bars)", minval = 3, maxval = 50, group = G_MTS)
mtPbDepth   = input.float(5.0, "H/L · max pullback depth (× ATR)", minval = 1.0, step = 0.5, group = G_MTS)
mtSbBody    = input.float(0.45, "Signal bar · min body / range", minval = 0.0, maxval = 1.0, step = 0.05, group = G_MTS)
mtSbClose   = input.float(0.65, "Signal bar · min close position (0=far, 1=at extreme)", minval = 0.0, maxval = 1.0, step = 0.05, group = G_MTS)
mtSbWick    = input.float(0.30, "Signal bar · max opposing wick / range", minval = 0.0, maxval = 1.0, step = 0.05, group = G_MTS)
mtSbSize    = input.float(0.6, "Signal bar · min size vs 20-bar average range", minval = 0.0, step = 0.1, group = G_MTS)

// ---- confidence weights (normalised, so they need not sum to 100) ----
mtWHtf      = input.float(15, "Weight · higher-timeframe alignment", minval = 0, group = G_MTC)
mtWTl       = input.float(15, "Weight · microtrendline quality", minval = 0, group = G_MTC)
mtWFbo      = input.float(20, "Weight · pattern / failed-breakout confirmation", minval = 0, group = G_MTC)
mtWSb       = input.float(15, "Weight · signal bar quality", minval = 0, group = G_MTC)
mtWMkt      = input.float(10, "Weight · market-condition suitability", minval = 0, group = G_MTC)
mtWVwap     = input.float(10, "Weight · VWAP alignment", minval = 0, group = G_MTC)
mtWH        = input.float(10, "Weight · H1/H2 · L1/L2 confluence", minval = 0, group = G_MTC)
mtWRoom     = input.float(5, "Weight · room to target", minval = 0, group = G_MTC)
mtVwapOn    = input.bool(true, "VWAP filter (scoring only; off = VWAP weight ignored)", group = G_MTC)
mtMinScore  = input.int(65, "Minimum score to display an actionable signal", minval = 30, maxval = 95, group = G_MTC)

// ---- trade plan ----
mtStopMode  = input.string("Wider of both", "Stop placement", options = ["Signal bar","Structural","Wider of both"], group = G_MTT)
mtMinStopATR = input.float(0.4, "Minimum stop distance (× ATR)", minval = 0.05, step = 0.05, group = G_MTT)
mtMaxStopATR = input.float(3.0, "Maximum stop distance (× ATR) · wider = no setup", minval = 0.5, step = 0.25, group = G_MTT)
mtTgtMode   = input.string("R multiples", "Targets based on", options = ["R multiples","Market structure"], group = G_MTT)
mtT1R       = input.float(1.0, "Target 1 (R)", minval = 0.25, step = 0.25, group = G_MTT)
mtT2R       = input.float(2.0, "Target 2 (R)", minval = 0.5, step = 0.25, group = G_MTT)
mtShowT3    = input.bool(true, "Show Target 3 (swing / measured move)", group = G_MTT)
mtPendBars  = input.int(3, "Pending entry expires after (bars)", minval = 1, maxval = 20, group = G_MTT)
mtMaxHold   = input.int(60, "Max bars in trade before time-out", minval = 5, maxval = 500, group = G_MTT)

// ---- alerts & stats ----
mtAlertFn   = input.bool(true, "Send detailed alert() messages (instrument · TF · setup · direction · score)", tooltip = "Create the alert with condition 'Any alert() function call'. The alertcondition() entries below are always available too.", group = G_MTA)
mtShowStats = input.bool(true, "Show historical signal statistics table", group = G_MTA)
mtStatsMode = input.string("Summary", "  Stats layout", options = ["Summary","Full"], tooltip = "Summary: overall + by score grade (2 rows). Full: by setup, market condition, time of day and score.", group = G_MTA)
mtStatsPos  = input.string("Bottom Right", "  Stats table position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], group = G_MTA)
mtStatsTgt  = input.string("Target 1", "  A signal 'wins' when it reaches", options = ["Target 1","Target 2"], group = G_MTA)
mtStatsRng  = input.bool(false, "  Restrict statistics to date range", group = G_MTA)
mtStatsFrom = input.time(timestamp("2024-01-01T00:00:00"), "    From", group = G_MTA)
mtStatsTo   = input.time(timestamp("2100-01-01T00:00:00"), "    To", group = G_MTA)

f_lineStyle() =>
    lineStyleI == "Dashed" ? line.style_dashed : lineStyleI == "Dotted" ? line.style_dotted : line.style_solid

// effective density preset + confidence window
string eDensity = densityPreset
int   eConfWin  = 5          // confidence % shown on the 5 nearest levels each side

// --- density preset -> effective declutter params (Custom uses the raw inputs) ---
// eTopN: how many levels per side (by confidence) stay BOLD; eGate: faint below this
// confidence %. Everything = draw all at full strength. De-emphasised levels are drawn
// FAINT (never removed), so nothing is lost — it just recedes.
int   eTopN = eDensity == "Minimal" ? 2 : eDensity == "Balanced" ? 4 : eDensity == "Everything" ? 9999 : densTopN
float eGate = eDensity == "Minimal" ? 12.0 : eDensity == "Balanced" ? 6.0 : eDensity == "Everything" ? 0.0 : densGate
bool  densOn = eDensity != "Everything"

// tested-state memory: prices that a wick has PROBED into (persists across the per-bar
// level rebuild). Populated in the capture block below; read at scoring + render time.
var testedP = array.new<float>()
f_isTested(float price, float atrU) =>
    bool hit = false
    if showTested and array.size(testedP) > 0
        float tol = math.max(atrU * 0.10, syminfo.mintick)
        for ti = 0 to array.size(testedP) - 1
            if math.abs(array.get(testedP, ti) - price) <= tol
                hit := true
    hit

f_labelSize() =>
    labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : size.small

// --- theme palette ---
themeBgBase  = uiTheme == "Refined Light" ? color.new(#f5f6fa, 0) : color.new(#171a21, 0)
themeTxt     = uiTheme == "Refined Light" ? color.new(#2b2f3a, 0) : color.new(#e6e9ef, 0)
themeMuted   = uiTheme == "Refined Light" ? color.new(#6b7280, 0) : color.new(#9aa4b2, 0)
themeUpSolid = color.new(#4db6ac, 0)
themeDnSolid = color.new(#e08d8d, 0)
themePanelBg = color.new(themeBgBase, math.min(100, uiPanelOpacity))
themeRowBg   = color.new(themeBgBase, math.min(100, uiPanelOpacity + 8))
themeBW      = uiSlimBorders ? 1 : 2

// core series
velocity  = ta.sma(math.abs(ta.change(close)), velLen)
secPerBar = timeframe.in_seconds(timeframe.period)
atr       = ta.atr(14)

// HTF-FVG scoring is only relevant on low timeframes (1-5 min by default). On higher chart
// timeframes the gap score reverts to the original full-weight model (see f_fvgStrength).
fvgHtfActive = (secPerBar / 60.0) <= htfFvgMaxTF

// -----------------------------------------------------------------------------
// SHARED MOMENTUM + RELATIVE VOLUME
// -----------------------------------------------------------------------------
dolEmaF   = ta.ema(close, 21)
dolEmaS   = ta.ema(close, 55)
dolTrendV = (dolEmaF - dolEmaS) / math.max(nz(atr), syminfo.mintick)
dolRoc    = ta.roc(close, 9) / 100.0
dolMomRaw = 0.6 * dolTrendV + 0.4 * (dolRoc * 20.0)
dolMom    = math.max(-1.0, math.min(1.0, dolMomRaw))
avgVol = ta.sma(volume, rvolLen)
rvol   = nz(avgVol) > 0 ? volume / avgVol : 0.0
volOK  = (not sfpUseVol) or (rvol >= rvolMult)

// -----------------------------------------------------------------------------
// HELPERS
// -----------------------------------------------------------------------------

f_tablePos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : p == "Middle Left" ? position.middle_left : position.middle_right


// clamp a drawing's start bar to inside the loaded history buffer (never < 0)
f_clampBar(int b) =>
    int back = math.min(bar_index, 300)
    int floorBar = bar_index - back
    int r = na(b) ? floorBar : math.max(b, floorBar)
    math.max(math.min(r, bar_index), 0)

// countdown-to-level string
f_countdown(float target) =>
    string outTxt = ""
    if showCD and nz(velocity) > 0 and not na(target)
        float dist = math.abs(target - close)
        bool approaching = (target > close and close > nz(close[1], close)) or (target < close and close < nz(close[1], close))
        if (not dirAware) or approaching
            float bars = dist / velocity
            if cdMode == "Bars"
                outTxt := " → ≈ " + str.tostring(math.round(bars)) + "b"
            else
                float secs = bars * secPerBar
                if secs < 3600
                    outTxt := " → ≈ " + str.tostring(math.round(secs / 60)) + "m"
                else if secs < 86400
                    int h = int(math.floor(secs / 3600))
                    int m = int(math.round((secs - h * 3600) / 60))
                    outTxt := " → ≈ " + str.tostring(h) + "h " + str.tostring(m) + "m"
                else
                    outTxt := " → ≈ " + str.tostring(math.round(secs / 86400)) + "d"
    outTxt

f_repeat(string e, int n) =>
    string s = ""
    int cnt = math.min(n, maxStrength)
    for i = 1 to cnt
        s := s + e
    s

f_tierEmoji(int members) =>
    members <= 1 ? "💧" : members == 2 ? "⚡" : members == 3 ? "🔥" : members == 4 ? "💎" : "🐋"

f_strongSize(int members) =>
    not bigStrongLbl ? f_labelSize() : (members >= 4 ? size.large : members >= 2 ? size.normal : f_labelSize())

// BSL/SSL by POSITION vs price
f_sideColI(int side, float lvl, color fallback) =>
    not sideColorOn ? fallback : (lvl >= close ? colBSL : colSSL)
f_sideEmojiI(int side, float lvl) =>
    not sideColorOn ? strengthEmoji : (lvl >= close ? emojiBSL : emojiSSL)
f_sideTagI(int side, float lvl) =>
    lvl >= close ? "BSL" : "SSL"


f_sessName(string base, bool carried) =>
    (sessReclassify and carried) ? (base + " (swing)") : base


f_extLen(int birthBar) => extendR

// -----------------------------------------------------------------------------
// LEVEL SOURCES
// -----------------------------------------------------------------------------
pdh   = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl   = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh   = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl   = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)
pmh   = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_on)
pml   = request.security(syminfo.tickerid, "M", low[1],  lookahead = barmerge.lookahead_on)
dOpen = request.security(syminfo.tickerid, "D", open,    lookahead = barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", open,    lookahead = barmerge.lookahead_on)
mOpen = request.security(syminfo.tickerid, "M", open,    lookahead = barmerge.lookahead_on)
// NY midnight open: capture price at the first bar of the New York (ET) day.
var float midO = na
bool newNYDay = ta.change(time("D", "0000-0000", "America/New_York")) != 0
if newNYDay
    midO := open
// session VWAP (scoring factor only)
vwapVal = ta.vwap(hlc3)

// -----------------------------------------------------------------------------
// SESSIONS
// -----------------------------------------------------------------------------
f_inSession(string s) => not na(time(timeframe.period, s, sessTZ))
newDay = ta.change(time("D", "0000-0000", sessTZ)) != 0

f_sessHL(bool active, string sess) =>
    var float hi        = na
    var float lo        = na
    var bool  prevIn    = false
    var bool  hiCarried = false
    var bool  loCarried = false
    bool inS = f_inSession(sess)
    if active
        if sessResetDaily and newDay
            hiCarried := not na(hi)
            loCarried := not na(lo)
        if inS and not prevIn
            hi := high
            lo := low
            hiCarried := false
            loCarried := false
        else if inS
            hi := math.max(nz(hi, high), high)
            lo := math.min(nz(lo, low), low)
        if sessRemoveSwept
            if not na(hi) and high > hi
                hi := na
                hiCarried := false
            if not na(lo) and low < lo
                lo := na
                loCarried := false
    prevIn := inS
    // "forming" = we're inside this session AND the current bar is at/making the extreme.
    // A forming extreme is not resting liquidity yet (price is defining it in real time),
    // so it should NOT act as a DOL magnet / carry a confidence % (it would just chase price).
    bool hiForming = active and inS and not na(hi) and high >= hi
    bool loForming = active and inS and not na(lo) and low  <= lo
    [hi, lo, hiCarried, loCarried, hiForming, loForming]

[asiaH, asiaL, asiaHc, asiaLc, asiaHf, asiaLf] = f_sessHL(showAsia, asiaSess)
[londH, londL, londHc, londLc, londHf, londLf] = f_sessHL(showLond, londSess)
[nyH,   nyL,   nyHc,   nyLc,   nyHf,   nyLf]   = f_sessHL(showNY,   nySess)

// -----------------------------------------------------------------------------
// SWINGS + HTF SWINGS
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

f_htfPH() => ta.pivothigh(high, htfLen, htfLen)
f_htfPL() => ta.pivotlow(low, htfLen, htfLen)
htfPH = htfSwingOn ? request.security(syminfo.tickerid, htfTF, f_htfPH(), lookahead = barmerge.lookahead_off) : na
htfPL = htfSwingOn ? request.security(syminfo.tickerid, htfTF, f_htfPL(), lookahead = barmerge.lookahead_off) : na
htfPHchg = not na(htfPH) and (na(htfPH[1]) or htfPH != htfPH[1])
htfPLchg = not na(htfPL) and (na(htfPL[1]) or htfPL != htfPL[1])

// --- HTF Fair Value Gaps: detect the 3-candle gap natively on the HTF, pull back the
// zone bounds + polarity + displacement volume in one security call. Box-less: they boost
// aligned chart-TF gap scores and feed the DOL model, but are never drawn as boxes. ---
f_htfFvg() =>
    bool bull = low > nz(high[2], low)
    bool bear = high < nz(low[2], high)
    bool exists = bull or bear
    float gT = bull ? low   : (bear ? low[2] : na)
    float gB = bull ? high[2] : (bear ? high  : na)
    float dV = nz(volume[1], volume)
    int   bn = bar_index
    [exists ? 1 : 0, gT, gB, bull ? 1 : 0, dV, bn]
// NOTE: request.security is called unconditionally (a ternary cannot return a tuple in Pine).
// The htfFvgOn guards on htfFvgNew / registration below suppress all tracking when it's off.
[hfvgEx, hfvgT, hfvgB, hfvgBull, hfvgVol, hfvgBar] = request.security(syminfo.tickerid, htfTF, f_htfFvg(), lookahead = barmerge.lookahead_off)
// a gap is "new" when the reported HTF bar index advances (one registration per HTF bar)
htfFvgNew = htfFvgOn and nz(hfvgEx) == 1 and not na(hfvgT) and not na(hfvgB) and (na(hfvgBar[1]) or hfvgBar != hfvgBar[1])

var float lastPH = na
var float lastPL = na
var int rangeDir = 0
if showSwing or showEQ or showConf
    if not na(ph)
        lastPH := ph
        rangeDir := -1
    if not na(pl)
        lastPL := pl
        rangeDir := 1

// LIVE dealing range (for the confluence OTE / premium-discount factor).
// Computed internally whenever the confluence score is on; NOT drawn on the chart.
// One end anchors to the freshest opposing swing; the other tracks the running
// extreme, so the OTE levels re-measure as price continues in the leg's direction.
var float rngHi = na
var float rngLo = na
if showConf
    if not na(pl)
        rngLo := pl
        rngHi := math.max(nz(rngHi, high), high)
    if not na(ph)
        rngHi := ph
        rngLo := math.min(nz(rngLo, low), low)
    if rangeDir >= 0
        rngHi := math.max(nz(rngHi, high), high)
    else
        rngLo := math.min(nz(rngLo, low), low)

// OTE retracement ratios used by the confluence score (internal; never drawn)
var float pdFib1 = 0.705
var float pdFib2 = 0.788
var float pdFib3 = 0.886

// -----------------------------------------------------------------------------
// MODULE STATE OBJECTS — persistent state + per-bar event flags live in objects so the large
// engine blocks can run inside functions (Pine forbids assigning globals from a function, but
// object fields can be updated). Keeps the script's main body under TradingView's size limit.
// -----------------------------------------------------------------------------
type MtState
    int cond = 2
    float hbRef = na
    bool hbPb = false
    int hbCnt = 0
    bool hbLeg = false
    float hbLow = na
    int hbBars = 0
    float lbRef = na
    bool lbPb = false
    int lbCnt = 0
    bool lbLeg = false
    float lbHigh = na
    int lbBars = 0
    int mtLastGenBar = -1000
    int mtLastHBar = -1000
    int mtLastHDir = 0
    int mtLastHCnt = 0
    int stSt = 0
    int stDir = 0
    int stType = 0
    float stScore = 0.0
    float stEntry = na
    float stStop = na
    float stT1 = na
    float stT2 = na
    float stT3 = na
    float stRisk = na
    float stFill = na
    float stSq = 0.0
    int stSigBar = 0
    int stEntryBar = 0
    bool stT1Hit = false
    bool stT2Hit = false
    bool stResolved = false
    int stCond = 2
    int stTod = 4
    string stRes = ""
    line stLnE = na
    line stLnS = na
    line stLnT1 = na
    line stLnT2 = na
    line stLnT3 = na
    label stLbE = na
    label stLbS = na
    label stLbT1 = na
    label stLbT2 = na
    label stLbT3 = na

type MtEv
    bool mtEvNewBull = false
    bool mtEvNewBear = false
    bool mtEvBrkBull = false
    bool mtEvBrkBear = false
    bool mtEvFboBull = false
    bool mtEvFboBear = false
    bool mtEvH1 = false
    bool mtEvH2 = false
    bool mtEvL1 = false
    bool mtEvL2 = false
    bool mtEvContL = false
    bool mtEvContS = false
    bool mtEvRevL = false
    bool mtEvRevS = false
    bool mtEvH2L = false
    bool mtEvL2S = false
    bool mtEvEntry = false
    bool mtEvStop = false
    bool mtEvT1 = false
    bool mtEvT2 = false
    bool mtEvSetupL = false
    bool mtEvSetupS = false

var MtState mtS = MtState.new()   // Brooks module persistent state

// -----------------------------------------------------------------------------
// MARKET CONDITION — one shared classifier: 1 TREND · 2 RANGE · 3 TRANSITION
// -----------------------------------------------------------------------------
// Efficiency ratio (net move / path), bar overlap, VWAP-cross frequency and EMA slope blend into
// a 0..1 trend score. TRANSITION = efficiency collapsing from a trending read, especially right
// after a genuine microtrendline break (mtS.mtLastGenBar is set by the Brooks engine, one bar lag).
float mtEma20  = ta.ema(close, 20)
float mtPath   = math.sum(math.abs(ta.change(close)), 20)
float mtEr20   = mtPath > 0 ? math.abs(close - close[20]) / mtPath : 0.0
float mtPath10 = math.sum(math.abs(ta.change(close)), 10)
float mtErNow  = mtPath10 > 0 ? math.abs(close - close[10]) / mtPath10 : 0.0
float mtErPrev = nz(mtErNow[10])
float mtBarRng = high - low
float mtOvl    = mtBarRng > 0 ? math.max(0.0, math.min(1.0, (math.min(high, high[1]) - math.max(low, low[1])) / mtBarRng)) : 1.0
float mtOvlAvg = ta.sma(mtOvl, 20)
float vwapCrosses = math.sum((not na(vwapVal) and ((close > vwapVal and close[1] <= nz(vwapVal[1])) or (close < vwapVal and close[1] >= nz(vwapVal[1])))) ? 1.0 : 0.0, 20)
bool  regimeChop  = vwapCrosses >= 4
float mtSlopeAtr  = atr > 0 ? math.abs(mtEma20 - mtEma20[5]) / atr : 0.0
float mtTrendScore = 0.4 * mtEr20 + 0.2 * (1.0 - mtOvlAvg) + 0.2 * (1.0 - math.min(1.0, vwapCrosses / 4.0)) + 0.2 * math.min(1.0, mtSlopeAtr)
f_mtCondCalc(int lastGen) =>
    int c = 2
    if mtErPrev >= 0.4 and mtErNow <= 0.6 * mtErPrev and (bar_index - lastGen <= mtTransBars or mtErNow <= 0.25)
        c := 3
    else if mtTrendScore >= mtTrendHi
        c := 1
    c
int mtCond = f_mtCondCalc(mtS.mtLastGenBar)
mtS.cond := mtCond

// historical swing storage
var swHi   = array.new<float>()
var swHiB  = array.new<int>()
var swLo   = array.new<float>()
var swLoB  = array.new<int>()

if showSwing and not na(ph)
    array.push(swHi, ph)
    array.push(swHiB, bar_index - swingLen)
if showSwing and not na(pl)
    array.push(swLo, pl)
    array.push(swLoB, bar_index - swingLen)
if showSwing and htfSwingOn and htfPHchg
    array.push(swHi, htfPH)
    array.push(swHiB, na)
if showSwing and htfSwingOn and htfPLchg
    array.push(swLo, htfPL)
    array.push(swLoB, na)

// sweep-removal from swing arrays
if removeSwept and array.size(swHi) > 0
    int ih = 0
    while ih < array.size(swHi)
        if high > array.get(swHi, ih)
            array.remove(swHi, ih)
            array.remove(swHiB, ih)
        else
            ih += 1
if removeSwept and array.size(swLo) > 0
    int il = 0
    while il < array.size(swLo)
        if low < array.get(swLo, il)
            array.remove(swLo, il)
            array.remove(swLoB, il)
        else
            il += 1
while array.size(swHi) > swingHist
    array.shift(swHi)
    array.shift(swHiB)
while array.size(swLo) > swingHist
    array.shift(swLo)
    array.shift(swLoB)

// -----------------------------------------------------------------------------
// EQUAL HIGHS / LOWS — rolling-buffer detection
// -----------------------------------------------------------------------------
float eqTolPrice = nz(atr) * eqTol
float relEqTolPrice = nz(atr) * relEqTol
var pvHi  = array.new<float>()
var pvLo  = array.new<float>()
var eqHiA = array.new<float>()
var eqHiB = array.new<int>()
var eqLoA = array.new<float>()
var eqLoB = array.new<int>()
var reqHiA = array.new<float>()   // relative (near) equal highs
var reqHiB = array.new<int>()
var reqLoA = array.new<float>()   // relative (near) equal lows
var reqLoB = array.new<int>()

// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkEqHigh() =>
    if showEQ and not na(ph)
        bool found = false
        bool relFound = false
        float matched = na
        float relMatched = na
        int hs = array.size(pvHi)
        if hs > 0
            int start = math.max(hs - eqLookback, 0)
            for qi = start to hs - 1
                float prevH = array.get(pvHi, qi)
                float d = math.abs(ph - prevH)
                if d <= eqTolPrice
                    found := true
                    matched := math.max(ph, prevH)
                else if showRelEQ and d <= relEqTolPrice
                    relFound := true
                    relMatched := math.max(ph, prevH)
        if found
            array.push(eqHiA, matched)
            array.push(eqHiB, bar_index - swingLen)
        else if relFound
            array.push(reqHiA, relMatched)
            array.push(reqHiB, bar_index - swingLen)
        array.push(pvHi, ph)
        while array.size(pvHi) > 40
            array.shift(pvHi)
    true
f_blkEqHigh()

// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkEqLow() =>
    if showEQ and not na(pl)
        bool found = false
        bool relFound = false
        float matched = na
        float relMatched = na
        int ls = array.size(pvLo)
        if ls > 0
            int start = math.max(ls - eqLookback, 0)
            for qi = start to ls - 1
                float prevL = array.get(pvLo, qi)
                float d = math.abs(pl - prevL)
                if d <= eqTolPrice
                    found := true
                    matched := math.min(pl, prevL)
                else if showRelEQ and d <= relEqTolPrice
                    relFound := true
                    relMatched := math.min(pl, prevL)
        if found
            array.push(eqLoA, matched)
            array.push(eqLoB, bar_index - swingLen)
        else if relFound
            array.push(reqLoA, relMatched)
            array.push(reqLoB, bar_index - swingLen)
        array.push(pvLo, pl)
        while array.size(pvLo) > 40
            array.shift(pvLo)
    true
f_blkEqLow()

if array.size(eqHiA) > 0
    int i = 0
    while i < array.size(eqHiA)
        if removeSwept and high > array.get(eqHiA, i)
            array.remove(eqHiA, i)
            array.remove(eqHiB, i)
        else
            i += 1
if array.size(eqLoA) > 0
    int i = 0
    while i < array.size(eqLoA)
        if removeSwept and low < array.get(eqLoA, i)
            array.remove(eqLoA, i)
            array.remove(eqLoB, i)
        else
            i += 1
while array.size(eqHiA) > swingHist
    array.shift(eqHiA)
    array.shift(eqHiB)
while array.size(eqLoA) > swingHist
    array.shift(eqLoA)
    array.shift(eqLoB)
// relative-EQ maintenance (sweep removal + size cap), mirroring exact EQ
if array.size(reqHiA) > 0
    int i = 0
    while i < array.size(reqHiA)
        if removeSwept and high > array.get(reqHiA, i)
            array.remove(reqHiA, i)
            array.remove(reqHiB, i)
        else
            i += 1
if array.size(reqLoA) > 0
    int i = 0
    while i < array.size(reqLoA)
        if removeSwept and low < array.get(reqLoA, i)
            array.remove(reqLoA, i)
            array.remove(reqLoB, i)
        else
            i += 1
while array.size(reqHiA) > swingHist
    array.shift(reqHiA)
    array.shift(reqHiB)
while array.size(reqLoA) > swingHist
    array.shift(reqLoA)
    array.shift(reqLoB)

// -----------------------------------------------------------------------------
// BIRTH-BAR TRACKING (level age → DOL age weighting)
// -----------------------------------------------------------------------------
var int b_pdh = na, var int b_pdl = na
var int b_pwh = na, var int b_pwl = na
var int b_pmh = na, var int b_pml = na
var int b_do  = na
var int b_wo  = na, var int b_mo = na, var int b_mid = na
var int b_ah  = na, var int b_al = na
var int b_lh  = na, var int b_ll = na
var int b_nh  = na, var int b_nl = na
b_pdh := (na(b_pdh) or pdh != pdh[1]) ? bar_index : b_pdh
b_pdl := (na(b_pdl) or pdl != pdl[1]) ? bar_index : b_pdl
b_pwh := (na(b_pwh) or pwh != pwh[1]) ? bar_index : b_pwh
b_pwl := (na(b_pwl) or pwl != pwl[1]) ? bar_index : b_pwl
b_pmh := (na(b_pmh) or pmh != pmh[1]) ? bar_index : b_pmh
b_pml := (na(b_pml) or pml != pml[1]) ? bar_index : b_pml
b_do  := (na(b_do)  or dOpen != dOpen[1]) ? bar_index : b_do
b_wo  := (na(b_wo)  or wOpen != wOpen[1]) ? bar_index : b_wo
b_mo  := (na(b_mo)  or mOpen != mOpen[1]) ? bar_index : b_mo
b_mid := (na(b_mid) or midO  != midO[1])  ? bar_index : b_mid
b_ah  := (na(b_ah)  or asiaH != asiaH[1]) ? bar_index : b_ah
b_al  := (na(b_al)  or asiaL != asiaL[1]) ? bar_index : b_al
b_lh  := (na(b_lh)  or londH != londH[1]) ? bar_index : b_lh
b_ll  := (na(b_ll)  or londL != londL[1]) ? bar_index : b_ll
b_nh  := (na(b_nh)  or nyH != nyH[1]) ? bar_index : b_nh
b_nl  := (na(b_nl)  or nyL != nyL[1]) ? bar_index : b_nl

// -----------------------------------------------------------------------------
// SWEEP MASKING for previous-period levels
// -----------------------------------------------------------------------------
var bool sw_pdh = false, var bool sw_pdl = false
var bool sw_pwh = false, var bool sw_pwl = false
var bool sw_pmh = false, var bool sw_pml = false
sw_pdh := (pdh != pdh[1]) ? false : (sw_pdh or (not na(pdh) and high > pdh))
sw_pdl := (pdl != pdl[1]) ? false : (sw_pdl or (not na(pdl) and low  < pdl))
sw_pwh := (pwh != pwh[1]) ? false : (sw_pwh or (not na(pwh) and high > pwh))
sw_pwl := (pwl != pwl[1]) ? false : (sw_pwl or (not na(pwl) and low  < pwl))
sw_pmh := (pmh != pmh[1]) ? false : (sw_pmh or (not na(pmh) and high > pmh))
sw_pml := (pml != pml[1]) ? false : (sw_pml or (not na(pml) and low  < pml))
pdhM = (removeSwept and sw_pdh) ? na : pdh
pdlM = (removeSwept and sw_pdl) ? na : pdl
pwhM = (removeSwept and sw_pwh) ? na : pwh
pwlM = (removeSwept and sw_pwl) ? na : pwl
pmhM = (removeSwept and sw_pmh) ? na : pmh
pmlM = (removeSwept and sw_pml) ? na : pml

// -----------------------------------------------------------------------------
// DAILY BIAS ENGINE — structural (daily candle structure + last PDH/PDL sweep)
// -----------------------------------------------------------------------------
// Pull the last two COMPLETED daily candles (offset [1]/[2] so they're closed, not forming).
// lookahead_off + the historical offset is the non-repainting pattern: we read only CLOSED
// daily bars, and the committed daily values never change retroactively on the chart TF.
dH1 = request.security(syminfo.tickerid, "D", high[1],  lookahead = barmerge.lookahead_off)
dL1 = request.security(syminfo.tickerid, "D", low[1],   lookahead = barmerge.lookahead_off)
dC1 = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_off)
dH2 = request.security(syminfo.tickerid, "D", high[2],  lookahead = barmerge.lookahead_off)
dL2 = request.security(syminfo.tickerid, "D", low[2],   lookahead = barmerge.lookahead_off)
// Layer 1 — daily candle structure (last 1-2 completed dailies): HH+HL vs LH+LL, plus a
// close-position tilt (where the last daily closed within its own range).
int structBias = 0
if not na(dH1) and not na(dH2) and not na(dL1) and not na(dL2)
    bool hh = dH1 > dH2
    bool hl = dL1 > dL2
    bool lh = dH1 < dH2
    bool ll = dL1 < dL2
    if hh and hl
        structBias := 1
    else if lh and ll
        structBias := -1
    else
        // mixed (inside/outside bar): break the tie with the last daily close position
        float dRng = math.max(dH1 - dL1, syminfo.mintick)
        float cPos = (dC1 - dL1) / dRng
        structBias := cPos >= 0.66 ? 1 : (cPos <= 0.34 ? -1 : 0)
// Layer 2 — last PDH/PDL sweep + close-confirmed reclaim/reject (the trigger).
//   PDL swept then reclaimed  -> bullish (grab below, close back above)
//   PDH swept then rejected   -> bearish (grab above, close back below)
// sweepBias holds the most recent such event until the next one supersedes it or a new day.
var int sweepBias = 0
bool pdlReclaim = not na(pdl) and sw_pdl and close > pdl        // was pierced below, now closed back above
bool pdhReject  = not na(pdh) and sw_pdh and close < pdh        // was pierced above, now closed back below
if pdlReclaim
    sweepBias := 1
else if pdhReject
    sweepBias := -1
if newDay
    sweepBias := 0                                              // reset each new daily candle
// Combine the two layers into a committed daily bias that HOLDS between events.
//   dayBias:  1 = LONG, -1 = SHORT, 0 = NEUTRAL
//   dayCaution: true = structure vs a fresh counter sweep disagree (conservative mode holds)
var int  dayBias    = 0
var bool dayCaution = false
if biasOn
    dayCaution := false
    bool agree = structBias != 0 and sweepBias != 0 and structBias == sweepBias
    bool conflict = structBias != 0 and sweepBias != 0 and structBias != sweepBias
    if agree
        dayBias := structBias                                  // high conviction
    else if sweepBias != 0 and structBias == 0
        dayBias := sweepBias                                   // sweep leads a neutral structure
    else if conflict
        if biasFast
            dayBias := sweepBias                               // fast: a fresh counter sweep flips it
        else
            dayBias := structBias                              // conservative: hold structure...
            dayCaution := true                                 // ...but flag the brewing flip
    else if structBias != 0
        dayBias := structBias                                  // structure only (no fresh sweep)
    // (both zero -> hold the previous dayBias; genuine range = stays as last committed)
else
    dayBias := 0
    dayCaution := false
// human-readable 'why' for the banner
string biasWhyStruct = structBias > 0 ? "bullish daily" : structBias < 0 ? "bearish daily" : "mixed daily"
string biasWhySweep  = sweepBias > 0 ? " · PDL reclaimed" : sweepBias < 0 ? " · PDH rejected" : ""
// bias-flip event (committed value changed direction) — for the alert
bool biasFlipNow = biasOn and dayBias != nz(dayBias[1], 0) and dayBias != 0

// -----------------------------------------------------------------------------
// SFP (sweep + reversal) DETECTION
// -----------------------------------------------------------------------------
lvHiNow = array.new<float>()
lvLoNow = array.new<float>()
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkSfpLevels() =>
    if showSFP  // collect levels
        if not na(pdhM)
            array.push(lvHiNow, pdhM)
        if not na(pwhM)
            array.push(lvHiNow, pwhM)
        if not na(pmhM)
            array.push(lvHiNow, pmhM)
        if not na(pdlM)
            array.push(lvLoNow, pdlM)
        if not na(pwlM)
            array.push(lvLoNow, pwlM)
        if not na(pmlM)
            array.push(lvLoNow, pmlM)
        if not na(asiaH)
            array.push(lvHiNow, asiaH)
        if not na(londH)
            array.push(lvHiNow, londH)
        if not na(nyH)
            array.push(lvHiNow, nyH)
        if not na(asiaL)
            array.push(lvLoNow, asiaL)
        if not na(londL)
            array.push(lvLoNow, londL)
        if not na(nyL)
            array.push(lvLoNow, nyL)
        if array.size(swHi) > 0
            for si = 0 to array.size(swHi) - 1
                array.push(lvHiNow, array.get(swHi, si))
        if array.size(swLo) > 0
            for si = 0 to array.size(swLo) - 1
                array.push(lvLoNow, array.get(swLo, si))
        if array.size(eqHiA) > 0
            for si = 0 to array.size(eqHiA) - 1
                array.push(lvHiNow, array.get(eqHiA, si))
        if array.size(eqLoA) > 0
            for si = 0 to array.size(eqLoA) - 1
                array.push(lvLoNow, array.get(eqLoA, si))
    true
f_blkSfpLevels()

// per-level SFP fired-memory: suppress re-firing on the SAME level within sfpCooldown bars.
var sfpFiredPx  = array.new<float>()   // price of a level that recently fired an SFP
var sfpFiredBar = array.new<int>()     // bar it fired on
// has an SFP fired on (a level within tol of) px inside the cooldown window?
f_sfpOnCooldown(float px, float tol) =>
    bool hit = false
    if sfpCooldown > 0 and array.size(sfpFiredPx) > 0
        for ci = 0 to array.size(sfpFiredPx) - 1
            if math.abs(array.get(sfpFiredPx, ci) - px) <= tol and (bar_index - array.get(sfpFiredBar, ci)) < sfpCooldown
                hit := true
    hit
float sfpTol = math.max(nz(atr) * 0.1, syminfo.mintick)
float sweptHiLvl = na
float sweptLoLvl = na
if showSFP and array.size(lvHiNow) > 0
    for si = 0 to array.size(lvHiNow) - 1
        float lv = array.get(lvHiNow, si)
        if high > lv and close < lv and not f_sfpOnCooldown(lv, sfpTol)
            if na(sweptHiLvl) or lv > sweptHiLvl
                sweptHiLvl := lv
if showSFP and array.size(lvLoNow) > 0
    for si = 0 to array.size(lvLoNow) - 1
        float lv = array.get(lvLoNow, si)
        if low < lv and close > lv and not f_sfpOnCooldown(lv, sfpTol)
            if na(sweptLoLvl) or lv < sweptLoLvl
                sweptLoLvl := lv

// confirm on bar close (no repaint) unless the user opts into the intrabar preview.
// On historical bars barstate.isconfirmed is always true, so history is unaffected — only the
// live forming bar is held until close.
bool sfpConfOK = (not sfpConfirm) or barstate.isconfirmed
bool sfpShort = showSFP and not na(sweptHiLvl) and volOK and sfpConfOK
bool sfpLong  = showSFP and not na(sweptLoLvl) and volOK and sfpConfOK
// was there a bullish / bearish SFP within the last fvgSweepBars bars (incl. this one)?
// computed every bar here so f_fvgStrength needs no history references (CW10003)
bool sfpLongRecent  = ta.barssince(sfpLong)  <= fvgSweepBars
bool sfpShortRecent = ta.barssince(sfpShort) <= fvgSweepBars
// record the fired level into the cooldown memory (so it won't re-fire for sfpCooldown bars)
if sfpCooldown > 0 and sfpShort and not na(sweptHiLvl)
    array.push(sfpFiredPx, sweptHiLvl)
    array.push(sfpFiredBar, bar_index)
if sfpCooldown > 0 and sfpLong and not na(sweptLoLvl)
    array.push(sfpFiredPx, sweptLoLvl)
    array.push(sfpFiredBar, bar_index)
// prune cooldown memory beyond the window (also hard-capped so it can't grow unbounded)
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkSfpCool() =>
    if array.size(sfpFiredPx) > 0
        int sfi = 0
        while sfi < array.size(sfpFiredPx)
            if (bar_index - array.get(sfpFiredBar, sfi)) >= sfpCooldown
                array.remove(sfpFiredPx, sfi)
                array.remove(sfpFiredBar, sfi)
            else
                sfi += 1
        while array.size(sfpFiredPx) > 50
            array.shift(sfpFiredPx)
            array.shift(sfpFiredBar)
    true
f_blkSfpCool()

// -----------------------------------------------------------------------------
// TESTED-STATE CAPTURE — a wick PROBES a level (enters within depth×ATR) but does NOT
// sweep through it. Recorded persistently by price (deduped/capped), independent of the
// per-bar level rebuild. Fully-swept levels are removed elsewhere, so this is the
// "touched but still standing" middle state.
// -----------------------------------------------------------------------------
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkTested() =>
    if showTested
        float tDepth = math.max(nz(atr) * testDepthATR, syminfo.mintick)
        float tDedup = math.max(nz(atr) * 0.05, syminfo.mintick)
        tHiNow = array.new<float>()
        tLoNow = array.new<float>()
        if not na(pdhM)
            array.push(tHiNow, pdhM)
        if not na(pwhM)
            array.push(tHiNow, pwhM)
        if not na(pmhM)
            array.push(tHiNow, pmhM)
        if not na(pdlM)
            array.push(tLoNow, pdlM)
        if not na(pwlM)
            array.push(tLoNow, pwlM)
        if not na(pmlM)
            array.push(tLoNow, pmlM)
        if not na(asiaH)
            array.push(tHiNow, asiaH)
        if not na(londH)
            array.push(tHiNow, londH)
        if not na(nyH)
            array.push(tHiNow, nyH)
        if not na(asiaL)
            array.push(tLoNow, asiaL)
        if not na(londL)
            array.push(tLoNow, londL)
        if not na(nyL)
            array.push(tLoNow, nyL)
        if array.size(swHi) > 0
            for si = 0 to array.size(swHi) - 1
                array.push(tHiNow, array.get(swHi, si))
        if array.size(swLo) > 0
            for si = 0 to array.size(swLo) - 1
                array.push(tLoNow, array.get(swLo, si))
        if array.size(eqHiA) > 0
            for si = 0 to array.size(eqHiA) - 1
                array.push(tHiNow, array.get(eqHiA, si))
        if array.size(eqLoA) > 0
            for si = 0 to array.size(eqLoA) - 1
                array.push(tLoNow, array.get(eqLoA, si))
        // highs: wick pokes up to within tDepth BELOW the level but doesn't reach it (no sweep)
        if array.size(tHiNow) > 0
            for si = 0 to array.size(tHiNow) - 1
                float lv = array.get(tHiNow, si)
                if high >= lv - tDepth and high < lv
                    bool dup = false
                    if array.size(testedP) > 0
                        for dj = 0 to array.size(testedP) - 1
                            if math.abs(array.get(testedP, dj) - lv) <= tDedup
                                dup := true
                    if not dup
                        array.push(testedP, lv)
        // lows: wick pokes down to within tDepth ABOVE the level but doesn't reach it
        if array.size(tLoNow) > 0
            for si = 0 to array.size(tLoNow) - 1
                float lv = array.get(tLoNow, si)
                if low <= lv + tDepth and low > lv
                    bool dup = false
                    if array.size(testedP) > 0
                        for dj = 0 to array.size(testedP) - 1
                            if math.abs(array.get(testedP, dj) - lv) <= tDedup
                                dup := true
                    if not dup
                        array.push(testedP, lv)
        // cap (oldest dropped first)
        while array.size(testedP) > testKeep
            array.shift(testedP)
    true
f_blkTested()

// signal markers — capped rolling pool so they never exhaust the label budget
var mk_labels = array.new<label>()
f_mark(int x, float y, string txt, string yl, string stl, color col, color tcol, string sz) =>
    label lb = label.new(x, y, txt, yloc = yl, style = stl, color = col, textcolor = tcol, size = sz)
    array.push(mk_labels, lb)
    while array.size(mk_labels) > 120
        label.delete(array.shift(mk_labels))

if masterOn and sfpLong
    f_mark(bar_index, low, "🎯 SFP▲" + (sfpUseVol ? " " + str.tostring(rvol, "#.0") + "x" : ""), yloc.belowbar, label.style_label_up, sfpColLong, color.white, size.small)
if masterOn and sfpShort
    f_mark(bar_index, high, "🎯 SFP▼" + (sfpUseVol ? " " + str.tostring(rvol, "#.0") + "x" : ""), yloc.abovebar, label.style_label_down, sfpColShort, color.white, size.small)

// -----------------------------------------------------------------------------
// ORDER BLOCKS
// -----------------------------------------------------------------------------
float bodySize = math.abs(close - open)
bool  disp     = bodySize >= obDisp * nz(atr)
var obTop  = array.new<float>()
var obBot  = array.new<float>()
var obBull = array.new<bool>()
var obBirth = array.new<int>()
var obStr  = array.new<float>()   // 0-100 strength per order block (displacement + size + sweep + volume)
// strength of the order block being created this bar: displacement body, zone size, sweep origin,
// and relative volume — a decisive, swept, high-volume block scores high. 0..100.
f_obStrength(bool fromSweep) =>
    float atrO = math.max(nz(atr), syminfo.mintick)
    float bodyW = math.min(math.abs(close - open) / atrO / 1.5, 1.0)          // displacement body vs ATR -> 0..1
    float zoneW = math.min((high[1] - low[1]) / atrO, 1.0)                    // the block's own range vs ATR
    float volW  = math.min(math.max(nz(rvol) - 1.0, 0.0) / 1.5, 1.0)         // relative volume 0..1
    float sweepW = fromSweep ? 1.0 : 0.0
    // weighted: displacement is the core, sweep origin + size + volume add on
    float raw = bodyW * 42.0 + zoneW * 20.0 + sweepW * 22.0 + volW * 16.0
    int(math.max(0.0, math.min(100.0, math.round(raw))))
// breaker blocks: a violated OB with flipped polarity (former demand -> supply, etc.)
var brkTop  = array.new<float>()
var brkBot  = array.new<float>()
var brkBull = array.new<bool>()   // polarity AFTER the flip
var brkBirth = array.new<int>()
if showOB and disp and close > open and (sfpLong or (close > high[1]))
    array.push(obTop, high[1])
    array.push(obBot, low[1])
    array.push(obBull, true)
    array.push(obBirth, bar_index - 1)
    array.push(obStr, f_obStrength(sfpLong))
if showOB and disp and close < open and (sfpShort or (close < low[1]))
    array.push(obTop, high[1])
    array.push(obBot, low[1])
    array.push(obBull, false)
    array.push(obBirth, bar_index - 1)
    array.push(obStr, f_obStrength(sfpShort))
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkObUpd() =>
    if array.size(obTop) > 0
        int oi = 0
        while oi < array.size(obTop)
            bool bull = array.get(obBull, oi)
            bool dead = bull ? (close < array.get(obBot, oi)) : (close > array.get(obTop, oi))
            if dead
                // on violation, convert to a breaker with flipped polarity (if enabled)
                if showBreaker
                    array.push(brkTop, array.get(obTop, oi))
                    array.push(brkBot, array.get(obBot, oi))
                    array.push(brkBull, not bull)
                    array.push(brkBirth, bar_index)
                array.remove(obTop, oi)
                array.remove(obBot, oi)
                array.remove(obBull, oi)
                array.remove(obBirth, oi)
                array.remove(obStr, oi)
            else
                oi += 1
    true
f_blkObUpd()
while array.size(obTop) > obKeep
    array.shift(obTop)
    array.shift(obBot)
    array.shift(obBull)
    array.shift(obBirth)
    array.shift(obStr)
// breaker maintenance: a breaker dies when price closes back through it (opposite of OB)
if array.size(brkTop) > 0
    int bi = 0
    while bi < array.size(brkTop)
        bool bbull = array.get(brkBull, bi)
        bool bdead = bbull ? (close < array.get(brkBot, bi)) : (close > array.get(brkTop, bi))
        if bdead
            array.remove(brkTop, bi)
            array.remove(brkBot, bi)
            array.remove(brkBull, bi)
            array.remove(brkBirth, bi)
        else
            bi += 1
while array.size(brkTop) > obKeep
    array.shift(brkTop)
    array.shift(brkBot)
    array.shift(brkBull)
    array.shift(brkBirth)

// -----------------------------------------------------------------------------
// COLLECT → CLUSTER → RENDER  (last bar only)
// -----------------------------------------------------------------------------
var pool_lines = array.new<line>()
var pool_labels = array.new<label>()
var pool_boxes = array.new<box>()
var xtra_boxes  = array.new<box>()
var xtra_labels = array.new<label>()

f_clearXtra() =>
    while array.size(xtra_boxes) > 0
        box.delete(array.pop(xtra_boxes))
    while array.size(xtra_labels) > 0
        label.delete(array.pop(xtra_labels))
f_clearPools() =>
    while array.size(pool_lines) > 0
        line.delete(array.pop(pool_lines))
    while array.size(pool_labels) > 0
        label.delete(array.pop(pool_labels))
    while array.size(pool_boxes) > 0
        box.delete(array.pop(pool_boxes))

// candidate level arrays (rebuilt each last-bar pass)
var lv_price = array.new<float>()
var lv_name = array.new<string>()
var lv_col = array.new<color>()
var lv_emo = array.new<string>()
var lv_birth = array.new<int>()
var lv_side = array.new<int>()
var lv_pull = array.new<float>()   // per-level DOL pull (proximity-weighted gravity)
var lv_qual = array.new<float>()   // per-level distance-neutral magnet quality
var lv_inwin = array.new<bool>()   // is this level within the N-nearest-each-side confidence window
var lv_nomag = array.new<bool>()   // true = level draws but takes NO DOL magnet / confidence role
var lv_primary = array.new<bool>() // declutter: true = among the Top-N by confidence on its side (drawn bold)

// variant that can flag a level as "no magnet" (still drawn, but excluded from the DOL pull)
f_addLevelM(bool active, float price, string name, color col, string emo, int birthBar, int side, bool noMagnet) =>
    if masterOn and active and not na(price)
        array.push(lv_price, price)
        array.push(lv_name, name)
        array.push(lv_col, col)
        array.push(lv_emo, emo)
        array.push(lv_birth, birthBar)
        array.push(lv_side, side)
        array.push(lv_nomag, noMagnet)

// convenience wrapper: a normal level always takes a magnet role
f_addLevel(bool active, float price, string name, color col, string emo, int birthBar, int side) =>
    f_addLevelM(active, price, name, col, emo, birthBar, side, false)

// FVG state (declared here so f_confScore + projection helpers below can read it; populated later)
var fvgBoxes  = array.new<box>()
var fvgIsBull = array.new<bool>()
var fvgStr    = array.new<float>()   // 0-100 strength score per gap
var fvgLabels = array.new<label>()   // optional strength label per gap (na if none)
var fvgCE     = array.new<line>()    // optional consequent-encroachment (50%) line per gap (na if none)
// HTF (higher-timeframe) FVG state — tracked box-less (plain floats, zero draw-object cost).
// They boost the score of aligned chart-TF gaps and feed the DOL model; never drawn.
var htfFvgTop   = array.new<float>()
var htfFvgBot   = array.new<float>()
var htfFvgBull  = array.new<bool>()
var htfFvgStr   = array.new<float>()  // 0-100 strength score per HTF gap
// inversion memory: zones of recently-invalidated gaps, so a new opposite gap in the
// same zone can be flagged as an inverted FVG (IFVG).
var invTop    = array.new<float>()
var invBot    = array.new<float>()
var invWasBull = array.new<bool>()   // polarity of the gap that got invalidated
var invBar    = array.new<int>()     // bar it was invalidated on

// How important is the strongest liquidity pool sitting on/just-beyond a gap? Returns 0..1,
// graded by a type hierarchy (weekly/monthly > equal highs/lows > prev-day > opens >
// session > swing), mirroring the DOL type weights. "Near" = overlap OR within fvgLiqATR of a
// gap edge, so it also rewards a gap that GUARDS a pool just beyond it (the fuel price hunts).
// is a price within [lo..hi]? (helper for f_gapLiqPool; top-level since Pine has no nesting)
f_inBand(float p, float lo, float hi) => not na(p) and p >= lo and p <= hi
f_gapLiqPool(float gTop, float gBot, bool isBull) =>
    float band = math.max(nz(atr) * fvgLiqATR, syminfo.mintick)
    float lo = gBot - band
    float hi = gTop + band
    float best = 0.0
    // equal highs/lows — engineered stop liquidity (very high value)
    if array.size(eqHiA) > 0
        for i = 0 to array.size(eqHiA) - 1
            if f_inBand(array.get(eqHiA, i), lo, hi)
                best := math.max(best, 0.90)
    if array.size(eqLoA) > 0
        for i = 0 to array.size(eqLoA) - 1
            if f_inBand(array.get(eqLoA, i), lo, hi)
                best := math.max(best, 0.90)
    if showRelEQ and array.size(reqHiA) > 0
        for i = 0 to array.size(reqHiA) - 1
            if f_inBand(array.get(reqHiA, i), lo, hi)
                best := math.max(best, 0.70)
    if showRelEQ and array.size(reqLoA) > 0
        for i = 0 to array.size(reqLoA) - 1
            if f_inBand(array.get(reqLoA, i), lo, hi)
                best := math.max(best, 0.70)
    // previous-period levels (weekly/monthly weigh most)
    if f_inBand(pwhM, lo, hi) or f_inBand(pwlM, lo, hi)
        best := math.max(best, 0.95)
    if f_inBand(pmhM, lo, hi) or f_inBand(pmlM, lo, hi)
        best := math.max(best, 1.00)
    if f_inBand(pdhM, lo, hi) or f_inBand(pdlM, lo, hi)
        best := math.max(best, 0.80)
    // key opens
    if f_inBand(wOpen, lo, hi) or f_inBand(mOpen, lo, hi)
        best := math.max(best, 0.85)
    if f_inBand(dOpen, lo, hi) or f_inBand(midO, lo, hi)
        best := math.max(best, 0.65)
    // session highs/lows
    if f_inBand(asiaH, lo, hi) or f_inBand(asiaL, lo, hi) or f_inBand(londH, lo, hi) or f_inBand(londL, lo, hi) or f_inBand(nyH, lo, hi) or f_inBand(nyL, lo, hi)
        best := math.max(best, 0.55)
    // swing BSL/SSL liquidity
    if array.size(swHi) > 0
        for i = 0 to array.size(swHi) - 1
            if f_inBand(array.get(swHi, i), lo, hi)
                best := math.max(best, 0.60)
    if array.size(swLo) > 0
        for i = 0 to array.size(swLo) - 1
            if f_inBand(array.get(swLo, i), lo, hi)
                best := math.max(best, 0.60)
    best

// How TRAPPED is a gap against opposing structure in its intended direction? Returns 0..1
// (0 = clear runway, 1 = heavily walled). For a BULLISH gap it scans just ABOVE the gap top
// for resistance (highs / order-block tops); for a BEARISH gap, just BELOW the gap bottom for
// support. Only OPPOSING-side structure counts — this is the poor-location penalty.
f_gapTrapped(float gTop, float gBot, bool isBull) =>
    float band = math.max(nz(atr) * fvgTrapATR, syminfo.mintick)
    // search window strictly on the opposing side, just beyond the gap edge
    float wLo = isBull ? gTop : (gBot - band)
    float wHi = isBull ? (gTop + band) : gBot
    float wall = 0.0
    if isBull
        // resistance above: prev-period / session / swing HIGHS, equal highs, OB tops
        if f_inBand(pwhM, wLo, wHi) or f_inBand(pmhM, wLo, wHi)
            wall := math.max(wall, 1.0)
        if f_inBand(pdhM, wLo, wHi)
            wall := math.max(wall, 0.85)
        if array.size(eqHiA) > 0
            for i = 0 to array.size(eqHiA) - 1
                if f_inBand(array.get(eqHiA, i), wLo, wHi)
                    wall := math.max(wall, 0.9)
        if f_inBand(nyH, wLo, wHi) or f_inBand(londH, wLo, wHi) or f_inBand(asiaH, wLo, wHi)
            wall := math.max(wall, 0.6)
        if array.size(swHi) > 0
            for i = 0 to array.size(swHi) - 1
                if f_inBand(array.get(swHi, i), wLo, wHi)
                    wall := math.max(wall, 0.6)
        if array.size(obTop) > 0
            for i = 0 to array.size(obTop) - 1
                if not array.get(obBull, i) and f_inBand(array.get(obTop, i), wLo, wHi)  // bearish OB above
                    wall := math.max(wall, 0.8)
    else
        // support below: prev-period / session / swing LOWS, equal lows, OB bottoms
        if f_inBand(pwlM, wLo, wHi) or f_inBand(pmlM, wLo, wHi)
            wall := math.max(wall, 1.0)
        if f_inBand(pdlM, wLo, wHi)
            wall := math.max(wall, 0.85)
        if array.size(eqLoA) > 0
            for i = 0 to array.size(eqLoA) - 1
                if f_inBand(array.get(eqLoA, i), wLo, wHi)
                    wall := math.max(wall, 0.9)
        if f_inBand(nyL, wLo, wHi) or f_inBand(londL, wLo, wHi) or f_inBand(asiaL, wLo, wHi)
            wall := math.max(wall, 0.6)
        if array.size(swLo) > 0
            for i = 0 to array.size(swLo) - 1
                if f_inBand(array.get(swLo, i), wLo, wHi)
                    wall := math.max(wall, 0.6)
        if array.size(obTop) > 0
            for i = 0 to array.size(obTop) - 1
                if array.get(obBull, i) and f_inBand(array.get(obBot, i), wLo, wHi)  // bullish OB below
                    wall := math.max(wall, 0.8)
    wall

// RANK a fair value gap 0-100 (a relative quality ranking, NOT a probability). CORE BASE (the
// quality every gap has: size · volume · displacement · premium-discount → ~40-55 for a clean
// gap) PLUS BONUS points added on top only when occasional factors fire — so absent bonuses
// never drag an ordinary gap to the floor, yet confluent gaps clearly rise above:
//   • gap size vs ATR            • creation volume (rel-vol of the displacement candle)
//   • inside an order/breaker     • inversion of a prior opposite gap (IFVG)
//   • alignment with an HTF gap   • premium/discount location in the dealing range
//   • displacement quality        • confluence (round number / VWAP / OTE)
//   • liquidity-pool confluence   • sweep precedence (SFP -> displacement -> FVG)
//   • freshness (tested gaps are discounted, applied as a multiplier after the average)
// dispVol = volume of the creating candle; dispQual = caller-computed 0..1 candle-conviction
// (body dominance + structure break). Pass isHtf=true to skip the HTF-alignment factor for
// HTF gaps themselves (avoids self-matching). Returns [score, isInv, inBlock, htfAligned].
f_fvgStrength(float gTop, float gBot, bool isBull, float dispVol, float dispQual, bool isHtf) =>
    float atrF = math.max(nz(atr), syminfo.mintick)
    // HTF-alignment is a low-timeframe tool: it is an APPLICABLE scoring factor only when the
    // chart TF <= htfFvgMaxTF (htfMode). On higher timeframes it is excluded from the average
    // entirely (not just zeroed), and gap-size importance rises, so HTF charts rank gaps on the
    // classic factors as before.
    bool  htfMode = fvgHtfActive and htfFvgOn and not isHtf
    // ---- CORE-BASE + BONUS model ----
    // Problem with a pure weighted average over ALL factors: most factors (OB, inversion, HTF,
    // confluence, sweep) are binary and usually ABSENT, so their zeros sit in the denominator and
    // drag every ordinary-but-valid gap's score to the floor — the filter then dims everything.
    // Fix: a gap's BASELINE quality is the weighted average of the CORE factors it *always* has
    // (size · volume · displacement · premium-discount) → a clean gap lands in a usable mid-range.
    // The occasional BONUS factors (OB/breaker · inversion · HTF · confluence · liquidity pool ·
    // sweep) then ADD points ON TOP only when they fire — so an absent bonus never penalises, and
    // confluent gaps rise above ordinary ones. Score = base (0..~65) + bonuses, capped at 100.
    //
    // --- CORE base (weighted average, 0..~70) ---
    // Sub-scores are calibrated so a TYPICAL gap reads mid-range (not near 0). On low timeframes
    // an FVG's size is usually a small fraction of ATR and volume/displacement are unremarkable,
    // so the old "1.0 = normal" curves floored every gap. These map a normal gap to ~0.5-0.7.
    float cNum = 0.0
    float cDen = 0.0
    // 1) gap size vs ATR — a gap ~0.4×ATR already reads as good size (not 0.4)
    float gapATRv = math.abs(gTop - gBot) / atrF
    float subSize = math.min(gapATRv / 0.4, 1.0)
    cNum := cNum + subSize * 22.0 * fvgSizeW
    cDen := cDen + 22.0 * fvgSizeW
    // 2) creation volume — average volume (relV≈1) already reads ~0.67; a spike saturates
    float relV   = nz(avgVol) > 0 ? dispVol / avgVol : 1.0
    float subVol = math.min(math.max(relV, 0.0) / 1.5, 1.0)
    cNum := cNum + subVol * 14.0 * fvgVolW
    cDen := cDen + 14.0 * fvgVolW
    // 7) displacement quality (caller 0..1) — floored so a normal displacement reads ~0.55+
    float subDisp = math.min(0.35 + math.max(nz(dispQual), 0.0) * 0.65, 1.0)
    cNum := cNum + subDisp * 16.0 * fvgDispW
    cDen := cDen + 16.0 * fvgDispW
    // 6) premium/discount location — full correct half scores linearly 0..1; neutral 0.5 when no
    //    range exists (so the factor never collapses the average to 0).
    float subPd = 0.5
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float gMid = (gTop + gBot) / 2.0
        float pos  = math.min(1.0, math.max(0.0, (gMid - rngLo) / (rngHi - rngLo)))
        subPd := isBull ? (1.0 - pos) : pos      // bull wants discount (low pos), bear wants premium
    cNum := cNum + subPd * 10.0 * fvgPdW
    cDen := cDen + 10.0 * fvgPdW
    // base scaled so a strong-core gap reaches ~70 (leaving headroom for bonuses up to 100)
    float base = cDen > 0 ? (cNum / cDen) * 70.0 : 0.0
    //
    // --- BONUS points added on top (absent bonuses add nothing — they never penalise) ---
    float bonus = 0.0
    // 3) inside an order block or breaker block
    bool  inBlock = false
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if not na(ot) and not na(ob) and gTop >= ob and gBot <= ot
                inBlock := true
    if showBreaker and array.size(brkTop) > 0
        for bri = 0 to array.size(brkTop) - 1
            float bt = array.get(brkTop, bri)
            float bb = array.get(brkBot, bri)
            if not na(bt) and not na(bb) and gTop >= bb and gBot <= bt
                inBlock := true
    if inBlock
        bonus := bonus + 12.0 * fvgBlockW
    // 4) inversion of a prior opposite gap in the same zone (IFVG)
    bool  isInv = false
    if array.size(invTop) > 0
        for ii = 0 to array.size(invTop) - 1
            if bar_index - array.get(invBar, ii) <= fvgInvBars and array.get(invWasBull, ii) != isBull
                float it = array.get(invTop, ii)
                float ib = array.get(invBot, ii)
                if gTop >= ib and gBot <= it
                    isInv := true
    if isInv
        bonus := bonus + 10.0 * fvgInvW
    // 5) HTF-gap alignment (low timeframes only)
    bool  htfAligned = false
    if htfMode and array.size(htfFvgTop) > 0
        float bestHtf = 0.0
        for hi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, hi)
            float hb = array.get(htfFvgBot, hi)
            if gTop >= hb and gBot <= ht
                htfAligned := true
                float hs = hi < array.size(htfFvgStr) ? array.get(htfFvgStr, hi) : 60.0
                bestHtf := math.max(bestHtf, 0.5 + 0.5 * (nz(hs, 60.0) / 100.0))   // 0.5..1.0
        if htfAligned
            bonus := bonus + bestHtf * 16.0 * fvgHtfW
    // 8) confluence: midpoint near a round number / VWAP / OTE fib
    float gMid2 = (gTop + gBot) / 2.0
    float tolC = math.max(atrF * 0.25, syminfo.mintick)
    bool  conflHit = false
    if confRound > 0
        float nearest = math.round(gMid2 / confRound) * confRound
        if math.abs(gMid2 - nearest) <= tolC
            conflHit := true
    if confVWAP and not na(vwapVal) and math.abs(gMid2 - vwapVal) <= tolC
        conflHit := true
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float rng = rngHi - rngLo
        bool bullLeg = rangeDir >= 0
        float oteA = bullLeg ? (rngHi - pdFib1 * rng) : (rngLo + pdFib1 * rng)
        float oteB = bullLeg ? (rngHi - pdFib2 * rng) : (rngLo + pdFib2 * rng)
        float oteC = bullLeg ? (rngHi - pdFib3 * rng) : (rngLo + pdFib3 * rng)
        if math.abs(gMid2 - oteA) <= tolC or math.abs(gMid2 - oteB) <= tolC or math.abs(gMid2 - oteC) <= tolC
            conflHit := true
    if conflHit
        bonus := bonus + 7.0 * fvgConflW
    // 10) liquidity-pool confluence (graded 0..1 by the most important nearby pool)
    float liqPool = f_gapLiqPool(gTop, gBot, isBull)
    bool  liqAligned = liqPool > 0.0
    bonus := bonus + liqPool * 14.0 * fvgLiqW
    // 11) sweep precedence (SFP -> displacement -> FVG) — chart-TF gaps only
    bool  sweptBefore = false
    if not isHtf
        sweptBefore := isBull ? sfpLongRecent : sfpShortRecent
        if sweptBefore
            bonus := bonus + 10.0 * fvgSweepW
    // formation score = core base + bonuses (capped at 100 before freshness/trap)
    float raw = math.min(base + bonus, 100.0)
    // 9) freshness multiplier — a gap price has already probed is 'used' liquidity, discount it
    float freshMul = 1.0
    if fvgFreshDisc > 0 and f_isTested((gTop + gBot) / 2.0, atrF)
        freshMul := 1.0 - fvgFreshDisc
    // 12) poor-location (trapped) multiplier — opposing structure right in the gap's path cuts
    //     the rank proportional to how walled it is (bullish gap under resistance, etc.).
    float trapMul = 1.0
    if fvgTrapDisc > 0
        float trapped = f_gapTrapped(gTop, gBot, isBull)
        trapMul := 1.0 - fvgTrapDisc * trapped
    int scInt = int(math.min(math.round(raw * freshMul * trapMul), 100))
    [scInt, isInv, inBlock, htfAligned, liqAligned, sweptBefore]

// confluence score for a price band [loB..hiB]
f_confScore(float mid, float loB, float hiB, int members) =>
    float score = 0.0
    string parts = ""
    float tol = math.max(nz(atr) * 0.25, syminfo.mintick)
    score := score + math.min(members, 5) * 12.0
    if members >= 2
        parts := parts + "stack "
    float atrC = math.max(nz(atr), syminfo.mintick)
    // ORDER BLOCK — graded by zone size (displacement leaves bigger blocks) + freshness,
    // instead of a flat flag. Take the STRONGEST overlapping OB (not a sum).
    float obBest = 0.0
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if hiB >= ob and loB <= ot
                float sizeW = math.min((ot - ob) / atrC, 1.5) / 1.5      // 0..1 by zone size vs ATR
                float freshW = 1.0 - math.min(math.max(0.0, bar_index - array.get(obBirth, oi)) / 60.0, 1.0)  // 1 fresh -> 0 old
                float obStrL = 12.0 + sizeW * 10.0 + freshW * 4.0          // 12 .. 26
                obBest := math.max(obBest, obStrL)
    if obBest > 0
        score := score + obBest
        parts := parts + (obBest >= 20.0 ? "OB+ " : "OB ")
    // FAIR VALUE GAP — folded into confluence, now graded by each gap's STRENGTH score
    // (size + creation volume + inside OB/breaker + inversion), not just raw gap size, so a
    // strong gap in a block / an IFVG adds far more weight than a trivial imbalance. Take the
    // strongest overlapping gap. Falls back to gap-size grading if strength wasn't stored.
    float fvgBest = 0.0
    if array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if hiB >= fb and loB <= ft
                float sStr = fi < array.size(fvgStr) ? array.get(fvgStr, fi) : na
                float strW = na(sStr) ? math.min(math.abs(ft - fb) / atrC, 1.0) : sStr / 100.0   // 0..1
                float fvgPts = 8.0 + strW * 14.0                           // 8 .. 22
                fvgBest := math.max(fvgBest, fvgPts)
    // HTF fair value gaps — same overlap grading, but a higher weight ceiling because an
    // HTF gap is a far stronger magnet than any chart-TF gap. Box-less, read from floats.
    if htfFvgOn and array.size(htfFvgTop) > 0
        for hi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, hi)
            float hb = array.get(htfFvgBot, hi)
            if hiB >= hb and loB <= ht
                float sStr = hi < array.size(htfFvgStr) ? array.get(htfFvgStr, hi) : na
                float strW = na(sStr) ? math.min(math.abs(ht - hb) / atrC, 1.0) : sStr / 100.0
                float htfPts = 12.0 + strW * 18.0                          // 12 .. 30 (above chart-TF ceiling)
                fvgBest := math.max(fvgBest, htfPts)
    if fvgBest > 0
        score := score + fvgBest
        parts := parts + (fvgBest >= 16.0 ? "FVG+ " : "FVG ")
    // OTE fib proximity + premium/discount extreme (from the live dealing range).
    // Computed internally for scoring only - the P/D fibs are NOT drawn on chart.
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float rng = rngHi - rngLo
        bool bullLeg = rangeDir >= 0
        f1 = bullLeg ? (rngHi - pdFib1 * rng) : (rngLo + pdFib1 * rng)
        f2 = bullLeg ? (rngHi - pdFib2 * rng) : (rngLo + pdFib2 * rng)
        f3 = bullLeg ? (rngHi - pdFib3 * rng) : (rngLo + pdFib3 * rng)
        bool fibHit = (math.abs(mid - f1) <= tol) or (math.abs(mid - f2) <= tol) or (math.abs(mid - f3) <= tol)
        if fibHit
            score := score + 18.0
            parts := parts + "OTE "
        float pos = (mid - rngLo) / rng
        if pos >= 0.75 or pos <= 0.25
            score := score + 8.0
            parts := parts + (pos >= 0.75 ? "prem " : "disc ")
    if confRound > 0
        float nearest = math.round(mid / confRound) * confRound
        if math.abs(mid - nearest) <= tol
            score := score + 10.0
            parts := parts + "round "
    // VWAP proximity — a defended fair-value reference (scoring factor only)
    if confVWAP and not na(vwapVal) and math.abs(mid - vwapVal) <= tol
        score := score + 10.0
        parts := parts + "VWAP "
    // breaker block overlap — flipped OB, strong reaction zone
    if showBreaker and array.size(brkTop) > 0
        bool brkHit = false
        for bri = 0 to array.size(brkTop) - 1
            if hiB >= array.get(brkBot, bri) and loB <= array.get(brkTop, bri)
                brkHit := true
        if brkHit
            score := score + 14.0
            parts := parts + "brk "
    int s = int(math.min(math.round(score), 100))
    [s, parts]

// ---- per-level DOL pull + magnet-quality ----
// Two scores are produced from the same weights:
//   • pull  = distance-decay × type × age × freshness × confluence
//             — proximity dominates. Drives the DOL arrow/bias and the 🎯 magnet.
//   • qual  = type × age × freshness × confluence  (distance REMOVED)
//             — "how strong a magnet is this for its distance". Drives the
//             per-level confidence % in Magnet-quality mode, so a far but heavy
//             pool can out-score a near lone level.
// f_pull returns [pull, qual]; callers pick which to display.
f_pull(float pk, string nk, int bk, float sensK, float atrU) =>
    float dist = math.abs(pk - close)
    // sharper decay so the NEAREST pool dominates (dolNearBias raises the exponent)
    float distW = math.pow(1.0 / (1.0 + sensK * (dist / atrU)), 1.0 + dolNearBias)
    // type weight — EQ (engineered liquidity) now ranks at the TOP with monthly/HTF
    float typeW = 1.0
    if dolUseType
        if str.contains(nk, "rEQ")
            typeW := 1.7                 // relative (near) equal H/L — softer than exact EQ
        else if str.contains(nk, "EQ")
            typeW := 2.4                 // exact equal H/L — engineered liquidity, top
        else if str.contains(nk, "PMH") or str.contains(nk, "PML")
            typeW := 2.2
        else if str.contains(nk, "PWH") or str.contains(nk, "PWL")
            typeW := 1.9
        else if str.contains(nk, "M.Open") or str.contains(nk, "W.Open")
            typeW := 1.8                 // monthly / weekly opens — institutional refs
        else if str.contains(nk, "Breaker")
            typeW := 1.7                 // flipped OB — strong reaction zone
        else if str.contains(nk, "PDH") or str.contains(nk, "PDL")
            typeW := 1.6
        else if str.contains(nk, "Midnight")
            typeW := 1.4                 // NY midnight open
        else if str.contains(nk, "London") or str.contains(nk, "NY") or str.contains(nk, "Asia")
            typeW := 1.2
        typeW := 1.0 + (typeW - 1.0) * sensK
    // age
    float ageW = 1.0
    if dolUseAge and not na(bk)
        float ageBars = math.max(0.0, bar_index - bk)
        ageW := 1.0 + math.min(1.0, math.log(1.0 + ageBars) / 6.0) * sensK
    // freshness — discount a level price is currently sitting right on (being tested)
    float freshW = 1.0
    if dolFreshW
        freshW := dist < atrU * 0.15 ? 0.6 : 1.0
    // confluence weight — a level's own confluence score amplifies its pull
    float confW = 1.0
    if dolConfW
        [cs, cp] = f_confScore(pk, pk - atrU * 0.05, pk + atrU * 0.05, 1)
        confW := 1.0 + cs / 100.0    // 1.0 .. 2.0
    // tested discount — a level already probed is a slightly weaker magnet
    float testW = 1.0
    if testDiscount and f_isTested(pk, atrU)
        testW := 1.0 - testDiscAmt
    float qual = typeW * ageW * freshW * confW * testW   // distance-neutral magnet quality
    float pull = distW * qual                             // proximity-weighted gravity
    [pull, qual]


// ---- projection helpers (reuse OB/FVG/level state; no new data feeds) ----
// Path-clearance: 0..100 for how UNOBSTRUCTED the route from price -> target is.
// Every opposing order block / FVG / strong level strictly between the two prices
// is an obstacle that cuts the score. A clear runway ≈ 100; a blocked path ≈ low.
f_pathClear(float fromP, float toP, float atrU) =>
    float lo = math.min(fromP, toP)
    float hi = math.max(fromP, toP)
    float pad = atrU * 0.05
    int obstacles = 0            // count shown in the banner
    float severity = 0.0         // strength-weighted obstacle load that actually cuts clearance
    // order blocks whose zone falls between price and target — a STRONG block walls the path harder
    // than a trivial one, so each block's severity scales with its strength score (0.2..1.0), the
    // same strength-weighting the FVG loop below uses (previously OBs added a flat 1.0 severity).
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if ot >= lo - pad and ob <= hi + pad and not (ot >= hi and ob >= hi) and not (ot <= lo and ob <= lo)
                float oStrV = oi < array.size(obStr) ? array.get(obStr, oi) : na
                float ow = na(oStrV) ? 1.0 : (0.2 + 0.8 * (oStrV / 100.0))
                obstacles := obstacles + 1
                severity  := severity + ow
    // fair value gaps between price and target — a STRONG gap walls the path harder than a
    // trivial one, so each gap's severity scales with its strength score (0.2..1.0).
    if array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if ft >= lo - pad and fb <= hi + pad
                float sStr = fi < array.size(fvgStr) ? array.get(fvgStr, fi) : na
                float w = na(sStr) ? 1.0 : (0.2 + 0.8 * (sStr / 100.0))
                obstacles := obstacles + 1
                severity  := severity + w
    // HTF gaps between price and target wall the path harder (0.4..1.4 severity).
    if htfFvgOn and array.size(htfFvgTop) > 0
        for gi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, gi)
            float hb = array.get(htfFvgBot, gi)
            if ht >= lo - pad and hb <= hi + pad
                float sStr = gi < array.size(htfFvgStr) ? array.get(htfFvgStr, gi) : na
                float w = na(sStr) ? 1.4 : (0.4 + 1.0 * (sStr / 100.0))
                obstacles := obstacles + 1
                severity  := severity + w
    float clr = 100.0 * math.pow(0.72, projClearW * severity)
    [math.round(clr), obstacles]







// Stacked agreement: does a price band overlap an order block OR an FVG?
f_hasOBFVG(float loB, float hiB) =>
    bool hit = false
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            if hiB >= array.get(obBot, oi) and loB <= array.get(obTop, oi)
                hit := true
    // only a reasonably strong gap counts toward stacked agreement — a trivial imbalance
    // shouldn't fire the high-conviction ⭐ flag.
    if not hit and array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            float sStr = fi < array.size(fvgStr) ? array.get(fvgStr, fi) : na
            bool strongEnough = na(sStr) or not fvgFilterOn or sStr >= fvgMinStr
            if hiB >= fb and loB <= ft and strongEnough
                hit := true
    // an HTF gap overlapping the band also counts toward stacked agreement
    if not hit and htfFvgOn and array.size(htfFvgTop) > 0
        for hi = 0 to array.size(htfFvgTop) - 1
            float ht = array.get(htfFvgTop, hi)
            float hb = array.get(htfFvgBot, hi)
            if hiB >= hb and loB <= ht
                hit := true
    hit

// ---- DOL flip stability state (persists across bars) ----
// Committed arrow direction from the last decision: +1 = UP (BSL draw), -1 = DOWN (SSL draw).
// The deadband + hysteresis logic below only mutates this when the opposing side wins
// decisively (bias clears the deadband), so the arrow holds through near-50/50 noise.
var float dm_dirState = 1.0

// ---- DOL gravity tally + shared direction (last bar) ----
// Last-bar render, split into four functions so each stays under TradingView's per-function
// limit on inputs / request values used (CE10116). Phases run in order on the last bar only.
// 1) collect every live level into the lv_* arrays
f_blkCollect() =>
    f_clearPools()
    array.clear(lv_price)
    array.clear(lv_name)
    array.clear(lv_col)
    array.clear(lv_emo)
    array.clear(lv_birth)
    array.clear(lv_side)
    array.clear(lv_pull)
    array.clear(lv_qual)
    array.clear(lv_inwin)
    array.clear(lv_nomag)
    array.clear(lv_primary)

    f_addLevel(showPDHL, pdhM,   "PDH",     colBull, emoPrev, b_pdh,  1)
    f_addLevel(showPDHL, pdlM,   "PDL",     colBear, emoPrev, b_pdl, -1)
    f_addLevel(showPWHL, pwhM,   "PWH",     colBull, emoPrev, b_pwh,  1)
    f_addLevel(showPWHL, pwlM,   "PWL",     colBear, emoPrev, b_pwl, -1)
    f_addLevel(showPMHL, pmhM,   "PMH",     colBull, emoPrev, b_pmh,  1)
    f_addLevel(showPMHL, pmlM,   "PML",     colBear, emoPrev, b_pml, -1)
    f_addLevel(showDO,   dOpen,  "D.Open",  colSess, emoPrev, b_do,   0)
    f_addLevel(showWO,   wOpen,  "W.Open",  colSess, emoPrev, b_wo,   0)
    f_addLevel(showMO,   mOpen,  "M.Open",  colSess, emoPrev, b_mo,   0)
    f_addLevel(showMidO, midO,   "Midnight",colSess, emoPrev, b_mid,  0)
    f_addLevelM(showAsia, asiaH,  f_sessName("Asia H", asiaHc),   colSess, emoSess, b_ah,   1, projLiveSess and asiaHf)
    f_addLevelM(showAsia, asiaL,  f_sessName("Asia L", asiaLc),   colSess, emoSess, b_al,  -1, projLiveSess and asiaLf)
    f_addLevelM(showLond, londH,  f_sessName("London H", londHc), colSess, emoSess, b_lh,   1, projLiveSess and londHf)
    f_addLevelM(showLond, londL,  f_sessName("London L", londLc), colSess, emoSess, b_ll,  -1, projLiveSess and londLf)
    f_addLevelM(showNY,   nyH,    f_sessName("NY H", nyHc),       colSess, emoSess, b_nh,   1, projLiveSess and nyHf)
    f_addLevelM(showNY,   nyL,    f_sessName("NY L", nyLc),       colSess, emoSess, b_nl,  -1, projLiveSess and nyLf)
    if showSwing
        if array.size(swHi) > 0
            for si = 0 to array.size(swHi) - 1
                f_addLevel(true, array.get(swHi, si), "BSL", colBull, emoLiq, array.get(swHiB, si), 1)
        if array.size(swLo) > 0
            for si = 0 to array.size(swLo) - 1
                f_addLevel(true, array.get(swLo, si), "SSL", colBear, emoLiq, array.get(swLoB, si), -1)
    if showEQ
        if array.size(eqHiA) > 0
            for ei = 0 to array.size(eqHiA) - 1
                f_addLevel(true, array.get(eqHiA, ei), "EQH", colBull, emoLiq, array.get(eqHiB, ei), 1)
        if array.size(eqLoA) > 0
            for ei = 0 to array.size(eqLoA) - 1
                f_addLevel(true, array.get(eqLoA, ei), "EQL", colBear, emoLiq, array.get(eqLoB, ei), -1)
    if showEQ and showRelEQ
        if array.size(reqHiA) > 0
            for ei = 0 to array.size(reqHiA) - 1
                f_addLevel(true, array.get(reqHiA, ei), "rEQH", colBull, emoLiq, array.get(reqHiB, ei), 1)
        if array.size(reqLoA) > 0
            for ei = 0 to array.size(reqLoA) - 1
                f_addLevel(true, array.get(reqLoA, ei), "rEQL", colBear, emoLiq, array.get(reqLoB, ei), -1)
    if showBreaker and array.size(brkTop) > 0
        for bri = 0 to array.size(brkTop) - 1
            float bmid = (array.get(brkTop, bri) + array.get(brkBot, bri)) / 2.0
            bool  bbl  = array.get(brkBull, bri)
            f_addLevel(true, bmid, bbl ? "Breaker▲" : "Breaker▼", bbl ? colBull : colBear, emoLiq, array.get(brkBirth, bri), bbl ? 1 : -1)
    true

// 2) draw-on-liquidity gravity: per-side pull, flip-stable direction, most-likely target
f_blkDol(float dirIn) =>
    float dirLocal = dirIn
    // ---- DOL gravity: pull = distance x type x age, per side ----
    float bslStrength = 0.0
    float sslStrength = 0.0
    float bslTopPull  = 0.0
    float sslTopPull  = 0.0
    float bslTopPrice = na
    float sslTopPrice = na
    int nl = array.size(lv_price)
    float totalPull = 0.0
    float totalQual = 0.0
    if nl > 0
        float sensK = dolSens == "High" ? 2.0 : dolSens == "Low" ? 0.5 : 1.0
        float atrU  = math.max(nz(atr), syminfo.mintick)
        // pass 1: pull/qual per level + DOL bias & 🎯 magnet.
        // Excluded levels (forming session extreme, or hugging price under the distance
        // floor) still DRAW but contribute zero pull/qual — they take no magnet, no bias
        // tilt, and no confidence %, so a level price is sitting on can't inflate the score.
        for k = 0 to nl - 1
            float pk = array.get(lv_price, k)
            string nk = array.get(lv_name, k)
            int   bk = array.get(lv_birth, k)
            bool  floorHit = projDistFloor and projDistFloorATR > 0 and (math.abs(pk - close) < projDistFloorATR * atrU)
            bool  excl = array.get(lv_nomag, k) or floorHit
            array.set(lv_nomag, k, excl)   // fold the dynamic floor in so pass 2 + render can read it
            [rawPull, rawQual] = f_pull(pk, nk, bk, sensK, atrU)
            float pull = excl ? 0.0 : rawPull
            float qual = excl ? 0.0 : rawQual
            array.push(lv_pull, pull)
            array.push(lv_qual, qual)
            array.push(lv_inwin, false)
            array.push(lv_primary, false)
            if not excl
                if pk >= close
                    bslStrength := bslStrength + pull
                    if pull > bslTopPull
                        bslTopPull  := pull
                        bslTopPrice := pk
                else
                    sslStrength := sslStrength + pull
                    if pull > sslTopPull
                        sslTopPull  := pull
                        sslTopPrice := pk
        // pass 2: confidence window — mark the N nearest levels ABOVE and N BELOW price.
        // A level is in-window if fewer than N same-side levels sit strictly nearer to price.
        for k = 0 to nl - 1
            // excluded levels take no window slot and don't crowd out real levels
            if not array.get(lv_nomag, k)
                float pk = array.get(lv_price, k)
                bool  above = pk >= close
                float dk = math.abs(pk - close)
                int nearer = 0
                for j = 0 to nl - 1
                    if j != k and not array.get(lv_nomag, j)
                        float pj = array.get(lv_price, j)
                        bool  aboveJ = pj >= close
                        if aboveJ == above and math.abs(pj - close) < dk
                            nearer := nearer + 1
                if nearer < eConfWin
                    array.set(lv_inwin, k, true)
                    totalPull := totalPull + array.get(lv_pull, k)
                    totalQual := totalQual + array.get(lv_qual, k)
        // pass 2b: declutter rank — mark the Top-N by confidence on each side as PRIMARY
        // (bold). A level is primary if fewer than eTopN same-side levels have higher
        // confidence. Below-Top-N or below the gate levels are drawn faintly at render.
        bool useQualR = lvlConfMode == "Magnet quality"
        for k = 0 to nl - 1
            if not array.get(lv_nomag, k)
                float pk = array.get(lv_price, k)
                bool  above = pk >= close
                float ck = useQualR ? array.get(lv_qual, k) : array.get(lv_pull, k)
                int stronger = 0
                for j = 0 to nl - 1
                    if j != k and not array.get(lv_nomag, j)
                        float pj = array.get(lv_price, j)
                        bool  aboveJ = pj >= close
                        float cj = useQualR ? array.get(lv_qual, j) : array.get(lv_pull, j)
                        if aboveJ == above and cj > ck
                            stronger := stronger + 1
                if stronger < eTopN
                    array.set(lv_primary, k, true)

    // ---- landscape cap: stop ONE hugging level from dominating its side ----
    // Distance decay makes the nearest level's pull huge, so a single level price is sitting
    // next to can out-weigh a whole cluster on the other side and flip the bias. Clamp each
    // level's contribution to biasCap × its side's raw total, so the bias reflects the mass /
    // cluster of levels (the liquidity landscape) rather than one proximity outlier.
    // The 🎯 magnet (bslTopPull/sslTopPull) is untouched — proximity read stays available.
    if biasCap < 1.0 and nl > 0
        float bslCapAbs = bslStrength * biasCap
        float sslCapAbs = sslStrength * biasCap
        float bslCapped = 0.0
        float sslCapped = 0.0
        for k = 0 to nl - 1
            if not array.get(lv_nomag, k)
                float pk2 = array.get(lv_price, k)
                float p2  = array.get(lv_pull, k)
                if pk2 >= close
                    bslCapped := bslCapped + math.min(p2, bslCapAbs)
                else
                    sslCapped := sslCapped + math.min(p2, sslCapAbs)
        bslStrength := bslCapped
        sslStrength := sslCapped

    // ---- resistance-adjusted (clearance-weighted) draw ----
    // Each side's EFFECTIVE pull = raw draw × how clear the path to that side's magnet is.
    // Structure in the way (OBs / FVGs) discounts a side; it never adds to the other side.
    float atrR   = math.max(nz(atr), syminfo.mintick)
    float upClr  = 100.0
    float dnClr  = 100.0
    if projResist
        if not na(bslTopPrice)
            [uc, uo] = f_pathClear(close, bslTopPrice, atrR)
            upClr := uc
        if not na(sslTopPrice)
            [dc, doo] = f_pathClear(close, sslTopPrice, atrR)
            dnClr := dc
    float bslEff = bslStrength * (projResist ? upClr / 100.0 : 1.0)
    float sslEff = sslStrength * (projResist ? dnClr / 100.0 : 1.0)

    float dm_totalG = bslEff + sslEff
    float dm_liqBias = dm_totalG > 0 ? (bslEff - sslEff) / dm_totalG : 0.0
    float dm_bias = (1.0 - dolMomWt / 100.0) * dm_liqBias + (dolMomWt / 100.0) * dolMom
    // ---- deadband + hysteresis: only flip when the opposing side wins DECISIVELY ----
    // flip stability: hold the prior direction until the bias clears the deadband on the other
    // side, committed on a closed bar only (no flicker near a key level)
    bool crossUp   = dm_bias >  dolDeadband and dirLocal < 0
    bool crossDown = dm_bias < -dolDeadband and dirLocal > 0
    if (crossUp or crossDown) and ((not dolFlipConfirm) or barstate.isconfirmed)
        dirLocal := crossUp ? 1.0 : -1.0
    bool  dolDrawUp = dirLocal >= 0
    float dolTgt = dolDrawUp ? bslTopPrice : sslTopPrice
    // single MOST-LIKELY target = the level with the greatest pull overall
    float topPullPrice = bslTopPull >= sslTopPull ? bslTopPrice : sslTopPrice
    [dirLocal, dolDrawUp, topPullPrice, totalPull, totalQual]

// 3) sort + cluster + draw levels / zones with confidence %
f_blkDraw(bool dolDrawUp, float topPullPrice, float totalPull, float totalQual) =>
    // ---- sort + cluster + render ----
    int n = array.size(lv_price)
    if n > 0
        idx = array.new<int>()
        for i = 0 to n - 1
            array.push(idx, i)
        int idxN = array.size(idx)
        if idxN > 1
            for i = 1 to idxN - 1
                int keyIdx = array.get(idx, i)
                float keyVal = array.get(lv_price, keyIdx)
                int j = i - 1
                while j >= 0 and array.get(lv_price, array.get(idx, j)) > keyVal
                    array.set(idx, j + 1, array.get(idx, j))
                    j := j - 1
                array.set(idx, j + 1, keyIdx)

        float mergeDist = nz(atr) * clustDist
        int gi = 0
        while gi < idxN
            int startI = gi
            float sumP = array.get(lv_price, array.get(idx, gi))
            float minP = sumP
            float maxP = sumP
            int members = 1
            string names = array.get(lv_name, array.get(idx, gi))
            int oldestBirth = array.get(lv_birth, array.get(idx, gi))
            int sideSum = array.get(lv_side, array.get(idx, gi))
            // accumulate only IN-WINDOW members' pull/qual so the zone % matches the windowed normalization
            bool  zInWin  = array.get(lv_inwin, array.get(idx, gi))
            bool  zPrimary = array.get(lv_primary, array.get(idx, gi))   // declutter: any Top-N member?
            float sumPull = zInWin ? array.get(lv_pull, array.get(idx, gi)) : 0.0
            float sumQual = zInWin ? array.get(lv_qual, array.get(idx, gi)) : 0.0
            while clusterOn and gi + 1 < idxN and (array.get(lv_price, array.get(idx, gi + 1)) - array.get(lv_price, array.get(idx, gi))) <= mergeDist
                gi := gi + 1
                float p = array.get(lv_price, array.get(idx, gi))
                sumP := sumP + p
                minP := math.min(minP, p)
                maxP := math.max(maxP, p)
                members := members + 1
                names := names + "·" + array.get(lv_name, array.get(idx, gi))
                int mb = array.get(lv_birth, array.get(idx, gi))
                oldestBirth := na(oldestBirth) ? mb : (na(mb) ? oldestBirth : math.min(oldestBirth, mb))
                sideSum := sideSum + array.get(lv_side, array.get(idx, gi))
                if array.get(lv_primary, array.get(idx, gi))
                    zPrimary := true
                if array.get(lv_inwin, array.get(idx, gi))
                    zInWin  := true
                    sumPull := sumPull + array.get(lv_pull, array.get(idx, gi))
                    sumQual := sumQual + array.get(lv_qual, array.get(idx, gi))

            int ext = f_extLen(oldestBirth)
            bool drawGroup = members >= minStrength
            if drawGroup and members == 1
                float p = array.get(lv_price, array.get(idx, startI))
                int  sd = array.get(lv_side, array.get(idx, startI))
                color c = f_sideColI(sd, p, array.get(lv_col, array.get(idx, startI)))
                string emo = sideColorOn ? f_sideEmojiI(sd, p) : array.get(lv_emo, array.get(idx, startI))
                string tier = tieredEmoji ? (f_tierEmoji(1) + " ") : ""
                // per-level confidence % — Magnet quality (distance removed) or Raw pull share.
                // Only levels inside the N-nearest-each-side window get a %.
                bool useQual = lvlConfMode == "Magnet quality"
                bool lInWin = array.get(lv_inwin, array.get(idx, startI))
                float lpNum = useQual ? array.get(lv_qual, array.get(idx, startI)) : array.get(lv_pull, array.get(idx, startI))
                float lpDen = useQual ? totalQual : totalPull
                float lp = lpDen > 0 ? lpNum / lpDen * 100.0 : 0.0
                bool isTop = not na(topPullPrice) and math.abs(p - topPullPrice) <= syminfo.mintick
                float atrUt = math.max(nz(atr), syminfo.mintick)
                // stacked-agreement ⭐: DOL-side agrees + it's the magnet + overlaps OB/FVG
                bool sideAgree = (dolDrawUp and p >= close) or (not dolDrawUp and p < close)
                string stackTag = (projStacked and lInWin and isTop and sideAgree and f_hasOBFVG(p - atrUt * 0.05, p + atrUt * 0.05)) ? " ⭐" : ""
                // tested/virgin: probed levels get a ✓ + dotted, dimmed line (still standing, just 'used')
                bool lTested = f_isTested(p, atrUt)
                string confLvlTag = (showLvlConf and lInWin) ? ((isTop ? " 🎯" : " ") + str.tostring(math.round(lp)) + "%" + stackTag) : ""
                string testTag = (showTested and lTested) ? " ✓" : ""
                // declutter: faint if de-prioritised (beyond Top-N) or below the confidence gate
                bool lPrimary = array.get(lv_primary, array.get(idx, startI))
                // bias-aligned: fade levels on the side price is NOT being drawn toward
                bool lCounterBias = biasFadeLvls and biasOn and dayBias != 0 and (dayBias > 0 ? p < close : p > close)
                bool lFaint = (densOn and (not lPrimary or (lInWin and lp < eGate))) or lCounterBias
                color cLine = lFaint ? color.new(c, densFadeOp) : ((showTested and lTested) ? color.new(c, 55) : c)
                string lStyle = (lFaint or (showTested and lTested)) ? line.style_dotted : f_lineStyle()
                string full = lFaint ? (array.get(lv_name, array.get(idx, startI)) + " " + str.tostring(p, format.mintick)) : (tier + (emo == "None" ? "" : emo + " ") + array.get(lv_name, array.get(idx, startI)) + " " + str.tostring(p, format.mintick) + confLvlTag + testTag + f_countdown(p))
                line ln = line.new(bar_index, p, bar_index + ext, p, color = cLine, width = lineWidth, style = lStyle)
                color soloBg  = lFaint ? color.new(c, densFadeOp) : (outlineTags ? c : color.new(c, 85))
                color soloTxt = lFaint ? color.new(c, math.max(densFadeOp - 30, 0)) : (outlineTags ? clustLblTxt : c)
                label lb = label.new(bar_index + ext, p, full, style = label.style_label_left, color = soloBg, textcolor = soloTxt, size = f_labelSize())
                array.push(pool_lines, ln)
                array.push(pool_labels, lb)
            else if drawGroup
                float mid = sumP / members
                float t = math.min((members - 1) / 4.0, 1.0)
                int op = int(zoneOpacityMin + (zoneOpacityMax - zoneOpacityMin) * t)
                float pad = math.max(maxP - minP, nz(atr) * 0.08) / 2.0
                int domSide = sideSum > 0 ? 1 : sideSum < 0 ? -1 : 0
                color zbase = f_sideColI(domSide, mid, colZone)
                string sideTag = (showSideTag and sideColorOn) ? f_sideTagI(domSide, mid) : ""
                [confS, confParts] = f_confScore(mid, minP, maxP, members)
                if not showConf or confS >= confMin
                    float heatT = showConf ? math.min(confS / 100.0, 1.0) : 0.0
                    color zoneFillBase = color.from_gradient(heatT, 0.0, 1.0, zbase, color.new(#ffb300, 0))
                    int   heatOp = int(op - op * 0.45 * heatT)
                    color zoneFill = color.new(zoneFillBase, math.max(heatOp, 0))
                    color zoneBorder = color.from_gradient(heatT, 0.0, 1.0, color.new(zbase, 25), color.new(#ffb300, 10))
                    box bx = box.new(bar_index, mid + pad, bar_index + ext, mid - pad, border_color = zoneBorder, border_width = lineWidth, bgcolor = zoneFill)
                    string strength = showStrengthEmoji ? (f_repeat(f_sideEmojiI(domSide, mid), members) + " x" + str.tostring(members)) : ("x" + str.tostring(members))
                    string tier = tieredEmoji ? (f_tierEmoji(members) + " ") : ""
                    string confTag = showConf ? ("  ⭐" + str.tostring(confS) + (confParts == "" ? "" : " [" + confParts + "]")) : ""
                    // per-zone target-likelihood — Magnet quality (distance removed) or Raw pull share.
                    // Only zones with a member inside the N-nearest-each-side window get a %.
                    bool zUseQual = lvlConfMode == "Magnet quality"
                    float zNum = zUseQual ? sumQual : sumPull
                    float zDen = zUseQual ? totalQual : totalPull
                    float zPull = zDen > 0 ? zNum / zDen * 100.0 : 0.0
                    bool zTop = not na(topPullPrice) and topPullPrice >= minP - pad and topPullPrice <= maxP + pad
                    float atrUz = math.max(nz(atr), syminfo.mintick)
                    // stacked-agreement ⭐: DOL-side agrees + it's the magnet + zone overlaps OB/FVG
                    bool zSideAgree = (dolDrawUp and mid >= close) or (not dolDrawUp and mid < close)
                    string zStackTag = (projStacked and zInWin and zTop and zSideAgree and f_hasOBFVG(minP - pad, maxP + pad)) ? " ⭐" : ""
                    // tested/virgin zone: dashed hollow border + ✓ when price has probed the zone
                    bool zTested = showTested and (f_isTested(mid, atrUz) or f_isTested(minP, atrUz) or f_isTested(maxP, atrUz))
                    string lvlConfTag = (showLvlConf and zInWin) ? ((zTop ? "  🎯" : "  →") + str.tostring(math.round(zPull)) + "%" + zStackTag) : ""
                    if zTested
                        box.set_border_style(bx, line.style_dashed)
                        box.set_bgcolor(bx, color.new(zbase, 92))
                    string testTagZ = zTested ? "  ✓" : ""
                    // declutter: faint zone if no Top-N member OR below the confidence gate
                    bool zCounterBias = biasFadeLvls and biasOn and dayBias != 0 and (dayBias > 0 ? mid < close : mid > close)
                    bool zFaint = (densOn and (not zPrimary or (zInWin and zPull < eGate))) or zCounterBias
                    if zFaint
                        box.set_border_style(bx, line.style_dotted)
                        box.set_border_color(bx, color.new(zbase, densFadeOp))
                        box.set_bgcolor(bx, color.new(zbase, math.max(densFadeOp, 90)))
                    string full = zFaint ? (names + "  " + str.tostring(mid, format.mintick)) : (tier + strength + (sideTag == "" ? "" : " " + sideTag) + "  " + names + "  " + str.tostring(mid, format.mintick) + confTag + lvlConfTag + testTagZ + f_countdown(mid))
                    color lblBg  = zFaint ? color.new(zbase, densFadeOp) : (outlineTags ? zbase : color.new(#1e222d, 10))
                    color lblTxt = zFaint ? color.new(zbase, math.max(densFadeOp - 30, 0)) : clustLblTxt
                    label lb = label.new(bar_index + ext, mid, full, style = label.style_label_left, color = lblBg, textcolor = lblTxt, size = zFaint ? size.tiny : f_strongSize(members))
                    array.push(pool_boxes, bx)
                    array.push(pool_labels, lb)
            gi := gi + 1
    true

// 4) order-block boxes
f_blkObDraw() =>
    // ---- Order block boxes (last bar) ----
    f_clearXtra()
    if masterOn and showOB and array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            bool bull = array.get(obBull, oi)
            color oc  = bull ? obColBull : obColBear
            int   ob0 = array.get(obBirth, oi)
            float obT = array.get(obTop, oi)
            float obB = array.get(obBot, oi)
            int   obSc = oi < array.size(obStr) ? int(array.get(obStr, oi)) : 50
            bool  obPass = (not obFilterOn) or (obSc >= obMinStr)
            if not na(obT) and not na(obB) and obPass
                int   ob1 = f_clampBar(ob0)
                box obx = box.new(ob1, obT, bar_index + extendR, obB, border_color = color.new(bull ? obColBull : obColBear, 20), border_width = 1, bgcolor = oc)
                array.push(xtra_boxes, obx)
                // strength % printed CENTERED inside the block (no right-edge label clutter)
                if obShowStr
                    int    obCx = int(math.round((ob1 + bar_index + extendR) / 2.0))
                    label olb = label.new(obCx, (obT + obB) / 2.0, str.tostring(obSc) + "%", style = label.style_text_outline, textcolor = color.white, color = color.new(bull ? obColBull : obColBear, 100), size = size.small)
                    array.push(xtra_labels, olb)
    true

if barstate.islast
    f_blkCollect()
    [dirNew, dolUpNow, topPullNow, totPullNow, totQualNow] = f_blkDol(dm_dirState)
    dm_dirState := dirNew
    f_blkDraw(dolUpNow, topPullNow, totPullNow, totQualNow)
    f_blkObDraw()


// ---- CONTEXT PANEL (Daily Bias + market condition) ----
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkCtx() =>
    if masterOn and barstate.islast
        bool ctxBias   = biasOn and biasBanner
        bool ctxRegime = regimeOn and not (mtOn and mtShowDash)   // Brooks dashboard already shows it
        if ctxBias or ctxRegime
            // --- Daily Bias rows ---
            color  biasAccent = dayBias > 0 ? themeUpSolid : dayBias < 0 ? themeDnSolid : themeMuted
            string biasWord = dayBias > 0 ? "LONG" : dayBias < 0 ? "SHORT" : "NEUTRAL"
            string biasArrow = dayBias > 0 ? "🔼" : dayBias < 0 ? "🔽" : "⏸"
            string cautionTxt = dayCaution ? " ⚠ caution" : ""
            string whyTxt = dayBias == 0 ? "no clean structure" : (biasWhyStruct + biasWhySweep)
            biasSzB = biasBanSize == "Huge" ? size.large : biasBanSize == "Large" ? size.normal : size.small
            // --- Regime row ---
            string regWord = mtCond == 1 ? "TREND" : mtCond == 3 ? "TRANSITION" : "RANGE"
            string regEmo  = mtCond == 1 ? "➡" : mtCond == 3 ? "⤴" : "↔"
            color  regCol  = mtCond == 1 ? themeUpSolid : mtCond == 3 ? color.orange : themeMuted
            string regTxt  = regEmo + " MARKET: " + regWord + "  · trend score " + str.tostring(100.0 * mtTrendScore, "#") + (regimeChop ? ("  ⚠ VWAP chop (" + str.tostring(int(vwapCrosses)) + "x)") : "")
            // build the panel (up to 3 rows: bias title, bias why, market condition)
            var table ctxTbl = table.new(position.top_left, 1, 3, border_width = 1)
            table.set_position(ctxTbl, f_tablePos(biasBanPos))
            table.clear(ctxTbl, 0, 0, 0, 2)
            int cr = 0
            if ctxBias
                table.cell(ctxTbl, 0, cr, biasArrow + " TODAY: " + biasWord + cautionTxt, text_color = biasAccent, bgcolor = themePanelBg, text_size = biasSzB)
                cr := cr + 1
                table.cell(ctxTbl, 0, cr, whyTxt, text_color = themeMuted, bgcolor = themeRowBg, text_size = size.small)
                cr := cr + 1
            if ctxRegime
                table.cell(ctxTbl, 0, cr, regTxt, text_color = regCol, bgcolor = cr == 0 ? themePanelBg : themeRowBg, text_size = size.small)
                cr := cr + 1
            table.set_frame_color(ctxTbl, color.new(biasAccent, 35))
            table.set_frame_width(ctxTbl, themeBW)
    true
f_blkCtx()

// wipe extra pool when master/OB off
if (not masterOn or not showOB) and array.size(xtra_boxes) + array.size(xtra_labels) > 0
    f_clearXtra()

// -----------------------------------------------------------------------------
// FAIR VALUE GAPS  — rolling boxes  (arrays declared earlier, near projection helpers)
// -----------------------------------------------------------------------------
f_delFvgAt(int ix) =>
    box.delete(array.get(fvgBoxes, ix))
    label lb = array.get(fvgLabels, ix)
    if not na(lb)
        label.delete(lb)
    line ce = array.get(fvgCE, ix)
    if not na(ce)
        line.delete(ce)
    array.remove(fvgBoxes, ix)
    array.remove(fvgIsBull, ix)
    array.remove(fvgStr, ix)
    array.remove(fvgLabels, ix)
    array.remove(fvgCE, ix)

if (not masterOn or not showFVG) and array.size(fvgBoxes) > 0
    while array.size(fvgBoxes) > 0
        f_delFvgAt(0)

bullFVG = low > nz(high[2], low)
bearFVG = high < nz(low[2], high)
// A newly confirmed gap is scored for strength; weak gaps are hidden (or dimmed) so the
// chart isn't flooded with trivial imbalances on low timeframes.
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkFvgNew() =>
    if masterOn and showFVG and (bullFVG or bearFVG)
        bool  isBull = bullFVG
        float gTop   = isBull ? low   : low[2]
        float gBot   = isBull ? high[2] : high
        // min-gap floor: a micro-gap below the ATR floor is ignored entirely (never scored/drawn)
        float gapATR = math.abs(gTop - gBot) / math.max(nz(atr), syminfo.mintick)
        bool  bigEnough = fvgMinGapATR <= 0.0 or gapATR >= fvgMinGapATR
        if bigEnough
            // the displacement candle that opened the gap is the middle bar [1]
            float dispVol = nz(volume[1], volume)
            // displacement quality (0..1): body dominance of the creating candle + a structure-break
            // bonus if that candle's close took out the most recent opposing swing.
            float dRange = math.max(high[1] - low[1], syminfo.mintick)
            float bodyDom = math.abs(close[1] - open[1]) / dRange                 // 0..1
            bool  brokeStruct = isBull ? (not na(lastPH) and close[1] > lastPH) : (not na(lastPL) and close[1] < lastPL)
            float dispQual = math.min(1.0, bodyDom * 0.7 + (brokeStruct ? 0.3 : 0.0))
            [sc, isInv, inBlock, htfAl, liqAl, swpAl] = f_fvgStrength(gTop, gBot, isBull, dispVol, dispQual, false)
            // bias-aligned declutter: a gap opposing the committed daily bias is counter-bias.
            bool counterBias = biasOn and dayBias != 0 and (isBull ? dayBias < 0 : dayBias > 0)
            bool biasHide = counterBias and biasHideFVG
            bool pass = (not fvgFilterOn) or (sc >= fvgMinStr)
            if (pass or fvgDimWeak) and not biasHide
                // counter-bias gaps are drawn faint (like weak) when fading is on
                bool weak = (fvgFilterOn and sc < fvgMinStr) or (counterBias and biasFadeFVG)
                color baseCol = isBull ? colBull : colBear
                int   fillOp  = weak ? math.min(opacityFVG + 15, 97) : opacityFVG
                int   bordOp  = weak ? 85 : 40
                box b = box.new(bar_index[2], gTop, bar_index + extendR, gBot, border_color = color.new(baseCol, bordOp), bgcolor = color.new(colFVGBase, fillOp))
                array.push(fvgBoxes, b)
                array.push(fvgIsBull, isBull)
                array.push(fvgStr, sc)
                label lb = na
                if fvgShowStr and not weak
                    string suffix = (htfAl ? " htf" : "") + (liqAl ? " liq" : "") + (swpAl ? " swp" : "") + (isInv ? " inv" : "") + (inBlock ? " blk" : "")
                    float ceY = (gTop + gBot) / 2.0
                    // % sits centered inside the gap box (tied to its box, away from the level labels)
                    int cx = int(math.round((bar_index[2] + bar_index + extendR) / 2.0))
                    lb := label.new(cx, ceY, str.tostring(sc) + "%" + suffix, style = label.style_text_outline, textcolor = color.white, color = color.new(baseCol, 100), size = size.small)
                array.push(fvgLabels, lb)
                // consequent-encroachment (CE) line at the gap midpoint — the 50% price reacts to
                line ce = na
                if fvgShowCE and not weak
                    float ceMid = (gTop + gBot) / 2.0
                    ce := line.new(bar_index[2], ceMid, bar_index + extendR, ceMid, color = fvgCECol, style = line.style_dashed, width = 1)
                array.push(fvgCE, ce)
    true
f_blkFvgNew()


// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkFvgUpdate() =>
    if array.size(fvgBoxes) > 0
        while array.size(fvgBoxes) > fvgKeep
            f_delFvgAt(0)
        int i = 0
        while i < array.size(fvgBoxes)
            box bx     = array.get(fvgBoxes, i)
            bool isBull = array.get(fvgIsBull, i)
            float top  = box.get_top(bx)
            float bot  = box.get_bottom(bx)
            float mid  = (top + bot) / 2.0
            bool invalid = false
            if hideMitFVG
                if fvgFillMode == "Body close through"
                    invalid := isBull ? (close < bot) : (close > top)
                else if fvgFillMode == "Wick touch (50%)"
                    invalid := isBull ? (low <= mid) : (high >= mid)
                else
                    invalid := high >= top and low <= bot
            if invalid
                // remember this zone briefly so a later opposite gap here counts as an inversion
                array.push(invTop, top)
                array.push(invBot, bot)
                array.push(invWasBull, isBull)
                array.push(invBar, bar_index)
                f_delFvgAt(i)
            else
                box.set_right(bx, bar_index + extendR)
                label lb = array.get(fvgLabels, i)
                // keep the label centered over the (growing) box
                if not na(lb)
                    label.set_x(lb, int(math.round((box.get_left(bx) + bar_index + extendR) / 2.0)))
                line ce = array.get(fvgCE, i)
                if not na(ce)
                    line.set_x2(ce, bar_index + extendR)
                i += 1
    true
f_blkFvgUpdate()


// prune inversion memory beyond its window
if array.size(invTop) > 0
    int k = 0
    while k < array.size(invTop)
        if bar_index - array.get(invBar, k) > fvgInvBars
            array.remove(invTop, k)
            array.remove(invBot, k)
            array.remove(invWasBull, k)
            array.remove(invBar, k)
        else
            k += 1

// -----------------------------------------------------------------------------
// HIGHER-TIMEFRAME FAIR VALUE GAPS — box-less tracking (boost aligned gaps + feed DOL)
// -----------------------------------------------------------------------------
// wipe when master/HTF-FVG off
if (not masterOn or not htfFvgOn) and array.size(htfFvgTop) > 0
    array.clear(htfFvgTop)
    array.clear(htfFvgBot)
    array.clear(htfFvgBull)
    array.clear(htfFvgStr)

// register a newly confirmed HTF gap (once per HTF bar), gated by the same min-gap floor
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkHtfFvgNew() =>
    if masterOn and htfFvgNew
        bool  hbull = nz(hfvgBull) == 1
        float hT = math.max(hfvgT, hfvgB)
        float hB = math.min(hfvgT, hfvgB)
        float hGapATR = math.abs(hT - hB) / math.max(nz(atr), syminfo.mintick)
        bool  hBig = fvgMinGapATR <= 0.0 or hGapATR >= fvgMinGapATR
        // avoid duplicate of a near-identical zone already tracked
        bool  dup = false
        if array.size(htfFvgTop) > 0
            float tolZ = nz(atr) * 0.1
            for di = 0 to array.size(htfFvgTop) - 1
                if math.abs(array.get(htfFvgTop, di) - hT) <= tolZ and math.abs(array.get(htfFvgBot, di) - hB) <= tolZ
                    dup := true
        if hBig and not dup
            // HTF gaps: skip the HTF-alignment factor (isHtf=true) to avoid self-matching; use a
            // neutral displacement quality since the HTF candle body isn't pulled back.
            [hsc, hInv, hBlk, hAl, hLq, hSw] = f_fvgStrength(hT, hB, hbull, nz(hfvgVol), 0.5, true)
            array.push(htfFvgTop, hT)
            array.push(htfFvgBot, hB)
            array.push(htfFvgBull, hbull)
            array.push(htfFvgStr, hsc)
            while array.size(htfFvgTop) > htfFvgKeep
                array.shift(htfFvgTop)
                array.shift(htfFvgBot)
                array.shift(htfFvgBull)
                array.shift(htfFvgStr)
    true
f_blkHtfFvgNew()

// invalidate tracked HTF gaps once the current (chart) price fills them, same rule set
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkHtfFvgUpd() =>
    if array.size(htfFvgTop) > 0
        int hi2 = 0
        while hi2 < array.size(htfFvgTop)
            float hT = array.get(htfFvgTop, hi2)
            float hB = array.get(htfFvgBot, hi2)
            bool  hbull = array.get(htfFvgBull, hi2)
            float hMid = (hT + hB) / 2.0
            bool hInvalid = false
            if hideMitFVG
                if fvgFillMode == "Body close through"
                    hInvalid := hbull ? (close < hB) : (close > hT)
                else if fvgFillMode == "Wick touch (50%)"
                    hInvalid := hbull ? (low <= hMid) : (high >= hMid)
                else
                    hInvalid := high >= hT and low <= hB
            if hInvalid
                array.remove(htfFvgTop, hi2)
                array.remove(htfFvgBot, hi2)
                array.remove(htfFvgBull, hi2)
                array.remove(htfFvgStr, hi2)
            else
                hi2 += 1
    true
f_blkHtfFvgUpd()

// (HTF FVGs are now folded into the gap SCORE — see f_fvgStrength's HTF-alignment factor —
//  and still feed the DOL model; there is no separate HTF panel.)

// -----------------------------------------------------------------------------
// OPENING RANGE BREAKOUT (ORB) — opening-window box + confirmed break / failed break
// -----------------------------------------------------------------------------
type OrbState
    float orbHi = na
    float orbLo = na
    int orbStartB = na
    bool orbReady = false
    int orbBreakDir = 0
    bool orbFailed = false
    int orbUpRun = 0
    int orbDnRun = 0
    box orbCurBox = na
    line orbCurHiLn = na
    line orbCurLoLn = na

type OrbEv
    bool orbBreakUpNow = false
    bool orbBreakDnNow = false
    bool orbFailNow = false

var OrbState orbS = OrbState.new()   // persistent ORB state (object so the ORB block can run in a function)
OrbEv orbE = OrbEv.new()              // per-bar ORB events
var array<box>  orbBoxes = array.new<box>()
var array<line> orbHiLns = array.new<line>()
var array<line> orbLoLns = array.new<line>()
var array<label> orbLbls = array.new<label>()   // break / fail markers, capped at 3 per kept day
bool orbInWin  = not na(time(timeframe.period, orbSession, orbTZ))
bool orbWinNew = orbInWin and not orbInWin[1]
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkOrb() =>
    if masterOn and orbOn
        if orbWinNew
            orbS.orbHi := high
            orbS.orbLo := low
            orbS.orbStartB := bar_index
            orbS.orbReady := false
            orbS.orbBreakDir := 0
            orbS.orbFailed := false
            orbS.orbUpRun := 0
            orbS.orbDnRun := 0
            orbS.orbCurBox  := box.new(bar_index, orbS.orbHi, bar_index, orbS.orbLo, border_color = color.new(orbCol, 30), border_width = 1, bgcolor = color.new(orbCol, 90))
            orbS.orbCurHiLn := line.new(bar_index, orbS.orbHi, bar_index, orbS.orbHi, color = orbCol, width = 1)
            orbS.orbCurLoLn := line.new(bar_index, orbS.orbLo, bar_index, orbS.orbLo, color = orbCol, width = 1)
            array.push(orbBoxes, orbS.orbCurBox)
            array.push(orbHiLns, orbS.orbCurHiLn)
            array.push(orbLoLns, orbS.orbCurLoLn)
            if array.size(orbBoxes) > orbHist
                box.delete(array.shift(orbBoxes))
                line.delete(array.shift(orbHiLns))
                line.delete(array.shift(orbLoLns))
        else if orbInWin
            orbS.orbHi := math.max(nz(orbS.orbHi, high), high)
            orbS.orbLo := math.min(nz(orbS.orbLo, low), low)
        else if orbInWin[1] and not orbInWin
            orbS.orbReady := true
        // draw / update only the current day's objects; past days stay frozen
        if not na(orbS.orbHi) and not na(orbS.orbLo) and not na(orbS.orbCurBox)
            int xr = orbExtend ? bar_index : (na(orbS.orbStartB) ? bar_index : orbS.orbStartB + 1)
            box.set_lefttop(orbS.orbCurBox, nz(orbS.orbStartB, bar_index), orbS.orbHi)
            box.set_rightbottom(orbS.orbCurBox, xr, orbS.orbLo)
            line.set_xy1(orbS.orbCurHiLn, nz(orbS.orbStartB, bar_index), orbS.orbHi)
            line.set_xy2(orbS.orbCurHiLn, xr, orbS.orbHi)
            line.set_xy1(orbS.orbCurLoLn, nz(orbS.orbStartB, bar_index), orbS.orbLo)
            line.set_xy2(orbS.orbCurLoLn, xr, orbS.orbLo)
        // break state on CONFIRMED bars only: a close must clear the edge by orbBrkBuf ATRs for
        // orbBrkBars consecutive closes; a later close back inside (past the buffer) = failed break.
        if barstate.isconfirmed and orbS.orbReady and not na(orbS.orbHi) and not na(orbS.orbLo)
            float orbBrkAbs = orbBrkBuf * math.max(nz(atr), syminfo.mintick)
            if orbS.orbBreakDir == 0
                orbS.orbUpRun := close > orbS.orbHi + orbBrkAbs ? orbS.orbUpRun + 1 : 0
                orbS.orbDnRun := close < orbS.orbLo - orbBrkAbs ? orbS.orbDnRun + 1 : 0
                if orbS.orbUpRun >= orbBrkBars
                    orbS.orbBreakDir := 1
                    orbE.orbBreakUpNow := true
                else if orbS.orbDnRun >= orbBrkBars
                    orbS.orbBreakDir := -1
                    orbE.orbBreakDnNow := true
            else if not orbS.orbFailed and ((orbS.orbBreakDir == 1 and close < orbS.orbHi - orbBrkAbs) or (orbS.orbBreakDir == -1 and close > orbS.orbLo + orbBrkAbs))
                orbS.orbFailed := true
                orbE.orbFailNow := true
            if orbE.orbBreakUpNow
                array.push(orbLbls, label.new(bar_index, high, "ORB ▲", style = label.style_label_down, color = color.new(themeUpSolid, 20), textcolor = color.white, size = size.tiny))
            if orbE.orbBreakDnNow
                array.push(orbLbls, label.new(bar_index, low, "ORB ▼", style = label.style_label_up, color = color.new(themeDnSolid, 20), textcolor = color.white, size = size.tiny))
            if orbE.orbFailNow
                array.push(orbLbls, label.new(bar_index, orbS.orbBreakDir == 1 ? high : low, "ORB fail", style = orbS.orbBreakDir == 1 ? label.style_label_down : label.style_label_up, color = color.new(color.orange, 20), textcolor = color.white, size = size.tiny))
            while array.size(orbLbls) > 3 * orbHist
                label.delete(array.shift(orbLbls))
    true
f_blkOrb()
// wipe all ORB drawings when off
// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkOrbWipe() =>
    if (not masterOn or not orbOn) and array.size(orbBoxes) + array.size(orbLbls) > 0
        for lbx in orbLbls
            label.delete(lbx)
        array.clear(orbLbls)
        for bx in orbBoxes
            box.delete(bx)
        for l in orbHiLns
            line.delete(l)
        for l in orbLoLns
            line.delete(l)
        array.clear(orbBoxes)
        array.clear(orbHiLns)
        array.clear(orbLoLns)
        orbS.orbCurBox := na
        orbS.orbCurHiLn := na
        orbS.orbCurLoLn := na
    true
f_blkOrbWipe()

// =============================================================================
// ⑫ AL BROOKS MICROTRENDLINE PRICE ACTION MODULE  (toggle: "Enable module")
//   Setup A  Failed microtrendline breakout (primary)
//   Setup B  Microtrendline break + pullback continuation
//   Setup C  Failed-breakout reversal (stricter confirmation)
//   Setup D  High 2 / Low 2 second-entry with trend context
//   + H1/H2/L1/L2 markers, market condition (TREND/RANGE/TRANSITION),
//     signal-bar quality, 0-100 confluence score, pending/entry/stop/target
//     tracking, dashboard, alerts and historical signal statistics.
// Non-repainting: the whole engine runs ONLY on confirmed (closed) bars; the
// higher-timeframe context uses lookahead_on with a [1] offset (last CLOSED HTF bar).
// The confluence score is a technical confluence rating, NOT a probability.
// =============================================================================
// =============================================================================
// TYPES + STATE
// =============================================================================
type MtTL
    int    dir       = 0
    int    state     = 0      // 0 none · 1 intact · 2 penetrated (watching) · 3 genuinely broken (post-break record) · 4 failed breakout (awaiting signal bar)
    int    x1        = 0
    float  y1        = na
    int    x2        = 0
    float  y2        = na
    float  slope     = 0.0
    int    touches   = 0
    bool   isMC      = false
    float  quality   = 0.0
    int    hug       = 0
    float  peak      = na
    int    peakBar   = 0
    int    brkBar    = 0
    float  brkExt    = na
    float  brkPen    = 0.0
    int    failBar   = 0
    float  structLvl = na
    bool   structOK  = true
    bool   closeOver = false
    bool   retested  = false
    int    retestBar = 0
    float  retestExt = na
    bool   evNew     = false
    bool   evBreak   = false
    bool   evFail    = false
    bool   evGenuine = false
    line   ln        = na

var MtTL mtBull    = MtTL.new(dir = 1)
var MtTL mtBear    = MtTL.new(dir = -1)
var MtTL mtBullBrk = MtTL.new(dir = 1)
var MtTL mtBearBrk = MtTL.new(dir = -1)

var array<float> mtPLpx = array.new<float>()
var array<int>   mtPLbr = array.new<int>()
var array<float> mtPHpx = array.new<float>()
var array<int>   mtPHbr = array.new<int>()
var array<line>  mtHist = array.new<line>()
var array<line>  mtOldLn = array.new<line>()
var array<label> mtOldLb = array.new<label>()
var array<label> mtSigLbls = array.new<label>()
var array<float> mtFacTmp  = array.new<float>(8, 0.0)
var array<float> mtFacBest = array.new<float>(8, 0.0)
var array<float> mtFac     = array.new<float>(8, 0.0)   // factor points of the current / last setup
var array<float> mtStat    = array.new<float>(80, 0.0)  // 16 groups × [n, wins, sumR, sumWinR, sumLossR]
var array<int>   mtCT = array.new<int>()
var array<int>   mtCD = array.new<int>()
var array<float> mtCF = array.new<float>()
var array<float> mtCQ = array.new<float>()
var array<float> mtCS = array.new<float>()
var array<float> mtC3 = array.new<float>()

// H / L sequence state
// setup / trade state: mtS.stSt 0 idle · 1 pending · 2 open · 3 finished
var int    mtMcBull = 0
var int    mtMcBear = 0

// =============================================================================
// PER-BAR SERIES (computed every bar; only read by the engine on confirmed bars)
// =============================================================================
// ---- multi-timeframe directional context (no lookahead: last CLOSED HTF bar) ----
f_mtCtx(int plen, bool lag) =>
    float cPh = ta.pivothigh(high, plen, plen)
    float plw = ta.pivotlow(low, plen, plen)
    var float h1 = na
    var float h0 = na
    var float l1 = na
    var float l0 = na
    if not na(cPh)
        h0 := h1
        h1 := cPh
    if not na(plw)
        l0 := l1
        l1 := plw
    float e = ta.ema(close, 20)
    float a = ta.atr(14)
    int st = 0
    if not na(h0) and not na(l0)
        if h1 > h0 and l1 > l0
            st := 1
        else if h1 < h0 and l1 < l0
            st := -1
    int mom = 0
    if close > e and e > e[3]
        mom := 1
    else if close < e and e < e[3]
        mom := -1
    int dir = st
    if st == 0
        dir := mom
    else if mom == -st
        dir := 0
    float strn = a > 0 ? math.abs(close - e) / a : 0.0
    [lag ? dir[1] : dir, lag ? strn[1] : strn]

[mtT1, mtT1s]       = f_mtCtx(mtCtxPiv, false)
[mtSec5, mtSec5s]   = request.security(syminfo.tickerid, mtTF5,  f_mtCtx(mtCtxPiv, true), lookahead = barmerge.lookahead_on)
[mtSec15, mtSec15s] = request.security(syminfo.tickerid, mtTF15, f_mtCtx(mtCtxPiv, true), lookahead = barmerge.lookahead_on)
// if the chart is already slower than the requested timeframe, fall back to the chart's own context
int mtD5  = timeframe.in_seconds(mtTF5)  <= secPerBar ? nz(mtT1) : nz(mtSec5)
int mtD15 = timeframe.in_seconds(mtTF15) <= secPerBar ? nz(mtT1) : nz(mtSec15)
int mtD1  = nz(mtT1)

// ---- pivots ----
float mtPLv = ta.pivotlow(low, mtPivL, mtPivR)
float mtPHv = ta.pivothigh(high, mtPivL, mtPivR)
bool  mtNewPL = not na(mtPLv)
bool  mtNewPH = not na(mtPHv)

// ---- microchannel run counters (stair-stepping bars) ----
mtMcBull := (low >= low[1] - mtMcTol * atr and high >= high[1] - mtMcTol * atr and close > close[1]) ? mtMcBull + 1 : 0
mtMcBear := (high <= high[1] + mtMcTol * atr and low <= low[1] + mtMcTol * atr and close < close[1]) ? mtMcBear + 1 : 0

// ---- signal bar anatomy ----
float mtAvgRng = ta.sma(mtBarRng, 20)
float mtBody = mtBarRng > 0 ? math.abs(close - open) / mtBarRng : 0.0
float mtCPos = mtBarRng > 0 ? (close - low) / mtBarRng : 0.5
float mtUW   = mtBarRng > 0 ? (high - math.max(open, close)) / mtBarRng : 0.0
float mtLW   = mtBarRng > 0 ? (math.min(open, close) - low) / mtBarRng : 0.0
float mtRelSz = mtAvgRng > 0 ? mtBarRng / mtAvgRng : 1.0
bool mtSbBullOk = close > open and mtBody >= mtSbBody and mtCPos >= mtSbClose and mtUW <= mtSbWick and mtRelSz >= mtSbSize
bool mtSbBearOk = close < open and mtBody >= mtSbBody and (1.0 - mtCPos) >= mtSbClose and mtLW <= mtSbWick and mtRelSz >= mtSbSize
float mtSqBull = close > open ? math.max(0.0, math.min(1.0, 0.30 * math.min(1.0, mtBody / 0.7) + 0.30 * mtCPos + 0.20 * (1.0 - math.min(1.0, mtUW / 0.4)) + 0.20 * math.min(1.0, mtRelSz / 1.2))) : 0.0
float mtSqBear = close < open ? math.max(0.0, math.min(1.0, 0.30 * math.min(1.0, mtBody / 0.7) + 0.30 * (1.0 - mtCPos) + 0.20 * (1.0 - math.min(1.0, mtLW / 0.4)) + 0.20 * math.min(1.0, mtRelSz / 1.2))) : 0.0

float mtVwapSlp = (not na(vwapVal) and atr > 0) ? (vwapVal - nz(vwapVal[5], vwapVal)) / atr : 0.0

// ---- time-of-day bucket (New York): 0 open · 1 late AM · 2 midday · 3 afternoon · 4 other ----
int mtHhmm = hour(time, "America/New_York") * 100 + minute(time, "America/New_York")
int mtTodIdx = (mtHhmm >= 930 and mtHhmm < 1030) ? 0 : (mtHhmm >= 1030 and mtHhmm < 1200) ? 1 : (mtHhmm >= 1200 and mtHhmm < 1400) ? 2 : (mtHhmm >= 1400 and mtHhmm < 1600) ? 3 : 4

// ---- per-bar event flags (reset every execution; set only on confirmed bars) ----
MtEv mtE = MtEv.new()

// =============================================================================
// HELPERS
// =============================================================================
// one key/value table row (muted key, colored value) — shared by the dashboard + stats tables
f_row(table t, int r, string k, string v, color vc, string ksz = size.small, string vsz = size.small) =>
    table.cell(t, 0, r, k, text_color = themeMuted, bgcolor = themeRowBg, text_size = ksz, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = vc, bgcolor = themeRowBg, text_size = vsz, text_halign = text.align_left)
    true

f_mtPos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : p == "Middle Right" ? position.middle_right : position.middle_left

f_mtVal(MtTL t, int bi) => t.y1 + t.slope * (bi - t.x1)

f_mtValid(MtTL t) => t.isMC or t.touches >= mtMinTouch

f_mtQuality(MtTL t) =>
    float tS = math.min(1.0, (t.touches - 1) / 3.0)
    float sS = atr > 0 ? math.min(1.0, (t.dir * t.slope / atr) / 0.15) : 0.0
    float lS = math.min(1.0, (t.x2 - t.x1) / 6.0)
    float hS = math.min(1.0, t.hug / 3.0)
    math.max(0.0, math.min(1.0, 0.35 * tS + 0.25 * sS + 0.20 * lS + 0.20 * hS))

f_mtTypeName(int ty) => ty == 0 ? "Failed BO" : ty == 1 ? "Pullback cont." : ty == 2 ? "Reversal" : "H2/L2"

f_mtCls(float sc) => sc >= 85 ? "A+ SETUP" : sc >= 75 ? "A SETUP" : sc >= 65 ? "B SETUP" : "BELOW B"

f_mtCopy(MtTL dst, MtTL src) =>
    dst.dir := src.dir
    dst.state := src.state
    dst.x1 := src.x1
    dst.y1 := src.y1
    dst.x2 := src.x2
    dst.y2 := src.y2
    dst.slope := src.slope
    dst.touches := src.touches
    dst.isMC := src.isMC
    dst.quality := src.quality
    dst.hug := src.hug
    dst.peak := src.peak
    dst.peakBar := src.peakBar
    dst.brkBar := src.brkBar
    dst.brkExt := src.brkExt
    dst.brkPen := src.brkPen
    dst.failBar := src.failBar
    dst.structLvl := src.structLvl
    true   // explicit return: keeps the function's return type consistent

// retire the drawn line (to history or delete) and mark the record empty
f_mtRetire(MtTL t, color fc) =>
    if not na(t.ln)
        if mtShowHist
            line.set_xy2(t.ln, bar_index, f_mtVal(t, bar_index))
            line.set_extend(t.ln, extend.none)
            line.set_color(t.ln, fc)
            line.set_style(t.ln, line.style_dotted)
            line.set_width(t.ln, 1)
            array.push(mtHist, t.ln)
            if array.size(mtHist) > mtHistKeep
                line.delete(array.shift(mtHist))
        else
            line.delete(t.ln)
        t.ln := na
    t.state := 0
    true   // explicit return: keeps the function's return type consistent

// genuine break: keep a post-break record (b) for setups B / C, retire the live line
f_mtGenuine(MtTL t, MtTL b) =>
    f_mtCopy(b, t)
    b.ln := na
    b.state := 3
    b.structOK := true
    b.closeOver := false
    b.retested := false
    b.retestBar := 0
    b.retestExt := na
    t.evGenuine := true
    f_mtRetire(t, mtColBrk)
    true   // explicit return: keeps the function's return type consistent

f_mtDraw(MtTL t) =>
    if mtShowTL and (t.state == 1 or t.state == 2 or t.state == 4) and f_mtValid(t)
        float yEnd = f_mtVal(t, bar_index)
        color col = t.state == 2 ? mtColBrk : (t.dir > 0 ? mtColBull : mtColBear)
        if na(t.ln)
            t.ln := line.new(t.x1, t.y1, bar_index, yEnd, color = col, width = 2, extend = extend.right)
        else
            line.set_xy1(t.ln, t.x1, t.y1)
            line.set_xy2(t.ln, bar_index, yEnd)
            line.set_color(t.ln, col)
        line.set_style(t.ln, t.state == 2 ? line.style_dashed : line.style_solid)
    true   // explicit return: keeps the function's return type consistent

// ---- the per-direction trendline state machine (s = +1 support line / bull, -1 resistance line / bear)
f_mtStep(MtTL t, MtTL b, int s, array<float> pPx, array<int> pBr, bool newPiv, int mcLen) =>
    t.evNew := false
    t.evBreak := false
    t.evFail := false
    t.evGenuine := false
    int bi = bar_index
    float pen = mtMaxPen * atr
    float ext = s > 0 ? low : high
    color fade = color.new(s > 0 ? mtColBull : mtColBear, 55)
    int n = array.size(pPx)
    // (1) form a line from the newest pivot, or count it as a touch of the live line
    if newPiv and n >= 1
        float p2 = array.get(pPx, n - 1)
        int x2 = array.get(pBr, n - 1)
        bool respected = false
        if t.state == 1 or t.state == 4
            float lvP = f_mtVal(t, x2)
            if math.abs(p2 - lvP) <= mtTouchTol * atr
                t.touches := t.touches + 1
                t.x2 := x2
                t.y2 := p2
                t.quality := f_mtQuality(t)
                respected := true
        if not respected and n >= 2 and (t.state == 0 or t.state == 1)
            for k = n - 2 to math.max(0, n - 5)
                float p1 = array.get(pPx, k)
                int x1 = array.get(pBr, k)
                int dx = x2 - x1
                if dx >= mtMinBetween and dx <= mtMaxBetween and s * (p2 - p1) > 0
                    float slp = (p2 - p1) / dx
                    if s * slp >= mtMinSlope * atr
                        bool ok = true
                        int hug = 0
                        float pk = na
                        int pkBar = x1
                        int span = bi - x1
                        for i = 0 to span
                            int xb = bi - i
                            float lvv = p1 + slp * (xb - x1)
                            float eb = s > 0 ? low[i] : high[i]
                            float pe = s > 0 ? high[i] : low[i]
                            float gap = s * (eb - lvv)
                            if gap < -pen
                                ok := false
                                break
                            if gap <= 0.35 * atr
                                hug += 1
                            if na(pk) or s * (pe - pk) > 0
                                pk := pe
                                pkBar := xb
                        if ok
                            if t.state == 1
                                f_mtRetire(t, fade)
                            t.x1 := x1
                            t.y1 := p1
                            t.x2 := x2
                            t.y2 := p2
                            t.slope := slp
                            t.touches := 2
                            t.isMC := false
                            t.hug := hug
                            t.peak := pk
                            t.peakBar := pkBar
                            t.structLvl := p1
                            t.state := 1
                            t.quality := f_mtQuality(t)
                            t.evNew := true
                            break
    // (2) microchannel line (few-bar channel, no separated pivots needed)
    if mtMcOn and mcLen >= mtMcMin and (t.state == 0 or (t.state == 1 and t.isMC))
        int i0 = math.min(mcLen, 12)
        float y0 = s > 0 ? low[i0] : high[i0]
        float bestSl = na
        for i = i0 - 1 to 0
            float yi = s > 0 ? low[i] : high[i]
            float sl = (yi - y0) / (i0 - i)
            if na(bestSl) or (s > 0 and sl < bestSl) or (s < 0 and sl > bestSl)
                bestSl := sl
        float move = s > 0 ? high - y0 : y0 - low
        if not na(bestSl) and s * bestSl >= mtMinSlope * atr * 0.5 and move >= mtMcMinMove * atr
            float pk2 = na
            int pk2Bar = bi
            for i = 0 to i0
                float pe2 = s > 0 ? high[i] : low[i]
                if na(pk2) or s * (pe2 - pk2) > 0
                    pk2 := pe2
                    pk2Bar := bi - i
            bool fresh = t.state == 0
            t.x1 := bi - i0
            t.y1 := y0
            t.x2 := bi
            t.y2 := y0 + bestSl * i0
            t.slope := bestSl
            t.touches := 2
            t.isMC := true
            t.hug := 3
            t.peak := pk2
            t.peakBar := pk2Bar
            t.structLvl := y0
            t.state := 1
            t.quality := math.min(1.0, 0.45 + 0.08 * (mcLen - mtMcMin) + 0.20 * math.min(1.0, move / (2.0 * atr)))
            if fresh
                t.evNew := true
    // (3) failed breakout housekeeping (bars after the reclaim bar)
    if t.state == 4 and t.failBar < bi
        float lv4 = f_mtVal(t, bi)
        bool lost = s > 0 ? low < t.brkExt : high > t.brkExt
        if lost
            f_mtGenuine(t, b)
        else if bi - t.failBar > mtSigWait
            if s * (close - lv4) > 0
                t.state := 1
            else
                f_mtRetire(t, fade)
    // (4) intact line: track the trend extreme, test for penetration, expire
    if t.state == 1
        float pe3 = s > 0 ? high : low
        if s * (pe3 - t.peak) > 0
            t.peak := pe3
            t.peakBar := bi
        float lv = f_mtVal(t, bi)
        float depth = s * (lv - ext)
        if depth > pen
            t.state := 2
            t.brkBar := bi
            t.brkExt := ext
            t.brkPen := atr > 0 ? depth / atr : 0.0
            t.evBreak := true
        else if bi - t.x2 > mtMaxAge
            f_mtRetire(t, fade)
    // (5) penetrated line: reclaim = FAILED breakout, no reclaim in time = genuine break
    if t.state == 2
        float lv2 = f_mtVal(t, bi)
        t.brkExt := s > 0 ? math.min(t.brkExt, low) : math.max(t.brkExt, high)
        if s * (close - lv2) > 0
            t.state := 4
            t.failBar := bi
            t.touches := t.touches + 1
            t.evFail := true
        else if bi - t.brkBar >= mtFailBars
            f_mtGenuine(t, b)
    true   // explicit return: keeps the function's return type consistent

// post-break record upkeep for setups B (pullback) and C (reversal)
f_mtPost(MtTL b, int s) =>
    if b.state == 3
        int since = bar_index - b.brkBar
        b.brkExt := s > 0 ? math.min(b.brkExt, low) : math.max(b.brkExt, high)
        if not na(b.structLvl) and s * (close - b.structLvl) < 0
            b.structOK := false
        if s * (close - b.peak) > 0
            b.closeOver := true
        bool inZone = s > 0 ? high >= b.peak - mtRetestTol * atr : low <= b.peak + mtRetestTol * atr
        if since >= 2 and inZone
            b.retested := true
            b.retestBar := bar_index
            float re = s > 0 ? high : low
            b.retestExt := na(b.retestExt) ? re : (s > 0 ? math.max(b.retestExt, re) : math.min(b.retestExt, re))
        if since > mtPostBreak
            b.state := 0
    true   // explicit return: keeps the function's return type consistent

// ---- candidate list ----
f_mtAddCand(int typ, int d, float fbo, float tlq, float stp, float t3) =>
    array.push(mtCT, typ)
    array.push(mtCD, d)
    array.push(mtCF, fbo)
    array.push(mtCQ, tlq)
    array.push(mtCS, stp)
    array.push(mtC3, t3)
    true   // explicit return: keeps the function's return type consistent

// ---- plan + confluence score for one candidate. Returns [score, entry, stop, risk, t1, t2, t3, ok, roomR]
f_mtEval(int typ, int d, float fboF, float tlQ, float stopStruct, float tgt3Ovr) =>
    float tick = syminfo.mintick
    float entry = d > 0 ? high + tick : low - tick
    float sigStop = d > 0 ? low - tick : high + tick
    float stp = sigStop
    if not na(stopStruct)
        float stS = d > 0 ? stopStruct - tick : stopStruct + tick
        if mtStopMode == "Structural"
            stp := stS
        else if mtStopMode == "Wider of both"
            stp := d > 0 ? math.min(sigStop, stS) : math.max(sigStop, stS)
    if d * (entry - stp) <= 0
        stp := sigStop
    float risk = math.abs(entry - stp)
    float minR = mtMinStopATR * atr
    if risk < minR
        risk := minR
        stp := entry - d * risk
    bool ok = risk > 0 and risk <= mtMaxStopATR * atr
    // nearest opposing swing (obstacle) and last swing leg (measured move)
    array<float> arr = d > 0 ? mtPHpx : mtPLpx
    float obs = na
    if array.size(arr) > 0
        for k = 0 to array.size(arr) - 1
            float v = array.get(arr, k)
            if d > 0 and v > entry and (na(obs) or v < obs)
                obs := v
            if d < 0 and v < entry and (na(obs) or v > obs)
                obs := v
    float leg = (array.size(mtPHpx) > 0 and array.size(mtPLpx) > 0) ? math.abs(array.get(mtPHpx, array.size(mtPHpx) - 1) - array.get(mtPLpx, array.size(mtPLpx) - 1)) : 3.0 * risk
    float t1 = entry + d * mtT1R * risk
    float t2 = entry + d * mtT2R * risk
    if mtTgtMode == "Market structure" and not na(obs) and d * (obs - entry) >= mtT1R * risk
        t2 := obs
    float t3 = entry + d * leg
    if not na(tgt3Ovr) and d * (tgt3Ovr - entry) > d * (t2 - entry)
        t3 := tgt3Ovr
    if d * (t3 - t2) <= 0
        t3 := entry + d * (mtT2R + 1.0) * risk
    float roomR = na(obs) ? 3.0 : math.abs(obs - entry) / risk
    // ---- factors (each 0..1) ----
    float a15 = mtD15 == d ? 1.0 : (mtD15 == 0 ? 0.5 : 0.0)
    float a5  = mtD5 == d ? 1.0 : (mtD5 == 0 ? 0.5 : 0.0)
    float f1 = 0.6 * a15 + 0.4 * a5
    if typ == 2
        f1 := 0.35 + 0.65 * f1
    float f2 = tlQ
    float f3 = fboF
    float f4 = d > 0 ? mtSqBull : mtSqBear
    float f5 = 0.5
    if typ == 0
        f5 := mtS.cond == 1 ? 1.0 : (mtS.cond == 3 ? 0.75 : 0.3)
    else if typ == 1
        f5 := mtS.cond == 1 ? 1.0 : (mtS.cond == 3 ? 0.7 : 0.25)
    else if typ == 2
        f5 := mtS.cond == 3 ? 1.0 : (mtS.cond == 2 ? 0.6 : 0.35)
    else
        f5 := mtS.cond == 1 ? 1.0 : (mtS.cond == 3 ? 0.6 : 0.3)
    float f6 = 0.5
    if mtVwapOn and not na(vwapVal) and atr > 0
        float vd = d * (close - vwapVal) / atr
        if typ == 2
            f6 := vd <= -1.5 ? 0.9 : (vd < 0 ? 0.55 : 0.4)
        else if math.abs(vd) < 0.2
            f6 := 0.6
        else if vd > 0
            f6 := d * mtVwapSlp > 0.02 ? 1.0 : 0.8
        else
            f6 := 0.3
    float f7 = 0.0
    if bar_index - mtS.mtLastHBar <= 3 and mtS.mtLastHDir == d
        f7 := mtS.mtLastHCnt == 2 ? 1.0 : 0.6
    if typ == 3
        f7 := 1.0
    float f8 = math.min(1.0, roomR / 2.0)
    float w6 = mtVwapOn ? mtWVwap : 0.0
    float wsum = mtWHtf + mtWTl + mtWFbo + mtWSb + mtWMkt + w6 + mtWH + mtWRoom
    float sc = 0.0
    if wsum > 0
        array.set(mtFacTmp, 0, 100.0 * mtWHtf * f1 / wsum)
        array.set(mtFacTmp, 1, 100.0 * mtWTl * f2 / wsum)
        array.set(mtFacTmp, 2, 100.0 * mtWFbo * f3 / wsum)
        array.set(mtFacTmp, 3, 100.0 * mtWSb * f4 / wsum)
        array.set(mtFacTmp, 4, 100.0 * mtWMkt * f5 / wsum)
        array.set(mtFacTmp, 5, 100.0 * w6 * f6 / wsum)
        array.set(mtFacTmp, 6, 100.0 * mtWH * f7 / wsum)
        array.set(mtFacTmp, 7, 100.0 * mtWRoom * f8 / wsum)
        for q = 0 to 7
            sc += array.get(mtFacTmp, q)
    [sc, entry, stp, risk, t1, t2, t3, ok, roomR]

// ---- statistics ----
f_mtRecG(int g, float r) =>
    int bs = g * 5
    array.set(mtStat, bs, array.get(mtStat, bs) + 1.0)
    array.set(mtStat, bs + 2, array.get(mtStat, bs + 2) + r)
    if r > 0
        array.set(mtStat, bs + 1, array.get(mtStat, bs + 1) + 1.0)
        array.set(mtStat, bs + 3, array.get(mtStat, bs + 3) + r)
    else
        array.set(mtStat, bs + 4, array.get(mtStat, bs + 4) + r)
    true   // explicit return: keeps the function's return type consistent

f_mtRec(float r, int typ, int cnd, int tod, float sc) =>
    f_mtRecG(0, r)
    f_mtRecG(1 + typ, r)
    f_mtRecG(5 + cnd - 1, r)
    f_mtRecG(8 + tod, r)
    f_mtRecG(13 + (sc >= 85 ? 0 : sc >= 75 ? 1 : 2), r)
    true   // explicit return: keeps the function's return type consistent

f_mtStatTxt(int g) =>
    int bs = g * 5
    float n = array.get(mtStat, bs)
    n > 0 ? (str.tostring(n, "#") + " · " + str.tostring(100.0 * array.get(mtStat, bs + 1) / n, "#") + "% · " + str.tostring(array.get(mtStat, bs + 2) / n, "+0.00;-0.00") + "R") : "—"

// ---- label / level bookkeeping ----
f_mtSigLabel(string txt, int x, float y, color col, string sty) =>
    label l = label.new(x, y, txt, color = col, textcolor = color.white, size = size.small, style = sty == "up" ? label.style_label_up : sty == "down" ? label.style_label_down : label.style_label_left)
    array.push(mtSigLbls, l)
    if array.size(mtSigLbls) > 60
        label.delete(array.shift(mtSigLbls))
    true   // explicit return: keeps the function's return type consistent

f_mtKeepObj(line ln, label lb) =>
    if mtKeepLvls
        array.push(mtOldLn, ln)
        array.push(mtOldLb, lb)
        if array.size(mtOldLn) > 20
            line.delete(array.shift(mtOldLn))
        if array.size(mtOldLb) > 20
            label.delete(array.shift(mtOldLb))
    else
        line.delete(ln)
        label.delete(lb)
    true   // explicit return: keeps the function's return type consistent

// =============================================================================
// ENGINE (confirmed bars only → no repainting)
// =============================================================================
f_mtLvl(float px, string txt, color col, int bi, bool dashed) =>
    line l = line.new(bi, px, bi + 1, px, color = col, width = 1, style = dashed ? line.style_dashed : line.style_solid)
    label lb = label.new(bi + 1, px, txt + " " + str.tostring(px, format.mintick), style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
    [l, lb]

f_mtMsg(string ev, int ty, int d, float sc) =>
    ev + " | " + syminfo.ticker + " " + timeframe.period + (ty >= 0 ? " | " + f_mtTypeName(ty) + " " + (d > 0 ? "LONG" : "SHORT") + " | score " + str.tostring(sc, "#") : "")

// Brooks engine, split into four functions (closed bars only) so each stays under
// TradingView's per-function limit on inputs / request values used (CE10116).
// A) pivots · trendline engines · High/Low 1-2 counting
f_mtPhaseA() =>
    int bi = bar_index
    float tick = syminfo.mintick
    color colLong = color.new(#00c853, 0)
    color colShort = color.new(#ff1744, 0)
    // ---- 1) pivots ----
    if mtNewPL
        array.push(mtPLpx, mtPLv)
        array.push(mtPLbr, bi - mtPivR)
        if array.size(mtPLpx) > 6
            array.shift(mtPLpx)
            array.shift(mtPLbr)
    if mtNewPH
        array.push(mtPHpx, mtPHv)
        array.push(mtPHbr, bi - mtPivR)
        if array.size(mtPHpx) > 6
            array.shift(mtPHpx)
            array.shift(mtPHbr)

    // ---- 2) trendline engines ----
    f_mtStep(mtBull, mtBullBrk, 1, mtPLpx, mtPLbr, mtNewPL, mtMcBull)
    f_mtStep(mtBear, mtBearBrk, -1, mtPHpx, mtPHbr, mtNewPH, mtMcBear)
    f_mtPost(mtBullBrk, 1)
    f_mtPost(mtBearBrk, -1)
    f_mtDraw(mtBull)
    f_mtDraw(mtBear)
    if mtBull.evNew
        mtE.mtEvNewBull := true
    if mtBear.evNew
        mtE.mtEvNewBear := true
    if mtBull.evBreak
        mtE.mtEvBrkBull := true
    if mtBear.evBreak
        mtE.mtEvBrkBear := true
    if mtBull.evFail
        mtE.mtEvFboBull := true
    if mtBear.evFail
        mtE.mtEvFboBear := true
    if mtBull.evGenuine or mtBear.evGenuine
        mtS.mtLastGenBar := bi
        mtS.cond := f_mtCondCalc(mtS.mtLastGenBar)   // same-bar TRANSITION after a genuine break

    // ---- 4) High 1/2 · Low 1/2 sequences (directional context required) ----
    bool ctxBull = mtD1 >= 0 and (mtD1 == 1 or mtD5 == 1) and mtD15 != -1
    bool ctxBear = mtD1 <= 0 and (mtD1 == -1 or mtD5 == -1) and mtD15 != 1
    int hAtt = 0
    int lAtt = 0
    float hPbLow = na
    float lPbHigh = na
    if not ctxBull
        mtS.hbPb := false
        mtS.hbCnt := 0
        mtS.hbRef := high
    else
        if not mtS.hbPb
            mtS.hbRef := na(mtS.hbRef) ? high : math.max(mtS.hbRef, high)
            if high < high[1]
                mtS.hbPb := true
                mtS.hbCnt := 0
                mtS.hbLeg := true
                mtS.hbLow := low
                mtS.hbBars := 1
        else
            mtS.hbBars += 1
            mtS.hbLow := math.min(mtS.hbLow, low)
            if low < low[1]
                mtS.hbLeg := true
            if high > mtS.hbRef
                mtS.hbPb := false
                mtS.hbCnt := 0
                mtS.hbRef := high
            else if high > high[1] and mtS.hbLeg
                mtS.hbCnt += 1
                mtS.hbLeg := false
                hPbLow := mtS.hbLow
                if mtS.hbCnt <= 2
                    hAtt := mtS.hbCnt
            if mtS.hbPb and (mtS.hbBars > mtPbMax or (mtS.hbRef - mtS.hbLow) > mtPbDepth * atr)
                mtS.hbPb := false
                mtS.hbCnt := 0
                mtS.hbRef := high
    if not ctxBear
        mtS.lbPb := false
        mtS.lbCnt := 0
        mtS.lbRef := low
    else
        if not mtS.lbPb
            mtS.lbRef := na(mtS.lbRef) ? low : math.min(mtS.lbRef, low)
            if low > low[1]
                mtS.lbPb := true
                mtS.lbCnt := 0
                mtS.lbLeg := true
                mtS.lbHigh := high
                mtS.lbBars := 1
        else
            mtS.lbBars += 1
            mtS.lbHigh := math.max(mtS.lbHigh, high)
            if high > high[1]
                mtS.lbLeg := true
            if low < mtS.lbRef
                mtS.lbPb := false
                mtS.lbCnt := 0
                mtS.lbRef := low
            else if low < low[1] and mtS.lbLeg
                mtS.lbCnt += 1
                mtS.lbLeg := false
                lPbHigh := mtS.lbHigh
                if mtS.lbCnt <= 2
                    lAtt := mtS.lbCnt
            if mtS.lbPb and (mtS.lbBars > mtPbMax or (mtS.lbHigh - mtS.lbRef) > mtPbDepth * atr)
                mtS.lbPb := false
                mtS.lbCnt := 0
                mtS.lbRef := low
    if hAtt == 1
        mtE.mtEvH1 := true
    if hAtt == 2
        mtE.mtEvH2 := true
    if lAtt == 1
        mtE.mtEvL1 := true
    if lAtt == 2
        mtE.mtEvL2 := true
    if hAtt > 0
        mtS.mtLastHBar := bi
        mtS.mtLastHDir := 1
        mtS.mtLastHCnt := hAtt
    if lAtt > 0
        mtS.mtLastHBar := bi
        mtS.mtLastHDir := -1
        mtS.mtLastHCnt := lAtt
    [hAtt, hPbLow, lAtt, lPbHigh]

// B) manage the pending / open setup
f_mtPhaseB() =>
    int bi = bar_index
    float tick = syminfo.mintick
    color colLong = color.new(#00c853, 0)
    color colShort = color.new(#ff1744, 0)
    // ---- 5) manage the pending / open setup ----
    bool ended = false
    string endTxt = ""
    bool inRng = not mtStatsRng or (time >= mtStatsFrom and time <= mtStatsTo)
    if mtS.stSt == 1 and bi > mtS.stSigBar
        bool lg = mtS.stDir > 0
        bool trig = lg ? high >= mtS.stEntry : low <= mtS.stEntry
        bool stopT = lg ? low <= mtS.stStop : high >= mtS.stStop
        if trig
            mtS.stFill := lg ? math.max(open, mtS.stEntry) : math.min(open, mtS.stEntry)
            mtS.stEntryBar := bi
            mtS.stSt := 2
            mtE.mtEvEntry := true
            if mtShowSig
                f_mtSigLabel("ENTRY", bi, mtS.stFill, color.new(color.gray, 20), "left")
            if not na(mtS.stLnE)
                line.set_style(mtS.stLnE, line.style_solid)
            if stopT
                float rr = mtS.stRisk > 0 ? mtS.stDir * (mtS.stStop - mtS.stFill) / mtS.stRisk : -1.0
                if inRng
                    f_mtRec(rr, mtS.stType, mtS.stCond, mtS.stTod, mtS.stScore)
                mtS.stResolved := true
                mtE.mtEvStop := true
                ended := true
                endTxt := "STOPPED (same bar as entry)"
        else if stopT
            ended := true
            endTxt := "INVALIDATED before entry"
        else if bi - mtS.stSigBar >= mtPendBars
            ended := true
            endTxt := "EXPIRED (not triggered)"
    else if mtS.stSt == 2 and bi > mtS.stEntryBar
        bool lg2 = mtS.stDir > 0
        bool stopH = lg2 ? low <= mtS.stStop : high >= mtS.stStop
        bool t1Reach = lg2 ? high >= mtS.stT1 : low <= mtS.stT1
        bool t2Reach = lg2 ? high >= mtS.stT2 : low <= mtS.stT2
        if stopH
            float rl = mtS.stRisk > 0 ? mtS.stDir * (mtS.stStop - mtS.stFill) / mtS.stRisk : -1.0
            if not mtS.stResolved and inRng
                f_mtRec(rl, mtS.stType, mtS.stCond, mtS.stTod, mtS.stScore)
            mtS.stResolved := true
            mtE.mtEvStop := true
            ended := true
            endTxt := "STOP HIT"
        else
            if t1Reach and not mtS.stT1Hit
                mtS.stT1Hit := true
                mtE.mtEvT1 := true
                if not mtS.stResolved and mtStatsTgt == "Target 1"
                    if inRng
                        f_mtRec(mtS.stRisk > 0 ? mtS.stDir * (mtS.stT1 - mtS.stFill) / mtS.stRisk : mtT1R, mtS.stType, mtS.stCond, mtS.stTod, mtS.stScore)
                    mtS.stResolved := true
                if mtShowSig
                    f_mtSigLabel("T1", bi, mtS.stT1, color.new(#00897b, 10), "left")
            if t2Reach
                mtS.stT2Hit := true
                mtE.mtEvT2 := true
                if not mtS.stResolved
                    if inRng
                        f_mtRec(mtS.stRisk > 0 ? mtS.stDir * (mtS.stT2 - mtS.stFill) / mtS.stRisk : mtT2R, mtS.stType, mtS.stCond, mtS.stTod, mtS.stScore)
                    mtS.stResolved := true
                if mtShowSig
                    f_mtSigLabel("T2", bi, mtS.stT2, color.new(#00695c, 0), "left")
                ended := true
                endTxt := "TARGET 2 REACHED"
            else if bi - mtS.stEntryBar >= mtMaxHold
                float rt = mtS.stRisk > 0 ? mtS.stDir * (close - mtS.stFill) / mtS.stRisk : 0.0
                if not mtS.stResolved and inRng
                    f_mtRec(rt, mtS.stType, mtS.stCond, mtS.stTod, mtS.stScore)
                mtS.stResolved := true
                ended := true
                endTxt := "TIME-OUT"
    if ended
        if mtE.mtEvStop and mtShowSig
            f_mtSigLabel("STOP", bi, mtS.stStop, color.new(#b71c1c, 10), "left")
        mtS.stSt := 3
        mtS.stRes := endTxt
        if not na(mtS.stLnE)
            line.set_x2(mtS.stLnE, bi)
            line.set_x2(mtS.stLnS, bi)
            line.set_x2(mtS.stLnT1, bi)
            line.set_x2(mtS.stLnT2, bi)
            label.set_x(mtS.stLbE, bi)
            label.set_x(mtS.stLbS, bi)
            label.set_x(mtS.stLbT1, bi)
            label.set_x(mtS.stLbT2, bi)
            f_mtKeepObj(mtS.stLnE, mtS.stLbE)
            f_mtKeepObj(mtS.stLnS, mtS.stLbS)
            f_mtKeepObj(mtS.stLnT1, mtS.stLbT1)
            f_mtKeepObj(mtS.stLnT2, mtS.stLbT2)
            if not na(mtS.stLnT3)
                line.set_x2(mtS.stLnT3, bi)
                label.set_x(mtS.stLbT3, bi)
                f_mtKeepObj(mtS.stLnT3, mtS.stLbT3)
            mtS.stLnE := na
            mtS.stLnS := na
            mtS.stLnT1 := na
            mtS.stLnT2 := na
            mtS.stLnT3 := na
            mtS.stLbE := na
            mtS.stLbS := na
            mtS.stLbT1 := na
            mtS.stLbT2 := na
            mtS.stLbT3 := na
    else if (mtS.stSt == 1 or mtS.stSt == 2) and not na(mtS.stLnE)
        line.set_x2(mtS.stLnE, bi + 1)
        line.set_x2(mtS.stLnS, bi + 1)
        line.set_x2(mtS.stLnT1, bi + 1)
        line.set_x2(mtS.stLnT2, bi + 1)
        label.set_x(mtS.stLbE, bi + 1)
        label.set_x(mtS.stLbS, bi + 1)
        label.set_x(mtS.stLbT1, bi + 1)
        label.set_x(mtS.stLbT2, bi + 1)
        if not na(mtS.stLnT3)
            line.set_x2(mtS.stLnT3, bi + 1)
            label.set_x(mtS.stLbT3, bi + 1)
    true

// C) look for a new setup
f_mtPhaseC(int hAtt, float hPbLow, int lAtt, float lPbHigh) =>
    int bi = bar_index
    float tick = syminfo.mintick
    color colLong = color.new(#00c853, 0)
    color colShort = color.new(#ff1744, 0)
    // ---- 6) look for a NEW setup (only when idle: one setup at a time, no duplicates) ----
    if mtS.stSt == 0 or mtS.stSt == 3
        array.clear(mtCT)
        array.clear(mtCD)
        array.clear(mtCF)
        array.clear(mtCQ)
        array.clear(mtCS)
        array.clear(mtC3)
        for si = 0 to 1
            int s = si == 0 ? 1 : -1
            MtTL tl = si == 0 ? mtBull : mtBear
            MtTL bk = si == 0 ? mtBullBrk : mtBearBrk
            bool sbOkS = s > 0 ? mtSbBullOk : mtSbBearOk
            bool sbOkOpp = s > 0 ? mtSbBearOk : mtSbBullOk
            // ---- A: failed microtrendline breakout ----
            if mtSetA and tl.state == 4 and f_mtValid(tl) and sbOkS and s * (close - f_mtVal(tl, bi)) > 0 and (tl.isMC or mtD1 == s or mtD5 == s)
                float speed = 1.0 - 0.5 * float(tl.failBar - tl.brkBar) / float(math.max(1, mtFailBars))
                float depthF = 1.0 - math.min(1.0, tl.brkPen / 0.75)
                f_mtAddCand(0, s, 0.6 * speed + 0.4 * depthF, tl.quality, tl.brkExt, na)
            // ---- B: break + pullback continuation ----
            if mtSetB and bk.state == 3 and bk.structOK and sbOkS and bi - bk.brkBar >= 2 and not (mtD15 == -s and mtD5 == -s)
                float legH = math.max(math.abs(bk.peak - bk.y1), tick)
                float retr = math.abs(bk.peak - bk.brkExt) / legH
                if retr <= mtMaxRetr
                    float extS = s > 0 ? low : high
                    int nSup = 0
                    if math.abs(extS - mtEma20) <= mtSupTol * atr
                        nSup += 1
                    if not na(vwapVal) and math.abs(extS - vwapVal) <= mtSupTol * atr
                        nSup += 1
                    array<float> sidePx = s > 0 ? mtPLpx : mtPHpx
                    if array.size(sidePx) > 0 and math.abs(extS - array.get(sidePx, array.size(sidePx) - 1)) <= mtSupTol * atr
                        nSup += 1
                    if math.abs(extS - bk.structLvl) <= mtSupTol * atr
                        nSup += 1
                    if nSup >= 1
                        f_mtAddCand(1, s, 0.4 + 0.3 * (1.0 - retr / mtMaxRetr) + 0.3 * math.min(1.0, nSup / 2.0), bk.quality, bk.brkExt, na)
            // ---- C: failed-breakout reversal (broken line of trend s, signal in the opposite direction) ----
            if mtSetC and bk.state == 3 and bk.retested and bi - bk.retestBar <= 3 and sbOkOpp
                bool extended = math.abs(bk.peak - bk.y1) >= mtExtATR * atr or bk.touches >= 3
                bool noOver = s * (bk.retestExt - bk.peak) <= mtRetestOver * atr
                float sqOpp = s > 0 ? mtSqBear : mtSqBull
                if extended and noOver and sqOpp >= mtRevSbMin
                    int conf = 0
                    if s * (bk.retestExt - bk.peak) <= 0.1 * atr
                        conf += 1
                    if sqOpp >= 0.75
                        conf += 1
                    int against = 0
                    for j = 0 to 2
                        if (s > 0 ? close[j] < open[j] : close[j] > open[j])
                            against += 1
                    if against >= 2
                        conf += 1
                    float wk = s > 0 ? math.max(mtUW, nz(mtUW[1]), nz(mtUW[2])) : math.max(mtLW, nz(mtLW[1]), nz(mtLW[2]))
                    if wk >= 0.35
                        conf += 1
                    if not bk.closeOver and bi - bk.brkBar >= 3
                        conf += 1
                    if conf >= mtRevConf
                        f_mtAddCand(2, -s, conf / 5.0, bk.quality, bk.retestExt, bk.y1)
        // ---- D: High 2 / Low 2 second entry with trend context ----
        if mtSetD and hAtt == 2 and mtSbBullOk
            f_mtAddCand(3, 1, 0.5, mtBull.state == 1 or mtBull.state == 4 ? mtBull.quality : 0.4, hPbLow, na)
        if mtSetD and lAtt == 2 and mtSbBearOk
            f_mtAddCand(3, -1, 0.5, mtBear.state == 1 or mtBear.state == 4 ? mtBear.quality : 0.4, lPbHigh, na)
        // ---- evaluate every candidate, keep the best ----
        float bSc = -1.0
        int bIdx = -1
        float bEn = na
        float bSp = na
        float bRk = na
        float bT1 = na
        float bT2 = na
        float bT3 = na
        bool bOk = false
        int nc = array.size(mtCT)
        if nc > 0
            for c = 0 to nc - 1
                [sc, en, sp, rk, t1v, t2v, t3v, okv, rm] = f_mtEval(array.get(mtCT, c), array.get(mtCD, c), array.get(mtCF, c), array.get(mtCQ, c), array.get(mtCS, c), array.get(mtC3, c))
                if okv and sc > bSc
                    bSc := sc
                    bIdx := c
                    bEn := en
                    bSp := sp
                    bRk := rk
                    bT1 := t1v
                    bT2 := t2v
                    bT3 := t3v
                    bOk := true
                    for q = 0 to 7
                        array.set(mtFacBest, q, array.get(mtFacTmp, q))
        if bOk and bSc >= mtMinScore
            int bTy = array.get(mtCT, bIdx)
            int bD = array.get(mtCD, bIdx)
            mtS.stSt := 1
            mtS.stDir := bD
            mtS.stType := bTy
            mtS.stScore := bSc
            mtS.stEntry := bEn
            mtS.stStop := bSp
            mtS.stRisk := bRk
            mtS.stT1 := bT1
            mtS.stT2 := bT2
            mtS.stT3 := bT3
            mtS.stSigBar := bi
            mtS.stT1Hit := false
            mtS.stT2Hit := false
            mtS.stResolved := false
            mtS.stFill := na
            mtS.stCond := mtS.cond
            mtS.stTod := mtTodIdx
            mtS.stSq := bD > 0 ? mtSqBull : mtSqBear
            mtS.stRes := "PENDING ENTRY"
            for q = 0 to 7
                array.set(mtFac, q, array.get(mtFacBest, q))
            // consume the source pattern so it cannot signal twice
            if bTy == 0
                if bD > 0
                    mtBull.state := 1
                else
                    mtBear.state := 1
            else if bTy == 1
                if bD > 0
                    mtBullBrk.state := 0
                else
                    mtBearBrk.state := 0
            else if bTy == 2
                if bD > 0
                    mtBearBrk.state := 0
                else
                    mtBullBrk.state := 0
            if bD > 0
                mtE.mtEvSetupL := true
            else
                mtE.mtEvSetupS := true
            if bTy <= 1
                if bD > 0
                    mtE.mtEvContL := true
                else
                    mtE.mtEvContS := true
            else if bTy == 2
                if bD > 0
                    mtE.mtEvRevL := true
                else
                    mtE.mtEvRevS := true
            else
                if bD > 0
                    mtE.mtEvH2L := true
                else
                    mtE.mtEvL2S := true
            if mtShowSig
                f_mtSigLabel((bD > 0 ? "LONG " : "SHORT ") + f_mtCls(bSc) + " " + str.tostring(bSc, "#") + "\n" + f_mtTypeName(bTy) + " · pending", bi, bD > 0 ? low : high, bD > 0 ? colLong : colShort, bD > 0 ? "up" : "down")
            if mtShowLvls
                [l1, b1] = f_mtLvl(mtS.stEntry, "ENTRY", color.new(color.white, 0), bi, true)
                [l2, b2] = f_mtLvl(mtS.stStop, "STOP", colShort, bi, false)
                [l3, b3] = f_mtLvl(mtS.stT1, "T1 " + str.tostring(mtT1R, "#.##") + "R", colLong, bi, false)
                [l4, b4] = f_mtLvl(mtS.stT2, "T2", colLong, bi, false)
                mtS.stLnE := l1
                mtS.stLbE := b1
                mtS.stLnS := l2
                mtS.stLbS := b2
                mtS.stLnT1 := l3
                mtS.stLbT1 := b3
                mtS.stLnT2 := l4
                mtS.stLbT2 := b4
                if mtShowT3
                    [l5, b5] = f_mtLvl(mtS.stT3, "T3", color.new(colLong, 40), bi, true)
                    mtS.stLnT3 := l5
                    mtS.stLbT3 := b5
    true

// D) detailed alert() messages
f_mtPhaseD() =>
    int bi = bar_index
    float tick = syminfo.mintick
    color colLong = color.new(#00c853, 0)
    color colShort = color.new(#ff1744, 0)
    // ---- 7) detailed alerts (once per confirmed bar) ----
    if mtAlertFn
        if mtE.mtEvNewBull
            alert(f_mtMsg("Bullish microtrendline detected", -1, 0, 0), alert.freq_once_per_bar_close)
        if mtE.mtEvNewBear
            alert(f_mtMsg("Bearish microtrendline detected", -1, 0, 0), alert.freq_once_per_bar_close)
        if mtE.mtEvBrkBull
            alert(f_mtMsg("Bullish microtrendline BREAK (support line penetrated)", -1, 0, 0), alert.freq_once_per_bar_close)
        if mtE.mtEvBrkBear
            alert(f_mtMsg("Bearish microtrendline BREAK (resistance line penetrated)", -1, 0, 0), alert.freq_once_per_bar_close)
        if mtE.mtEvFboBull
            alert(f_mtMsg("Bullish FAILED breakout", -1, 0, 0), alert.freq_once_per_bar_close)
        if mtE.mtEvFboBear
            alert(f_mtMsg("Bearish FAILED breakout", -1, 0, 0), alert.freq_once_per_bar_close)
        if mtE.mtEvSetupL or mtE.mtEvSetupS
            alert(f_mtMsg("SETUP " + f_mtCls(mtS.stScore), mtS.stType, mtS.stDir, mtS.stScore), alert.freq_once_per_bar_close)
        if mtE.mtEvEntry
            alert(f_mtMsg("ENTRY TRIGGERED", mtS.stType, mtS.stDir, mtS.stScore), alert.freq_once_per_bar_close)
        if mtE.mtEvStop
            alert(f_mtMsg("STOP LOSS reached", mtS.stType, mtS.stDir, mtS.stScore), alert.freq_once_per_bar_close)
        if mtE.mtEvT1
            alert(f_mtMsg("TARGET 1 reached", mtS.stType, mtS.stDir, mtS.stScore), alert.freq_once_per_bar_close)
        if mtE.mtEvT2
            alert(f_mtMsg("TARGET 2 reached", mtS.stType, mtS.stDir, mtS.stScore), alert.freq_once_per_bar_close)
    true

if mtOn and barstate.isconfirmed and not na(atr) and bar_index > 30
    [mtHAtt, mtHPbLow, mtLAtt, mtLPbHigh] = f_mtPhaseA()
    f_mtPhaseB()
    f_mtPhaseC(mtHAtt, mtHPbLow, mtLAtt, mtLPbHigh)
    f_mtPhaseD()
mtCond := mtS.cond   // pick up a same-bar TRANSITION set by the engine

// =============================================================================
// MARKERS · SHADING · VWAP
// =============================================================================
plot(mtOn and mtShowVwap ? vwapVal : na, "MT VWAP", color = color.new(#ffd54f, 0), linewidth = 1)
bgcolor(mtOn and mtShowBg ? (mtCond == 1 ? color.new(#00c853, 93) : mtCond == 3 ? color.new(#ff9800, 92) : color.new(#9e9e9e, 94)) : na, title = "MT market condition")
plotshape(mtOn and mtShowBrk and mtE.mtEvBrkBull, "MT bull line penetrated", shape.xcross, location.belowbar, color.new(#ff9800, 0), size = size.tiny)
plotshape(mtOn and mtShowBrk and mtE.mtEvBrkBear, "MT bear line penetrated", shape.xcross, location.abovebar, color.new(#ff9800, 0), size = size.tiny)
plotshape(mtOn and mtShowBrk and mtE.mtEvFboBull, "MT bullish failed breakout", shape.diamond, location.belowbar, color.new(#00e5ff, 0), text = "FBO", textcolor = color.new(#00e5ff, 0), size = size.tiny)
plotshape(mtOn and mtShowBrk and mtE.mtEvFboBear, "MT bearish failed breakout", shape.diamond, location.abovebar, color.new(#e040fb, 0), text = "FBO", textcolor = color.new(#e040fb, 0), size = size.tiny)
plotshape(mtOn and mtShowHL and mtE.mtEvH1, "MT H1", shape.labelup, location.belowbar, color.new(#26a69a, 30), text = "H1", textcolor = color.white, size = size.tiny)
plotshape(mtOn and mtShowHL and mtE.mtEvH2, "MT H2", shape.labelup, location.belowbar, color.new(#00897b, 0), text = "H2", textcolor = color.white, size = size.tiny)
plotshape(mtOn and mtShowHL and mtE.mtEvL1, "MT L1", shape.labeldown, location.abovebar, color.new(#ef5350, 30), text = "L1", textcolor = color.white, size = size.tiny)
plotshape(mtOn and mtShowHL and mtE.mtEvL2, "MT L2", shape.labeldown, location.abovebar, color.new(#c62828, 0), text = "L2", textcolor = color.white, size = size.tiny)

// =============================================================================
// DASHBOARD + STATISTICS TABLE (last bar only; reads state committed on closed bars)
// =============================================================================
f_mtBias(int d) => d > 0 ? "▲" : d < 0 ? "▼" : "—"

// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkMtDash() =>
    if mtOn and mtShowDash and barstate.islast
        var table mtTbl = table.new(position.top_right, 2, 20, border_width = 1)
        table.set_position(mtTbl, f_mtPos(mtDashPos))
        table.clear(mtTbl, 0, 0, 1, 19)
        // choose the line to describe: live line first, else the post-break record
        MtTL showTl = mtBull
        if mtBear.state != 0 and (mtBull.state == 0 or mtBear.x2 > mtBull.x2)
            showTl := mtBear
        if showTl.state == 0
            showTl := mtBullBrk.state == 3 ? mtBullBrk : (mtBearBrk.state == 3 ? mtBearBrk : showTl)
        string condTxt = mtCond == 1 ? "TREND" : mtCond == 3 ? "TRANSITION" : "RANGE"
        color condCol = mtCond == 1 ? themeUpSolid : mtCond == 3 ? color.orange : themeMuted
        string tlDir = showTl.state == 0 ? "none" : (showTl.dir > 0 ? "BULLISH ▲ (support)" : "BEARISH ▼ (resistance)")
        color tlCol = showTl.state == 0 ? themeMuted : (showTl.dir > 0 ? themeUpSolid : themeDnSolid)
        string tlQ = showTl.state == 0 ? "—" : (str.tostring(100.0 * showTl.quality, "#") + "%" + (showTl.isMC ? " · microchannel" : ""))
        string tlStat = showTl.state == 0 ? "—" : showTl.state == 1 ? "INTACT" : showTl.state == 2 ? ("PENETRATED " + str.tostring(bar_index - showTl.brkBar) + "b ago") : showTl.state == 4 ? "FAILED BREAKOUT ✔ (await signal bar)" : ("BROKEN " + str.tostring(bar_index - showTl.brkBar) + "b ago")
        string clsTxt = mtS.stSt == 0 ? "NO TRADE" : f_mtCls(mtS.stScore)
        string dirTxt = mtS.stSt == 0 ? "—" : (mtS.stDir > 0 ? "LONG" : "SHORT")
        color dirCol = mtS.stSt == 0 ? themeMuted : (mtS.stDir > 0 ? themeUpSolid : themeDnSolid)
        string hTxt = (bar_index - mtS.mtLastHBar <= 5) ? ((mtS.mtLastHDir > 0 ? "H" : "L") + str.tostring(mtS.mtLastHCnt) + " (" + str.tostring(bar_index - mtS.mtLastHBar) + "b ago)") : "—"
        string facN = "HTF|TL|PAT|SB|MKT|VWAP|H|ROOM"
        string whyTxt = ""
        string weakTxt = ""
        float wsumD = mtWHtf + mtWTl + mtWFbo + mtWSb + mtWMkt + (mtVwapOn ? mtWVwap : 0.0) + mtWH + mtWRoom
        if mtS.stSt != 0 and wsumD > 0
            array<string> names = str.split(facN, "|")
            array<float> wts = array.from(mtWHtf, mtWTl, mtWFbo, mtWSb, mtWMkt, mtVwapOn ? mtWVwap : 0.0, mtWH, mtWRoom)
            for q = 0 to 7
                float w = array.get(wts, q)
                if w > 0
                    float pts = array.get(mtFac, q)
                    float mx = 100.0 * w / wsumD
                    whyTxt += array.get(names, q) + " " + str.tostring(pts, "#") + "/" + str.tostring(mx, "#") + "  "
                    if pts < 0.5 * mx
                        weakTxt += array.get(names, q) + " "
        string tsz = mtTblSz == "Small" ? size.small : size.tiny
        if mtDashMode == "Compact"
            // one column, 3-5 short rows
            string tlS = showTl.state == 0 ? "no trendline" : ((showTl.dir > 0 ? "TL ▲ " : "TL ▼ ") + str.tostring(100.0 * showTl.quality, "#") + "% · " + str.tostring(showTl.touches) + "t · " + (showTl.state == 1 ? "intact" : showTl.state == 2 ? "pierced" : showTl.state == 4 ? "FAILED BO ✔" : ("broken " + str.tostring(bar_index - showTl.brkBar) + "b")))
            table.cell(mtTbl, 0, 0, "BROOKS · " + condTxt + " · 15m" + f_mtBias(mtD15) + " 5m" + f_mtBias(mtD5) + " 1m" + f_mtBias(mtD1), text_color = condCol, bgcolor = themePanelBg, text_size = tsz, text_halign = text.align_left)
            table.cell(mtTbl, 0, 1, tlS, text_color = tlCol, bgcolor = themeRowBg, text_size = tsz, text_halign = text.align_left)
            table.cell(mtTbl, 0, 2, mtS.stSt == 0 ? "no setup" + (hTxt == "—" ? "" : " · " + hTxt) : (dirTxt + " " + clsTxt + " " + str.tostring(mtS.stScore, "#") + " · " + f_mtTypeName(mtS.stType)), text_color = dirCol, bgcolor = themeRowBg, text_size = tsz, text_halign = text.align_left)
            if mtS.stSt != 0
                float eShow = mtS.stSt == 2 or (mtS.stSt == 3 and not na(mtS.stFill)) ? mtS.stFill : mtS.stEntry
                table.cell(mtTbl, 0, 3, "E " + str.tostring(eShow, format.mintick) + "  S " + str.tostring(mtS.stStop, format.mintick) + "  T1 " + str.tostring(mtS.stT1, format.mintick) + "  T2 " + str.tostring(mtS.stT2, format.mintick), text_color = themeTxt, bgcolor = themeRowBg, text_size = tsz, text_halign = text.align_left)
                table.cell(mtTbl, 0, 4, (mtS.stSt == 1 ? "PENDING ENTRY" : mtS.stSt == 2 ? ("TRIGGERED" + (mtS.stT1Hit ? " · T1 ✔" : "")) : mtS.stRes) + (weakTxt == "" ? "" : "  · weak: " + weakTxt), text_color = mtS.stSt == 2 ? themeUpSolid : themeMuted, bgcolor = themeRowBg, text_size = tsz, text_halign = text.align_left)
        else
            int r = 0
            table.cell(mtTbl, 0, r, "BROOKS MICROTRENDLINE", text_color = themeTxt, bgcolor = themePanelBg, text_size = tsz, text_halign = text.align_left)
            table.cell(mtTbl, 1, r, mtOn ? "ON" : "", text_color = themeMuted, bgcolor = themePanelBg, text_size = tsz, text_halign = text.align_right)
            r += 1
            f_row(mtTbl, r, "Market", condTxt, condCol, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Bias 15m·5m·1m", f_mtBias(mtD15) + "  " + f_mtBias(mtD5) + "  " + f_mtBias(mtD1), themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Trendline", tlDir, tlCol, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Quality", tlQ, themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Touches", showTl.state == 0 ? "—" : str.tostring(showTl.touches), themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Break status", tlStat, showTl.state == 2 or showTl.state == 3 ? color.orange : themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Setup", mtS.stSt == 0 ? "NO TRADE" : (clsTxt + " · " + f_mtTypeName(mtS.stType)), dirCol, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Direction · score", mtS.stSt == 0 ? "—" : (dirTxt + " · " + str.tostring(mtS.stScore, "#") + "/100"), dirCol, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Signal bar · H/L", (mtS.stSt == 0 ? "—" : str.tostring(100.0 * mtS.stSq, "#") + "%") + " · " + hTxt, themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Entry", mtS.stSt == 0 ? "—" : ((mtS.stSt == 1 ? "stop-entry " : "filled ") + str.tostring(mtS.stSt == 2 or (mtS.stSt == 3 and not na(mtS.stFill)) ? mtS.stFill : mtS.stEntry, format.mintick)), themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Stop", mtS.stSt == 0 ? "—" : str.tostring(mtS.stStop, format.mintick), themeDnSolid, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Target 1 · 2", mtS.stSt == 0 ? "—" : (str.tostring(mtS.stT1, format.mintick) + " · " + str.tostring(mtS.stT2, format.mintick)), themeUpSolid, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Risk : reward", mtS.stSt == 0 ? "—" : ("1 : " + str.tostring(mtT1R, "#.##") + " / 1 : " + str.tostring(math.abs(mtS.stT2 - mtS.stEntry) / math.max(mtS.stRisk, syminfo.mintick), "#.##")), themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Status", mtS.stSt == 0 ? "no active setup" : (mtS.stSt == 1 ? "PENDING ENTRY" : mtS.stSt == 2 ? ("TRIGGERED" + (mtS.stT1Hit ? " · T1 ✔" : "")) : mtS.stRes), mtS.stSt == 2 ? themeUpSolid : themeTxt, tsz, tsz)
            r += 1
            f_row(mtTbl, r, "Score drivers", whyTxt == "" ? "—" : whyTxt, themeTxt, tsz, size.tiny)
            r += 1
            f_row(mtTbl, r, "Weak factors", weakTxt == "" ? "—" : weakTxt, color.orange, tsz, tsz)
        table.set_frame_color(mtTbl, color.new(condCol, 35))
        table.set_frame_width(mtTbl, themeBW)
    true
f_blkMtDash()

// (wrapped in a function to keep the main body under TradingView's size limit)
f_blkMtStats() =>
    if mtOn and mtShowStats and barstate.islast
        var table mtStTbl = table.new(position.bottom_right, 2, 20, border_width = 1)
        table.set_position(mtStTbl, f_mtPos(mtStatsPos))
        table.clear(mtStTbl, 0, 0, 1, 19)
        array<string> labs = array.from("ALL SIGNALS", "Failed BO", "Pullback cont.", "Reversal", "H2/L2", "Trend", "Range", "Transition", "Open 9:30-10:30", "10:30-12:00", "12:00-14:00", "14:00-16:00", "Other hours", "Score A+ (85+)", "Score A (75-84)", "Score B (<75)")
        string ssz = mtTblSz == "Small" ? size.small : size.tiny
        int sr = 0
        if mtStatsMode == "Summary"
            table.cell(mtStTbl, 0, 0, "STATS " + f_mtStatTxt(0), text_color = themeTxt, bgcolor = themePanelBg, text_size = ssz, text_halign = text.align_left)
            table.cell(mtStTbl, 0, 1, "A+ " + f_mtStatTxt(13) + " | A " + f_mtStatTxt(14) + " | B " + f_mtStatTxt(15), text_color = themeMuted, bgcolor = themeRowBg, text_size = ssz, text_halign = text.align_left)
        else
            table.cell(mtStTbl, 0, sr, "SIGNAL STATS", text_color = themeTxt, bgcolor = themePanelBg, text_size = size.small, text_halign = text.align_left)
            table.cell(mtStTbl, 1, sr, "n · win% · expectancy (R)", text_color = themeMuted, bgcolor = themePanelBg, text_size = size.tiny, text_halign = text.align_left)
            sr += 1
            float nAll = array.get(mtStat, 0)
            string extra = nAll > 0 ? ("win " + str.tostring(array.get(mtStat, 1), "#") + " / loss " + str.tostring(nAll - array.get(mtStat, 1), "#") + " · avg win " + str.tostring(array.get(mtStat, 1) > 0 ? array.get(mtStat, 3) / array.get(mtStat, 1) : 0.0, "+0.00") + "R · avg loss " + str.tostring(nAll - array.get(mtStat, 1) > 0 ? array.get(mtStat, 4) / (nAll - array.get(mtStat, 1)) : 0.0, "0.00") + "R") : "no completed signals"
            for g = 0 to 15
                f_row(mtStTbl, sr, array.get(labs, g), f_mtStatTxt(g), themeTxt, size.tiny, size.tiny)
                sr += 1
            f_row(mtStTbl, sr, "Totals", extra, themeTxt, size.tiny, size.tiny)
            sr += 1
            f_row(mtStTbl, sr, "Not a backtest", "1 position at a time · stop wins same-bar ties · no costs", themeMuted, size.tiny, size.tiny)
        table.set_frame_color(mtStTbl, color.new(themeMuted, 40))
        table.set_frame_width(mtStTbl, themeBW)
    true
f_blkMtStats()

// =============================================================================
// ALERT CONDITIONS (fire only on confirmed bars; message placeholders are filled by TradingView)
// =============================================================================
alertcondition(mtOn and mtE.mtEvNewBull, "MT 1 · Bullish microtrendline detected", "Bullish microtrendline detected {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvNewBear, "MT 2 · Bearish microtrendline detected", "Bearish microtrendline detected {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvBrkBull, "MT 3 · Bullish microtrendline break (support penetrated)", "Bullish microtrendline broken {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvBrkBear, "MT 4 · Bearish microtrendline break (resistance penetrated)", "Bearish microtrendline broken {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvFboBull, "MT 5 · Bullish failed breakout", "Bullish failed breakout {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvFboBear, "MT 6 · Bearish failed breakout", "Bearish failed breakout {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvContL, "MT 7 · Bullish continuation setup", "Bullish continuation setup {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvContS, "MT 8 · Bearish continuation setup", "Bearish continuation setup {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvRevL, "MT 9 · Bullish reversal setup", "Bullish reversal setup {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvRevS, "MT 10 · Bearish reversal setup", "Bearish reversal setup {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvH2L, "MT 11 · High 2 long setup", "High 2 long setup {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvL2S, "MT 12 · Low 2 short setup", "Low 2 short setup {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvEntry, "MT 13 · Entry triggered", "Entry triggered {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvStop, "MT 14 · Stop loss reached", "Stop loss reached {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvT1, "MT 15 · Target 1 reached", "Target 1 reached {{ticker}} {{interval}}")
alertcondition(mtOn and mtE.mtEvT2, "MT 16 · Target 2 reached", "Target 2 reached {{ticker}} {{interval}}")

// -----------------------------------------------------------------------------
// ALERTS
// -----------------------------------------------------------------------------
f_touch(float lvl) => not na(lvl) and high >= lvl and low <= lvl
alertcondition(f_touch(pdh) or f_touch(pdl), "PD level touched", "Price touched a Previous-Day level")
alertcondition(f_touch(lastPH) or f_touch(lastPL), "Liquidity swept", "Price swept a swing liquidity level")
alertcondition(f_touch(nyH) or f_touch(nyL) or f_touch(londH) or f_touch(londL) or f_touch(asiaH) or f_touch(asiaL), "Session level touched", "Price touched a session high/low")
alertcondition(sfpLong or sfpShort, "SFP fired", "Sweep + reversal (liquidity grab) detected")
alertcondition(sfpLong, "SFP long", "Bullish sweep + reversal")
alertcondition(sfpShort, "SFP short", "Bearish sweep + reversal")
alertcondition(biasFlipNow,    "Daily bias flipped",    "The Daily Bias direction changed")
alertcondition(orbE.orbBreakUpNow or orbE.orbBreakDnNow, "ORB break", "Opening range: confirmed break")
alertcondition(orbE.orbFailNow, "ORB failed break", "Opening range: break failed back inside")
