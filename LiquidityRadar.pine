//@version=6
// =============================================================================
// Liquidity Radar  (Pine Script v6) — STREAMLINED CORE
// Focus: key liquidity levels + their validity.
//   • Liquidity levels: PDH/PDL, PWH/PWL, PMH/PML, sessions H/L, swings (+HTF),
//     equal highs/lows — all removed once swept.
//   • Stacked liquidity: nearby levels merge into strength-rated zones.
//   • Confluence score (0-100) per zone.
//   • Draw-on-Liquidity (DOL) bias gauge + conviction.
//   • Order Blocks and Fair Value Gaps.
//   • Sweep + reversal (SFP) markers, per-level countdown, age-scaled extension.
// =============================================================================
indicator("Liquidity Radar", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 1000)

// Anchor plot so the compiler always sees a top-level drawing output.
plot(na, "anchor", display = display.none)

// -----------------------------------------------------------------------------
// GROUP NAMES
// -----------------------------------------------------------------------------
var string G_PREV   = "① Previous-Period Levels"
var string G_SESS   = "② Sessions"
var string G_STRUCT = "③ Structure (swings · EQ · FVG · OB · SFP)"
var string G_CD     = "④ Countdown"
var string G_CLUST  = "⑤ Clustering & Confluence"
var string G_DOL    = "⑥ Draw-on-Liquidity Gauge"
var string G_STYLE  = "⑦ Style"
var string G_EMO    = "⑧ Emoji Tags"
var string G_GHOST  = "⑨ Ghost Levels"

// -----------------------------------------------------------------------------
// INPUTS — PREVIOUS-PERIOD LEVELS
// -----------------------------------------------------------------------------
showPDHL = input.bool(true,  "Prev Day High/Low (PDH/PDL)",    group = G_PREV)
showPWHL = input.bool(true,  "Prev Week High/Low (PWH/PWL)",   group = G_PREV)
showPMHL = input.bool(false, "Prev Month High/Low (PMH/PML)",  group = G_PREV)
showDO   = input.bool(false, "Daily Open",                     group = G_PREV)
showWO   = input.bool(false, "Weekly Open",                    tooltip = "Current week's opening price — a key institutional reference; price often reverts to it. Feeds the clusters + DOL pull.", group = G_PREV)
showMO   = input.bool(false, "Monthly Open",                   tooltip = "Current month's opening price — a major reference level. Feeds the clusters + DOL pull.", group = G_PREV)
showMidO = input.bool(false, "NY Midnight Open (00:00 ET)",    tooltip = "Price at 00:00 New York time — the ICT 'true day' open. A high-signal intraday anchor for premium/discount. Feeds the clusters + DOL pull.", group = G_PREV)

// -----------------------------------------------------------------------------
// INPUTS — SESSIONS
// -----------------------------------------------------------------------------
sessTZ    = input.string("UTC", "Session Timezone", options = ["UTC","America/New_York","Europe/London","Asia/Tokyo"], group = G_SESS)
showAsia  = input.bool(true,  "Asian Session H/L",   group = G_SESS)
asiaSess  = input.session("0000-0800", "  Asian time",   group = G_SESS)
showLond  = input.bool(true,  "London Session H/L",  group = G_SESS)
londSess  = input.session("0800-1600", "  London time",  group = G_SESS)
showNY    = input.bool(true,  "New York Session H/L", group = G_SESS)
nySess    = input.session("1300-2100", "  New York time", group = G_SESS)
sessResetDaily = input.bool(true, "Reset session H/L each new day", tooltip = "At the start of a new trading day, clear the previous day's session highs/lows so stale levels don't linger.", group = G_SESS)
sessRemoveSwept = input.bool(true, "Remove session level once swept", tooltip = "If price trades through a session high/low, drop it (the liquidity has been taken).", group = G_SESS)
sessReclassify = input.bool(true, "Reclassify unswept session H/L as swings", tooltip = "A session high/low that survives into the next day (never swept) gets relabeled e.g. 'Asia H (swing)'.", group = G_SESS)

// -----------------------------------------------------------------------------
// INPUTS — STRUCTURE
// -----------------------------------------------------------------------------
showSwing  = input.bool(true,  "Swing Highs/Lows (liquidity)", group = G_STRUCT)
swingLen   = input.int(10, "  Swing pivot length", minval = 2, group = G_STRUCT)
swingHist  = input.int(40, "  Historical swings kept (per side)", minval = 1, maxval = 200, tooltip = "How many UNSWEPT swing highs/lows to keep. Higher = more levels going back. Old untapped swings persist until swept.", group = G_STRUCT)
htfSwingOn = input.bool(true, "  Add higher-timeframe swings", tooltip = "Also pull swing highs/lows from a higher timeframe so major structural levels far back are captured on a low-TF chart.", group = G_STRUCT)
htfTF      = input.timeframe("240", "  HTF timeframe", tooltip = "Timeframe for the extra structural swings (e.g. 240 = 4h, D = daily).", group = G_STRUCT)
htfLen     = input.int(5, "  HTF swing pivot length", minval = 2, group = G_STRUCT)
removeSwept = input.bool(true, "Remove swept levels (swings, EQ, prev-period)", tooltip = "Once price trades through a level, remove it - the liquidity has been taken.", group = G_STRUCT)
showEQ     = input.bool(true,  "Equal Highs/Lows (EQH/EQL)",   group = G_STRUCT)
eqTol      = input.float(0.35, "  EQ tolerance (× ATR)", minval = 0.0, step = 0.05, tooltip = "Two swing pivots count as an Equal High/Low if within this many ATRs of each other.", group = G_STRUCT)
eqLookback = input.int(6, "  EQ lookback (pivots)", minval = 1, maxval = 30, tooltip = "How many recent same-type pivots to compare against when hunting equal highs/lows.", group = G_STRUCT)
showRelEQ  = input.bool(true, "  Relative (near) Equal H/L", tooltip = "Also flag NEAR-equal highs/lows — pivots close but not within the strict EQ tolerance. Real stop-runs rarely line up to the tick; relative EQs (rEQH/rEQL) catch the softer clusters. Tagged distinctly and fed into the clusters/pull at a slightly lower weight than exact EQs.", group = G_STRUCT)
relEqTol   = input.float(0.75, "    Relative EQ tolerance (× ATR)", minval = 0.0, step = 0.05, tooltip = "Wider band (in ATRs) for near-equal highs/lows. Should be larger than the strict EQ tolerance.", group = G_STRUCT)
showBreaker = input.bool(true, "Breaker blocks (failed OB flips polarity)", tooltip = "When an order block is violated (price closes through it), it doesn't just vanish — it becomes a BREAKER: former demand flips to supply (and vice versa). Breakers are strong reaction zones; they feed the confluence score + resistance like order blocks.", group = G_STRUCT)
// --- FVG ---
showFVG    = input.bool(true,  "Fair Value Gaps (FVG)",        group = G_STRUCT)
hideMitFVG = input.bool(true,  "  Remove invalidated FVGs",    group = G_STRUCT)
fvgFillMode = input.string("Body close through", "  FVG invalidation", options = ["Body close through","Wick touch (50%)","Full fill (wick)"], tooltip = "Body close through: gap disappears once a candle CLOSES beyond it. Wick touch: removed at midpoint. Full fill: removed only when a wick fully engulfs it.", group = G_STRUCT)
// --- SFP (sweep + reversal) ---
showSFP    = input.bool(true, "Sweep + reversal markers (SFP)", tooltip = "The core validity trigger: a wick pierces a tracked level then the candle CLOSES back on the origin side (a stop-run). Marks 🎯 SFP long/short.", group = G_STRUCT)
sfpUseVol  = input.bool(true, "  Require volume confirmation", tooltip = "Only flag a sweep as a real grab on elevated relative volume.", group = G_STRUCT)
rvolLen    = input.int(20, "  Rel-volume lookback", minval = 5, maxval = 200, group = G_STRUCT)
rvolMult   = input.float(1.5, "  Min rel-volume for grab", minval = 1.0, maxval = 5.0, step = 0.1, group = G_STRUCT)
sfpColLong  = input.color(color.new(#26a69a, 0), "  Bullish SFP color", group = G_STRUCT)
sfpColShort = input.color(color.new(#ef5350, 0), "  Bearish SFP color", group = G_STRUCT)
// --- Order Blocks ---
showOB     = input.bool(true, "Order blocks after displacement", tooltip = "After a sweep+displacement, mark the last opposing candle as a demand/supply zone until mitigated.", group = G_STRUCT)
obDisp     = input.float(1.2, "  Displacement size (× ATR)", minval = 0.3, step = 0.1, tooltip = "How large the breakout candle body must be (in ATRs) to leave a valid order block.", group = G_STRUCT)
obColBull  = input.color(color.new(#26a69a, 80), "  Bullish OB color", group = G_STRUCT)
obColBear  = input.color(color.new(#ef5350, 80), "  Bearish OB color", group = G_STRUCT)
obKeep     = input.int(8, "  Max order blocks kept", minval = 1, maxval = 40, group = G_STRUCT)

// -----------------------------------------------------------------------------
// INPUTS — COUNTDOWN
// -----------------------------------------------------------------------------
showCD    = input.bool(true,  "Show countdown to level",  group = G_CD)
velLen    = input.int(14, "Velocity lookback (bars)", minval = 2, group = G_CD)
cdMode    = input.string("Clock time", "Countdown units", options = ["Clock time","Bars"], group = G_CD)
dirAware  = input.bool(true,  "Only show for levels price is approaching", group = G_CD)

// -----------------------------------------------------------------------------
// INPUTS — CLUSTERING & CONFLUENCE
// -----------------------------------------------------------------------------
masterOn   = input.bool(true, "MASTER: draw everything", tooltip = "Global on/off for all drawings.", group = G_CLUST)
// --- declutter: one-click density + top-N-per-side + confidence gate (faint, not removed) ---
densityPreset = input.string("Balanced", "Chart density", options = ["Minimal","Balanced","Everything","Custom"], tooltip = "One-click declutter. MINIMAL: only the few strongest levels each side drawn boldly, everything else faint. BALANCED: a healthy handful. EVERYTHING: draw all at full strength (legacy). CUSTOM: use the Top-N / gate / fade values below. Levels below the cut are DIMMED (drawn faintly), never removed — so nothing is lost, it just recedes.", group = G_CLUST)
densTopN   = input.int(4, "  Custom: bold levels per side (Top-N by confidence)", minval = 1, maxval = 30, tooltip = "Only the N highest-confidence levels ABOVE and N BELOW price are drawn bold; the rest go faint. (Custom preset.)", group = G_CLUST)
densGate   = input.float(6.0, "  Custom: faint below confidence %", minval = 0.0, maxval = 100.0, step = 1.0, tooltip = "Levels/zones whose confidence % is below this are drawn faintly. (Custom preset.)", group = G_CLUST)
densFadeOp = input.int(78, "  Faint opacity (0 solid → 100 invisible)", minval = 40, maxval = 96, tooltip = "How dim a de-emphasized level is drawn. Higher = fainter.", group = G_CLUST)
clusterOn  = input.bool(true, "Merge nearby levels into zones", group = G_CLUST)
clustDist  = input.float(0.5, "Cluster distance (× ATR)", minval = 0.05, step = 0.05, tooltip = "Levels within this many ATRs of each other merge into one strength-rated zone.", group = G_CLUST)
minStrength = input.int(1, "Min strength to display", minval = 1, maxval = 8, tooltip = "Only draw levels/zones whose strength (stacked count) is at least this. 2+ hides lone levels.", group = G_CLUST)
maxStrength   = input.int(4, "Max strength markers shown", minval = 1, maxval = 6, group = G_CLUST)
zoneOpacityMin = input.int(85, "Zone fill opacity — weakest", minval = 0, maxval = 100, group = G_CLUST)
zoneOpacityMax = input.int(55, "Zone fill opacity — strongest", minval = 0, maxval = 100, group = G_CLUST)
sideColorOn = input.bool(true, "Color-code by side (BSL/SSL)", tooltip = "Levels ABOVE price = BSL (resistance) use the BSL color; BELOW price = SSL (support) use the SSL color.", group = G_CLUST)
colBSL   = input.color(color.new(#ef5350, 0), "  BSL color (above price)", group = G_CLUST)
colSSL   = input.color(color.new(#26a69a, 0), "  SSL color (below price)", group = G_CLUST)
emojiBSL = input.string("🔴", "  BSL strength marker", options = ["🔴","🟥","🔺","🛑","⛔","🔻","💢"], group = G_CLUST)
emojiSSL = input.string("🟢", "  SSL strength marker", options = ["🟢","🟩","🔼","✅","💚","🔽","🌿"], group = G_CLUST)
strengthEmoji = input.string("🔥", "  Neutral strength marker (side off)", options = ["🔥","⭐","🟥","🟦","🟨","🔶","💠"], group = G_CLUST)
clustLblTxt = input.color(color.new(#ffffff, 0),  "Cluster label text color", group = G_CLUST)
showStrengthEmoji = input.bool(true, "Show strength emojis on clusters", group = G_CLUST)
showSideTag  = input.bool(true, "Show BSL/SSL text tag on clusters", group = G_CLUST)
outlineTags  = input.bool(true, "Outline level/cluster tags in side color", group = G_CLUST)
tieredEmoji  = input.bool(true, "Fun tiered strength emojis (💧⚡🔥💎🐋)", group = G_CLUST)
bigStrongLbl = input.bool(true, "Enlarge label for strong zones", group = G_CLUST)
// --- Confluence score ---
showConf    = input.bool(true, "Confluence score on zones (0-100)", tooltip = "Rolls up stacked levels + order-block overlap + OTE-fib proximity + premium/discount extreme + round-number proximity into a 0-100 'how loaded is this zone' score. The OTE/premium-discount factors are computed from the live dealing range internally (not drawn on the chart).", group = G_CLUST)
confMin     = input.int(0, "  Hide zones below score", minval = 0, maxval = 100, tooltip = "Only show cluster zones scoring at least this. 0 = show all.", group = G_CLUST)
confRound   = input.float(0.0, "  Round-number step (price)", minval = 0.0, tooltip = "Adds confluence when a zone sits near a round-number multiple of this step (e.g. 50/100 indices, 1000 BTC). 0 = disable.", group = G_CLUST)
confVWAP    = input.bool(true, "  VWAP proximity in confluence", tooltip = "Adds confluence when a level sits near the session VWAP — a heavily-defended fair-value reference. VWAP is used as a SCORING factor only (not drawn as its own magnet).", group = G_CLUST)
showVP      = input.bool(false, "Volume Profile levels (POC / VAH / VAL)", tooltip = "Builds a rough volume profile over a lookback and adds the Point of Control (highest-volume price) and Value Area High/Low as levels. Acceptance-based levels (where volume traded), a different KIND of level from swing liquidity — they feed the clusters + DOL pull.", group = G_CLUST)
vpLen       = input.int(240, "  VP lookback (bars)", minval = 20, maxval = 1000, tooltip = "How many recent bars to build the volume profile from.", group = G_CLUST)
vpBins      = input.int(24, "  VP resolution (bins)", minval = 8, maxval = 60, tooltip = "Number of price buckets in the profile. More = finer POC/VA, slightly heavier.", group = G_CLUST)

// -----------------------------------------------------------------------------
// INPUTS — DRAW-ON-LIQUIDITY GAUGE
// -----------------------------------------------------------------------------
showDOL   = input.bool(true, "Show DOL gauge", tooltip = "A corner banner pointing to the side (BSL above vs SSL below) with the greater LIQUIDITY GRAVITY - a multi-factor score of where price is most likely being drawn.", group = G_DOL)
dolBanPos = input.string("Top Right", "Banner position", options = ["Top Right","Top Left","Bottom Right","Bottom Left","Middle Right","Middle Left"], group = G_DOL)
dolBull   = input.string("🔼", "Bullish draw emoji", options = ["🔼","🟢","🚀","📈","👆","🐂"], group = G_DOL)
dolBear   = input.string("🔽", "Bearish draw emoji", options = ["🔽","🔴","🐻","📉","👇","🩸"], group = G_DOL)
dolSize   = input.string("Large", "Banner text size", options = ["Normal","Large","Huge"], group = G_DOL)
dolSens   = input.string("Medium", "Gravity sensitivity", options = ["Low","Medium","High"], tooltip = "How sharply nearby / important / aged / clustered liquidity dominates the pull.", group = G_DOL)
dolUseType = input.bool(true, "Weight by level importance (type)", tooltip = "Major levels (PDH/PDL, weekly/monthly, HTF) pull harder than minor session/local levels.", group = G_DOL)
dolUseAge  = input.bool(true, "Weight by level age (resting time)", group = G_DOL)
dolMomWt   = input.float(30, "Momentum tilt %", minval = 0, maxval = 100, step = 5, tooltip = "How much live directional momentum biases the arrow on top of the static liquidity score.", group = G_DOL)
dolTgtLine = input.bool(true, "Show primary-magnet target in banner", tooltip = "Adds a banner row with the strongest magnet price and its distance (ATR / %).", group = G_DOL)
dolMeter   = input.bool(true, "Show conviction meter", group = G_DOL)
dolTugBar  = input.bool(true, "Show tug-of-war bar (BSL vs SSL)", group = G_DOL)
// --- pull-field ladder: a compact right-edge heatmap of the draw toward the dominant magnet ---
showField  = input.bool(false, "Pull-field ladder (right-edge heatmap)", tooltip = "A compact stack of colored cells at the right edge showing WHERE the draw toward the dominant magnet is strongest. Each cell is a price band between price and the primary target; HOT = strong, clear pull; COLD = weak or blocked by an order block / FVG in the path. It's the resistance-adjusted pull model rendered as a spatial field — a legibility view, not a new signal. Default off to keep the chart clean.", group = G_DOL)
fieldBands = input.int(12, "  Field resolution (cells)", minval = 4, maxval = 30, tooltip = "How many price bands to split the price→magnet span into.", group = G_DOL)
fieldWidth = input.int(4, "  Field width (bars)", minval = 1, maxval = 20, tooltip = "Width of the ladder column in bars, drawn to the right of the last bar.", group = G_DOL)
fieldGap   = input.int(2, "  Field gap from price (bars)", minval = 0, maxval = 30, group = G_DOL)
fieldHot   = input.color(color.new(#ff5252, 0), "  Hot color (strong clear pull)", group = G_DOL)
fieldCold  = input.color(color.new(#5c6bc0, 0), "  Cold color (weak / blocked)", group = G_DOL)
fieldOpacity = input.int(30, "  Field opacity (0 solid → 100 invisible)", minval = 0, maxval = 90, group = G_DOL)
// --- accuracy pass ---
dolConfW   = input.bool(true, "Weight pull by each level's confluence score", tooltip = "A level sitting in an order block + OTE + round number pulls far harder than a lone level. Multiplies each level's DOL pull by its own confluence score - the single biggest accuracy boost.", group = G_DOL)
dolNearBias = input.float(1.5, "Nearest-pool emphasis", minval = 0.0, maxval = 4.0, step = 0.25, tooltip = "Extra sharpening of the distance decay. Higher = the nearest untapped pool dominates the pull (price hunts the closest liquidity first). 0 = flat.", group = G_DOL)
dolFreshW  = input.bool(true, "Freshness premium (untested pulls harder)", tooltip = "Levels price has NOT yet reacted off pull harder; levels already wicked into are discounted.", group = G_DOL)
showLvlConf = input.bool(true, "Show per-level confidence % (target likelihood)", tooltip = "Each level/zone gets a 0-100 score for how likely price heads THERE next. The single most-likely target is flagged 🎯.", group = G_DOL)
lvlConfMode = input.string("Magnet quality", "  Confidence % basis", options = ["Magnet quality","Raw pull"], tooltip = "Magnet quality (recommended): distance is removed so the % reflects how STRONG a magnet each level is for its distance — a far but heavy pool (equal highs + order block + old + fresh) can out-score a near lone swing. Raw pull (legacy): the % is each level's share of the proximity-weighted gravity, so the nearest level almost always dominates (obvious, less useful). The 🎯 still marks the nearest strongest pull in both modes.", group = G_DOL)
lvlConfWin  = input.int(5, "  Confidence window (levels each side)", minval = 1, maxval = 50, tooltip = "Only the N nearest levels ABOVE and N nearest BELOW price get a confidence %, and the % is normalized over just those levels. Keeps intraday reads focused on the levels price can realistically reach instead of diluting the % across far higher-timeframe levels. Lower = tighter/more decisive; higher = wider context. 🎯 still uses all levels.", group = G_DOL)
// --- projection pass (all reuse existing pull / velocity / OB-FVG / range machinery) ---
projClear   = input.bool(true,  "Path-clearance on 🎯 target", tooltip = "Discounts the primary magnet by what stands between price and it: opposing order blocks / FVGs / strong levels in the path lower a 0-100 clearance score. A clear runway reads high; a blocked path reads low. Shown as 🛣️ on the target row.", group = G_DOL)
projClearW  = input.float(1.0, "  Clearance sensitivity", minval = 0.0, maxval = 3.0, step = 0.25, tooltip = "How hard each obstacle in the path cuts the clearance score. 0 = ignore obstacles; higher = a single blocker matters more.", group = G_DOL)
projETA     = input.bool(true,  "ETA to 🎯 target (time projection)", tooltip = "Uses recent price velocity to project HOW LONG until the primary magnet is reached (bars or clock time, per the Countdown setting). Adds a ⏱ estimate to the target row.", group = G_DOL)
projEqui    = input.bool(true,  "Equilibrium / range-state (Prem·EQ·Disc)", tooltip = "Shows where price sits in the current dealing range: Premium (upper), Equilibrium (~50%), or Discount (lower). Crossing equilibrium toward a pool is a continuation tell. Adds a range-state row to the banner.", group = G_DOL)
projConfMom = input.bool(true,  "Confidence momentum ▲▼", tooltip = "Marks whether each level's confidence % is RISING or FALLING versus the previous bar. A strengthening magnet (▲) is a firming draw; a fading one (▼) warns of rejection. Appended to the per-level %.", group = G_DOL)
projStacked = input.bool(true,  "Stacked-agreement flag ⭐", tooltip = "Flags a level where multiple independent signals align — DOL bias side + primary magnet + an overlapping order block / FVG. 3+ agreeing signals is the highest-conviction projection. Adds ⭐ to that level.", group = G_DOL)
// --- de-skew: stop a level price is CURRENTLY forming/sitting on from inflating confidence ---
projLiveSess = input.bool(true, "Exclude forming session H/L from magnet", tooltip = "A still-forming session high/low tracks price in real time, so it sits ~0 distance away and unfairly dominates the confidence % (price 'chasing' a level it is itself creating). When on, the CURRENT session's extreme still draws as a line but takes no magnet / confidence role until the session closes or price pulls away — it becomes real resting liquidity, then re-enters the pull.", group = G_DOL)
projDistFloor = input.bool(true, "Distance floor (ignore levels hugging price)", tooltip = "General safety net: any level within the floor distance of price contributes ~no pull and no confidence %, since you can't be 'drawn' to where price already is. Catches the session case and any other level price is sitting on.", group = G_DOL)
projDistFloorATR = input.float(0.12, "  Distance floor (× ATR)", minval = 0.0, maxval = 1.0, step = 0.02, tooltip = "How close (in ATRs) a level must be to price before it's treated as 'already here' and excluded from the magnet pool. 0 = disable.", group = G_DOL)
// --- resistance-adjusted bias: a pool only pulls as hard as the PATH to it is open ---
projResist = input.bool(true, "Resistance-adjusted DOL bias", tooltip = "Weights each side's draw by how CLEAR the path to it is. Structure standing in the way (order blocks, FVGs) between price and a pool discounts that side's effective pull, so a heavily-walled pool pulls less than an open one. Price hunts the REACHABLE liquidity, not the blocked pool. Conservative: resistance only DISCOUNTS a side's pull, it never adds to the opposite side. Obstacle severity uses the Path-clearance sensitivity. A 🧱 clearance readout is added to the banner.", group = G_DOL)
// --- landscape bias: don't let ONE level price is hugging dominate the whole side ---
biasCap = input.float(0.5, "Bias dominance cap (max share per level)", minval = 0.2, maxval = 1.0, step = 0.05, tooltip = "Caps how much a SINGLE level can contribute to its side's pull when computing the DOL bias. Without this, one level price is sitting right next to can out-pull a whole cluster of levels on the other side (distance decay makes the nearest level huge), flipping the bias toward wherever price momentarily is. Capping each level's share (e.g. 0.5 = no level exceeds 50% of its side) makes the bias reflect the LIQUIDITY LANDSCAPE — where the mass/cluster of levels sits — instead of one proximity outlier. The 🎯 magnet still tracks the single nearest-strongest level, so you keep both readings. 1.0 = disable (legacy).", group = G_DOL)

// -----------------------------------------------------------------------------
// INPUTS — STYLE
// -----------------------------------------------------------------------------
uiTheme    = input.string("Refined Dark", "Panel theme", options = ["Refined Dark","Refined Light","Midnight","Slate","Classic (legacy)"], group = G_STYLE)
uiPanelOpacity = input.int(16, "Panel background opacity boost", minval = 0, maxval = 60, group = G_STYLE)
uiAccentTint = input.int(70, "Accent softness", minval = 0, maxval = 90, group = G_STYLE)
uiSlimBorders = input.bool(true, "Slim panel borders", group = G_STYLE)
lineWidth  = input.int(1, "Line width", minval = 1, maxval = 3, group = G_STYLE)
lineStyleI = input.string("Solid", "Line style", options = ["Solid","Dashed","Dotted"], group = G_STYLE)
labelSize  = input.string("Small", "Label size", options = ["Tiny","Small","Normal"], group = G_STYLE)
extendR    = input.int(10, "Line extend-right (bars)", minval = 0, group = G_STYLE)
ageExtend  = input.bool(true, "Age-scaled extension (older = longer)", tooltip = "Each level's line grows with how long it has persisted, so mature levels are visibly longer.", group = G_STYLE)
ageMaxBars = input.int(20, "  Max extra bars from age", minval = 0, maxval = 200, group = G_STYLE)
ageScale   = input.float(0.35, "  Age scale (bars added per bar of age)", minval = 0.05, maxval = 1.0, step = 0.05, group = G_STYLE)
compact    = input.bool(false, "Compact Mode (hide levels far from price)", group = G_STYLE)
nearN      = input.int(3, "  Nearest N above & below", minval = 1, maxval = 10, group = G_STYLE)
compactBand = input.float(4.0, "  Compact band (× ATR × N)", minval = 1.0, step = 0.5, group = G_STYLE)
colBull  = input.color(color.new(#26a69a, 0),  "Bullish / High color", group = G_STYLE)
colBear  = input.color(color.new(#ef5350, 0),  "Bearish / Low color",  group = G_STYLE)
colSess  = input.color(color.new(#42a5f5, 0),  "Session color",        group = G_STYLE)
colZone  = input.color(color.new(#ffb300, 0),  "Cluster zone color",   group = G_STYLE)
colFVGBase = input.color(color.new(#ab47bc, 0), "FVG fill color",       group = G_STYLE)
opacityFVG = input.int(80, "FVG zone opacity", minval = 0, maxval = 100, group = G_STYLE)
colFVG  = color.new(colFVGBase, opacityFVG)

// -----------------------------------------------------------------------------
// INPUTS — EMOJI TAGS
// -----------------------------------------------------------------------------
emoPrev = input.string("⭐", "Previous-period tag", options = ["None","🔥","⭐","🟡","🔹","💧","🎯","🧲"], group = G_EMO)
emoSess = input.string("🟡", "Session tag",         options = ["None","🔥","⭐","🟡","🔹","💧","🎯","🧲"], group = G_EMO)
emoLiq  = input.string("💧", "Liquidity tag",       options = ["None","🔥","⭐","🟡","🔹","💧","🎯","🧲"], group = G_EMO)

// -----------------------------------------------------------------------------
// INPUTS — GHOST LEVELS
// -----------------------------------------------------------------------------
showGhost   = input.bool(true, "Show ghost levels (recently swept)", tooltip = "When a level is SWEPT (price trades through it), leave a faint dotted 'ghost' where the liquidity was taken. Ghosts fade over their lifetime, then disappear.", group = G_GHOST)
showGhostHist = input.bool(true, "Show historical ghosts (dotted lines)", tooltip = "ON: keep ghosts of ALL recent sweeps as dotted lines going back through history (up to the max kept). OFF: only show a ghost briefly at the moment of the sweep. Either way they fade with age.", group = G_GHOST)
ghostOpacity = input.int(70, "Ghost opacity (0 solid, 100 invisible)", minval = 0, maxval = 100, tooltip = "Starting transparency of a fresh ghost line. Higher = fainter. Ghosts fade further toward invisible as they age.", group = G_GHOST)
ghostLife   = input.int(120, "Ghost lifetime (bars)", minval = 1, maxval = 3000, tooltip = "How many bars a ghost lingers after the level was swept before it disappears. Increase if ghosts vanish before you notice them.", group = G_GHOST)
ghostCol    = input.color(color.new(#b0bec5, 0), "Ghost line color", group = G_GHOST)
ghostKeep   = input.int(60, "Max ghosts kept", minval = 1, maxval = 300, tooltip = "Cap on the number of ghost lines retained at once (oldest dropped first).", group = G_GHOST)
// --- tested / virgin state: has price already PROBED a level (wicked in, not swept through)? ---
showTested   = input.bool(true, "Flag tested levels (probed, not swept)", tooltip = "Marks levels a wick has already PROBED into (reacted off) but not fully swept — 'used' liquidity vs a virgin untouched level. Tested levels get a ✓ and a dotted/dimmed outline; untouched ones stay solid. (Fully swept levels are removed already.)", group = G_GHOST)
testDepthATR = input.float(0.10, "  Tested probe depth (× ATR)", minval = 0.02, maxval = 1.0, step = 0.02, tooltip = "How far a wick must poke INTO a level (in ATRs) to count as tested. Small = only genuine probes register; larger = grazes count too.", group = G_GHOST)
testDiscount = input.bool(true, "  Discount tested levels in scoring", tooltip = "A tested level is a slightly weaker magnet (some of its liquidity was already taken / defended), so reduce its DOL pull. Visual-only if this is off.", group = G_GHOST)
testDiscAmt  = input.float(0.25, "    Tested pull discount", minval = 0.0, maxval = 0.9, step = 0.05, tooltip = "How much to cut a tested level's pull (0.25 = -25%). 0 = no discount.", group = G_GHOST)
testKeep     = input.int(120, "  Max tested levels tracked", minval = 10, maxval = 500, group = G_GHOST)

// -----------------------------------------------------------------------------
// HELPERS
// -----------------------------------------------------------------------------
f_lineStyle() =>
    lineStyleI == "Dashed" ? line.style_dashed : lineStyleI == "Dotted" ? line.style_dotted : line.style_solid

// --- density preset -> effective declutter params (Custom uses the raw inputs) ---
// eTopN: how many levels per side (by confidence) stay BOLD; eGate: faint below this
// confidence %. Everything = draw all at full strength. De-emphasised levels are drawn
// FAINT (never removed), so nothing is lost — it just recedes.
int   eTopN = densityPreset == "Minimal" ? 2 : densityPreset == "Balanced" ? 4 : densityPreset == "Everything" ? 9999 : densTopN
float eGate = densityPreset == "Minimal" ? 12.0 : densityPreset == "Balanced" ? 6.0 : densityPreset == "Everything" ? 0.0 : densGate
bool  densOn = densityPreset != "Everything"

// tested-state memory: prices that a wick has PROBED into (persists across the per-bar
// level rebuild). Populated in the capture block below; read at scoring + render time.
var testedP = array.new<float>()
f_isTested(float price, float atrU) =>
    bool hit = false
    if showTested and array.size(testedP) > 0
        float tol = math.max(atrU * 0.10, syminfo.mintick)
        for ti = 0 to array.size(testedP) - 1
            if math.abs(array.get(testedP, ti) - price) <= tol
                hit := true
    hit

f_labelSize() =>
    labelSize == "Tiny" ? size.tiny : labelSize == "Normal" ? size.normal : size.small

// --- theme palette ---
themeBgBase  = uiTheme == "Refined Light" ? color.new(#f5f6fa, 0) : uiTheme == "Midnight" ? color.new(#0d1117, 0) : uiTheme == "Slate" ? color.new(#262b36, 0) : uiTheme == "Classic (legacy)" ? color.new(#1e222d, 0) : color.new(#171a21, 0)
themeTxt     = uiTheme == "Refined Light" ? color.new(#2b2f3a, 0) : color.new(#e6e9ef, 0)
themeMuted   = uiTheme == "Refined Light" ? color.new(#6b7280, 0) : color.new(#9aa4b2, 0)
themeHdrRaw  = uiTheme == "Refined Light" ? #b45309 : #d4b483
themeHdr     = color.new(themeHdrRaw, uiAccentTint > 40 ? uiAccentTint - 40 : 0)
themeUpSolid = color.new(#4db6ac, 0)
themeDnSolid = color.new(#e08d8d, 0)
themePanelBg = color.new(themeBgBase, math.min(100, uiPanelOpacity))
themeRowBg   = color.new(themeBgBase, math.min(100, uiPanelOpacity + 8))
themeBorder  = color.new(uiTheme == "Refined Light" ? #d0d4dc : #3a4150, uiSlimBorders ? 20 : 0)
themeBW      = uiSlimBorders ? 1 : 2

// core series
velocity  = ta.sma(math.abs(ta.change(close)), velLen)
secPerBar = timeframe.in_seconds(timeframe.period)
atr       = ta.atr(14)

// DOL momentum (per-bar, real history)
dolEmaF   = ta.ema(close, 21)
dolEmaS   = ta.ema(close, 55)
dolTrendV = (dolEmaF - dolEmaS) / math.max(nz(atr), syminfo.mintick)
dolRoc    = ta.roc(close, 9) / 100.0
dolMomRaw = 0.6 * dolTrendV + 0.4 * (dolRoc * 20.0)
dolMom    = math.max(-1.0, math.min(1.0, dolMomRaw))

// relative volume
avgVol = ta.sma(volume, rvolLen)
rvol   = nz(avgVol) > 0 ? volume / avgVol : 0.0
volOK  = (not sfpUseVol) or (rvol >= rvolMult)

f_tablePos(string p) =>
    p == "Top Right" ? position.top_right : p == "Top Left" ? position.top_left : p == "Bottom Right" ? position.bottom_right : p == "Bottom Left" ? position.bottom_left : p == "Middle Left" ? position.middle_left : position.middle_right

// clamp a drawing's start bar to inside the loaded history buffer (never < 0)
f_clampBar(int b) =>
    int back = math.min(bar_index, 300)
    int floorBar = bar_index - back
    int r = na(b) ? floorBar : math.max(b, floorBar)
    math.max(math.min(r, bar_index), 0)

// countdown-to-level string
f_countdown(float target) =>
    string outTxt = ""
    if showCD and nz(velocity) > 0 and not na(target)
        float dist = math.abs(target - close)
        bool approaching = (target > close and close > nz(close[1], close)) or (target < close and close < nz(close[1], close))
        if (not dirAware) or approaching
            float bars = dist / velocity
            if cdMode == "Bars"
                outTxt := " → ≈ " + str.tostring(math.round(bars)) + "b"
            else
                float secs = bars * secPerBar
                if secs < 3600
                    outTxt := " → ≈ " + str.tostring(math.round(secs / 60)) + "m"
                else if secs < 86400
                    int h = int(math.floor(secs / 3600))
                    int m = int(math.round((secs - h * 3600) / 60))
                    outTxt := " → ≈ " + str.tostring(h) + "h " + str.tostring(m) + "m"
                else
                    outTxt := " → ≈ " + str.tostring(math.round(secs / 86400)) + "d"
    outTxt

f_repeat(string e, int n) =>
    string s = ""
    int cnt = math.min(n, maxStrength)
    for i = 1 to cnt
        s := s + e
    s

f_tierEmoji(int members) =>
    members <= 1 ? "💧" : members == 2 ? "⚡" : members == 3 ? "🔥" : members == 4 ? "💎" : "🐋"

f_strongSize(int members) =>
    not bigStrongLbl ? f_labelSize() : (members >= 4 ? size.large : members >= 2 ? size.normal : f_labelSize())

// BSL/SSL by POSITION vs price
f_sideColI(int side, float lvl, color fallback) =>
    not sideColorOn ? fallback : (lvl >= close ? colBSL : colSSL)
f_sideEmojiI(int side, float lvl) =>
    not sideColorOn ? strengthEmoji : (lvl >= close ? emojiBSL : emojiSSL)
f_sideTagI(int side, float lvl) =>
    lvl >= close ? "BSL" : "SSL"

f_sessName(string base, bool carried) =>
    (sessReclassify and carried) ? (base + " (swing)") : base

f_inCompactRange(float lvl) =>
    not compact or (na(lvl) ? false : math.abs(lvl - close) <= nz(atr) * (nearN * compactBand))

f_extLen(int birthBar) =>
    if not ageExtend or na(birthBar)
        extendR
    else
        int age = math.max(bar_index - birthBar, 0)
        int extra = int(math.min(age * ageScale, ageMaxBars))
        extendR + extra

// -----------------------------------------------------------------------------
// LEVEL SOURCES
// -----------------------------------------------------------------------------
pdh   = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl   = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)
pwh   = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl   = request.security(syminfo.tickerid, "W", low[1],  lookahead = barmerge.lookahead_on)
pmh   = request.security(syminfo.tickerid, "M", high[1], lookahead = barmerge.lookahead_on)
pml   = request.security(syminfo.tickerid, "M", low[1],  lookahead = barmerge.lookahead_on)
dOpen = request.security(syminfo.tickerid, "D", open,    lookahead = barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", open,    lookahead = barmerge.lookahead_on)
mOpen = request.security(syminfo.tickerid, "M", open,    lookahead = barmerge.lookahead_on)
// NY midnight open: capture price at the first bar of the New York (ET) day.
var float midO = na
bool newNYDay = ta.change(time("D", "0000-0000", "America/New_York")) != 0
if newNYDay
    midO := open
// session VWAP (scoring factor only)
vwapVal = ta.vwap(hlc3)

// -----------------------------------------------------------------------------
// VOLUME PROFILE — rough POC / Value Area over a lookback (computed on last bar)
// -----------------------------------------------------------------------------
var float vpPOC = na
var float vpVAH = na
var float vpVAL = na
if showVP and barstate.islast
    float hiP = ta.highest(high, vpLen)
    float loP = ta.lowest(low, vpLen)
    if not na(hiP) and not na(loP) and hiP > loP
        float binW = (hiP - loP) / vpBins
        var bins = array.new<float>()
        array.clear(bins)
        for bni = 0 to vpBins - 1
            array.push(bins, 0.0)
        // distribute each bar's volume into the bin covering its hlc3
        for bk = 0 to vpLen - 1
            float pxk = (high[bk] + low[bk] + close[bk]) / 3.0
            float vk  = nz(volume[bk], 1.0)
            int bidx = int(math.floor((pxk - loP) / binW))
            bidx := math.max(0, math.min(vpBins - 1, bidx))
            array.set(bins, bidx, array.get(bins, bidx) + vk)
        // POC = highest-volume bin center; total for value-area
        float totV = array.sum(bins)
        int pocI = 0
        float pocV = 0.0
        for bni = 0 to vpBins - 1
            if array.get(bins, bni) > pocV
                pocV := array.get(bins, bni)
                pocI := bni
        vpPOC := loP + (pocI + 0.5) * binW
        // expand around POC until ~70% of volume is captured -> value area
        float acc = pocV
        int lo_i = pocI
        int hi_i = pocI
        while acc < totV * 0.70 and (lo_i > 0 or hi_i < vpBins - 1)
            float belowV = lo_i > 0 ? array.get(bins, lo_i - 1) : -1.0
            float aboveV = hi_i < vpBins - 1 ? array.get(bins, hi_i + 1) : -1.0
            if aboveV >= belowV and hi_i < vpBins - 1
                hi_i := hi_i + 1
                acc := acc + array.get(bins, hi_i)
            else if lo_i > 0
                lo_i := lo_i - 1
                acc := acc + array.get(bins, lo_i)
            else if hi_i < vpBins - 1
                hi_i := hi_i + 1
                acc := acc + array.get(bins, hi_i)
        vpVAL := loP + lo_i * binW
        vpVAH := loP + (hi_i + 1) * binW

// -----------------------------------------------------------------------------
// SESSIONS
// -----------------------------------------------------------------------------
f_inSession(string s) => not na(time(timeframe.period, s, sessTZ))
newDay = ta.change(time("D", "0000-0000", sessTZ)) != 0

f_sessHL(bool active, string sess) =>
    var float hi        = na
    var float lo        = na
    var bool  prevIn    = false
    var bool  hiCarried = false
    var bool  loCarried = false
    bool inS = f_inSession(sess)
    if active
        if sessResetDaily and newDay
            hiCarried := not na(hi)
            loCarried := not na(lo)
        if inS and not prevIn
            hi := high
            lo := low
            hiCarried := false
            loCarried := false
        else if inS
            hi := math.max(nz(hi, high), high)
            lo := math.min(nz(lo, low), low)
        if sessRemoveSwept
            if not na(hi) and high > hi
                hi := na
                hiCarried := false
            if not na(lo) and low < lo
                lo := na
                loCarried := false
    prevIn := inS
    // "forming" = we're inside this session AND the current bar is at/making the extreme.
    // A forming extreme is not resting liquidity yet (price is defining it in real time),
    // so it should NOT act as a DOL magnet / carry a confidence % (it would just chase price).
    bool hiForming = active and inS and not na(hi) and high >= hi
    bool loForming = active and inS and not na(lo) and low  <= lo
    [hi, lo, hiCarried, loCarried, hiForming, loForming]

[asiaH, asiaL, asiaHc, asiaLc, asiaHf, asiaLf] = f_sessHL(showAsia, asiaSess)
[londH, londL, londHc, londLc, londHf, londLf] = f_sessHL(showLond, londSess)
[nyH,   nyL,   nyHc,   nyLc,   nyHf,   nyLf]   = f_sessHL(showNY,   nySess)

// -----------------------------------------------------------------------------
// SWINGS + HTF SWINGS
// -----------------------------------------------------------------------------
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

f_htfPH() => ta.pivothigh(high, htfLen, htfLen)
f_htfPL() => ta.pivotlow(low, htfLen, htfLen)
htfPH = htfSwingOn ? request.security(syminfo.tickerid, htfTF, f_htfPH(), lookahead = barmerge.lookahead_off) : na
htfPL = htfSwingOn ? request.security(syminfo.tickerid, htfTF, f_htfPL(), lookahead = barmerge.lookahead_off) : na
htfPHchg = not na(htfPH) and (na(htfPH[1]) or htfPH != htfPH[1])
htfPLchg = not na(htfPL) and (na(htfPL[1]) or htfPL != htfPL[1])

var float lastPH = na
var float lastPL = na
var int rangeDir = 0
if showSwing or showEQ or showConf
    if not na(ph)
        lastPH := ph
        rangeDir := -1
    if not na(pl)
        lastPL := pl
        rangeDir := 1

// LIVE dealing range (for the confluence OTE / premium-discount factor).
// Computed internally whenever the confluence score is on; NOT drawn on the chart.
// One end anchors to the freshest opposing swing; the other tracks the running
// extreme, so the OTE levels re-measure as price continues in the leg's direction.
var float rngHi = na
var float rngLo = na
if showConf
    if not na(pl)
        rngLo := pl
        rngHi := math.max(nz(rngHi, high), high)
    if not na(ph)
        rngHi := ph
        rngLo := math.min(nz(rngLo, low), low)
    if rangeDir >= 0
        rngHi := math.max(nz(rngHi, high), high)
    else
        rngLo := math.min(nz(rngLo, low), low)

// OTE retracement ratios used by the confluence score (internal; never drawn)
var float pdFib1 = 0.705
var float pdFib2 = 0.788
var float pdFib3 = 0.886

// historical swing storage
var swHi   = array.new<float>()
var swHiB  = array.new<int>()
var swLo   = array.new<float>()
var swLoB  = array.new<int>()

if showSwing and not na(ph)
    array.push(swHi, ph)
    array.push(swHiB, bar_index - swingLen)
if showSwing and not na(pl)
    array.push(swLo, pl)
    array.push(swLoB, bar_index - swingLen)
if showSwing and htfSwingOn and htfPHchg
    array.push(swHi, htfPH)
    array.push(swHiB, na)
if showSwing and htfSwingOn and htfPLchg
    array.push(swLo, htfPL)
    array.push(swLoB, na)

// sweep-removal from swing arrays
if removeSwept and array.size(swHi) > 0
    int ih = 0
    while ih < array.size(swHi)
        if high > array.get(swHi, ih)
            array.remove(swHi, ih)
            array.remove(swHiB, ih)
        else
            ih += 1
if removeSwept and array.size(swLo) > 0
    int il = 0
    while il < array.size(swLo)
        if low < array.get(swLo, il)
            array.remove(swLo, il)
            array.remove(swLoB, il)
        else
            il += 1
while array.size(swHi) > swingHist
    array.shift(swHi)
    array.shift(swHiB)
while array.size(swLo) > swingHist
    array.shift(swLo)
    array.shift(swLoB)

// -----------------------------------------------------------------------------
// EQUAL HIGHS / LOWS — rolling-buffer detection
// -----------------------------------------------------------------------------
float eqTolPrice = nz(atr) * eqTol
float relEqTolPrice = nz(atr) * relEqTol
var pvHi  = array.new<float>()
var pvLo  = array.new<float>()
var eqHiA = array.new<float>()
var eqHiB = array.new<int>()
var eqLoA = array.new<float>()
var eqLoB = array.new<int>()
var reqHiA = array.new<float>()   // relative (near) equal highs
var reqHiB = array.new<int>()
var reqLoA = array.new<float>()   // relative (near) equal lows
var reqLoB = array.new<int>()

if showEQ and not na(ph)
    bool found = false
    bool relFound = false
    float matched = na
    float relMatched = na
    int hs = array.size(pvHi)
    if hs > 0
        int start = math.max(hs - eqLookback, 0)
        for qi = start to hs - 1
            float prevH = array.get(pvHi, qi)
            float d = math.abs(ph - prevH)
            if d <= eqTolPrice
                found := true
                matched := math.max(ph, prevH)
            else if showRelEQ and d <= relEqTolPrice
                relFound := true
                relMatched := math.max(ph, prevH)
    if found
        array.push(eqHiA, matched)
        array.push(eqHiB, bar_index - swingLen)
    else if relFound
        array.push(reqHiA, relMatched)
        array.push(reqHiB, bar_index - swingLen)
    array.push(pvHi, ph)
    while array.size(pvHi) > 40
        array.shift(pvHi)

if showEQ and not na(pl)
    bool found = false
    bool relFound = false
    float matched = na
    float relMatched = na
    int ls = array.size(pvLo)
    if ls > 0
        int start = math.max(ls - eqLookback, 0)
        for qi = start to ls - 1
            float prevL = array.get(pvLo, qi)
            float d = math.abs(pl - prevL)
            if d <= eqTolPrice
                found := true
                matched := math.min(pl, prevL)
            else if showRelEQ and d <= relEqTolPrice
                relFound := true
                relMatched := math.min(pl, prevL)
    if found
        array.push(eqLoA, matched)
        array.push(eqLoB, bar_index - swingLen)
    else if relFound
        array.push(reqLoA, relMatched)
        array.push(reqLoB, bar_index - swingLen)
    array.push(pvLo, pl)
    while array.size(pvLo) > 40
        array.shift(pvLo)

if array.size(eqHiA) > 0
    int i = 0
    while i < array.size(eqHiA)
        if removeSwept and high > array.get(eqHiA, i)
            array.remove(eqHiA, i)
            array.remove(eqHiB, i)
        else
            i += 1
if array.size(eqLoA) > 0
    int i = 0
    while i < array.size(eqLoA)
        if removeSwept and low < array.get(eqLoA, i)
            array.remove(eqLoA, i)
            array.remove(eqLoB, i)
        else
            i += 1
while array.size(eqHiA) > swingHist
    array.shift(eqHiA)
    array.shift(eqHiB)
while array.size(eqLoA) > swingHist
    array.shift(eqLoA)
    array.shift(eqLoB)
// relative-EQ maintenance (sweep removal + size cap), mirroring exact EQ
if array.size(reqHiA) > 0
    int i = 0
    while i < array.size(reqHiA)
        if removeSwept and high > array.get(reqHiA, i)
            array.remove(reqHiA, i)
            array.remove(reqHiB, i)
        else
            i += 1
if array.size(reqLoA) > 0
    int i = 0
    while i < array.size(reqLoA)
        if removeSwept and low < array.get(reqLoA, i)
            array.remove(reqLoA, i)
            array.remove(reqLoB, i)
        else
            i += 1
while array.size(reqHiA) > swingHist
    array.shift(reqHiA)
    array.shift(reqHiB)
while array.size(reqLoA) > swingHist
    array.shift(reqLoA)
    array.shift(reqLoB)

// -----------------------------------------------------------------------------
// BIRTH-BAR TRACKING (for age-scaled extension)
// -----------------------------------------------------------------------------
var int b_pdh = na, var int b_pdl = na
var int b_pwh = na, var int b_pwl = na
var int b_pmh = na, var int b_pml = na
var int b_do  = na
var int b_wo  = na, var int b_mo = na, var int b_mid = na
var int b_ah  = na, var int b_al = na
var int b_lh  = na, var int b_ll = na
var int b_nh  = na, var int b_nl = na
b_pdh := (na(b_pdh) or pdh != pdh[1]) ? bar_index : b_pdh
b_pdl := (na(b_pdl) or pdl != pdl[1]) ? bar_index : b_pdl
b_pwh := (na(b_pwh) or pwh != pwh[1]) ? bar_index : b_pwh
b_pwl := (na(b_pwl) or pwl != pwl[1]) ? bar_index : b_pwl
b_pmh := (na(b_pmh) or pmh != pmh[1]) ? bar_index : b_pmh
b_pml := (na(b_pml) or pml != pml[1]) ? bar_index : b_pml
b_do  := (na(b_do)  or dOpen != dOpen[1]) ? bar_index : b_do
b_wo  := (na(b_wo)  or wOpen != wOpen[1]) ? bar_index : b_wo
b_mo  := (na(b_mo)  or mOpen != mOpen[1]) ? bar_index : b_mo
b_mid := (na(b_mid) or midO  != midO[1])  ? bar_index : b_mid
b_ah  := (na(b_ah)  or asiaH != asiaH[1]) ? bar_index : b_ah
b_al  := (na(b_al)  or asiaL != asiaL[1]) ? bar_index : b_al
b_lh  := (na(b_lh)  or londH != londH[1]) ? bar_index : b_lh
b_ll  := (na(b_ll)  or londL != londL[1]) ? bar_index : b_ll
b_nh  := (na(b_nh)  or nyH != nyH[1]) ? bar_index : b_nh
b_nl  := (na(b_nl)  or nyL != nyL[1]) ? bar_index : b_nl

// -----------------------------------------------------------------------------
// SWEEP MASKING for previous-period levels
// -----------------------------------------------------------------------------
var bool sw_pdh = false, var bool sw_pdl = false
var bool sw_pwh = false, var bool sw_pwl = false
var bool sw_pmh = false, var bool sw_pml = false
sw_pdh := (pdh != pdh[1]) ? false : (sw_pdh or (not na(pdh) and high > pdh))
sw_pdl := (pdl != pdl[1]) ? false : (sw_pdl or (not na(pdl) and low  < pdl))
sw_pwh := (pwh != pwh[1]) ? false : (sw_pwh or (not na(pwh) and high > pwh))
sw_pwl := (pwl != pwl[1]) ? false : (sw_pwl or (not na(pwl) and low  < pwl))
sw_pmh := (pmh != pmh[1]) ? false : (sw_pmh or (not na(pmh) and high > pmh))
sw_pml := (pml != pml[1]) ? false : (sw_pml or (not na(pml) and low  < pml))
pdhM = (removeSwept and sw_pdh) ? na : pdh
pdlM = (removeSwept and sw_pdl) ? na : pdl
pwhM = (removeSwept and sw_pwh) ? na : pwh
pwlM = (removeSwept and sw_pwl) ? na : pwl
pmhM = (removeSwept and sw_pmh) ? na : pmh
pmlM = (removeSwept and sw_pml) ? na : pml

// -----------------------------------------------------------------------------
// GHOST LEVELS — robust, self-contained per-bar capture.
// Independent of removeSwept / SFP / pivot timing (the reason the old version
// never showed). Build the set of currently-tracked levels each bar; the instant
// THIS bar's high/low crosses one (prev bar not already beyond), record a ghost.
// De-duped by price so a level ghosts only once while it stays swept.
// -----------------------------------------------------------------------------
var ghostP   = array.new<float>()   // price where liquidity was taken
var ghostBar = array.new<int>()     // bar it was swept
if showGhost
    gHiNow = array.new<float>()
    gLoNow = array.new<float>()
    if showPDHL and not na(pdh)
        array.push(gHiNow, pdh)
    if showPDHL and not na(pdl)
        array.push(gLoNow, pdl)
    if showPWHL and not na(pwh)
        array.push(gHiNow, pwh)
    if showPWHL and not na(pwl)
        array.push(gLoNow, pwl)
    if showPMHL and not na(pmh)
        array.push(gHiNow, pmh)
    if showPMHL and not na(pml)
        array.push(gLoNow, pml)
    if showAsia and not na(asiaH)
        array.push(gHiNow, asiaH)
    if showAsia and not na(asiaL)
        array.push(gLoNow, asiaL)
    if showLond and not na(londH)
        array.push(gHiNow, londH)
    if showLond and not na(londL)
        array.push(gLoNow, londL)
    if showNY and not na(nyH)
        array.push(gHiNow, nyH)
    if showNY and not na(nyL)
        array.push(gLoNow, nyL)
    if showSwing and array.size(swHi) > 0
        for gsi = 0 to array.size(swHi) - 1
            array.push(gHiNow, array.get(swHi, gsi))
    if showSwing and array.size(swLo) > 0
        for gsi = 0 to array.size(swLo) - 1
            array.push(gLoNow, array.get(swLo, gsi))
    if showEQ and array.size(eqHiA) > 0
        for gei = 0 to array.size(eqHiA) - 1
            array.push(gHiNow, array.get(eqHiA, gei))
    if showEQ and array.size(eqLoA) > 0
        for gei = 0 to array.size(eqLoA) - 1
            array.push(gLoNow, array.get(eqLoA, gei))
    float gTol = math.max(nz(atr) * 0.05, syminfo.mintick)
    if array.size(gHiNow) > 0
        for gi = 0 to array.size(gHiNow) - 1
            float lv = array.get(gHiNow, gi)
            if high >= lv and high[1] < lv
                bool dup = false
                if array.size(ghostP) > 0
                    for dj = 0 to array.size(ghostP) - 1
                        if math.abs(array.get(ghostP, dj) - lv) <= gTol
                            dup := true
                if not dup
                    array.push(ghostP, lv)
                    array.push(ghostBar, bar_index)
    if array.size(gLoNow) > 0
        for gi = 0 to array.size(gLoNow) - 1
            float lv = array.get(gLoNow, gi)
            if low <= lv and low[1] > lv
                bool dup = false
                if array.size(ghostP) > 0
                    for dj = 0 to array.size(ghostP) - 1
                        if math.abs(array.get(ghostP, dj) - lv) <= gTol
                            dup := true
                if not dup
                    array.push(ghostP, lv)
                    array.push(ghostBar, bar_index)

// ghost expiry (older than lifetime) + cap
if array.size(ghostP) > 0
    int gj = 0
    while gj < array.size(ghostP)
        if bar_index - array.get(ghostBar, gj) > ghostLife
            array.remove(ghostP, gj)
            array.remove(ghostBar, gj)
        else
            gj += 1
while array.size(ghostP) > ghostKeep
    array.shift(ghostP)
    array.shift(ghostBar)

// -----------------------------------------------------------------------------
// SFP (sweep + reversal) DETECTION
// -----------------------------------------------------------------------------
lvHiNow = array.new<float>()
lvLoNow = array.new<float>()
if showSFP
    if not na(pdhM)
        array.push(lvHiNow, pdhM)
    if not na(pwhM)
        array.push(lvHiNow, pwhM)
    if not na(pmhM)
        array.push(lvHiNow, pmhM)
    if not na(pdlM)
        array.push(lvLoNow, pdlM)
    if not na(pwlM)
        array.push(lvLoNow, pwlM)
    if not na(pmlM)
        array.push(lvLoNow, pmlM)
    if not na(asiaH)
        array.push(lvHiNow, asiaH)
    if not na(londH)
        array.push(lvHiNow, londH)
    if not na(nyH)
        array.push(lvHiNow, nyH)
    if not na(asiaL)
        array.push(lvLoNow, asiaL)
    if not na(londL)
        array.push(lvLoNow, londL)
    if not na(nyL)
        array.push(lvLoNow, nyL)
    if array.size(swHi) > 0
        for si = 0 to array.size(swHi) - 1
            array.push(lvHiNow, array.get(swHi, si))
    if array.size(swLo) > 0
        for si = 0 to array.size(swLo) - 1
            array.push(lvLoNow, array.get(swLo, si))
    if array.size(eqHiA) > 0
        for si = 0 to array.size(eqHiA) - 1
            array.push(lvHiNow, array.get(eqHiA, si))
    if array.size(eqLoA) > 0
        for si = 0 to array.size(eqLoA) - 1
            array.push(lvLoNow, array.get(eqLoA, si))

float sweptHiLvl = na
float sweptLoLvl = na
if showSFP and array.size(lvHiNow) > 0
    for si = 0 to array.size(lvHiNow) - 1
        float lv = array.get(lvHiNow, si)
        if high > lv and close < lv
            if na(sweptHiLvl) or lv > sweptHiLvl
                sweptHiLvl := lv
if showSFP and array.size(lvLoNow) > 0
    for si = 0 to array.size(lvLoNow) - 1
        float lv = array.get(lvLoNow, si)
        if low < lv and close > lv
            if na(sweptLoLvl) or lv < sweptLoLvl
                sweptLoLvl := lv

bool sfpShort = showSFP and not na(sweptHiLvl) and volOK
bool sfpLong  = showSFP and not na(sweptLoLvl) and volOK

// -----------------------------------------------------------------------------
// TESTED-STATE CAPTURE — a wick PROBES a level (enters within depth×ATR) but does NOT
// sweep through it. Recorded persistently by price (deduped/capped), independent of the
// per-bar level rebuild. Fully-swept levels are removed elsewhere, so this is the
// "touched but still standing" middle state.
// -----------------------------------------------------------------------------
if showTested
    float tDepth = math.max(nz(atr) * testDepthATR, syminfo.mintick)
    float tDedup = math.max(nz(atr) * 0.05, syminfo.mintick)
    tHiNow = array.new<float>()
    tLoNow = array.new<float>()
    if not na(pdhM)
        array.push(tHiNow, pdhM)
    if not na(pwhM)
        array.push(tHiNow, pwhM)
    if not na(pmhM)
        array.push(tHiNow, pmhM)
    if not na(pdlM)
        array.push(tLoNow, pdlM)
    if not na(pwlM)
        array.push(tLoNow, pwlM)
    if not na(pmlM)
        array.push(tLoNow, pmlM)
    if not na(asiaH)
        array.push(tHiNow, asiaH)
    if not na(londH)
        array.push(tHiNow, londH)
    if not na(nyH)
        array.push(tHiNow, nyH)
    if not na(asiaL)
        array.push(tLoNow, asiaL)
    if not na(londL)
        array.push(tLoNow, londL)
    if not na(nyL)
        array.push(tLoNow, nyL)
    if array.size(swHi) > 0
        for si = 0 to array.size(swHi) - 1
            array.push(tHiNow, array.get(swHi, si))
    if array.size(swLo) > 0
        for si = 0 to array.size(swLo) - 1
            array.push(tLoNow, array.get(swLo, si))
    if array.size(eqHiA) > 0
        for si = 0 to array.size(eqHiA) - 1
            array.push(tHiNow, array.get(eqHiA, si))
    if array.size(eqLoA) > 0
        for si = 0 to array.size(eqLoA) - 1
            array.push(tLoNow, array.get(eqLoA, si))
    // highs: wick pokes up to within tDepth BELOW the level but doesn't reach it (no sweep)
    if array.size(tHiNow) > 0
        for si = 0 to array.size(tHiNow) - 1
            float lv = array.get(tHiNow, si)
            if high >= lv - tDepth and high < lv
                bool dup = false
                if array.size(testedP) > 0
                    for dj = 0 to array.size(testedP) - 1
                        if math.abs(array.get(testedP, dj) - lv) <= tDedup
                            dup := true
                if not dup
                    array.push(testedP, lv)
    // lows: wick pokes down to within tDepth ABOVE the level but doesn't reach it
    if array.size(tLoNow) > 0
        for si = 0 to array.size(tLoNow) - 1
            float lv = array.get(tLoNow, si)
            if low <= lv + tDepth and low > lv
                bool dup = false
                if array.size(testedP) > 0
                    for dj = 0 to array.size(testedP) - 1
                        if math.abs(array.get(testedP, dj) - lv) <= tDedup
                            dup := true
                if not dup
                    array.push(testedP, lv)
    // cap (oldest dropped first)
    while array.size(testedP) > testKeep
        array.shift(testedP)

// signal markers — capped rolling pool so they never exhaust the label budget
var mk_labels = array.new<label>()
f_mark(int x, float y, string txt, string yl, string stl, color col, color tcol, string sz) =>
    label lb = label.new(x, y, txt, yloc = yl, style = stl, color = col, textcolor = tcol, size = sz)
    array.push(mk_labels, lb)
    while array.size(mk_labels) > 120
        label.delete(array.shift(mk_labels))

if masterOn and sfpLong
    f_mark(bar_index, low, "🎯 SFP▲" + (sfpUseVol ? " " + str.tostring(rvol, "#.0") + "x" : ""), yloc.belowbar, label.style_label_up, sfpColLong, color.white, size.small)
if masterOn and sfpShort
    f_mark(bar_index, high, "🎯 SFP▼" + (sfpUseVol ? " " + str.tostring(rvol, "#.0") + "x" : ""), yloc.abovebar, label.style_label_down, sfpColShort, color.white, size.small)

// -----------------------------------------------------------------------------
// ORDER BLOCKS
// -----------------------------------------------------------------------------
float bodySize = math.abs(close - open)
bool  disp     = bodySize >= obDisp * nz(atr)
var obTop  = array.new<float>()
var obBot  = array.new<float>()
var obBull = array.new<bool>()
var obBirth = array.new<int>()
// breaker blocks: a violated OB with flipped polarity (former demand -> supply, etc.)
var brkTop  = array.new<float>()
var brkBot  = array.new<float>()
var brkBull = array.new<bool>()   // polarity AFTER the flip
var brkBirth = array.new<int>()
if showOB and disp and close > open and (sfpLong or (close > high[1]))
    array.push(obTop, high[1])
    array.push(obBot, low[1])
    array.push(obBull, true)
    array.push(obBirth, bar_index - 1)
if showOB and disp and close < open and (sfpShort or (close < low[1]))
    array.push(obTop, high[1])
    array.push(obBot, low[1])
    array.push(obBull, false)
    array.push(obBirth, bar_index - 1)
if array.size(obTop) > 0
    int oi = 0
    while oi < array.size(obTop)
        bool bull = array.get(obBull, oi)
        bool dead = bull ? (close < array.get(obBot, oi)) : (close > array.get(obTop, oi))
        if dead
            // on violation, convert to a breaker with flipped polarity (if enabled)
            if showBreaker
                array.push(brkTop, array.get(obTop, oi))
                array.push(brkBot, array.get(obBot, oi))
                array.push(brkBull, not bull)
                array.push(brkBirth, bar_index)
            array.remove(obTop, oi)
            array.remove(obBot, oi)
            array.remove(obBull, oi)
            array.remove(obBirth, oi)
        else
            oi += 1
while array.size(obTop) > obKeep
    array.shift(obTop)
    array.shift(obBot)
    array.shift(obBull)
    array.shift(obBirth)
// breaker maintenance: a breaker dies when price closes back through it (opposite of OB)
if array.size(brkTop) > 0
    int bi = 0
    while bi < array.size(brkTop)
        bool bbull = array.get(brkBull, bi)
        bool bdead = bbull ? (close < array.get(brkBot, bi)) : (close > array.get(brkTop, bi))
        if bdead
            array.remove(brkTop, bi)
            array.remove(brkBot, bi)
            array.remove(brkBull, bi)
            array.remove(brkBirth, bi)
        else
            bi += 1
while array.size(brkTop) > obKeep
    array.shift(brkTop)
    array.shift(brkBot)
    array.shift(brkBull)
    array.shift(brkBirth)

// -----------------------------------------------------------------------------
// COLLECT → CLUSTER → RENDER  (last bar only)
// -----------------------------------------------------------------------------
var pool_lines = array.new<line>()
var pool_labels = array.new<label>()
var pool_boxes = array.new<box>()
var xtra_boxes  = array.new<box>()
var xtra_labels = array.new<label>()
var ghost_lines = array.new<line>()
var field_boxes = array.new<box>()   // pull-field ladder cells (right edge)

f_clearGhost() =>
    while array.size(ghost_lines) > 0
        line.delete(array.pop(ghost_lines))

f_clearField() =>
    while array.size(field_boxes) > 0
        box.delete(array.pop(field_boxes))

f_clearXtra() =>
    while array.size(xtra_boxes) > 0
        box.delete(array.pop(xtra_boxes))
    while array.size(xtra_labels) > 0
        label.delete(array.pop(xtra_labels))
f_clearPools() =>
    while array.size(pool_lines) > 0
        line.delete(array.pop(pool_lines))
    while array.size(pool_labels) > 0
        label.delete(array.pop(pool_labels))
    while array.size(pool_boxes) > 0
        box.delete(array.pop(pool_boxes))

// candidate level arrays (rebuilt each last-bar pass)
var lv_price = array.new<float>()
var lv_name = array.new<string>()
var lv_col = array.new<color>()
var lv_emo = array.new<string>()
var lv_birth = array.new<int>()
var lv_side = array.new<int>()
var lv_pull = array.new<float>()   // per-level DOL pull (proximity-weighted gravity)
var lv_qual = array.new<float>()   // per-level distance-neutral magnet quality
var lv_inwin = array.new<bool>()   // is this level within the N-nearest-each-side confidence window
var lv_nomag = array.new<bool>()   // true = level draws but takes NO DOL magnet / confidence role
var lv_primary = array.new<bool>() // declutter: true = among the Top-N by confidence on its side (drawn bold)

// variant that can flag a level as "no magnet" (still drawn, but excluded from the DOL pull)
f_addLevelM(bool active, float price, string name, color col, string emo, int birthBar, int side, bool noMagnet) =>
    if masterOn and active and not na(price) and f_inCompactRange(price)
        array.push(lv_price, price)
        array.push(lv_name, name)
        array.push(lv_col, col)
        array.push(lv_emo, emo)
        array.push(lv_birth, birthBar)
        array.push(lv_side, side)
        array.push(lv_nomag, noMagnet)

// convenience wrapper: a normal level always takes a magnet role
f_addLevel(bool active, float price, string name, color col, string emo, int birthBar, int side) =>
    f_addLevelM(active, price, name, col, emo, birthBar, side, false)

// FVG state (declared here so f_confScore + projection helpers below can read it; populated later)
var fvgBoxes  = array.new<box>()
var fvgIsBull = array.new<bool>()

// confluence score for a price band [loB..hiB]
f_confScore(float mid, float loB, float hiB, int members) =>
    float score = 0.0
    string parts = ""
    float tol = math.max(nz(atr) * 0.25, syminfo.mintick)
    score := score + math.min(members, 5) * 12.0
    if members >= 2
        parts := parts + "stack "
    float atrC = math.max(nz(atr), syminfo.mintick)
    // ORDER BLOCK — graded by zone size (displacement leaves bigger blocks) + freshness,
    // instead of a flat flag. Take the STRONGEST overlapping OB (not a sum).
    float obBest = 0.0
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if hiB >= ob and loB <= ot
                float sizeW = math.min((ot - ob) / atrC, 1.5) / 1.5      // 0..1 by zone size vs ATR
                float freshW = 1.0 - math.min(math.max(0.0, bar_index - array.get(obBirth, oi)) / 60.0, 1.0)  // 1 fresh -> 0 old
                float obStr = 12.0 + sizeW * 10.0 + freshW * 4.0          // 12 .. 26
                obBest := math.max(obBest, obStr)
    if obBest > 0
        score := score + obBest
        parts := parts + (obBest >= 20.0 ? "OB+ " : "OB ")
    // FAIR VALUE GAP — now folded into confluence, graded by gap size vs ATR. An unfilled
    // gap overlapping the level adds real weight (was previously ignored in scoring).
    float fvgBest = 0.0
    if array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if hiB >= fb and loB <= ft
                float gapW = math.min(math.abs(ft - fb) / atrC, 1.0)      // 0..1 by gap size vs ATR
                float fvgStr = 8.0 + gapW * 8.0                            // 8 .. 16
                fvgBest := math.max(fvgBest, fvgStr)
    if fvgBest > 0
        score := score + fvgBest
        parts := parts + (fvgBest >= 13.0 ? "FVG+ " : "FVG ")
    // OTE fib proximity + premium/discount extreme (from the live dealing range).
    // Computed internally for scoring only - the P/D fibs are NOT drawn on chart.
    if not na(rngHi) and not na(rngLo) and rngHi > rngLo
        float rng = rngHi - rngLo
        bool bullLeg = rangeDir >= 0
        f1 = bullLeg ? (rngHi - pdFib1 * rng) : (rngLo + pdFib1 * rng)
        f2 = bullLeg ? (rngHi - pdFib2 * rng) : (rngLo + pdFib2 * rng)
        f3 = bullLeg ? (rngHi - pdFib3 * rng) : (rngLo + pdFib3 * rng)
        bool fibHit = (math.abs(mid - f1) <= tol) or (math.abs(mid - f2) <= tol) or (math.abs(mid - f3) <= tol)
        if fibHit
            score := score + 18.0
            parts := parts + "OTE "
        float pos = (mid - rngLo) / rng
        if pos >= 0.75 or pos <= 0.25
            score := score + 8.0
            parts := parts + (pos >= 0.75 ? "prem " : "disc ")
    if confRound > 0
        float nearest = math.round(mid / confRound) * confRound
        if math.abs(mid - nearest) <= tol
            score := score + 10.0
            parts := parts + "round "
    // VWAP proximity — a defended fair-value reference (scoring factor only)
    if confVWAP and not na(vwapVal) and math.abs(mid - vwapVal) <= tol
        score := score + 10.0
        parts := parts + "VWAP "
    // breaker block overlap — flipped OB, strong reaction zone
    if showBreaker and array.size(brkTop) > 0
        bool brkHit = false
        for bri = 0 to array.size(brkTop) - 1
            if hiB >= array.get(brkBot, bri) and loB <= array.get(brkTop, bri)
                brkHit := true
        if brkHit
            score := score + 14.0
            parts := parts + "brk "
    int s = int(math.min(math.round(score), 100))
    [s, parts]

// ---- per-level DOL pull + magnet-quality (accuracy pass) ----
// Two scores are produced from the same weights:
//   • pull  = distance-decay(#2) × type × age × freshness(#3) × confluence(#1)
//             — proximity dominates. Drives the DOL arrow/bias and the 🎯 magnet.
//   • qual  = type × age × freshness × confluence  (distance REMOVED)
//             — "how strong a magnet is this for its distance". Drives the
//             per-level confidence % in Magnet-quality mode, so a far but heavy
//             pool can out-score a near lone level.
// f_pull returns [pull, qual]; callers pick which to display.
f_pull(float pk, string nk, int bk, float sensK, float atrU) =>
    float dist = math.abs(pk - close)
    // sharper decay so the NEAREST pool dominates (dolNearBias raises the exponent)
    float distW = math.pow(1.0 / (1.0 + sensK * (dist / atrU)), 1.0 + dolNearBias)
    // type weight — EQ (engineered liquidity) now ranks at the TOP with monthly/HTF
    float typeW = 1.0
    if dolUseType
        if str.contains(nk, "rEQ")
            typeW := 1.7                 // relative (near) equal H/L — softer than exact EQ
        else if str.contains(nk, "EQ")
            typeW := 2.4                 // exact equal H/L — engineered liquidity, top
        else if str.contains(nk, "PMH") or str.contains(nk, "PML")
            typeW := 2.2
        else if str.contains(nk, "POC")
            typeW := 2.1                 // volume point of control — heavy acceptance
        else if str.contains(nk, "PWH") or str.contains(nk, "PWL")
            typeW := 1.9
        else if str.contains(nk, "M.Open") or str.contains(nk, "W.Open")
            typeW := 1.8                 // monthly / weekly opens — institutional refs
        else if str.contains(nk, "VAH") or str.contains(nk, "VAL")
            typeW := 1.7                 // value-area edges
        else if str.contains(nk, "Breaker")
            typeW := 1.7                 // flipped OB — strong reaction zone
        else if str.contains(nk, "PDH") or str.contains(nk, "PDL")
            typeW := 1.6
        else if str.contains(nk, "Midnight")
            typeW := 1.4                 // NY midnight open
        else if str.contains(nk, "London") or str.contains(nk, "NY") or str.contains(nk, "Asia")
            typeW := 1.2
        typeW := 1.0 + (typeW - 1.0) * sensK
    // age
    float ageW = 1.0
    if dolUseAge and not na(bk)
        float ageBars = math.max(0.0, bar_index - bk)
        ageW := 1.0 + math.min(1.0, math.log(1.0 + ageBars) / 6.0) * sensK
    // freshness — discount a level price is currently sitting right on (being tested)
    float freshW = 1.0
    if dolFreshW
        freshW := dist < atrU * 0.15 ? 0.6 : 1.0
    // confluence weight — a level's own confluence score amplifies its pull
    float confW = 1.0
    if dolConfW
        [cs, cp] = f_confScore(pk, pk - atrU * 0.05, pk + atrU * 0.05, 1)
        confW := 1.0 + cs / 100.0    // 1.0 .. 2.0
    // tested discount — a level already probed is a slightly weaker magnet
    float testW = 1.0
    if testDiscount and f_isTested(pk, atrU)
        testW := 1.0 - testDiscAmt
    float qual = typeW * ageW * freshW * confW * testW   // distance-neutral magnet quality
    float pull = distW * qual                             // proximity-weighted gravity
    [pull, qual]


// ---- projection helpers (reuse OB/FVG/level state; no new data feeds) ----
// Path-clearance: 0..100 for how UNOBSTRUCTED the route from price -> target is.
// Every opposing order block / FVG / strong level strictly between the two prices
// is an obstacle that cuts the score. A clear runway ≈ 100; a blocked path ≈ low.
f_pathClear(float fromP, float toP, float atrU) =>
    float lo = math.min(fromP, toP)
    float hi = math.max(fromP, toP)
    float pad = atrU * 0.05
    int obstacles = 0
    // order blocks whose zone falls between price and target
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            float ot = array.get(obTop, oi)
            float ob = array.get(obBot, oi)
            if ot >= lo - pad and ob <= hi + pad and not (ot >= hi and ob >= hi) and not (ot <= lo and ob <= lo)
                obstacles := obstacles + 1
    // fair value gaps between price and target
    if array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if ft >= lo - pad and fb <= hi + pad
                obstacles := obstacles + 1
    float clr = 100.0 * math.pow(0.72, projClearW * obstacles)
    [math.round(clr), obstacles]

// ETA to a target price from recent velocity (independent of the countdown toggle so the
// projETA switch works on its own). Formats per the Countdown units setting.
f_eta(float target) =>
    string outTxt = ""
    if nz(velocity) > 0 and not na(target)
        float bars = math.abs(target - close) / velocity
        if cdMode == "Bars"
            outTxt := " ⏱≈" + str.tostring(math.round(bars)) + "b"
        else
            float secs = bars * secPerBar
            outTxt := secs < 3600 ? (" ⏱≈" + str.tostring(math.round(secs / 60)) + "m") : (secs < 86400 ? (" ⏱≈" + str.tostring(math.round(secs / 3600)) + "h") : (" ⏱≈" + str.tostring(math.round(secs / 86400)) + "d"))
    outTxt

// Confidence momentum: remember each level's confidence % keyed by rounded price so we
// can show ▲/▼ vs the previous bar. Two maps: *_prev is last bar's snapshot (read from),
// *_now is this bar's fresh values (written to); they swap at the end of the last-bar block.
var cm_keysPrev = array.new<float>()
var cm_valsPrev = array.new<float>()
var cm_keysNow  = array.new<float>()
var cm_valsNow  = array.new<float>()
f_cmKey(float p, float atrU) =>
    math.round(p / math.max(atrU * 0.1, syminfo.mintick))
f_cmPrev(float p, float atrU) =>
    float k = f_cmKey(p, atrU)
    float found = na
    if array.size(cm_keysPrev) > 0
        for ci = 0 to array.size(cm_keysPrev) - 1
            if array.get(cm_keysPrev, ci) == k
                found := array.get(cm_valsPrev, ci)
    found
f_cmStore(float p, float atrU, float confPct) =>
    array.push(cm_keysNow, f_cmKey(p, atrU))
    array.push(cm_valsNow, confPct)
    0

// Stacked agreement: does a price band overlap an order block OR an FVG?
f_hasOBFVG(float loB, float hiB) =>
    bool hit = false
    if array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            if hiB >= array.get(obBot, oi) and loB <= array.get(obTop, oi)
                hit := true
    if not hit and array.size(fvgBoxes) > 0
        for fi = 0 to array.size(fvgBoxes) - 1
            float ft = box.get_top(array.get(fvgBoxes, fi))
            float fb = box.get_bottom(array.get(fvgBoxes, fi))
            if hiB >= fb and loB <= ft
                hit := true
    hit

// ---- DOL gravity tally + shared direction (last bar) ----
if barstate.islast
    f_clearPools()
    array.clear(lv_price)
    array.clear(lv_name)
    array.clear(lv_col)
    array.clear(lv_emo)
    array.clear(lv_birth)
    array.clear(lv_side)
    array.clear(lv_pull)
    array.clear(lv_qual)
    array.clear(lv_inwin)
    array.clear(lv_nomag)
    array.clear(lv_primary)
    array.clear(cm_keysNow)          // fresh confidence-momentum snapshot this bar
    array.clear(cm_valsNow)

    f_addLevel(showPDHL, pdhM,   "PDH",     colBull, emoPrev, b_pdh,  1)
    f_addLevel(showPDHL, pdlM,   "PDL",     colBear, emoPrev, b_pdl, -1)
    f_addLevel(showPWHL, pwhM,   "PWH",     colBull, emoPrev, b_pwh,  1)
    f_addLevel(showPWHL, pwlM,   "PWL",     colBear, emoPrev, b_pwl, -1)
    f_addLevel(showPMHL, pmhM,   "PMH",     colBull, emoPrev, b_pmh,  1)
    f_addLevel(showPMHL, pmlM,   "PML",     colBear, emoPrev, b_pml, -1)
    f_addLevel(showDO,   dOpen,  "D.Open",  colSess, emoPrev, b_do,   0)
    f_addLevel(showWO,   wOpen,  "W.Open",  colSess, emoPrev, b_wo,   0)
    f_addLevel(showMO,   mOpen,  "M.Open",  colSess, emoPrev, b_mo,   0)
    f_addLevel(showMidO, midO,   "Midnight",colSess, emoPrev, b_mid,  0)
    f_addLevelM(showAsia, asiaH,  f_sessName("Asia H", asiaHc),   colSess, emoSess, b_ah,   1, projLiveSess and asiaHf)
    f_addLevelM(showAsia, asiaL,  f_sessName("Asia L", asiaLc),   colSess, emoSess, b_al,  -1, projLiveSess and asiaLf)
    f_addLevelM(showLond, londH,  f_sessName("London H", londHc), colSess, emoSess, b_lh,   1, projLiveSess and londHf)
    f_addLevelM(showLond, londL,  f_sessName("London L", londLc), colSess, emoSess, b_ll,  -1, projLiveSess and londLf)
    f_addLevelM(showNY,   nyH,    f_sessName("NY H", nyHc),       colSess, emoSess, b_nh,   1, projLiveSess and nyHf)
    f_addLevelM(showNY,   nyL,    f_sessName("NY L", nyLc),       colSess, emoSess, b_nl,  -1, projLiveSess and nyLf)
    if showSwing
        if array.size(swHi) > 0
            for si = 0 to array.size(swHi) - 1
                f_addLevel(true, array.get(swHi, si), "BSL", colBull, emoLiq, array.get(swHiB, si), 1)
        if array.size(swLo) > 0
            for si = 0 to array.size(swLo) - 1
                f_addLevel(true, array.get(swLo, si), "SSL", colBear, emoLiq, array.get(swLoB, si), -1)
    if showEQ
        if array.size(eqHiA) > 0
            for ei = 0 to array.size(eqHiA) - 1
                f_addLevel(true, array.get(eqHiA, ei), "EQH", colBull, emoLiq, array.get(eqHiB, ei), 1)
        if array.size(eqLoA) > 0
            for ei = 0 to array.size(eqLoA) - 1
                f_addLevel(true, array.get(eqLoA, ei), "EQL", colBear, emoLiq, array.get(eqLoB, ei), -1)
    if showEQ and showRelEQ
        if array.size(reqHiA) > 0
            for ei = 0 to array.size(reqHiA) - 1
                f_addLevel(true, array.get(reqHiA, ei), "rEQH", colBull, emoLiq, array.get(reqHiB, ei), 1)
        if array.size(reqLoA) > 0
            for ei = 0 to array.size(reqLoA) - 1
                f_addLevel(true, array.get(reqLoA, ei), "rEQL", colBear, emoLiq, array.get(reqLoB, ei), -1)
    if showBreaker and array.size(brkTop) > 0
        for bri = 0 to array.size(brkTop) - 1
            float bmid = (array.get(brkTop, bri) + array.get(brkBot, bri)) / 2.0
            bool  bbl  = array.get(brkBull, bri)
            f_addLevel(true, bmid, bbl ? "Breaker▲" : "Breaker▼", bbl ? colBull : colBear, emoLiq, array.get(brkBirth, bri), bbl ? 1 : -1)
    if showVP
        f_addLevel(not na(vpPOC), vpPOC, "POC", colZone, emoPrev, na, 0)
        f_addLevel(not na(vpVAH), vpVAH, "VAH", colZone, emoPrev, na, 1)
        f_addLevel(not na(vpVAL), vpVAL, "VAL", colZone, emoPrev, na, -1)

    // ---- DOL gravity: pull = distance x type x age, per side ----
    float bslStrength = 0.0
    float sslStrength = 0.0
    float bslTopPull  = 0.0
    float sslTopPull  = 0.0
    float bslTopPrice = na
    float sslTopPrice = na
    int nl = array.size(lv_price)
    float totalPull = 0.0
    float totalQual = 0.0
    if nl > 0
        float sensK = dolSens == "High" ? 2.0 : dolSens == "Low" ? 0.5 : 1.0
        float atrU  = math.max(nz(atr), syminfo.mintick)
        // pass 1: pull/qual per level + DOL bias & 🎯 magnet.
        // Excluded levels (forming session extreme, or hugging price under the distance
        // floor) still DRAW but contribute zero pull/qual — they take no magnet, no bias
        // tilt, and no confidence %, so a level price is sitting on can't inflate the score.
        for k = 0 to nl - 1
            float pk = array.get(lv_price, k)
            string nk = array.get(lv_name, k)
            int   bk = array.get(lv_birth, k)
            bool  floorHit = projDistFloor and projDistFloorATR > 0 and (math.abs(pk - close) < projDistFloorATR * atrU)
            bool  excl = array.get(lv_nomag, k) or floorHit
            array.set(lv_nomag, k, excl)   // fold the dynamic floor in so pass 2 + render can read it
            [rawPull, rawQual] = f_pull(pk, nk, bk, sensK, atrU)
            float pull = excl ? 0.0 : rawPull
            float qual = excl ? 0.0 : rawQual
            array.push(lv_pull, pull)
            array.push(lv_qual, qual)
            array.push(lv_inwin, false)
            array.push(lv_primary, false)
            if not excl
                if pk >= close
                    bslStrength := bslStrength + pull
                    if pull > bslTopPull
                        bslTopPull  := pull
                        bslTopPrice := pk
                else
                    sslStrength := sslStrength + pull
                    if pull > sslTopPull
                        sslTopPull  := pull
                        sslTopPrice := pk
        // pass 2: confidence window — mark the N nearest levels ABOVE and N BELOW price.
        // A level is in-window if fewer than N same-side levels sit strictly nearer to price.
        for k = 0 to nl - 1
            // excluded levels take no window slot and don't crowd out real levels
            if not array.get(lv_nomag, k)
                float pk = array.get(lv_price, k)
                bool  above = pk >= close
                float dk = math.abs(pk - close)
                int nearer = 0
                for j = 0 to nl - 1
                    if j != k and not array.get(lv_nomag, j)
                        float pj = array.get(lv_price, j)
                        bool  aboveJ = pj >= close
                        if aboveJ == above and math.abs(pj - close) < dk
                            nearer := nearer + 1
                if nearer < lvlConfWin
                    array.set(lv_inwin, k, true)
                    totalPull := totalPull + array.get(lv_pull, k)
                    totalQual := totalQual + array.get(lv_qual, k)
        // pass 2b: declutter rank — mark the Top-N by confidence on each side as PRIMARY
        // (bold). A level is primary if fewer than eTopN same-side levels have higher
        // confidence. Below-Top-N or below the gate levels are drawn faintly at render.
        bool useQualR = lvlConfMode == "Magnet quality"
        for k = 0 to nl - 1
            if not array.get(lv_nomag, k)
                float pk = array.get(lv_price, k)
                bool  above = pk >= close
                float ck = useQualR ? array.get(lv_qual, k) : array.get(lv_pull, k)
                int stronger = 0
                for j = 0 to nl - 1
                    if j != k and not array.get(lv_nomag, j)
                        float pj = array.get(lv_price, j)
                        bool  aboveJ = pj >= close
                        float cj = useQualR ? array.get(lv_qual, j) : array.get(lv_pull, j)
                        if aboveJ == above and cj > ck
                            stronger := stronger + 1
                if stronger < eTopN
                    array.set(lv_primary, k, true)

    // ---- landscape cap: stop ONE hugging level from dominating its side ----
    // Distance decay makes the nearest level's pull huge, so a single level price is sitting
    // next to can out-weigh a whole cluster on the other side and flip the bias. Clamp each
    // level's contribution to biasCap × its side's raw total, so the bias reflects the mass /
    // cluster of levels (the liquidity landscape) rather than one proximity outlier.
    // The 🎯 magnet (bslTopPull/sslTopPull) is untouched — proximity read stays available.
    if biasCap < 1.0 and nl > 0
        float bslCapAbs = bslStrength * biasCap
        float sslCapAbs = sslStrength * biasCap
        float bslCapped = 0.0
        float sslCapped = 0.0
        for k = 0 to nl - 1
            if not array.get(lv_nomag, k)
                float pk2 = array.get(lv_price, k)
                float p2  = array.get(lv_pull, k)
                if pk2 >= close
                    bslCapped := bslCapped + math.min(p2, bslCapAbs)
                else
                    sslCapped := sslCapped + math.min(p2, sslCapAbs)
        bslStrength := bslCapped
        sslStrength := sslCapped

    // ---- resistance-adjusted (clearance-weighted) draw ----
    // Each side's EFFECTIVE pull = raw draw × how clear the path to that side's magnet is.
    // Structure in the way (OBs / FVGs) discounts a side; it never adds to the other side.
    float atrR   = math.max(nz(atr), syminfo.mintick)
    float upClr  = 100.0
    float dnClr  = 100.0
    if projResist
        if not na(bslTopPrice)
            [uc, uo] = f_pathClear(close, bslTopPrice, atrR)
            upClr := uc
        if not na(sslTopPrice)
            [dc, doo] = f_pathClear(close, sslTopPrice, atrR)
            dnClr := dc
    float bslEff = bslStrength * (projResist ? upClr / 100.0 : 1.0)
    float sslEff = sslStrength * (projResist ? dnClr / 100.0 : 1.0)

    float dm_totalG = bslEff + sslEff
    float dm_liqBias = dm_totalG > 0 ? (bslEff - sslEff) / dm_totalG : 0.0
    float dm_bias = (1.0 - dolMomWt / 100.0) * dm_liqBias + (dolMomWt / 100.0) * dolMom
    bool  dolDrawUp = dm_bias >= 0
    float dolTgt = dolDrawUp ? bslTopPrice : sslTopPrice
    // single MOST-LIKELY target = the level with the greatest pull overall
    float topPullPrice = bslTopPull >= sslTopPull ? bslTopPrice : sslTopPrice

    // ---- sort + cluster + render ----
    int n = array.size(lv_price)
    if n > 0
        idx = array.new<int>()
        for i = 0 to n - 1
            array.push(idx, i)
        int idxN = array.size(idx)
        if idxN > 1
            for i = 1 to idxN - 1
                int keyIdx = array.get(idx, i)
                float keyVal = array.get(lv_price, keyIdx)
                int j = i - 1
                while j >= 0 and array.get(lv_price, array.get(idx, j)) > keyVal
                    array.set(idx, j + 1, array.get(idx, j))
                    j := j - 1
                array.set(idx, j + 1, keyIdx)

        float mergeDist = nz(atr) * clustDist
        int gi = 0
        while gi < idxN
            int startI = gi
            float sumP = array.get(lv_price, array.get(idx, gi))
            float minP = sumP
            float maxP = sumP
            int members = 1
            string names = array.get(lv_name, array.get(idx, gi))
            int oldestBirth = array.get(lv_birth, array.get(idx, gi))
            int sideSum = array.get(lv_side, array.get(idx, gi))
            // accumulate only IN-WINDOW members' pull/qual so the zone % matches the windowed normalization
            bool  zInWin  = array.get(lv_inwin, array.get(idx, gi))
            bool  zPrimary = array.get(lv_primary, array.get(idx, gi))   // declutter: any Top-N member?
            float sumPull = zInWin ? array.get(lv_pull, array.get(idx, gi)) : 0.0
            float sumQual = zInWin ? array.get(lv_qual, array.get(idx, gi)) : 0.0
            while clusterOn and gi + 1 < idxN and (array.get(lv_price, array.get(idx, gi + 1)) - array.get(lv_price, array.get(idx, gi))) <= mergeDist
                gi := gi + 1
                float p = array.get(lv_price, array.get(idx, gi))
                sumP := sumP + p
                minP := math.min(minP, p)
                maxP := math.max(maxP, p)
                members := members + 1
                names := names + "·" + array.get(lv_name, array.get(idx, gi))
                int mb = array.get(lv_birth, array.get(idx, gi))
                oldestBirth := na(oldestBirth) ? mb : (na(mb) ? oldestBirth : math.min(oldestBirth, mb))
                sideSum := sideSum + array.get(lv_side, array.get(idx, gi))
                if array.get(lv_primary, array.get(idx, gi))
                    zPrimary := true
                if array.get(lv_inwin, array.get(idx, gi))
                    zInWin  := true
                    sumPull := sumPull + array.get(lv_pull, array.get(idx, gi))
                    sumQual := sumQual + array.get(lv_qual, array.get(idx, gi))

            int ext = f_extLen(oldestBirth)
            bool drawGroup = members >= minStrength
            if drawGroup and members == 1
                float p = array.get(lv_price, array.get(idx, startI))
                int  sd = array.get(lv_side, array.get(idx, startI))
                color c = f_sideColI(sd, p, array.get(lv_col, array.get(idx, startI)))
                string emo = sideColorOn ? f_sideEmojiI(sd, p) : array.get(lv_emo, array.get(idx, startI))
                string tier = tieredEmoji ? (f_tierEmoji(1) + " ") : ""
                // per-level confidence % — Magnet quality (distance removed) or Raw pull share.
                // Only levels inside the N-nearest-each-side window get a %.
                bool useQual = lvlConfMode == "Magnet quality"
                bool lInWin = array.get(lv_inwin, array.get(idx, startI))
                float lpNum = useQual ? array.get(lv_qual, array.get(idx, startI)) : array.get(lv_pull, array.get(idx, startI))
                float lpDen = useQual ? totalQual : totalPull
                float lp = lpDen > 0 ? lpNum / lpDen * 100.0 : 0.0
                bool isTop = not na(topPullPrice) and math.abs(p - topPullPrice) <= syminfo.mintick
                float atrUt = math.max(nz(atr), syminfo.mintick)
                // confidence momentum ▲/▼ vs previous bar (feature 4)
                string momTag = ""
                if projConfMom and showLvlConf and lInWin
                    float prevC = f_cmPrev(p, atrUt)
                    momTag := na(prevC) ? "" : (lp > prevC + 0.5 ? " ▲" : (lp < prevC - 0.5 ? " ▼" : " ="))
                    f_cmStore(p, atrUt, lp)
                // stacked-agreement ⭐: DOL-side agrees + it's the magnet + overlaps OB/FVG (feature 8)
                bool sideAgree = (dolDrawUp and p >= close) or (not dolDrawUp and p < close)
                string stackTag = (projStacked and lInWin and isTop and sideAgree and f_hasOBFVG(p - atrUt * 0.05, p + atrUt * 0.05)) ? " ⭐" : ""
                string confLvlTag = (showLvlConf and lInWin) ? ((isTop ? " 🎯" : " ") + str.tostring(math.round(lp)) + "%" + momTag + stackTag) : ""
                // tested/virgin: probed levels get a ✓ + dotted, dimmed line (still standing, just 'used')
                bool lTested = f_isTested(p, atrUt)
                string testTag = (showTested and lTested) ? " ✓" : ""
                // declutter: faint if de-prioritised (beyond Top-N) or below the confidence gate
                bool lPrimary = array.get(lv_primary, array.get(idx, startI))
                bool lFaint = densOn and (not lPrimary or (lInWin and lp < eGate))
                color cLine = lFaint ? color.new(c, densFadeOp) : ((showTested and lTested) ? color.new(c, 55) : c)
                string lStyle = (lFaint or (showTested and lTested)) ? line.style_dotted : f_lineStyle()
                // faint levels shed their tags to a bare price so they recede into the background
                string full = lFaint ? (array.get(lv_name, array.get(idx, startI)) + " " + str.tostring(p, format.mintick)) : (tier + (emo == "None" ? "" : emo + " ") + array.get(lv_name, array.get(idx, startI)) + " " + str.tostring(p, format.mintick) + confLvlTag + testTag + f_countdown(p))
                line ln = line.new(bar_index, p, bar_index + ext, p, color = cLine, width = lineWidth, style = lStyle)
                color soloBg  = lFaint ? color.new(c, densFadeOp) : (outlineTags ? c : color.new(c, 85))
                color soloTxt = lFaint ? color.new(c, math.max(densFadeOp - 30, 0)) : (outlineTags ? clustLblTxt : c)
                label lb = label.new(bar_index + ext, p, full, style = label.style_label_left, color = soloBg, textcolor = soloTxt, size = f_labelSize())
                array.push(pool_lines, ln)
                array.push(pool_labels, lb)
            else if drawGroup
                float mid = sumP / members
                float t = math.min((members - 1) / 4.0, 1.0)
                int op = int(zoneOpacityMin + (zoneOpacityMax - zoneOpacityMin) * t)
                float pad = math.max(maxP - minP, nz(atr) * 0.08) / 2.0
                int domSide = sideSum > 0 ? 1 : sideSum < 0 ? -1 : 0
                color zbase = f_sideColI(domSide, mid, colZone)
                string sideTag = (showSideTag and sideColorOn) ? f_sideTagI(domSide, mid) : ""
                [confS, confParts] = f_confScore(mid, minP, maxP, members)
                if not showConf or confS >= confMin
                    float heatT = showConf ? math.min(confS / 100.0, 1.0) : 0.0
                    color zoneFillBase = color.from_gradient(heatT, 0.0, 1.0, zbase, color.new(#ffb300, 0))
                    int   heatOp = int(op - op * 0.45 * heatT)
                    color zoneFill = color.new(zoneFillBase, math.max(heatOp, 0))
                    color zoneBorder = color.from_gradient(heatT, 0.0, 1.0, color.new(zbase, 25), color.new(#ffb300, 10))
                    box bx = box.new(bar_index, mid + pad, bar_index + ext, mid - pad, border_color = zoneBorder, border_width = lineWidth, bgcolor = zoneFill)
                    string strength = showStrengthEmoji ? (f_repeat(f_sideEmojiI(domSide, mid), members) + " x" + str.tostring(members)) : ("x" + str.tostring(members))
                    string tier = tieredEmoji ? (f_tierEmoji(members) + " ") : ""
                    string confTag = showConf ? ("  ⭐" + str.tostring(confS) + (confParts == "" ? "" : " [" + confParts + "]")) : ""
                    // per-zone target-likelihood — Magnet quality (distance removed) or Raw pull share.
                    // Only zones with a member inside the N-nearest-each-side window get a %.
                    bool zUseQual = lvlConfMode == "Magnet quality"
                    float zNum = zUseQual ? sumQual : sumPull
                    float zDen = zUseQual ? totalQual : totalPull
                    float zPull = zDen > 0 ? zNum / zDen * 100.0 : 0.0
                    bool zTop = not na(topPullPrice) and topPullPrice >= minP - pad and topPullPrice <= maxP + pad
                    float atrUz = math.max(nz(atr), syminfo.mintick)
                    // confidence momentum ▲/▼ vs previous bar (feature 4)
                    string zMomTag = ""
                    if projConfMom and showLvlConf and zInWin
                        float zPrevC = f_cmPrev(mid, atrUz)
                        zMomTag := na(zPrevC) ? "" : (zPull > zPrevC + 0.5 ? " ▲" : (zPull < zPrevC - 0.5 ? " ▼" : " ="))
                        f_cmStore(mid, atrUz, zPull)
                    // stacked-agreement ⭐: DOL-side agrees + it's the magnet + zone overlaps OB/FVG (feature 8)
                    bool zSideAgree = (dolDrawUp and mid >= close) or (not dolDrawUp and mid < close)
                    string zStackTag = (projStacked and zInWin and zTop and zSideAgree and f_hasOBFVG(minP - pad, maxP + pad)) ? " ⭐" : ""
                    string lvlConfTag = (showLvlConf and zInWin) ? ((zTop ? "  🎯" : "  →") + str.tostring(math.round(zPull)) + "%" + zMomTag + zStackTag) : ""
                    // tested/virgin zone: dashed hollow border + ✓ when price has probed the zone
                    bool zTested = showTested and (f_isTested(mid, atrUz) or f_isTested(minP, atrUz) or f_isTested(maxP, atrUz))
                    if zTested
                        box.set_border_style(bx, line.style_dashed)
                        box.set_bgcolor(bx, color.new(zbase, 92))
                    string testTagZ = zTested ? "  ✓" : ""
                    // declutter: faint zone if no Top-N member OR below the confidence gate
                    bool zFaint = densOn and (not zPrimary or (zInWin and zPull < eGate))
                    if zFaint
                        box.set_border_style(bx, line.style_dotted)
                        box.set_border_color(bx, color.new(zbase, densFadeOp))
                        box.set_bgcolor(bx, color.new(zbase, math.max(densFadeOp, 90)))
                    string full = zFaint ? (names + "  " + str.tostring(mid, format.mintick)) : (tier + strength + (sideTag == "" ? "" : " " + sideTag) + "  " + names + "  " + str.tostring(mid, format.mintick) + confTag + lvlConfTag + testTagZ + f_countdown(mid))
                    color lblBg  = zFaint ? color.new(zbase, densFadeOp) : (outlineTags ? zbase : color.new(#1e222d, 10))
                    color lblTxt = zFaint ? color.new(zbase, math.max(densFadeOp - 30, 0)) : clustLblTxt
                    label lb = label.new(bar_index + ext, mid, full, style = label.style_label_left, color = lblBg, textcolor = lblTxt, size = zFaint ? size.tiny : f_strongSize(members))
                    array.push(pool_boxes, bx)
                    array.push(pool_labels, lb)
            gi := gi + 1

    // ---- Ghost levels (last bar): faint dotted lines that fade with age ----
    f_clearGhost()
    if masterOn and showGhost and array.size(ghostP) > 0
        int firstG = showGhostHist ? 0 : array.size(ghostP) - 1   // hist: all; else newest only
        for gk = firstG to array.size(ghostP) - 1
            float gp = array.get(ghostP, gk)
            int   gb = array.get(ghostBar, gk)
            if not na(gp)
                int   age = math.max(0, bar_index - gb)
                float fade = ghostLife > 0 ? (age / ghostLife) : 1.0
                int transp = int(math.min(100, ghostOpacity + (100 - ghostOpacity) * fade))
                color gc = color.new(ghostCol, transp)
                line gl = line.new(f_clampBar(gb), gp, bar_index + 3, gp, color = gc, width = 1, style = line.style_dotted)
                array.push(ghost_lines, gl)

    // ---- Order block boxes (last bar) ----
    f_clearXtra()
    if masterOn and showOB and array.size(obTop) > 0
        for oi = 0 to array.size(obTop) - 1
            bool bull = array.get(obBull, oi)
            color oc  = bull ? obColBull : obColBear
            int   ob0 = array.get(obBirth, oi)
            float obT = array.get(obTop, oi)
            float obB = array.get(obBot, oi)
            if not na(obT) and not na(obB)
                box obx = box.new(f_clampBar(ob0), obT, bar_index + extendR, obB, border_color = color.new(bull ? obColBull : obColBear, 20), border_width = 1, bgcolor = oc)
                array.push(xtra_boxes, obx)
                label olb = label.new(bar_index + extendR, (obT + obB) / 2.0, bull ? "OB▲ demand" : "OB▼ supply", style = label.style_label_left, color = color.new(bull ? obColBull : obColBear, 30), textcolor = color.white, size = size.tiny)
                array.push(xtra_labels, olb)

    // confidence-momentum: snapshot this bar's values into *_prev for next bar's ▲/▼
    array.clear(cm_keysPrev)
    array.clear(cm_valsPrev)
    if array.size(cm_keysNow) > 0
        for ci = 0 to array.size(cm_keysNow) - 1
            array.push(cm_keysPrev, array.get(cm_keysNow, ci))
            array.push(cm_valsPrev, array.get(cm_valsNow, ci))

    // ---- DOL banner ----
    if masterOn and showDOL and (bslStrength > 0 or sslStrength > 0)
        float atrU2 = math.max(nz(atr), syminfo.mintick)
        float totalG = dm_totalG
        bool drawUp = dolDrawUp
        string arrow = drawUp ? dolBull : dolBear
        // balance-aware conviction (#9): magnitude of the bias, further scaled by how
        // DECISIVE the BSL-vs-SSL split is. A near-50/50 tug-of-war reads as low
        // confidence even when the winning side's absolute pull is large.
        float dominance = totalG > 0 ? math.abs(bslEff - sslEff) / totalG : 0.0
        float conv = math.round(math.min(1.0, math.abs(dm_bias)) * (0.4 + 0.6 * dominance) * 100)
        float tgtPrice = dolTgt
        string distTxt = ""
        if not na(tgtPrice)
            float dATR = math.abs(tgtPrice - close) / atrU2
            float dPct = math.abs(tgtPrice - close) / math.max(close, syminfo.mintick) * 100.0
            distTxt := " · " + str.tostring(tgtPrice, format.mintick) + " (" + str.tostring(dATR, "#.0") + " ATR / " + str.tostring(dPct, "#.0#") + "%)"
        string meter = ""
        if dolMeter
            int filled = math.max(0, math.min(5, int(math.round(conv / 20.0))))
            string mtr = ""
            for seg = 1 to 5
                mtr := mtr + (seg <= filled ? "▰" : "▱")
            meter := " " + mtr
        string dolTxt = arrow + " DOL " + (drawUp ? "UP" : "DOWN") + " " + str.tostring(math.round(conv)) + "%" + meter
        // path-clearance (feature 1) + ETA (feature 2) appended to the 🎯 target row
        string clrTxt = ""
        if projClear and not na(tgtPrice)
            [clrScore, obsN] = f_pathClear(close, tgtPrice, atrU2)
            clrTxt := " · 🛣️" + str.tostring(clrScore) + (obsN > 0 ? (" (" + str.tostring(obsN) + " block" + (obsN == 1 ? "" : "s") + ")") : " clear")
        string etaTxt = (projETA and not na(tgtPrice)) ? f_eta(tgtPrice) : ""
        string tgtTxt = na(tgtPrice) ? "" : ("🎯 target" + distTxt + clrTxt + etaTxt)
        string tugTxt = ""
        if dolTugBar and totalG > 0
            int bslPct = int(math.round(bslEff / totalG * 100.0))
            int sslPct = 100 - bslPct
            int sslSeg = int(math.round(sslPct / 10.0))
            string bar = ""
            for sg = 1 to 10
                bar := bar + (sg <= sslSeg ? "▮" : "▯")
            tugTxt := "SSL " + str.tostring(sslPct) + " " + bar + " " + str.tostring(bslPct) + " BSL"
        // equilibrium / range-state (feature 3): where price sits in the live dealing range
        string equiTxt = ""
        if projEqui and not na(rngHi) and not na(rngLo) and rngHi > rngLo
            float posR = (close - rngLo) / (rngHi - rngLo)
            string state = posR >= 0.62 ? "PREMIUM" : (posR <= 0.38 ? "DISCOUNT" : "EQUILIBRIUM")
            string emoR = posR >= 0.62 ? "🔺" : (posR <= 0.38 ? "🔻" : "⚖️")
            equiTxt := emoR + " " + state + " " + str.tostring(math.round(posR * 100)) + "%"
        // resistance readout: how clear the path is up vs down (0 = fully walled, 100 = open)
        string resistTxt = ""
        if projResist
            resistTxt := "🧱 clear ↑" + str.tostring(math.round(upClr)) + " ↓" + str.tostring(math.round(dnClr))
        color dirAccent = drawUp ? themeUpSolid : themeDnSolid
        bool showTgtRow = dolTgtLine and not na(tgtPrice)
        bool showTugRow = dolTugBar and totalG > 0
        bool showEquiRow = projEqui and equiTxt != ""
        bool showResistRow = projResist and resistTxt != ""
        dolSzB = dolSize == "Huge" ? size.large : dolSize == "Large" ? size.normal : size.small
        var table dolTbl = table.new(position.top_right, 1, 5, border_width = 1)
        table.set_position(dolTbl, f_tablePos(dolBanPos))
        table.clear(dolTbl, 0, 0, 0, 4)
        table.cell(dolTbl, 0, 0, dolTxt, text_color = dirAccent, bgcolor = themePanelBg, text_size = dolSzB)
        int rowN = 1
        if showTugRow
            table.cell(dolTbl, 0, rowN, tugTxt, text_color = themeTxt, bgcolor = themeRowBg, text_size = size.small)
            rowN := rowN + 1
        if showResistRow
            table.cell(dolTbl, 0, rowN, resistTxt, text_color = themeTxt, bgcolor = themeRowBg, text_size = size.small)
            rowN := rowN + 1
        if showEquiRow
            table.cell(dolTbl, 0, rowN, equiTxt, text_color = themeTxt, bgcolor = themeRowBg, text_size = size.small)
            rowN := rowN + 1
        if showTgtRow
            table.cell(dolTbl, 0, rowN, tgtTxt, text_color = themeMuted, bgcolor = themeRowBg, text_size = size.small)
        table.set_frame_color(dolTbl, color.new(dirAccent, 35))
        table.set_frame_width(dolTbl, themeBW)

    // ---- pull-field ladder (right-edge heatmap toward the dominant magnet) ----
    // For each price band between price and dolTgt: strength = draw-toward-magnet (rises as
    // the band nears the target) × path-clearance from price to the band (cold where an
    // OB/FVG blocks the way). Rendered as a compact column of boxes at the right edge.
    f_clearField()
    if masterOn and showField and not na(dolTgt) and math.abs(dolTgt - close) > syminfo.mintick
        float atrF  = math.max(nz(atr), syminfo.mintick)
        float span  = dolTgt - close                 // signed: + = magnet above, - = below
        int   x0    = bar_index + fieldGap
        int   x1    = x0 + fieldWidth
        // pass 1: raw band scores, track max for normalization
        var fscore = array.new<float>()
        array.clear(fscore)
        float fmax = 0.0
        for bi = 0 to fieldBands - 1
            float f0 = span * (bi / float(fieldBands))
            float f1 = span * ((bi + 1) / float(fieldBands))
            float bMid = close + (f0 + f1) / 2.0
            float dTo = math.abs(dolTgt - bMid) / atrF          // distance from band to magnet
            float draw = math.pow(1.0 / (1.0 + dTo), 1.0 + dolNearBias)  // stronger near the target
            [clr, obs] = f_pathClear(close, bMid, atrF)          // clearance price -> band
            float sc = draw * (clr / 100.0)
            array.push(fscore, sc)
            fmax := math.max(fmax, sc)
        // pass 2: render normalized hot->cold cells
        if fmax > 0
            for bi = 0 to fieldBands - 1
                float f0 = span * (bi / float(fieldBands))
                float f1 = span * ((bi + 1) / float(fieldBands))
                float yTop = close + math.max(f0, f1)
                float yBot = close + math.min(f0, f1)
                float t = array.get(fscore, bi) / fmax           // 0..1 heat
                color cell = color.from_gradient(t, 0.0, 1.0, fieldCold, fieldHot)
                box fb = box.new(x0, yTop, x1, yBot, border_color = color.new(cell, math.min(fieldOpacity + 20, 95)), border_width = 1, bgcolor = color.new(cell, fieldOpacity))
                array.push(field_boxes, fb)
// wipe field when master/field off
if (not masterOn or not showField) and array.size(field_boxes) > 0
    f_clearField()

// wipe extra pool when master/OB off
if (not masterOn or not showOB) and array.size(xtra_boxes) + array.size(xtra_labels) > 0
    f_clearXtra()
// wipe ghost lines when master/ghost off
if (not masterOn or not showGhost) and array.size(ghost_lines) > 0
    f_clearGhost()

// -----------------------------------------------------------------------------
// FAIR VALUE GAPS  — rolling boxes  (arrays declared earlier, near projection helpers)
// -----------------------------------------------------------------------------
if (not masterOn or not showFVG) and array.size(fvgBoxes) > 0
    while array.size(fvgBoxes) > 0
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgIsBull)

bullFVG = low > nz(high[2], low)
bearFVG = high < nz(low[2], high)
if masterOn and showFVG and bullFVG
    b = box.new(bar_index[2], low, bar_index + extendR, high[2], border_color = color.new(colBull, 40), bgcolor = colFVG)
    array.push(fvgBoxes, b)
    array.push(fvgIsBull, true)
if masterOn and showFVG and bearFVG
    b = box.new(bar_index[2], low[2], bar_index + extendR, high, border_color = color.new(colBear, 40), bgcolor = colFVG)
    array.push(fvgBoxes, b)
    array.push(fvgIsBull, false)

if array.size(fvgBoxes) > 0
    while array.size(fvgBoxes) > 20
        box.delete(array.shift(fvgBoxes))
        array.shift(fvgIsBull)
    int i = 0
    while i < array.size(fvgBoxes)
        box bx     = array.get(fvgBoxes, i)
        bool isBull = array.get(fvgIsBull, i)
        float top  = box.get_top(bx)
        float bot  = box.get_bottom(bx)
        float mid  = (top + bot) / 2.0
        bool invalid = false
        if hideMitFVG
            if fvgFillMode == "Body close through"
                invalid := isBull ? (close < bot) : (close > top)
            else if fvgFillMode == "Wick touch (50%)"
                invalid := isBull ? (low <= mid) : (high >= mid)
            else
                invalid := high >= top and low <= bot
        if invalid
            box.delete(bx)
            array.remove(fvgBoxes, i)
            array.remove(fvgIsBull, i)
        else
            box.set_right(bx, bar_index + extendR)
            i += 1

// -----------------------------------------------------------------------------
// ALERTS
// -----------------------------------------------------------------------------
f_touch(float lvl) => not na(lvl) and high >= lvl and low <= lvl
alertcondition(f_touch(pdh) or f_touch(pdl), "PD level touched", "Price touched a Previous-Day level")
alertcondition(f_touch(lastPH) or f_touch(lastPL), "Liquidity swept", "Price swept a swing liquidity level")
alertcondition(f_touch(nyH) or f_touch(nyL) or f_touch(londH) or f_touch(londL) or f_touch(asiaH) or f_touch(asiaL), "Session level touched", "Price touched a session high/low")
alertcondition(sfpLong or sfpShort, "SFP fired", "Sweep + reversal (liquidity grab) detected")
alertcondition(sfpLong, "SFP long", "Bullish sweep + reversal")
alertcondition(sfpShort, "SFP short", "Bearish sweep + reversal")
